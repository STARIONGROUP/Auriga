<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>11.0</LangVersion>
        <Title>Auriga.Xmi</Title>
        <Version>1.0.0</Version>
        <Description>XMI readers and writers for Eclipse Capella models: .capella / .melodymodeller / .capellafragment semantic documents (Auriga.Xmi.Model.*) and Sirius .aird / .airdfragment diagram documents (Auriga.Xmi.Diagram.*), built on the metamodel-agnostic XMI runtime (Auriga.Xmi.Core.*).</Description>
        <PackageId>Auriga.Xmi</PackageId>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <AssemblyTitle>Auriga.Xmi</AssemblyTitle>
        <PackageTags>Capella Arcadia Sirius GMF Aird Ecore XMI MBSE modeltopia</PackageTags>
        <!-- Generated at release time from CHANGELOG.md by .github/workflows/nuget-release.yml. Record a change there, not here. -->
        <PackageReleaseNotes></PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Autofac" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Auriga.Extensions\Auriga.Extensions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    </ItemGroup>

</Project>
