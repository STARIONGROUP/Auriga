<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>11.0</LangVersion>
        <Title>Auriga.Reporting</Title>
        <Version>1.0.0</Version>
        <Description>Turns Eclipse Capella / Sirius diagrams into the artifacts a reader consumes: SVG, PNG, JPEG and Excel. Built on a renderer-agnostic intermediate model — a Diagram of Boxes and Edges with absolute, persisted coordinates, produced from a parsed .aird by pairing each GMF notation view with its Sirius representation element and resolved Capella semantic element.</Description>
        <PackageId>Auriga.Reporting</PackageId>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <AssemblyTitle>Auriga.Reporting</AssemblyTitle>
        <PackageTags>Capella Arcadia Sirius GMF Aird Diagram Rendering Reporting SVG PNG MBSE modeltopia</PackageTags>
        <!-- Generated at release time from CHANGELOG.md by .github/workflows/nuget-release.yml. Record a change there, not here. -->
        <PackageReleaseNotes></PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Autofac" />
        <PackageReference Include="ClosedXML" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="SkiaSharp" />
        <!-- SkiaSharp ships native assets for Windows and macOS only; Linux needs this one. -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
        <PackageReference Include="Svg.Skia" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Auriga.Extensions\Auriga.Extensions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Assets\CapellaIcons\*.svg" />
        <EmbeddedResource Include="Assets\CapellaIcons\*.gif" />
        <EmbeddedResource Include="Assets\CapellaIcons\*.png" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    </ItemGroup>

</Project>
