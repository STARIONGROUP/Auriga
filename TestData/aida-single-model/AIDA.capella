                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c84d3291-0051-44e2-9b8b-30ded151e5b1" sid="c84d3291-0051-44e2-9b8b-30ded151e5b1"
