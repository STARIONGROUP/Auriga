                  name="[SF1.2.6] Depower motor 2" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The&amp;nbsp;MCPS shall shut down the Motor&amp;nbsp;2 command when Motor&amp;nbsp;2 disabled is &amp;quot;Requested&amp;quot; or when its status is INVALID.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#32302aed-d6a3-443c-b20b-f6ccc542c0ba"
