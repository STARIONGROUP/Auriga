            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="8567a34c-429d-4a84-9211-0f7e377c9e39" sid="8567a34c-429d-4a84-9211-0f7e377c9e39"
                name="[SF7.3] Monitor drone parameters" appliedPropertyValueGroups="#e71c0d4b-9549-4222-8e02-d6f64da392ff">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="e71c0d4b-9549-4222-8e02-d6f64da392ff" sid="e71c0d4b-9549-4222-8e02-d6f64da392ff"
                  name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="48aa74b3-739e-4ac7-b8ea-d7c9824c041a" sid="48aa74b3-739e-4ac7-b8ea-d7c9824c041a"
                    name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                    type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#7186ed46-d9ae-48d1-b485-24f4c5604809"/>
              </ownedPropertyValueGroups>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="7f0e6282-565e-479b-81e4-2032e8800e3f" sid="7f0e6282-565e-479b-81e4-2032e8800e3f"
                  name="[SF7.3.1] Compare drone attitude" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compare drone attitude and drone attitude MON.&lt;/p>&#xA;&#xA;&lt;p>The monitoring shall compare drone attitude rate and drone attitude rate MON.&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall detect an attitude measurement failure as follows : IF (drone attitude is INVALID) OR (drone attitude rate is INVALID) OR (drone attitude MON is INVALID) OR (drone attitude rate MON is INVALID) OR (a drone attitude discrepancy is&amp;nbsp;detected) OR (a drone attitude rate discrepancy is detected) THEN attitude measurement failure&amp;nbsp;= FAILURE DETECTED ELSE attitude measurement = NO FAILURE.&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall detect an attitude measurement failure as follows :&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#9cd5002b-4ac3-40bc-8eaf-93a5c0c9200d">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="9cd5002b-4ac3-40bc-8eaf-93a5c0c9200d" name="DAL level.FDAL"
                    appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="79eeb1c8-1573-4410-a7a9-c676eed32200" name="Functionnal Design Assurance Level"
                      appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="bea29538-aba7-4dcd-8f41-82a5d2072744" sid="bea29538-aba7-4dcd-8f41-82a5d2072744"
                    name="FIP 1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
