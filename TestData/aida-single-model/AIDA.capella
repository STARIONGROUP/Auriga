                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="084b83ce-a081-4604-8a66-9bb2fb64ed5c" sid="084b83ce-a081-4604-8a66-9bb2fb64ed5c"
                    name="FOP 2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="376d2aee-1c5e-46fb-a323-576e2184dada" sid="376d2aee-1c5e-46fb-a323-576e2184dada"
                    name="FOP 3"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="587d2d86-b2f7-4d77-a196-193c3d0b7ece" sid="587d2d86-b2f7-4d77-a196-193c3d0b7ece"
