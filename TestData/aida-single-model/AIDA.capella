          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="40de6da2-7c73-4f86-93d6-e70724e98c63" sid="40de6da2-7c73-4f86-93d6-e70724e98c63"
              name="[SF3] Provide drone navigation data" appliedPropertyValueGroups="#bd9262c3-248e-4b0e-a267-25480b4cd84d">
            <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                id="bd9262c3-248e-4b0e-a267-25480b4cd84d" sid="bd9262c3-248e-4b0e-a267-25480b4cd84d"
                name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
              <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                  id="f5111d43-b563-4886-a8dd-7addcbe0a4a7" sid="f5111d43-b563-4886-a8dd-7addcbe0a4a7"
                  name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                  type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
            </ownedPropertyValueGroups>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="5e797bb9-32b5-44a6-9556-06fc843c9756" sid="5e797bb9-32b5-44a6-9556-06fc843c9756"
                name="[SF3.1] Measure physical values" description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;FR&quot;>les attitudes sont estim&amp;eacute;es &amp;agrave; partir des mesures gyro. Les biais des gyro roulis et tangage sont estim&amp;eacute;s gr&amp;acirc;ce &amp;agrave; la comparaison avec la mesure de la gravit&amp;eacute; effectu&amp;eacute;e par les acc&amp;eacute;l&amp;eacute;rom&amp;egrave;tres (fen&amp;ecirc;tre temporelle d&amp;rsquo;environ 30s, en l&amp;rsquo;absence de commande d&amp;rsquo;attitude). &lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;FR&quot;>Le biais gyro en lacet est estim&amp;eacute;e gr&amp;acirc;ce au magn&amp;eacute;tom&amp;egrave;tre (hypoth&amp;egrave;se Terre plate . Direction du nord magn&amp;eacute;tique fixe pendant la mission)&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>&lt;span lang=&quot;FR&quot;>Note : confirm that pitch and roll consigns are used only to detect the absence of attitude command and trigger the gyroscop bias estimation (only during init phase on ground ?)&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&amp;nbsp;&lt;/p>&#xA;"
                appliedPropertyValueGroups="#763dbc29-b39a-4218-a2da-530584427c58">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="763dbc29-b39a-4218-a2da-530584427c58" sid="763dbc29-b39a-4218-a2da-530584427c58"
                  name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="2d1d4422-8c4e-4098-9d43-12cabcaf71a7" sid="2d1d4422-8c4e-4098-9d43-12cabcaf71a7"
                    name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                    type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
