                  id="ff93fe9e-b653-40f2-a397-988921eb0132" sid="ff93fe9e-b653-40f2-a397-988921eb0132"
                  name="[SF7.2.5] Control roll angle MON" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute Pphi as the result of the closed loop control of the rollangle to reach the Roll consign from the current Drone roll and Drone roll rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute the Pphi validity status as follow : IF (Drone roll is INVALID) OR (Drone roll rate validity status&amp;nbsp;is INVALID) OR (Roll consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Pphi validity status is INVALID ELSE Pphi validity status is VALID&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#6b78a3e9-d800-4f89-b09d-d72f1a867979">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
