              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="ef59e24b-b7f8-4e1b-9f8b-ecc196742ce2" sid="ef59e24b-b7f8-4e1b-9f8b-ecc196742ce2"
                  name="[SF7.3.2] Compare drone altitude" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compare altitude and altitude MON.&lt;/p>&#xA;&#xA;&lt;p>The monitoring shall compare vertical speed and vertical speed MON.&lt;/p>&#xA;&#xA;&lt;p>The monitoring shall compare ground altitude and ground altitude MON.&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall detect an altitude measurement failure as follows : IF (drone altitude is INVALID) OR (vertical speed is INVALID) OR (ground speed is INVALID) OR&amp;nbsp;(drone attitude MON is INVALID) OR (vertical speed MON is INVALID) OR (ground altitude is INVALID) OR&amp;nbsp;(an atitude discrepancy is&amp;nbsp;detected) OR (a&amp;nbsp;vertical speed&amp;nbsp;discrepancy is detected) OR (a ground altitude discrepancy is detected) THEN altitude measurement failure&amp;nbsp;= FAILURE DETECTED ELSE altitude measurement = NO FAILURE.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#68ad3be5-3fa8-4a45-9bd5-a1b9ed69596e">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="68ad3be5-3fa8-4a45-9bd5-a1b9ed69596e" name="DAL level.FDAL"
                    appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="202b1af1-b928-40a1-bad9-20ccac88c7e0" name="Functionnal Design Assurance Level"
                      appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="73ad8098-5a4d-4419-a797-fd3d2a23c49f" sid="73ad8098-5a4d-4419-a797-fd3d2a23c49f"
                    name="FIP 3"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="435a30c9-05d5-45c9-a387-69f4abcb4508" sid="435a30c9-05d5-45c9-a387-69f4abcb4508"
                    name="FIP 4"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="b4b37a07-0eaf-4639-a9b4-a21b0550adbd" sid="b4b37a07-0eaf-4639-a9b4-a21b0550adbd"
                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="a6613fa5-a7b1-4ec9-8be3-dffadc1b7c0c" sid="a6613fa5-a7b1-4ec9-8be3-dffadc1b7c0c"
                  name="[SF7.3.3] Compare drone motor commands" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>For each motor, the monitoring processor shall compare Motor rate and Motor rate MON.&lt;/p>&#xA;&#xA;&lt;p>For each motor, the monitoring processor shall detect a motor consign failure as follows : IF (Motor rate is INVALID) OR (Motor rate MON is INVALID) OR (a motor rate discrepancy is detected) THEN Motor consign failure = FAILURE DETECTED ELSE Motor consign failure = NO FAILURE.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#b4fcc075-1150-47d3-80a5-acc432575a04">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="b4fcc075-1150-47d3-80a5-acc432575a04" sid="b4fcc075-1150-47d3-80a5-acc432575a04"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="974a1759-7c50-404b-9b0f-71a97ac96547" sid="974a1759-7c50-404b-9b0f-71a97ac96547"
