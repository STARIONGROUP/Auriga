                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="a2b3d418-a21e-4ca1-ad03-7eda97b1d908" sid="a2b3d418-a21e-4ca1-ad03-7eda97b1d908"
                    name="FIP 1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="b94bd614-26da-48ad-a82c-cab526c49eef" sid="b94bd614-26da-48ad-a82c-cab526c49eef"
                    name="FOP 1"/>
