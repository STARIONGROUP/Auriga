                    name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                    type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
              </ownedPropertyValueGroups>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="e4af7c54-78fe-463c-8141-6915d2de3807" sid="e4af7c54-78fe-463c-8141-6915d2de3807"
                  name="[SF2.2.1] Acquire pitch order" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote Pitch order and send it to the Drone as the Pitch consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#93aeddd7-f350-4e5f-b599-fc3d08c6a653">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
