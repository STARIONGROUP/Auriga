            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="458bd840-7571-4fc8-b044-4f3cc7ea4307" sid="cd4b4638-23ec-4864-8924-4a3b5c99db04"
                name="[SF1.2] Control propeller 2" description="&lt;p>This function controls the engine 1.&lt;/p>&#xA;"
                appliedPropertyValueGroups="#d5ef0047-7888-4bac-9be0-4d24efa1c457">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="d5ef0047-7888-4bac-9be0-4d24efa1c457" sid="d5ef0047-7888-4bac-9be0-4d24efa1c457"
                  name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="457adcb8-90ae-4f05-a332-c6c99b086da5" sid="457adcb8-90ae-4f05-a332-c6c99b086da5"
                    name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                    type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#1ed8f881-a7b9-4ac3-b2e6-ea5235d56475"/>
              </ownedPropertyValueGroups>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="a650d702-3c2f-4875-b1f5-ecd4c91f234d" sid="3ae73397-7ab1-46e6-88de-bd3aeb9515b3"
                  name="[SF1.2.1] Control motor 2" description="&lt;p>This function controls the current sent to the engine, based on the Motor rate demand and the Motor rate measurement. The Motor position measurement is also used, it is assumed at this stage that the motor will be brushless engines for which the position is needed.&lt;/p>&#xA;&#xA;&lt;p>REQs :&lt;/p>&#xA;&#xA;&lt;p>The&amp;nbsp;variator shall compute the Motor i control consign as a function of the &amp;quot;Motor i rate&amp;quot; demand, the &amp;quot;Motor i rate measured&amp;quot; feedback and the &amp;quot;Motor i position measured&amp;quot; feedback.&lt;/p>&#xA;&#xA;&lt;p>The variator shall set the Motor i control consign validity&amp;nbsp;status to INVALID if one of the validity status of &amp;quot;Motor i rate&amp;quot;, &amp;quot;Motor i rate measured&amp;quot; or &amp;quot;Motor i position measured&amp;quot; is INVALID, otherwise to VALID.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#dac216e2-989a-4826-957a-826a9a9032d7">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="dac216e2-989a-4826-957a-826a9a9032d7" sid="dac216e2-989a-4826-957a-826a9a9032d7"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="860c6b74-04e8-494b-8fd5-5780a6aaa087" sid="860c6b74-04e8-494b-8fd5-5780a6aaa087"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#1ed8f881-a7b9-4ac3-b2e6-ea5235d56475"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c3c6be8f-2c54-43c9-9c06-8835966fd619" sid="8cc98ce5-c678-4ee9-9a69-d1e55e9e546d"
                    name="FIP 1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="84110427-88ab-4890-b9f9-7831b9702772" sid="ceee2807-ceed-4cf8-b61c-fce252a4398e"
