                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="d6d89294-e63d-41c9-babf-3cc3a1522438" sid="d6d89294-e63d-41c9-babf-3cc3a1522438"
                    name="FOP Pt"/>
