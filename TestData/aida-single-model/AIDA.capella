              </ownedFeatures>
              <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
                  id="5b1065e0-58e3-4b3a-ac8e-a7cbea51d318" targetElement="#53711f6d-23a4-42e1-be6b-3fded5ba0efe"
