                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="a40d4be4-aed2-432c-9b54-5a550ed4f5be" sid="a40d4be4-aed2-432c-9b54-5a550ed4f5be"
                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="5a37e623-789b-40f1-ba28-79d833d8fcd9" targetElement="#c5713742-5587-471c-9973-1f6a2e7e8118"
                  sourceElement="#99a496c2-c42f-41fc-857e-fa7f7092187a"/>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="bfa07d56-547b-4e77-887c-c280711194c0" targetElement="#043c12a5-e7c6-44d2-98ea-19160c9d6d58"
                  sourceElement="#99a496c2-c42f-41fc-857e-fa7f7092187a"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="79fd1a18-e41e-4fa5-9d45-cff4b6bfe612" sid="79fd1a18-e41e-4fa5-9d45-cff4b6bfe612"
                name="[SF2.3] Control attitude" description="&lt;p>This function realises the closed-loop control of the drone attitude :&lt;/p>&#xA;&#xA;&lt;p>- first, the adequate attitude demand is selected (SF2.3.2), depending on AP engagement value :&amp;nbsp;IF AP engagement = &amp;quot;engaged&amp;quot;, THEN the Attitude AP values are selected ELSE the pilot consign are selected (Yaw rate demand is integrated to compute the yaw demand : SF2.3.1)&lt;/p>&#xA;&#xA;&lt;p>- then, SF2.3.3, SF2.3.4 and SF2.3.5 realise the closed-loop control of each angle (respectively pitch, roll, yaw) : they compute the requested forces related to each angle to achieve the requested positions, using the attitude position and speed measurements from SF3. Two typical control structure (see dedicated presentation)&amp;nbsp;: either a multi-variable PID loop&amp;nbsp;on both position and speed, or two imbricated PI loops on position and speed.&lt;/p>&#xA;"
                appliedPropertyValueGroups="#bf610856-cf08-450e-8b8d-a0a8a6ee8294">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="bf610856-cf08-450e-8b8d-a0a8a6ee8294" sid="bf610856-cf08-450e-8b8d-a0a8a6ee8294"
                  name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="0176db07-d4eb-4344-813b-8f5978f7895e" sid="0176db07-d4eb-4344-813b-8f5978f7895e"
                    name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                    type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
              </ownedPropertyValueGroups>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="cd92c2d9-3b41-4b1c-88d2-6c501be16a50" sid="cd92c2d9-3b41-4b1c-88d2-6c501be16a50"
                  name="[SF2.3.1] Compute yaw consign" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Yaw consign as th integration of the Yaw rate consign.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Yaw consign validity status as the Yaw rate consign validity status.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#dd90bf83-96ec-4f07-b27f-468e868eeff2">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="dd90bf83-96ec-4f07-b27f-468e868eeff2" sid="dd90bf83-96ec-4f07-b27f-468e868eeff2"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="ed893a2a-27dc-42f0-be85-f619e96bc984" sid="ed893a2a-27dc-42f0-be85-f619e96bc984"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="e4bd1d4e-12a5-40ae-bd26-a5451296db1a" sid="e4bd1d4e-12a5-40ae-bd26-a5451296db1a"
                    name="FIP 1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="13a08651-2194-45fe-b1b9-bbb31deaab56" sid="13a08651-2194-45fe-b1b9-bbb31deaab56"
                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="2a86f5c7-9823-4931-a0b1-35c58c62a1b2" sid="2a86f5c7-9823-4931-a0b1-35c58c62a1b2"
