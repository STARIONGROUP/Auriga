              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="b19bfc9e-6c25-43e5-9d71-7f76396b03d5" sid="b19bfc9e-6c25-43e5-9d71-7f76396b03d5"
                  name="[SF1.4.7] Measure motor 4 speed MON" description="&lt;p>REQ&lt;/p>&#xA;&#xA;&lt;p>The motor shall provide a tachometer signal corresponding to its rotation speed to the Monitoring channel of the MCPS&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#15012f83-2566-4181-b60f-fdf9e07b9d88">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="15012f83-2566-4181-b60f-fdf9e07b9d88" sid="15012f83-2566-4181-b60f-fdf9e07b9d88"
