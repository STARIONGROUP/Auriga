                  id="a3ff93be-2aec-40a3-97b6-efa16f20df9a" name="FIP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="069b4089-9f78-40bf-85cd-93781d7ecb7c" name="FOP 1"/>
