                  <ownedRequirements xsi:type="Requirements:Requirement" id="bc8f5d28-198e-4378-8106-fafb4c77a010"
                      ReqIFIdentifier="MCPS_0015" ReqIFLongName="Safety - failure rates"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The MCPS shall respect the following failure rates :&lt;/p>&#xA;&#xA;&lt;p>- Loss of communication on Motors CAN bus : &amp;lt;1.10^-5&lt;/p>&#xA;&#xA;&lt;p>-Erroneous communication on Motors CAN bus : &amp;lt;1.10^-6&lt;/p>&#xA;&#xA;&lt;p>- Loss of MCPS control channel : 1.10^-5&lt;/p>&#xA;&#xA;&lt;p>- Misleading MCPS control channel : &amp;lt;1.10^-6&lt;/p>&#xA;&#xA;&lt;p>- Loss of MCPS monitoring channel : &amp;lt;1.10^-5&lt;/p>&#xA;&#xA;&lt;p>- Misleading MCPS monitoring channel : &amp;lt;1.10^-6&lt;/p>&#xA;">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="dca12a8e-20d2-4ea3-9c60-3b33b36fd0a1" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
