                    requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The Desing Assurance Level associated to the function of the Propulsion unit shall be A.&lt;/p>&#xA;">
                  <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
