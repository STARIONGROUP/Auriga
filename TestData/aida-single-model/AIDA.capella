                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="33bd8c83-b1da-47de-b61c-d6515a30508d" sid="33bd8c83-b1da-47de-b61c-d6515a30508d"
                    name="FIP Tman"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="76712516-d72e-4db8-b9b9-039c37bb24c2" sid="76712516-d72e-4db8-b9b9-039c37bb24c2"
                    name="FIP Eng"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="d551297a-b9d2-4d6f-9cf7-384184de2647" sid="d551297a-b9d2-4d6f-9cf7-384184de2647"
                    name="FOP T"/>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="06acfde5-f3f3-4cd1-b80d-2d3913fec6ae" targetElement="#0fd53135-bf6c-4aa2-98c8-2a4b41ec0cc0"
                  sourceElement="#b7e0ca10-5698-4cf6-a0cf-94994d78cc82"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="be2f8504-5786-46f4-b19b-d7df0bd4edf4" sid="be2f8504-5786-46f4-b19b-d7df0bd4edf4"
                  name="Altitude consign" target="#e248a904-fb22-4c6b-9aec-d75205078c15"
                  source="#8e620e63-07d1-4cdd-b1bd-4d7ed2cff9c7"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="12d0082a-ec1f-4597-8e21-6cbe7ae8c9f2" sid="12d0082a-ec1f-4597-8e21-6cbe7ae8c9f2"
                  name="Tmanual" target="#33bd8c83-b1da-47de-b61c-d6515a30508d" source="#25be096a-127a-463b-9b95-6d0a2cbf67f8"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="a99351ae-d454-4594-9ada-9d6a8b1808d7" sid="a99351ae-d454-4594-9ada-9d6a8b1808d7"
                name="[SF2.5] Compute motor commands" description="&lt;p>This function computes the engines rotation rate demands to generate the various thrust components :&amp;nbsp;total vertical&amp;nbsp;thrust (to control the altitude) and torque generated around the various axis (to control the attitude).&lt;/p>&#xA;&#xA;&lt;p>Ptheta/phi/psi are the forces needed to generate a rotation around the corresponding axis (=Torque X Lever_arm).&lt;/p>&#xA;"
                appliedPropertyValueGroups="#ea3f6f19-e8da-47a6-a764-c23f8d1c2daa">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="ea3f6f19-e8da-47a6-a764-c23f8d1c2daa" sid="ea3f6f19-e8da-47a6-a764-c23f8d1c2daa"
                  name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="9938afee-1723-461b-bc57-84ea897020c6" sid="9938afee-1723-461b-bc57-84ea897020c6"
                    name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                    type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
              </ownedPropertyValueGroups>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="00217877-bab0-4431-bcdd-00680d096be9" sid="00217877-bab0-4431-bcdd-00680d096be9"
                  name="[SF2.5.1] Compute motors expected thrust" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the thrust required from each propeller P1, P2, P3, P4 with the following formulas :&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>1&lt;/font>&lt;/sub> = Thrust + P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>2&lt;/font>&lt;/sub> = Thrust - P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>3&lt;/font>&lt;/sub> = Thrust- P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>4&lt;/font>&lt;/sub> = Thrust + P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the P1, P2, P3, P4 validity statuses as follows : IF (Thrust is INVALID) OR (PTheta is INVALID) OR (Pphi is INVALID) OR (Ppsi is INVALID) THEN P1, P2, P3, P4 are INVALID ELSE P1, P2, P3, P4 are VALID.&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&amp;nbsp;&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#f9dd19f4-f15e-4e94-8e0b-0400a18209f5">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="f9dd19f4-f15e-4e94-8e0b-0400a18209f5" name="DAL level.FDAL"
                    appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="28e6cfb8-35b2-4948-a3a7-d3c884175347" name="Functionnal Design Assurance Level"
                      appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="5769320c-c32d-4e10-a14c-ca1230f0ee06" sid="5769320c-c32d-4e10-a14c-ca1230f0ee06"
                    name="FIP Pt"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c943e445-c272-4446-9d10-820ca59ec981" sid="c943e445-c272-4446-9d10-820ca59ec981"
                    name="FIP Pphi"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c3555e6d-cff7-4aa0-b439-40647ce0d21d" sid="c3555e6d-cff7-4aa0-b439-40647ce0d21d"
                    name="FIP Ppsi"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="34179cb8-d7f3-43df-99b9-d0098f3ad722" sid="34179cb8-d7f3-43df-99b9-d0098f3ad722"
                    name="FIP T"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="1de99de0-c831-4a84-9b7c-aaf37fa1e440" sid="1de99de0-c831-4a84-9b7c-aaf37fa1e440"
                    name="FOP P1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="02eb39e3-5226-488d-9e01-4a80aeb22be2" sid="02eb39e3-5226-488d-9e01-4a80aeb22be2"
                    name="FOP P2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="9ebf1694-477e-4926-aba5-e257c8df8ce2" sid="9ebf1694-477e-4926-aba5-e257c8df8ce2"
                    name="FOP P3"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="9e8c5d65-c28c-44e9-a194-4fd914af756d" sid="9e8c5d65-c28c-44e9-a194-4fd914af756d"
                    name="FOP P4"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="5fee77ff-f555-4c52-812a-c767b6d69f2a" sid="5fee77ff-f555-4c52-812a-c767b6d69f2a"
                  name="[SF2.5.2] Compute motors speed command" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the Motor 1,2,3,4 rotation rate for each propeller from the expected thrust as follows (Cprop_i being the propeller coefficient of the propeller i):&lt;/p>&#xA;&#xA;&lt;p>Motor i rotation rate = square_root(Pi/Cprop_i) (i=1,2,3,4)&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the Motor 1,2,3,4 rotation rate validity status as follows : IF Pi is INVALID THEN Motor i rotation rate is INVALID ELSE Motor i rotation rate is valid (i=1,2,3,4).&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#76cdf3e9-50ac-47c6-92fa-1ffa42c0729d">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="76cdf3e9-50ac-47c6-92fa-1ffa42c0729d" sid="76cdf3e9-50ac-47c6-92fa-1ffa42c0729d"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="c4dadb5a-4c1f-49f6-b5b8-f9ff2d4605cc" sid="c4dadb5a-4c1f-49f6-b5b8-f9ff2d4605cc"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="45a40d9b-6ced-4574-a589-f871badd7dc3" sid="45a40d9b-6ced-4574-a589-f871badd7dc3"
                    name="FIP P1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
