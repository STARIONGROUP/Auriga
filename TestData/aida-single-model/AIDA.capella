                    name="FIP 6"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="a951dfdf-f42a-461e-80ce-db85c3090180" sid="a951dfdf-f42a-461e-80ce-db85c3090180"
