              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="1c4686cd-84ea-4d98-9dd9-812ec656d978" sid="ac9a89d2-caff-407c-9f29-efa9b221cba0"
                  name="[SF1.4.3] Create thrust and torque at propeller 4" description="&lt;p>This function transforms the rotation mouvement into lift/drag and torque.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The propeller shall transform the Motor i motion into Helix 1 thrust and Helix 1 torque.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#c2eabdcf-c7fd-453f-b3c9-4f999581637f">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="c2eabdcf-c7fd-453f-b3c9-4f999581637f" sid="c2eabdcf-c7fd-453f-b3c9-4f999581637f"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
