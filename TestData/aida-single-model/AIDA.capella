        </ownedTypes>
        <ownedTypes xsi:type="Requirements:RelationType" id="725baeba-8665-4983-93f7-7b5a985ddc08"
            ReqIFLongName="Allocation"/>
        <ownedTypes xsi:type="Requirements:RelationType" id="801e3058-4eb7-40e8-8355-0b26b2fab27c"
            ReqIFLongName="Refers to"/>
      </ownedExtensions>
      <ownedExtensions xsi:type="CapellaRequirements:CapellaModule" id="30f5d910-a53a-4a80-95e4-9c5c9ae2116f"
          ReqIFLongName="AIDA requirements">
        <ownedRequirements xsi:type="Requirements:Folder" id="9a61e3c2-81b2-466d-be20-ecda2e8aa6e1"
            ReqIFLongName="AIDA system requirements" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4">
          <ownedRequirements xsi:type="Requirements:Folder" id="ebdbd85d-2214-443a-b57b-4df90c669473"
              ReqIFLongName="User and operationnal needs" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4">
            <ownedRequirements xsi:type="Requirements:Requirement" id="7f891e95-6a78-48e0-9cf2-e0d3eb86f1fb"
                ReqIFIdentifier="[AIDA_UserNeed_1]" ReqIFLongName="Pre-flight check assistance"
                requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The AIDA system shall provide the following information to assistate the pre-flight check process :&lt;br />&#xA;- pictures and videos of the various inspection points as defined in standard pre-flight check procedure&lt;br />&#xA;- analysis of the compliance of the aircraft state, and detection of the deviations&lt;br />&#xA;- analysis of the icing state of the aircraft&lt;/p>&#xA;">
              <ownedAttributes xsi:type="Requirements:EnumerationValueAttribute" id="4f8dfe16-897e-4ed4-b125-c38da9bc03cd"
                  definition="#96f5da6c-4d14-4746-9e9b-82862394c925" values="#8a4e94ad-bd26-4bc7-89ad-03b7537ea5ea"/>
              <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="7c28f563-7b83-40fa-a459-685bd376cbe3"
                  value=""/>
              <ownedAttributes xsi:type="Requirements:IntegerValueAttribute" id="46a808d2-f9b0-4961-85ba-18596f9a880e"
                  definition="#d68d0e3b-2797-4037-a994-0af555053e42"/>
              <ownedAttributes xsi:type="Requirements:EnumerationValueAttribute" id="4c8d37a0-8f49-4eda-8eca-39f4c9188217"
                  definition="#4971d352-90fc-43fa-83d2-244a80219341" values="#0b3b662a-0784-4c0e-9991-1f9642f3278b"/>
              <ownedAttributes xsi:type="Requirements:EnumerationValueAttribute" id="454457ef-5356-4db4-80a6-52008591a68c"
                  definition="#a0c5ea8b-d45c-4294-bbe8-b2730071cea1" values="#75779eb8-3590-4eb4-9551-4957f2c4d7fa"/>
              <ownedAttributes xsi:type="Requirements:EnumerationValueAttribute" id="87667d2d-9c29-4e02-bea9-36c5502ee490"
                  definition="#91382234-cc33-4531-ac08-a188f28ab844" values="#827c5481-21bd-46d4-baf8-f08d6bb8d574"/>
              <ownedAttributes xsi:type="Requirements:EnumerationValueAttribute" id="42d07f89-3174-4231-8783-3d450beafa08"
                  definition="#7a9f52d3-4942-4258-a6e8-1b8ecb9336f2" values="#f85d1810-587b-416e-88bf-942f53d7e49d"/>
              <ownedAttributes xsi:type="Requirements:EnumerationValueAttribute" id="67924e48-bb9e-4bc4-9bf4-718c304735cf"
                  definition="#0f0d2229-8efb-44de-85ed-f689720d552f" values="#438cc86d-f40f-4451-b51f-4fbcabf645fa"/>
              <ownedAttributes xsi:type="Requirements:EnumerationValueAttribute" id="41eb6389-7215-410e-8602-85a7cace6ba4"
                  definition="#62edef84-b962-4699-a89e-24b112895167" values="#937d0766-5c9b-43f8-b5e3-6d2182452cfc"/>
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="e874a2dd-bad9-402d-ba62-5b2540f0533a" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#7f891e95-6a78-48e0-9cf2-e0d3eb86f1fb" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="b5808f58-14c5-4026-9190-5e9ce68b65df"
                ReqIFIdentifier="[AIDA_UserNeed_2]" ReqIFLongName="UAS concept" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="The AIDA system shall be an Unmanned Aircraft System concept.">
              <ownedAttributes xsi:type="Requirements:EnumerationValueAttribute" id="d81113b1-d4ef-4883-be12-66a0ca910b95"
                  definition="#a0c5ea8b-d45c-4294-bbe8-b2730071cea1"/>
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="6f4fb02a-24cc-4ed2-ab82-3240bfd36c68" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#b5808f58-14c5-4026-9190-5e9ce68b65df" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="b9b1524e-c529-4b6c-820a-8a5edfd1b9ca"
                ReqIFIdentifier="[AIDA_UserNeed_3]" ReqIFLongName="Inspection time"
                requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The AIDA system shall realize the aircraft inspection in the timeframe of a typical walk-around procedure.">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="7efbeedd-3ddf-43c9-b30a-0cf6f2a90e06" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#b9b1524e-c529-4b6c-820a-8a5edfd1b9ca" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="e9855050-a528-4b54-b6a6-3649d438e00e"
                ReqIFIdentifier="[AIDA_UserNeed_4]" ReqIFLongName="Airport gate environment"
                requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The AIDA system shall realize the Pre-Flight check of a civil aircraft in the typical environment of a commercial airport gate.&lt;br />&#xA;The following operations may take place at the same time : passengers and cargo loading and unloading, fuel servicing, cleaning, food servicing, de-icing.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="a8af5c0b-a676-46f3-ba95-af08751a0258" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#e9855050-a528-4b54-b6a6-3649d438e00e" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="1d2afed9-ef00-4158-8ff4-18e279f19f08"
                ReqIFIdentifier="[AIDA_UserNeed_5]" ReqIFLongName="Air environment conditions"
                requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The AIDA system shall realise the aircraft inspection in the following environmental conditions :&lt;br />&#xA;- day or night&lt;br />&#xA;- limited wind (&amp;lt;20kt TBC)&lt;br />&#xA;- no precipitations (rain, snow, hail,...)&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="638a8fcc-24e7-4367-ade1-abcee3c7b4da" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#1d2afed9-ef00-4158-8ff4-18e279f19f08" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Folder" id="606a9157-4e89-4e4c-9775-4c0ca6eaec71"
              ReqIFLongName="Certification requirements">
            <ownedRequirements xsi:type="Requirements:Requirement" id="199bb785-af95-4fb6-972c-73a94965b3d2"
                ReqIFIdentifier="[AIDA_certif_1]" ReqIFLongName="Applicable regulation - general"
                ReqIFName="" ReqIFPrefix="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFChapterName="" ReqIFText="&lt;p>The AIDA system shall comply with the following UAS applicable rules :&lt;br />&#xA;- Commission Implementing Regulation 2019/947 of 24 May 2019 on the rules and procedure for the operations of unmanned aircraft, amended by Commission regulation 2020/639&lt;br />&#xA;- Commission delegated regulation 2019/945 of 12 march 2019 on unmanned aircraft systems and on thrid country operators of unmanned aircraft systems, amended by Commission regulation 2020/746&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="248cfbbf-5d85-455d-b48c-83dc10b505da" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#199bb785-af95-4fb6-972c-73a94965b3d2" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="218962bc-bc7f-42a9-915a-a6a4deb93c9d"
                ReqIFIdentifier="[AIDA_certif_2]" ReqIFLongName="Applicable regulation - safety"
                requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The AIDA system shall comply with SC-RPAS1309-03 Special condition Equiment, systems and installations.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="b6343e57-bd8d-4e82-b60d-3a57645879e2" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#218962bc-bc7f-42a9-915a-a6a4deb93c9d" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Folder" id="65dd6c7a-2507-4cd5-b644-3451fb02e952"
              ReqIFLongName="Safety requirements">
            <ownedRequirements xsi:type="Requirements:Requirement" id="8640cdd3-02ae-4a7d-b3e1-822932c32246"
                ReqIFIdentifier="[AIDA_safety_1]" ReqIFLongName="FC01 (CAT)" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="The AIDA system shall be designed so that the Failure Condition « Uncontrolled drone, leading the drone to an unauthorized area, identified as Catastrophic, has a failure rate lower than 10-8/Fh and does not result from a single failure.">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="c8834158-3e65-49ba-9afc-ad0fdf1d1ce8" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#8640cdd3-02ae-4a7d-b3e1-822932c32246" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="0a47e1f1-a485-487d-bb20-2c5cf7efe402"
                ReqIFIdentifier="[AIDA_safety_2]" ReqIFLongName="FC02 (HAZ)" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="The AIDA system shall be designed so that the Failure Condition « Uncontrolled drone, leading the drone to an unauthorized area, identified as Catastrophic, has a failure rate lower than 10-8/Fh and does not result from a single failure.">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="4b3c0718-4596-4cc3-9c2d-ecc2e10f84e6" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#0a47e1f1-a485-487d-bb20-2c5cf7efe402" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="2ae5b212-92d1-46ae-a381-609a2ecc4130"
                ReqIFIdentifier="[AIDA_safety_3]" ReqIFLongName="FC03 (MAJ)" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="The AIDA system shall be designed so that the Failure Condition «Loss of drone capability leading to mission abortion », identified as Major, has a failure rate lower than 10-4/fh.">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="dcabf82c-475b-40e2-9912-fb0541d6491a" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#2ae5b212-92d1-46ae-a381-609a2ecc4130" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="1a61a7de-ec9d-4e4c-954b-3c50b1f60e1d"
                ReqIFIdentifier="[AIDA_safety_4]" ReqIFLongName="FC04 (MAJ)" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="The AIDA system shall be designed so that the Failure Condition «Loss of drone capability leading to mission abortion », identified as Major, has a failure rate lower than 10-4/fh.">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="e8d17a48-16a6-472f-9e1d-07353afde34d" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#1a61a7de-ec9d-4e4c-954b-3c50b1f60e1d" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Folder" id="4717ce34-1b65-4494-8ecd-b0924f2cb3c5"
              ReqIFLongName="Functional requirements">
            <ownedRequirements xsi:type="Requirements:Requirement" id="66f82ab1-1601-44c9-90f5-e52ae42d6ac8"
                ReqIFIdentifier="[AIDA_Fun_1]" ReqIFLongName="Provide direct remote identification information"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>When the drone is in operation, the AIDA system shall broadcast a direct remote identification that:&amp;nbsp;&lt;br />&#xA;- allows the upload of the UAS operator registration number in accordance with Article 14 of Implementing Regulation (EU) 2019/947 and exclusively following the process provided by the registration system|&amp;nbsp;&lt;br />&#xA;- ensures, in real time during the whole duration of the flight, the direct periodic broadcast from the UA using an open and documented transmission protocol, of the following data, in a way that they can be received directly by existing mobile devices within the broadcasting range:&amp;nbsp;&lt;br />&#xA;&amp;nbsp;&amp;nbsp; i the UAS operator registration number|&amp;nbsp;&lt;br />&#xA;&amp;nbsp;&amp;nbsp; ii the unique physical serial number of the UA compliant with standard ANSI/CTA-2063|&amp;nbsp;&lt;br />&#xA;&amp;nbsp;&amp;nbsp; iii the geographical position of the UA and its height above the surface or take-off point|&amp;nbsp;&lt;br />&#xA;&amp;nbsp;&amp;nbsp; iv the route course measured clockwise from true north and ground speed of the UA|&amp;nbsp; and&lt;br />&#xA;&amp;nbsp;&amp;nbsp; V the geographical position of the remote pilot or, if not available, the take-off point|&amp;nbsp;&lt;br />&#xA;-ensures that the user cannot modify the data mentioned under points ii, iii, iv and v&lt;/p>&#xA;">
              <ownedAttributes xsi:type="Requirements:EnumerationValueAttribute" id="57176333-4f4a-4892-92a9-6536136ab4a6"
                  definition="#96f5da6c-4d14-4746-9e9b-82862394c925"/>
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="a78a7100-77c5-4c04-aa05-62fa2447dc6f" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#66f82ab1-1601-44c9-90f5-e52ae42d6ac8" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="e586b23b-6b4e-4d21-984c-9693a9434f49"
                ReqIFIdentifier="[AIDA_Fun_2]" ReqIFLongName="Manage mission - mission definition"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>The AIDA system shall compute the authorized flight zone and the flight plan based on mission parameters provided by the pilot and mission data retrieved from the airline database.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="66e0512d-5512-4a4e-bba3-d3d54e273ae2" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#e586b23b-6b4e-4d21-984c-9693a9434f49" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="42e91b1d-e026-4e5f-a3fe-91b2e0f389e5"
                ReqIFIdentifier="[AIDA_Fun_3]" ReqIFLongName="Provide drone navigation data - attitude and angular rate"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>In the Mission execution mode, the AIDA system shall compute the drone attitude and angular rate with the following performances :&lt;br />&#xA;-roll : range +/-90&amp;deg;| accuracy 0.1&amp;deg; | resolution 0.01&amp;deg;&lt;br />&#xA;-pitch : range +/-90&amp;deg;| accuracy 0.1&amp;deg; | resolution 0.01&amp;deg;&lt;br />&#xA;-heading : range +/-180&amp;deg;| accuracy 0.1&amp;deg; | resolution 0.01&amp;deg;&lt;br />&#xA;-angular rate : range +/- 360&amp;deg;/s | accuracy 0.1&amp;deg;/s | resolution 0.01&amp;deg;/s&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="95201cd1-b128-4f04-91a3-14f95143102d" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#42e91b1d-e026-4e5f-a3fe-91b2e0f389e5" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="baad4f10-a8bb-4f48-a8cc-1992c3089dcf"
                ReqIFIdentifier="[AIDA_Fun_4]" ReqIFLongName="Provide drone navigation data - position and speed"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>In the Mission execution mode, the AIDA system shall compute the drone position and speed with the following accuracy :&lt;br />&#xA;-position : 1m&lt;br />&#xA;-speed : 0.1m/s&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="d8d5e025-6874-4bcb-ad0b-abe663dff19a" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#baad4f10-a8bb-4f48-a8cc-1992c3089dcf" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="071634b1-8ec0-4e2e-936e-2bfe0c6b5e63"
                ReqIFIdentifier="[AIDA_Fun_5]" ReqIFLongName="Control drone motion - control modes"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>The AIDA system shall provide the following control modes :&lt;br />&#xA;- Flight plan : the drone execute automatically the selected sequence (flight plan defined by the operator, or one of the pre-defined sequence : take-off, aircraft detection, landing, Return-To-Home)&lt;br />&#xA;- Speed consign : the drone keeps its current position, and moves when required by the pilot (pilot commands are interpreted as speed commands)&lt;br />&#xA;- Manual modes : the drone stabilizes its attitude (null pitch and roll, current heading), and moves when required by the pilot (pilot commands are interpreted as yaw rate, pitch and roll commands)&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="7d0b1766-17d4-44e2-b6f5-c1460acd5986" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#071634b1-8ec0-4e2e-936e-2bfe0c6b5e63" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="8c07d9ca-558e-49d8-8326-c83d226b600c"
                ReqIFIdentifier="[AIDA_Fun_6]" ReqIFLongName="Control drone motion - flight plan mode"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>In Flight plan mode, the AIDA system shall execute automatically the flight plan defined by the operator.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="ee549b54-fc62-41b8-bc0d-16abf968dc87" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#8c07d9ca-558e-49d8-8326-c83d226b600c" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="d6cde6e6-bff5-47b8-ba30-46ac0a55db38"
                ReqIFIdentifier="[AIDA_Fun_7]" ReqIFLongName="Control drone motion - speed consign mode"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>In position stabilisation mode, the AIDA system shall maintain the drone in its current position, and move the drone when required by the pilot (manual motion commands are interpreted as speed commands).&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="07b374ed-eb2a-4dad-91d3-a1c38ac1a60e" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#d6cde6e6-bff5-47b8-ba30-46ac0a55db38" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="59077d8c-12b1-447e-9772-113b5b0cb6da"
                ReqIFIdentifier="[AIDA_Fun_8]" ReqIFLongName="Control drone motion - manual mode"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>In manual mode, the AIDA system shall stabilize the drone attitude (null pitch and roll, current heading), and move the drone when required by the pilot (manual motion commands are interpreted as yaw rate, pitch and roll commands).&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="6fb150b2-0548-4602-ad4a-522e67f0d9af" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#59077d8c-12b1-447e-9772-113b5b0cb6da" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="bca31597-8fd4-4c66-9a4e-fe237db55afa"
                ReqIFIdentifier="[AIDA_Fun_9]" ReqIFLongName="Make and record videos"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>The AIDA system shall acquire pictures or videos when the pilot commands an acquisition or when required for the flight plan execution.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="604267c5-948f-428a-b252-cff512b8a4f3" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#bca31597-8fd4-4c66-9a4e-fe237db55afa" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="32f31542-a751-43c6-b72c-4062aada2065"
                ReqIFIdentifier="[AIDA_Fun_10]" ReqIFLongName="Detect AIDA failures - attitude measurement failure"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>The AIDA system shall detect the attitude measurement failures, and cut off the power supply to the motors when a failure is detected.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="8d3a8fc3-7102-471c-9bbb-aa55e5e951b0" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#32f31542-a751-43c6-b72c-4062aada2065" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="4227cac4-8711-440c-8ff9-fd250a5036e4"
                ReqIFIdentifier="[AIDA_Fun_11]" ReqIFLongName="Detect AIDA failures - altitude measurement failure"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>The AIDA system shall detect the altitude measurement failures, and cut off the power supply to the motors when a failure is detected.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="99492015-a6ad-47e7-aa19-39593ec18058" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#4227cac4-8711-440c-8ff9-fd250a5036e4" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="a4d33c0f-31c9-424b-96b5-790e9ee22a5b"
                ReqIFIdentifier="[AIDA_Fun_12]" ReqIFLongName="Detect AIDA failures - drone control failure"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>The AIDA system shall detect the drone control failures, and cut off the power supply to the motors when a failure is detected.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="921ee3d7-14af-4c49-97a4-caf038483308" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#a4d33c0f-31c9-424b-96b5-790e9ee22a5b" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="afa7cc7d-f7c0-49c3-823f-9242e1017063"
                ReqIFIdentifier="[AIDA_Fun_13]" ReqIFLongName="Detect AIDA failures - motor failures"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>The AIDA system shall detect the motor failures, and cut off the power supply to the failed motor when a failure is detected.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="6561bf9f-7d1e-4df0-b13d-1d7c027a1326" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#afa7cc7d-f7c0-49c3-823f-9242e1017063" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="04ab1ed3-3400-400f-889c-3a9daf4997d5"
                ReqIFIdentifier="[AIDA_Fun_14]" ReqIFLongName="Manage mission - drone measurement analysis"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>The AIDA system shall analyse the collected pictures and videos to detect aircraft abnormal state and icing.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="e5729dc6-fc76-43cb-9d67-14d05494acc6" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#04ab1ed3-3400-400f-889c-3a9daf4997d5" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Folder" id="7ecf0032-1c73-47d0-bb0c-29e48e64b41c"
              ReqIFLongName="Interface requirements">
            <ownedRequirements xsi:type="Requirements:Requirement" id="fec36e30-023c-4ca7-a2b7-948d5760fdd3"
                ReqIFIdentifier="[AIDA_Interfaces_1]" ReqIFLongName="Database interface"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>The AIDA system shall exchange the following information with the airline database :&lt;br />&#xA;- mission definition information (from database to AIDA) : flight zone, relative flight plan&lt;br />&#xA;- mission report (from AIDA to database) : acquired pictures and videos, analysis results&lt;/p>&#xA;">
              <ownedAttributes xsi:type="Requirements:EnumerationValueAttribute" id="5f287f5d-cd5a-43fd-a551-abeb5e24a488"
                  definition="#96f5da6c-4d14-4746-9e9b-82862394c925"/>
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="565728d3-11bc-47b5-8a8c-7409de2f6bb6" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#fec36e30-023c-4ca7-a2b7-948d5760fdd3" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="232f4b40-5827-4c85-9d1f-27f905397116"
                ReqIFIdentifier="[AIDA_Interfaces_2]" ReqIFLongName="Pilot interface"
                ReqIFName="" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                ReqIFText="&lt;p>The AIDA system shall provide an interface to exchange the following information with the operator :&lt;br />&#xA;- Mission parameters (from operator to AIDA) : reference of flight zone and default flight plan, mission customization parameters, mission definition validation&lt;br />&#xA;- Mission information (from AIDA to operator) : flight zone and flight plan visualisation&lt;br />&#xA;- Auto-sequence selection and start (from operator to AIDA)&lt;br />&#xA;- Pilot control mode, manual motion commands and manual visual information acquisition commands (from operator to AIDA)&lt;br />&#xA;- Mission status (from AIDA to operator) : selected sequence, progress of the flight plan, drone information (position, speed, altitude, heading)&lt;br />&#xA;- Drone detected failures (from AIDA to operator)&lt;br />&#xA;- Live video of the drone point of view (from AIDA to operator)&lt;br />&#xA;- Inspection results : acquired pictures and videos, analysis results&lt;br />&#xA;- Log of events request (from operator to AIDA) and log of events (from AIDA to operator)&lt;/p>&#xA;">
              <ownedAttributes xsi:type="Requirements:EnumerationValueAttribute" id="293343ea-bc8f-43f0-ba26-334000ee69e3"
                  definition="#96f5da6c-4d14-4746-9e9b-82862394c925"/>
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="0204cde4-cda4-482c-a1ba-e4fad1edc919" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#232f4b40-5827-4c85-9d1f-27f905397116" target="#aee7f4f9-698b-4652-b27f-bae18a2df7eb"/>
            </ownedRequirements>
          </ownedRequirements>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Folder" id="9c81b706-2541-489f-bf7d-9bb229577d4f"
            ReqIFLongName="Sub-systems">
          <ownedRequirements xsi:type="Requirements:Folder" id="1fb31a31-5a4c-47c3-b0b2-407e005a2e54"
              ReqIFLongName="Remote control requirements">
            <ownedRequirements xsi:type="Requirements:Requirement" id="5b11a62c-8c22-4cd2-83c8-7158541557e0"
                ReqIFIdentifier="[Remote control_0005]" ReqIFLongName="Manual payload control"
                ReqIFText="&lt;p>The remote control shall acquire the manual payload control information from the operator and send it to the payload.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="ecd0f903-22ac-4a4e-94ef-64ab57ee8301" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#5b11a62c-8c22-4cd2-83c8-7158541557e0" target="#28455e0b-3bab-4003-b432-d939a6eac0e1"/>
            </ownedRequirements>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Folder" id="30e2e6a1-237b-49ab-a2a8-372f7caaf8de"
              ReqIFLongName="Drone control desk requirements">
            <ownedRequirements xsi:type="Requirements:Requirement" id="4f587365-6027-44cf-b20f-7d465e860aa6"
                ReqIFIdentifier="[Control desk_0001]" ReqIFLongName="Manage mission - mission definition"
                requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The control desk shall compute the authorized flight zone and the flight plan based on mission parameters provided by the pilot and mission data retrieved from the airline database.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="fea8a20a-d672-4646-bab1-98e37520a580" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#4f587365-6027-44cf-b20f-7d465e860aa6" target="#3482f44c-8671-43fb-bcb8-49cfc05ff568"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="e7b4dc21-8501-47a8-a05e-f30128639f8f"
                ReqIFIdentifier="[Control desk_0002]" ReqIFLongName="Flight zone computation"
                requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The control desk shall compute the flight zone as required by the operator.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="6390cd4e-f71d-45c8-8049-62a383ba2a48" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#e7b4dc21-8501-47a8-a05e-f30128639f8f" target="#3482f44c-8671-43fb-bcb8-49cfc05ff568"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="0ded534f-759b-495d-a994-aae00121b36c"
                ReqIFIdentifier="[Control desk_0003]" ReqIFLongName="Flight plan computation"
                requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The control desk shall compute the flight plan as required by the operator.&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="7f91daa2-ee12-486d-8c17-e602ebf1f2fe" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#0ded534f-759b-495d-a994-aae00121b36c" target="#3482f44c-8671-43fb-bcb8-49cfc05ff568"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Requirement" id="9521ec76-17f3-4b92-b8b7-298ef912d846"
                ReqIFIdentifier="[Control desk_0004]" ReqIFLongName="Flight plan validation"
                requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The control desk shall set the validity of the computed flight plan to VALID if all the following conditions are fulfilled :&lt;br />&#xA;&amp;nbsp;- the flight plan is contained inside the flight zone&lt;br />&#xA;&amp;nbsp;- the flight plan terminates on the ground&lt;br />&#xA;- the operator has confirmed the validity of the flight plan&lt;/p>&#xA;">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="a622ac7c-80c6-4ae7-bae0-905f1b531fb2" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                  source="#9521ec76-17f3-4b92-b8b7-298ef912d846" target="#3482f44c-8671-43fb-bcb8-49cfc05ff568"/>
            </ownedRequirements>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Folder" id="d4339a5b-4764-4fd7-97db-31783731d2b0"
              ReqIFLongName="Drone">
            <ownedRequirements xsi:type="Requirements:Folder" id="4c001cd3-4275-4c83-acae-008b234c44e4"
                ReqIFLongName="Structure" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4">
              <ownedRequirements xsi:type="Requirements:Folder" id="e9969999-3e66-430e-a90c-c96851d66c13"
                  ReqIFLongName="Requirements">
                <ownedRequirements xsi:type="Requirements:Requirement" id="24c63ee0-99da-4b6b-9950-2102aa2393de"
                    ReqIFIdentifier="[Struct_0003]" ReqIFLongName="Failure conditions"
                    requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The structure shall be designed so that the following Failure Conditions :&lt;br />&#xA;- &amp;quot;Erroneous thrust due to Structure&amp;quot; has failure rate lower than 1.10^-9 and does not result from a single Failure.&lt;/p>&#xA;">
                  <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                      id="f644ecf5-c6c6-4801-8364-69c8498688fe" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                      source="#24c63ee0-99da-4b6b-9950-2102aa2393de" target="#45b7594e-817a-4f8c-9a39-6679fe76c4a4"/>
                </ownedRequirements>
                <ownedRequirements xsi:type="Requirements:Requirement" id="547b2c0a-bb9d-44d1-a41d-69df23e61d2a"
                    ReqIFIdentifier="[Struct_0002]" ReqIFLongName="Structure functions"
                    requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Structure shall reconstitute a global thrust and torque from the thrust and torque provided by each propulsion unit of the Propulsion system.">
                  <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                      id="d149dfc2-239b-4c9d-90c6-ca1fdd840a95" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                      source="#547b2c0a-bb9d-44d1-a41d-69df23e61d2a" target="#45b7594e-817a-4f8c-9a39-6679fe76c4a4"/>
                </ownedRequirements>
                <ownedRequirements xsi:type="Requirements:Requirement" id="0f62554b-3e11-4921-8eac-841a5e3fbcdc"
                    ReqIFIdentifier="[Struct_0001]" ReqIFLongName="Structure design"
                    requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Structure shall consist in a central plateform supporting the Flight Control system, the Payload and the Power supply system, and four arms supporting the Propulsion system">
                  <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                      id="82e5c0a5-62b0-43a4-ad00-c6a240f91cb3" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                      source="#0f62554b-3e11-4921-8eac-841a5e3fbcdc" target="#45b7594e-817a-4f8c-9a39-6679fe76c4a4"/>
                </ownedRequirements>
                <ownedRequirements xsi:type="Requirements:Requirement" id="185aeb4e-feee-4d40-ac19-01b3c807d37b"
                    ReqIFIdentifier="[Struct_0004]" ReqIFLongName="Mass" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                    ReqIFText="&lt;p>The Structure mass shall be lower than 500g.&lt;/p>&#xA;">
                  <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                      id="d3313ef2-f730-497c-ae6f-5d9b66ee632a" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                      source="#185aeb4e-feee-4d40-ac19-01b3c807d37b" target="#45b7594e-817a-4f8c-9a39-6679fe76c4a4"/>
                  <ownedRelations xsi:type="Requirements:InternalRelation" id="f8c0f544-898f-469d-a190-6728ccfaf38c"
                      relationType="#801e3058-4eb7-40e8-8355-0b26b2fab27c" source="#185aeb4e-feee-4d40-ac19-01b3c807d37b"
                      target="#9e455df3-16b7-4a80-a6a7-64aff16237ed"/>
                </ownedRequirements>
              </ownedRequirements>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Folder" id="9785f2c1-8e8e-40d4-9f61-fbec58660fe9"
                ReqIFLongName="Propulsion unit">
              <ownedRequirements xsi:type="Requirements:Folder" id="13bc5c29-fd14-4249-afba-530760b6e57d"
                  ReqIFLongName="Requirements">
                <ownedRequirements xsi:type="Requirements:Requirement" id="f673236e-7ad3-49ef-8752-9960757d9953"
                    ReqIFIdentifier="[PropSys_0002]" ReqIFLongName="Propulsion unit function"
                    requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The Propulsion unit shall provide a controlled Thrust and Torque, according to the motor rotation speed consign provided by the Flight Control System&lt;/p>&#xA;">
                  <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                      id="da50c64f-b999-48fc-8932-334fb3a2c753" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                      source="#f673236e-7ad3-49ef-8752-9960757d9953" target="#f6b32e48-c55c-45ae-89b3-b7dd3ccd55e9"/>
                </ownedRequirements>
                <ownedRequirements xsi:type="Requirements:Requirement" id="76f66610-9a2a-4c66-8f4b-9bfe4e268913"
                    ReqIFIdentifier="[PropSys_0003]" ReqIFLongName="Failure conditions"
                    requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The Propulsion unit shall be designed so that the following Failure Conditions :&amp;nbsp;&lt;br />&#xA;- &amp;quot;Erroneous or loss of propulsion&amp;quot; (CAT) has a Failure rate lower than 5.10^-10, and is not the result of a single Failure.&lt;/p>&#xA;&#xA;&lt;p>.- &amp;quot;Incapacity to depower actuators due to propulsion system&amp;quot; (HAZ)&amp;nbsp;has failure rate lower than 5.10^-5.&lt;/p>&#xA;">
                  <ownedRelations xsi:type="Requirements:InternalRelation" id="5f47e34a-d2bd-4832-a3f8-01b482c17756"
                      relationType="#801e3058-4eb7-40e8-8355-0b26b2fab27c" source="#76f66610-9a2a-4c66-8f4b-9bfe4e268913"
                      target="#8640cdd3-02ae-4a7d-b3e1-822932c32246"/>
                  <ownedRelations xsi:type="Requirements:InternalRelation" id="0151abbb-c51d-4baa-b9a1-1648a71c35d1"
                      relationType="#801e3058-4eb7-40e8-8355-0b26b2fab27c" source="#76f66610-9a2a-4c66-8f4b-9bfe4e268913"
                      target="#0a47e1f1-a485-487d-bb20-2c5cf7efe402"/>
                  <ownedRelations xsi:type="Requirements:InternalRelation" id="7c66d96c-d9b6-46db-bdbb-86fb6be14643"
                      relationType="#801e3058-4eb7-40e8-8355-0b26b2fab27c" source="#76f66610-9a2a-4c66-8f4b-9bfe4e268913"
                      target="#2ae5b212-92d1-46ae-a381-609a2ecc4130"/>
                  <ownedRelations xsi:type="Requirements:InternalRelation" id="b7210382-6bc9-4e41-a203-175bbc0f4f08"
                      relationType="#801e3058-4eb7-40e8-8355-0b26b2fab27c" source="#76f66610-9a2a-4c66-8f4b-9bfe4e268913"
                      target="#1a61a7de-ec9d-4e4c-954b-3c50b1f60e1d"/>
                  <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
