              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="9a13fce3-7dd3-4a3b-8c56-92de76e3a0cd" sid="a12b760a-5031-4c1a-aae0-37c452952904"
                  name="[SF1.2.5] Compute motor 2 speed" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The motor and variator i shall compute the &amp;quot;Motor i rate measured&amp;quot; as the result of the temporal integration of &amp;quot;Motor i position&amp;quot; and provide the associated validity status.&lt;/p>&#xA;&#xA;&lt;p>If the Motor i position measured validity status is INVALID, the motor and variator i shall set the Motor i rate measured validity status&amp;nbsp;to INVALID.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#bf014ea0-21f9-4d0d-8ef9-6c370a5f14f0">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="bf014ea0-21f9-4d0d-8ef9-6c370a5f14f0" sid="bf014ea0-21f9-4d0d-8ef9-6c370a5f14f0"
