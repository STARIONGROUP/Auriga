              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="db797d2e-fa6e-4144-ad85-96fd6eea876f" sid="db797d2e-fa6e-4144-ad85-96fd6eea876f"
                  name="[SF7.2.7] Compute thrust MON" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>- The monitoring processor shall compute the thrust required from each propeller P1, P2, P3, P4 with the following formulas :&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>1&lt;/font>&lt;/sub> = Thrust MON&amp;nbsp;+ P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>2&lt;/font>&lt;/sub> = Thrust MON&amp;nbsp;- P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>3&lt;/font>&lt;/sub> = Thrust MON - P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>4&lt;/font>&lt;/sub> = Thrust MON&amp;nbsp;+ P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the P1, P2, P3, P4 validity statuses as follows : IF (Thrust MON is INVALID) OR (PTheta is INVALID) OR (Pphi is INVALID) OR (Ppsi is INVALID) THEN P1, P2, P3, P4 are INVALID ELSE P1, P2, P3, P4 are VALID.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#67a053aa-eb97-402c-9002-5c3722903a97">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="67a053aa-eb97-402c-9002-5c3722903a97" name="DAL level.FDAL"
                    appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="02fc674f-1bf3-4bf7-8f77-5b286443385a" name="Functionnal Design Assurance Level"
                      appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="86e211a1-2283-4d3e-8449-33c4ec753386" sid="86e211a1-2283-4d3e-8449-33c4ec753386"
                    name="FIP Pt"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="6d42973e-fc24-4d4e-9841-1389ef8b4dfe" sid="6d42973e-fc24-4d4e-9841-1389ef8b4dfe"
                    name="FIP Pphi"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="0092f606-eb43-43a7-ad6d-b337ca804262" sid="0092f606-eb43-43a7-ad6d-b337ca804262"
                    name="FIP Ppsi"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="82e95ccb-8fe0-475c-8ea3-d87b4b3c87dc" sid="82e95ccb-8fe0-475c-8ea3-d87b4b3c87dc"
                    name="FIP T"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="61253e34-743e-4668-a5e2-39f091a70702" sid="61253e34-743e-4668-a5e2-39f091a70702"
                    name="FOP P1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="97b35eb9-65cb-434b-8e01-ab5253e830a7" sid="97b35eb9-65cb-434b-8e01-ab5253e830a7"
                    name="FOP P2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="5acb829a-142c-4fd5-842a-593e2b251900" sid="5acb829a-142c-4fd5-842a-593e2b251900"
                    name="FOP P3"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="ff6f351b-2939-468f-bdb7-a7a03dd586a6" sid="ff6f351b-2939-468f-bdb7-a7a03dd586a6"
                    name="FOP P4"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="e02c5c09-8b1e-4a6d-aa51-505d837b9651" sid="e02c5c09-8b1e-4a6d-aa51-505d837b9651"
                  name="[SF7.2.8] Compute motor rate MON" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>- The monitoring processor shall compute the Motor 1,2,3,4 rotation rate MON&amp;nbsp;for each propeller from the expected thrust as follows (Cprop_i being the propeller coefficient of the propeller i):&lt;/p>&#xA;&#xA;&lt;p>Motor i rotation rate MON = square_root(Pi/Cprop_i) (i=1,2,3,4)&lt;/p>&#xA;&#xA;&lt;p>- The monitoring processor shall compute the Motor 1,2,3,4 rotation rate MON&amp;nbsp;validity status as follows : IF Pi is INVALID THEN Motor i rotation rate MON&amp;nbsp;is INVALID ELSE Motor i rotation rate MON&amp;nbsp;is valid (i=1,2,3,4).&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#f04065c2-a0f0-4153-8730-5f36e5f1ce9f">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="f04065c2-a0f0-4153-8730-5f36e5f1ce9f" name="DAL level.FDAL"
                    appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="bff01588-1b52-4c07-b98e-634590e5adef" name="Functionnal Design Assurance Level"
                      appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="26f97611-d905-47ac-af50-bf896680f037" sid="26f97611-d905-47ac-af50-bf896680f037"
