              id="be3372e7-9db6-471d-88e4-f4f616ae58f6" sid="be3372e7-9db6-471d-88e4-f4f616ae58f6"
              name="[SF5] Make and record video" appliedPropertyValueGroups="#29449791-0d19-482c-97af-4a96654ed853">
            <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
