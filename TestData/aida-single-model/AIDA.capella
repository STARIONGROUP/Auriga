                    id="f8303b66-cb59-428b-8b83-cf4fd4c05510" sid="f8303b66-cb59-428b-8b83-cf4fd4c05510"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="f267587c-fa69-4461-884b-98cea786bfcc" sid="f267587c-fa69-4461-884b-98cea786bfcc"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#1ed8f881-a7b9-4ac3-b2e6-ea5235d56475"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="17b1dd9c-e6e9-4393-b061-394c9613b714" sid="17b1dd9c-e6e9-4393-b061-394c9613b714"
                    name="FIP 1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="a2fb48f1-b53d-4112-aba7-9ae4630e2675" sid="a2fb48f1-b53d-4112-aba7-9ae4630e2675"
                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="e265685a-2d05-4fba-a4aa-184ea41e826b" sid="e265685a-2d05-4fba-a4aa-184ea41e826b"
                  name="[SF1.1.8] Acquire motor 1 speed MON" description="&lt;p>REQ&lt;/p>&#xA;&#xA;&lt;p>The monitoring channel of the MCPS shall acquire the tachometer signal from the motor and convert it into a numerical value of the rotation speed.&lt;/p>&#xA;&#xA;&lt;p>The monitoring channel of the MCPS shall compute a validity status ot the measured rotation speed, as the result of the signal acquisition checks (electrical range, numerical range, frequency range, internal health).&lt;/p>&#xA;&#xA;&lt;p>The monitoring channel of the MCPS shall send the Motor&amp;nbsp;i rotation speed value and its validity status to the monitoring channel of the flight control system.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#8be39af0-a2e6-4938-84fd-a4c3f74d08da">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="8be39af0-a2e6-4938-84fd-a4c3f74d08da" sid="8be39af0-a2e6-4938-84fd-a4c3f74d08da"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="4e85adfe-77c4-4b99-9131-5432bac2fe60" sid="4e85adfe-77c4-4b99-9131-5432bac2fe60"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#1ed8f881-a7b9-4ac3-b2e6-ea5235d56475"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="f2521bc0-8a24-4a17-8dc2-c631c94e80fd" sid="f2521bc0-8a24-4a17-8dc2-c631c94e80fd"
                    name="FIP 1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="7a8885fd-699f-4718-9a46-2fe0936072da" sid="7a8885fd-699f-4718-9a46-2fe0936072da"
                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="20d72c81-f1e1-482b-8465-4b2aa67f42f3" sid="20d72c81-f1e1-482b-8465-4b2aa67f42f3"
                  name="[SF1.1.2] Create motion 1" description="&lt;p>This function transform the Motor i command into rotation mouvement.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The motor&amp;nbsp; i shall rotate according to the Motor i command signal.&lt;/p>&#xA;&#xA;&lt;p>The motor i shall provide to the MCPS a 3-phased electrical interface. Two phases are used for the motor command, the last one is used as a voltage feedback of the motor position.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#a67c02cb-2dac-4645-a70e-328126b683ab">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
