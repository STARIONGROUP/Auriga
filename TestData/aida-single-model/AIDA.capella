          <ownedAttributes xsi:type="Requirements:AttributeDefinitionEnumeration"
              id="96f5da6c-4d14-4746-9e9b-82862394c925" ReqIFLongName="Status" definitionType="#b16bfafa-e875-47b2-918c-0379f927f749"/>
          <ownedAttributes xsi:type="Requirements:AttributeDefinition" id="d68d0e3b-2797-4037-a994-0af555053e42"
              ReqIFLongName="Issue" definitionType="#4cee2db1-e378-4c0a-be69-7081eea8dd58"/>
          <ownedAttributes xsi:type="Requirements:AttributeDefinitionEnumeration"
              id="62edef84-b962-4699-a89e-24b112895167" ReqIFLongName="Terminal" definitionType="#1e22504d-a206-4a15-9e9d-6a35a3d641e8"/>
          <ownedAttributes xsi:type="Requirements:AttributeDefinitionEnumeration"
              id="a0c5ea8b-d45c-4294-bbe8-b2730071cea1" ReqIFLongName="Traceability Type"
              definitionType="#bc4ba75a-c80f-4a81-97c6-6293bd109447"/>
          <ownedAttributes xsi:type="Requirements:AttributeDefinitionEnumeration"
              id="91382234-cc33-4531-ac08-a188f28ab844" ReqIFLongName="Safety" definitionType="#003180e3-90f2-44e1-ab8c-cbf99c6f69c6"/>
          <ownedAttributes xsi:type="Requirements:AttributeDefinitionEnumeration"
              id="0f0d2229-8efb-44de-85ed-f689720d552f" ReqIFLongName="Requirement Type"
              definitionType="#e594770d-487a-4d80-9731-00b88439038a"/>
          <ownedAttributes xsi:type="Requirements:AttributeDefinition" id="00b5dbb4-f348-422f-a22e-62470235101c"
              ReqIFLongName="Rationale" definitionType="#0c8f626c-9ee4-471f-8703-dbd4d64cf93f"/>
          <ownedAttributes xsi:type="Requirements:AttributeDefinition" id="a26556c9-97eb-44cf-b2ea-5fd35e7a186f"
              ReqIFLongName="Additional Information" definitionType="#0c8f626c-9ee4-471f-8703-dbd4d64cf93f"/>
          <ownedAttributes xsi:type="Requirements:AttributeDefinitionEnumeration"
              id="4971d352-90fc-43fa-83d2-244a80219341" ReqIFLongName="Conformity"
              definitionType="#cd9077b6-4ca0-4b77-b08f-d8e2cc9d164f"/>
          <ownedAttributes xsi:type="Requirements:AttributeDefinitionEnumeration"
              id="7a9f52d3-4942-4258-a6e8-1b8ecb9336f2" ReqIFLongName="Means Of Compliance"
