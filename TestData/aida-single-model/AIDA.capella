              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="dc634c14-17ef-40d8-b040-de2dfe9fce10" sid="dc634c14-17ef-40d8-b040-de2dfe9fce10"
                  name="[SF2.3.4] Control roll angle" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Pphi as the result of the closed loop control of the rollangle to reach the Roll consign from the current Drone roll and Drone roll rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Pphi validity status as follow : IF (Drone roll is INVALID) OR (Drone roll rate validity status&amp;nbsp;is INVALID) OR (Roll consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Pphi validity status is INVALID ELSE Pphi validity status is VALID&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#72d67942-a341-4625-b3f7-205f46a3fe56">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="72d67942-a341-4625-b3f7-205f46a3fe56" name="DAL level.FDAL"
                    appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="beda07f2-5fb7-484a-acf4-2b212bfbbf21" name="Functionnal Design Assurance Level"
                      appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="6b20556f-ce67-4489-a0df-6d7ea757aabd" sid="6b20556f-ce67-4489-a0df-6d7ea757aabd"
                    name="FIP RC"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="9ac1e775-04d5-44fb-9db4-43c752f04c02" sid="9ac1e775-04d5-44fb-9db4-43c752f04c02"
                    name="FIP DR"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="a45741ea-4caa-428e-b703-eca3457488f8" sid="a45741ea-4caa-428e-b703-eca3457488f8"
                    name="FIP DRR"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="3453be3b-b6ef-4a1d-bc5d-56768ef9caf2" sid="3453be3b-b6ef-4a1d-bc5d-56768ef9caf2"
                    name="FOP Pphi"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="af9dcf0b-124f-4a67-9457-44147c69f468" sid="af9dcf0b-124f-4a67-9457-44147c69f468"
                  name="[SF2.3.5] Control yaw angle" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Ppsi as the result of the closed loop control of the yaw angle to reach the Yaw consign from the current Drone yaw and Drone yaw rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Ppsi validity status as follow : IF (Drone yaw is INVALID) OR (Drone yaw rate validity status&amp;nbsp;is INVALID) OR (Yaw consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Ppsi validity status is INVALID ELSE Ppsi validity status is VALID&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#102ae7f8-429f-4cd4-ae9c-946d0283687b">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="102ae7f8-429f-4cd4-ae9c-946d0283687b" name="DAL level.FDAL"
                    appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="1b158002-a36f-4b86-be35-84b52a73dded" name="Functionnal Design Assurance Level"
                      appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="975c6ad9-6371-4387-b371-40105b73ae10" sid="975c6ad9-6371-4387-b371-40105b73ae10"
                    name="FIP YC"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c4c09e1a-dec3-4e80-bc6b-d8001b0353c1" sid="c4c09e1a-dec3-4e80-bc6b-d8001b0353c1"
                    name="FIP DY"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="3aafc5ce-29f7-4d3b-8112-f263dad48ff1" sid="3aafc5ce-29f7-4d3b-8112-f263dad48ff1"
                    name="FIP DYR"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="b430e36e-0dd3-4ea9-9a81-d8de482fe200" sid="b430e36e-0dd3-4ea9-9a81-d8de482fe200"
                    name="FOP Ppsi"/>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="8f71a3b4-366a-4b55-8b06-6e00db0c6b7e" targetElement="#b37ad0d5-467b-41cc-b82b-e9c342cd8d2b"
                  sourceElement="#79fd1a18-e41e-4fa5-9d45-cff4b6bfe612"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="7cb5a784-9099-4225-9c95-17fbc14ffc45" sid="7cb5a784-9099-4225-9c95-17fbc14ffc45"
                  name="Yaw consign" target="#9e7459b6-2068-44e5-9778-c52ab7f4b550"
                  source="#13a08651-2194-45fe-b1b9-bbb31deaab56"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="ed8f1731-eae4-47e0-9bbe-0d94b8eb2535" sid="ed8f1731-eae4-47e0-9bbe-0d94b8eb2535"
                  name="Pitch consign" target="#73b2f756-05bd-4c16-85e8-3929667d9485"
                  source="#86c6098e-1269-40b3-987f-65d78b060bbd"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="8b548238-1c7f-46be-8940-cd12be0eccc9" sid="8b548238-1c7f-46be-8940-cd12be0eccc9"
                  name="Roll consign" target="#6b20556f-ce67-4489-a0df-6d7ea757aabd"
                  source="#40d44593-8d21-489d-93b6-80d8d30fd555"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="87386598-10f1-4da6-8d15-edaea0ab0b88" sid="87386598-10f1-4da6-8d15-edaea0ab0b88"
                  name="Yaw consign" target="#975c6ad9-6371-4387-b371-40105b73ae10"
                  source="#1c6dc6d6-cb98-4ea4-873e-e556b4ed0d34"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="b7e0ca10-5698-4cf6-a0cf-94994d78cc82" sid="b7e0ca10-5698-4cf6-a0cf-94994d78cc82"
                name="[SF2.4] Control altitude" description="&lt;p>This function computes the requested total thrust :&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;- in manual mode : to ensure the vertical speed demand provided by the pilot&lt;/p>&#xA;&#xA;&lt;p>- in AP mode, the total thrust demand is already computed by SF2.1&lt;/p>&#xA;&#xA;&lt;p>The final thrust demand is then selected according to the current control mode.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;"
                appliedPropertyValueGroups="#f1309143-2645-48d4-8eb1-43f0ba0fd756">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="f1309143-2645-48d4-8eb1-43f0ba0fd756" sid="f1309143-2645-48d4-8eb1-43f0ba0fd756"
                  name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="c148292d-d6ee-48b2-ae89-c36c857848f4" sid="c148292d-d6ee-48b2-ae89-c36c857848f4"
                    name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                    type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
              </ownedPropertyValueGroups>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="a455ce49-0054-4bbf-ac80-f3f759444ed2" sid="a455ce49-0054-4bbf-ac80-f3f759444ed2"
                  name="[SF2.4.1] Compute altitude consign" description="&lt;p>This function integrates the vertical speed demand to compute an altitude demand.&lt;/p>&#xA;&#xA;&lt;p>Note : the integration operation probably also requires the measure of the current altitude.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the&amp;nbsp;Altitude consign as th integration of the Vertical speed consign.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Altitude consign validity status as the Altitude rate consign validity status.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#2ae706cd-d81b-4e29-8786-32090cd0985d">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="2ae706cd-d81b-4e29-8786-32090cd0985d" sid="2ae706cd-d81b-4e29-8786-32090cd0985d"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="4e544be8-ba33-42de-97c4-10f6ac00be88" sid="4e544be8-ba33-42de-97c4-10f6ac00be88"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="cd7d10aa-056e-464b-bde1-f95a32eef3f4" sid="cd7d10aa-056e-464b-bde1-f95a32eef3f4"
                    name="FIP 1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="8e620e63-07d1-4cdd-b1bd-4d7ed2cff9c7" sid="8e620e63-07d1-4cdd-b1bd-4d7ed2cff9c7"
                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="3a2f7b89-a884-4a86-85e1-97d0c9c02078" sid="3a2f7b89-a884-4a86-85e1-97d0c9c02078"
                  name="[SF2.4.2] Compute total thrust" description="&lt;p>This function realised the closed loop control on altitude, it computes the thrust demand to achieve the requested altitude.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Tmanual as the result of the closed loop control of the&amp;nbsp;altitude to reach the Altitude consign from the current altitude measurement and Drone pitch&amp;nbsp;and&amp;nbsp;roll&amp;nbsp;measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Tmanual validity status as follow : IF (Drone pitch is INVALID) OR (Drone&amp;nbsp;roll validity status&amp;nbsp;is INVALID) OR (Altitude consign validity status&amp;nbsp;is INVALID)&amp;nbsp;OR (Altitude validity status&amp;nbsp;is INVALID)THEN&amp;nbsp;Tmanual validity status is INVALID ELSE&amp;nbsp;Tmanual validity status is VALID&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#6bd3f28a-51e7-4a8c-8cdc-ce87b25d68a5">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="6bd3f28a-51e7-4a8c-8cdc-ce87b25d68a5" name="DAL level.FDAL"
                    appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="370bf916-67a0-41a7-ab7c-87c7a6517d2d" name="Functionnal Design Assurance Level"
                      appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="e248a904-fb22-4c6b-9aec-d75205078c15" sid="e248a904-fb22-4c6b-9aec-d75205078c15"
                    name="FIP Alt Cons"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="b6bbfe80-b407-4bcd-8708-bd4dbf5f7ff4" sid="b6bbfe80-b407-4bcd-8708-bd4dbf5f7ff4"
                    name="FIP Alt"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="75db1d27-d0e4-435a-a69c-70b04e111e0a" sid="75db1d27-d0e4-435a-a69c-70b04e111e0a"
                    name="FIP Pitch"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="7d54b263-ff1b-4f85-92be-61143f433d17" sid="7d54b263-ff1b-4f85-92be-61143f433d17"
                    name="FIP Roll"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="25be096a-127a-463b-9b95-6d0a2cbf67f8" sid="25be096a-127a-463b-9b95-6d0a2cbf67f8"
                    name="FOP T"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="3b2e3a74-6e95-47ac-b8f0-0438e561da86" sid="3b2e3a74-6e95-47ac-b8f0-0438e561da86"
                  name="[SF2.4.3] Select total thrust consign" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall select the&amp;nbsp;Total Thrust consign as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup width=&quot;204&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;207&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup span=&quot;2&quot; width=&quot;245&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Tmanual Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Thrust AP Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Selected Thrust&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Validity status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Thrust AP&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Thrust AP&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Tmanual&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Tmanual&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;"
                  appliedPropertyValueGroups="#ff8e3c1d-c4fa-4993-a2b4-2599f59a4bac">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="ff8e3c1d-c4fa-4993-a2b4-2599f59a4bac" name="DAL level.FDAL"
                    appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="f2d48a27-240d-4fa8-ac22-c532d329687c" name="Functionnal Design Assurance Level"
                      appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="21469201-11bb-4858-82f2-eb7c536293bf" sid="21469201-11bb-4858-82f2-eb7c536293bf"
