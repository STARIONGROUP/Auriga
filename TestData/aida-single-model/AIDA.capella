                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="c48f5934-ff91-483e-b9ba-7df60db584fb" sid="c48f5934-ff91-483e-b9ba-7df60db584fb"
                    name="FOP 2"/>
