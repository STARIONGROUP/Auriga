                        source="#ea5f2ea6-059c-40f3-96e6-49c58f458f59" target="#538878f3-7849-44f4-9d87-99fd0cce9c40"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="e78b0c48-a57e-46e3-a100-10e9ef9a0f8c"
                      ReqIFIdentifier="Propeller_0003" ReqIFLongName="Safety" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                      ReqIFText="&lt;p>The propeller shall respect the following failure rates :&lt;/p>&#xA;&#xA;&lt;p>- Complete loss of thrust on propeller axis (ex : loss of all blades): &amp;lt;1.10^-5&lt;/p>&#xA;&#xA;&lt;p>- Partial loss of thrust on propeller axis (ex : loss of one blade): &amp;lt;1.10^-6&lt;/p>&#xA;">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="bb411419-6d37-4608-a9af-88f55e8b4d71" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#e78b0c48-a57e-46e3-a100-10e9ef9a0f8c" target="#538878f3-7849-44f4-9d87-99fd0cce9c40"/>
                  </ownedRequirements>
                </ownedRequirements>
                <ownedRequirements xsi:type="Requirements:Folder" id="2ceabaa6-ddac-45a8-995b-972edf7f72d0"
                    ReqIFLongName="Motor-propeller interface">
                  <ownedRequirements xsi:type="Requirements:Requirement" id="a274bb4c-7c95-4fde-822a-d157184a84ef"
                      ReqIFIdentifier="Motor_propeller_0001" ReqIFLongName="Interface mechanical characteristics"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The motor axis shall allow the propeller fixing as defined below."/>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="858847a4-7240-48b6-9fa1-24f72679eb61"
                      ReqIFIdentifier="Motor_propeller_0002" ReqIFLongName="Safety"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The interface between the motor and the propeller shall respect the following failure rates :"/>
                </ownedRequirements>
              </ownedRequirements>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Folder" id="f4803a96-1559-4d79-9b06-a90a5d39d7f8"
                ReqIFLongName="Payload">
              <ownedRequirements xsi:type="Requirements:Folder" id="53bb4346-d54c-4f2a-bc52-5955ca6ec615"
                  ReqIFLongName="Requirements">
                <ownedRequirements xsi:type="Requirements:Requirement" id="321788b5-2999-42b4-93fd-04906dd16382"
                    ReqIFIdentifier="[Payload_0002]" ReqIFLongName="Camera orientation control (SF5.2)"
                    requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The payload shall set the camera to the computed camera position consign.">
                  <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                      id="46669ccb-20b3-4cd6-a50f-ab1451a8513e" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                      source="#321788b5-2999-42b4-93fd-04906dd16382" target="#52074add-3d9e-475f-923e-cde9487c04b2"/>
                </ownedRequirements>
                <ownedRequirements xsi:type="Requirements:Requirement" id="f18b3ab5-9941-46e0-948e-41c3b7bd6055"
                    ReqIFIdentifier="[Payload_0001]" ReqIFLongName="Payload control (SF5.1)"
                    requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The payload shall compute the camera position consign, the photo and video acquisition command and the file storage format, from the manual payload control provided by the remote control and the automatic payload control information provided by the flight controller.">
                  <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                      id="c5c04817-54d7-4f29-9ed2-b4dd3ea517bc" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
