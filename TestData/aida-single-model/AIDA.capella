    <ownedArchitectures xsi:type="org.polarsys.capella.core.data.oa:OperationalAnalysis"
        id="22d8a374-5d0e-4fbb-a0ea-2c97da2e0807" name="Operational Analysis">
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="ff296e35-9c06-4e1d-9933-7ed555713f94" name="Copyright (c) 2016-2022 IRT AESE. All rights reserved. Available under the terms of Creative Commons BY-SA 4.0.">
