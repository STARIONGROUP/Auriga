                </ownedRequirements>
                <ownedRequirements xsi:type="Requirements:Requirement" id="10b81b37-14b9-486d-be3d-94addaaf643e"
                    ReqIFIdentifier="[Payload_0003]" ReqIFLongName="Photos and video acquisition (SF5.2)"
                    requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The payload shall acquire photos and video when triggered by the payload control function.">
                  <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                      id="2a5b0761-726d-4c73-ba4e-ebdbb3e92f7a" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                      source="#10b81b37-14b9-486d-be3d-94addaaf643e" target="#52074add-3d9e-475f-923e-cde9487c04b2"/>
