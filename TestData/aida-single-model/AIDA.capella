                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="f4c5b2af-e3c1-4a9f-b023-689f67d37305" sid="f4c5b2af-e3c1-4a9f-b023-689f67d37305"
