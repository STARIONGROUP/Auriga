                  id="01a3740b-0e1d-4d6f-91ca-f9abdbd2fe26" sid="01a3740b-0e1d-4d6f-91ca-f9abdbd2fe26"
                  name="[SF7.2.1] Compute total thrust MON" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute Tmanual MON&amp;nbsp;as the result of the closed loop control of the&amp;nbsp;altitude to reach the Altitude consign from the current altitude measurement and Drone pitch&amp;nbsp;and&amp;nbsp;roll&amp;nbsp;measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Tmanual MON&amp;nbsp;validity status as follow : IF (Drone pitch is INVALID) OR (Drone&amp;nbsp;roll validity status&amp;nbsp;is INVALID) OR (Altitude consign validity status&amp;nbsp;is INVALID)&amp;nbsp;OR (Altitude validity status&amp;nbsp;is INVALID)THEN&amp;nbsp;Tmanual validity status is INVALID ELSE&amp;nbsp;Tmanual validity status is VALID&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#e06d6273-ce5c-47bf-9a5c-ccf6241b0951">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="e06d6273-ce5c-47bf-9a5c-ccf6241b0951" name="DAL level.FDAL"
                    appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="6395ed0d-e9c3-472c-8e05-43a33f6d030a" name="Functionnal Design Assurance Level"
                      appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="48602ef1-e9b4-45f0-a3ca-edbf0168196d" sid="48602ef1-e9b4-45f0-a3ca-edbf0168196d"
                    name="FIP Pitch"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c256fc47-fcf4-4ff5-80a2-ba3ca15b1d95" sid="c256fc47-fcf4-4ff5-80a2-ba3ca15b1d95"
                    name="FIP Alt"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="0a2dadb1-08eb-4b10-b621-d0c5c868649c" sid="0a2dadb1-08eb-4b10-b621-d0c5c868649c"
                    name="FIP Roll"/>
