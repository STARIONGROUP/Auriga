            id="466f7e4e-6475-4d9b-82f2-f76e78259268" name="Aircraft" description="&lt;p align=&quot;JUSTIFY&quot; dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>this is the aircraft inspected by AIDA. It &amp;quot;provides&amp;quot; visual information to be acquired by the system, and it is also a kind of &amp;quot;obstacle&amp;quot;, as the drone must of course avoid any collision with it.&lt;/span>&lt;/p>&#xA;"
            actor="true">
          <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
              id="6baa498c-43cf-4191-a178-c2197e9f47ff" targetElement="#fe1f3a1f-3827-4d95-9fdd-3a7a3453543f"
              sourceElement="#466f7e4e-6475-4d9b-82f2-f76e78259268"/>
          <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
              id="836447e7-2f30-41e5-8e25-db7208c02bcf" name="CP 1" orientation="OUT"
              kind="FLOW">
            <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                id="8e93759e-3f75-4215-b6d4-e29922c1c3d9" targetElement="#544715a4-7ff7-4d7c-bcfb-3708c6b91837"
                sourceElement="#836447e7-2f30-41e5-8e25-db7208c02bcf"/>
          </ownedFeatures>
          <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
              id="a9807b17-fd55-4c8a-bf11-ab2f4868c403" targetElement="#9b09be2d-b8c6-4bfe-8ed9-7433aadfeb23"
              sourceElement="#466f7e4e-6475-4d9b-82f2-f76e78259268"/>
        </ownedSystemComponents>
        <ownedSystemComponents xsi:type="org.polarsys.capella.core.data.ctx:SystemComponent"
            id="6e19622d-f84d-4211-a7c5-a06860c70002" name="Drone operator" description="&lt;p>&lt;span lang=&quot;EN&quot;>The person who will use the drone to accomplish the aircraft inspection. It is assumed that the drone operator is one of the ground operation team that usually perform the Walk-Around procedure. It is not a professional drone pilot, therefore only basic piloting skills are expected. However, it is assumed that sufficient training has been provided so that the operator knows how to operate the drone in its environment, covering normal and emergency operations. &lt;/span>&lt;/p>&#xA;"
            actor="true" human="true">
          <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
              id="927f845c-0b91-4e70-93cf-be231c83e882" targetElement="#696858b5-7dc7-47d0-a939-adcb641d1b5b"
              sourceElement="#6e19622d-f84d-4211-a7c5-a06860c70002"/>
