                    ReqIFIdentifier="[Payload_0005]" ReqIFLongName="Mass" requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4"
                    ReqIFText="&lt;p>The Payload mass shall be lower than 500g.&lt;/p>&#xA;">
                  <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
