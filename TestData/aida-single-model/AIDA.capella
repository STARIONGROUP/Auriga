              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="43c48331-70fa-49e4-9e1c-cff34d953ae5" sid="1c6acd2b-5185-4ea7-abcf-1c0bfa017574"
                  name="[SF1.4.4] Measure motor 4 position" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The motor and variator i shall measure the angular position of the Motor and provide&amp;nbsp;the associated&amp;nbsp;validity status.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#84dd8f06-efa7-4f3a-9e19-2414e5eae236">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
