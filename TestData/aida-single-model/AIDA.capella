              </ownedRequirements>
              <ownedRequirements xsi:type="Requirements:Folder" id="f0f4992a-6e3e-4669-ab3f-678178af5acb"
                  ReqIFLongName="Sub-systems"/>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Folder" id="b76140b7-302d-4ecf-a770-d160e915f64a"
                ReqIFLongName="Power supply">
              <ownedRequirements xsi:type="Requirements:Requirement" id="977f91cf-6ba1-4205-9016-00db12875f66"
                  ReqIFIdentifier="[PowerSupply_0001]" ReqIFLongName="Power supply functions"
                  requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Power Supply system shall provide electrical power to the Flight Control System and to the four Propulsion units">
                <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                    id="11790797-fa78-4f88-b491-f7967a759787" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                    source="#977f91cf-6ba1-4205-9016-00db12875f66" target="#412e6eae-692f-4af2-b72c-0fae1a1d6c10"/>
              </ownedRequirements>
              <ownedRequirements xsi:type="Requirements:Requirement" id="e46a2afb-5714-4358-9017-c2475545c780"
                  ReqIFIdentifier="[PowerSupply_0002]" ReqIFLongName="Power supply electical characteristics - Flight control system"
                  requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Power Supply system shall provide a continuous voltage to the Flight Control System between 4.75V and 5.25V">
                <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                    id="e54193c3-a28b-4be7-b3af-3f05a6685334" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                    source="#e46a2afb-5714-4358-9017-c2475545c780" target="#412e6eae-692f-4af2-b72c-0fae1a1d6c10"/>
              </ownedRequirements>
              <ownedRequirements xsi:type="Requirements:Requirement" id="86aea617-55c5-4505-a065-0e6d86922f5a"
                  ReqIFIdentifier="[PowerSupply_0003]" ReqIFLongName="Power supply electical characteristics - Propulsion unit"
                  requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The Power Supply system shall provide a three-phased alternative electrical power supply to each propulsion unit, with the following characteristic :&lt;/p>&#xA;&#xA;&lt;p>-voltage : between 6.6V and 19.8V&lt;/p>&#xA;&#xA;&lt;p>- max continuous current : 60A&lt;/p>&#xA;&#xA;&lt;p>- max peak current (&amp;lt;10s) : 80A&lt;/p>&#xA;">
                <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                    id="0101aadb-0a07-4581-a533-ca366473deaf" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                    source="#86aea617-55c5-4505-a065-0e6d86922f5a" target="#412e6eae-692f-4af2-b72c-0fae1a1d6c10"/>
              </ownedRequirements>
              <ownedRequirements xsi:type="Requirements:Requirement" id="534cf47f-1388-41fe-abee-df3ffe50010e"
                  ReqIFIdentifier="[PowerSupply_0004]" ReqIFLongName="Power supply autonomy"
                  requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Power Supply system shall have an autonomy of 12800mAh">
                <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                    id="bb8590eb-18f5-4c90-81c0-6a726ac44552" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                    source="#534cf47f-1388-41fe-abee-df3ffe50010e" target="#412e6eae-692f-4af2-b72c-0fae1a1d6c10"/>
              </ownedRequirements>
              <ownedRequirements xsi:type="Requirements:Requirement" id="a8aaa474-d06f-4058-b165-250dfd711c8d"
                  ReqIFIdentifier="[PowerSupply_0005]" ReqIFLongName="Power supply mass"
                  requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The Power Supply mass shall be lower than 1500g&lt;/p>&#xA;">
                <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                    id="2c37c175-7109-4ada-9020-b4bc36b61930" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                    source="#a8aaa474-d06f-4058-b165-250dfd711c8d" target="#412e6eae-692f-4af2-b72c-0fae1a1d6c10"/>
                <ownedRelations xsi:type="Requirements:InternalRelation" id="621f7545-5248-4c26-9d43-ca6f85579b98"
                    relationType="#801e3058-4eb7-40e8-8355-0b26b2fab27c" source="#a8aaa474-d06f-4058-b165-250dfd711c8d"
                    target="#9e455df3-16b7-4a80-a6a7-64aff16237ed"/>
              </ownedRequirements>
              <ownedRequirements xsi:type="Requirements:Requirement" id="30b46565-a732-4226-9e18-04fad1eb716e"
                  ReqIFIdentifier="[PowerSupply_0006]" ReqIFLongName="Power supply Failure conditions"
                  requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The Power supply shall be designed so that the following Failure modes:&amp;nbsp;&lt;br />&#xA;- &amp;quot;Loss of power supply to one propulsion unit&amp;quot; has Failure rate lower than 2.5.10^-10&lt;/p>&#xA;&#xA;&lt;p>- &amp;quot;Loss of power supply to the Flight Control system&amp;quot; has Failure rate lower than 1.10^-7&lt;/p>&#xA;&#xA;&lt;p>- &amp;quot;Complete loss of power supply to Flight Control System and all propulsion units&amp;quot; has a Failure rate lower than 1.10^-7&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
                <ownedRelations xsi:type="Requirements:InternalRelation" id="ccba7e76-e592-4150-9b4c-78136a430bf5"
                    relationType="#801e3058-4eb7-40e8-8355-0b26b2fab27c" source="#30b46565-a732-4226-9e18-04fad1eb716e"
                    target="#8640cdd3-02ae-4a7d-b3e1-822932c32246"/>
                <ownedRelations xsi:type="Requirements:InternalRelation" id="1ebefbd3-09dc-484b-b708-d2161aa4aca8"
                    relationType="#801e3058-4eb7-40e8-8355-0b26b2fab27c" source="#30b46565-a732-4226-9e18-04fad1eb716e"
                    target="#0a47e1f1-a485-487d-bb20-2c5cf7efe402"/>
                <ownedRelations xsi:type="Requirements:InternalRelation" id="12b4d0a1-57b3-4966-9ee1-81173323ddfa"
                    relationType="#801e3058-4eb7-40e8-8355-0b26b2fab27c" source="#30b46565-a732-4226-9e18-04fad1eb716e"
                    target="#2ae5b212-92d1-46ae-a381-609a2ecc4130"/>
                <ownedRelations xsi:type="Requirements:InternalRelation" id="2775303d-8288-476b-9da8-ede15e1895e3"
                    relationType="#801e3058-4eb7-40e8-8355-0b26b2fab27c" source="#30b46565-a732-4226-9e18-04fad1eb716e"
                    target="#1a61a7de-ec9d-4e4c-954b-3c50b1f60e1d"/>
                <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                    id="7195745f-5ceb-46cc-bd14-2a859b663a5f" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                    source="#30b46565-a732-4226-9e18-04fad1eb716e" target="#412e6eae-692f-4af2-b72c-0fae1a1d6c10"/>
              </ownedRequirements>
              <ownedRequirements xsi:type="Requirements:Requirement" id="5b30950d-d7ec-4b02-b028-a668aaf70735"
                  ReqIFIdentifier="[PowerSupply_0007]" ReqIFLongName="Design Assurance Level"
                  requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The Desing Assurance Level associated to the Power Supply shall be A.&lt;/p>&#xA;">
                <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                    id="5bffaa63-c86d-416d-990a-c8ec613d2082" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                    source="#5b30950d-d7ec-4b02-b028-a668aaf70735" target="#412e6eae-692f-4af2-b72c-0fae1a1d6c10"/>
              </ownedRequirements>
            </ownedRequirements>
            <ownedRequirements xsi:type="Requirements:Folder" id="e862cd31-c115-4e2e-853f-95f05c3853c2"
                ReqIFLongName="Flight control system">
              <ownedRequirements xsi:type="Requirements:Folder" id="a39272c3-4831-4aee-a04a-adb60cf73799"
                  ReqIFLongName="Flight control system requirements">
                <ownedRequirements xsi:type="Requirements:Folder" id="4b74d77a-ee7c-4384-8971-28726df44aa5"
                    ReqIFLongName="FCS interfaces">
                  <ownedRequirements xsi:type="Requirements:Requirement" id="61f6d47d-663b-4303-9186-118c39e737cb"
                      ReqIFIdentifier="[FCS_0001]" ReqIFLongName="FCS interfaces - Control desk interface"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall send the photos and videos acquired by the payload on the WIFI link to the control desk.">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="f4f14cda-7082-4411-929d-e382f8cd5344" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#61f6d47d-663b-4303-9186-118c39e737cb" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="534ddcb4-d492-4f30-90ba-3c6a18efca0b"
                      ReqIFIdentifier="[FCS_0002]" ReqIFLongName="FCS interfaces- Control desk interface"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The Flight Control system shall communicate with the Control Desk through a bi-directionnal WIFI link.&lt;/p>&#xD;&#xA;">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="d4778faa-a124-42bd-a38a-2069f1232bf8" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#534ddcb4-d492-4f30-90ba-3c6a18efca0b" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="114f2ac2-9f12-46af-be18-ed0065e8a1f5"
                      ReqIFIdentifier="[FCS_0003]" ReqIFLongName="FCS interfaces - Control desk interface"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall acquire the pilot consigns and mode selection sent by the control desk on the WIFI link">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="ba4e95ac-7def-4102-90b3-96219f42e1ea" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#114f2ac2-9f12-46af-be18-ed0065e8a1f5" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="2adb892b-d971-474d-aee6-5e1358bc4a8e"
                      ReqIFIdentifier="[FCS_0004]" ReqIFLongName="FCS interfaces - Control desk interface"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall send the flight plan progress and the Indicated control mode on the WIFI link to the control desk">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="fde9921c-6399-4fa5-bf7d-14b8bc015120" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#2adb892b-d971-474d-aee6-5e1358bc4a8e" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="cbeac336-e8d1-4e00-86d7-8013953fd76f"
                      ReqIFIdentifier="[FCS_0005]" ReqIFLongName="FCS interfaces - Control desk interface"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall acquire and store the flight plan and the flight zone sent by the control desk on the WIFI link">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="05cba129-34fa-4620-b19c-ff351ec610ba" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#cbeac336-e8d1-4e00-86d7-8013953fd76f" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="c1be3a06-8eb4-43ab-9c92-85b2daaeae67"
                      ReqIFIdentifier="[FCS_0006]" ReqIFLongName="FCS interfaces - Remote control interface"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall receive the Manual control consigns and Manual override data on the RC communication link from the remote control">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="8779feb0-7ab6-445a-8b1d-14b210db16ad" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#c1be3a06-8eb4-43ab-9c92-85b2daaeae67" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="214b8b53-9e74-49f9-bfd8-de5ab45efcf1"
                      ReqIFIdentifier="[FCS_0007]" ReqIFLongName="FCS interfaces - PWMs"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall send the motors speed commands to each propulsion unit through a dedicated Pulse Width Modulation (PWM) interface.">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="a8878048-8ce1-4094-b57d-47b82c78d7d9" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#214b8b53-9e74-49f9-bfd8-de5ab45efcf1" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="f546f64e-1c6d-47f0-bcc0-5c9c2e0070fc"
                      ReqIFIdentifier="[FCS_0008]" ReqIFLongName="FCS interfaces - Motors CAN bus"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall receive the measured rotation speed from each propulsion unit and send the desactivation orders to each propulsion unit on the Motors CAN bus">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="5987b71a-3de9-48fe-9eb5-938e089be5d8" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#f546f64e-1c6d-47f0-bcc0-5c9c2e0070fc" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="96c82fc5-9645-40c0-88b0-f1ae49935534"
                      ReqIFIdentifier="[FCS_0009]" ReqIFLongName="FCS interfaces - Payload CAN bus"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall send the Payload consigns to the Payload and receive the acquired photos and videos from the Payload on a CAN bus">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="f1cd33a5-b51f-4439-bd92-3eed0706c934" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#96c82fc5-9645-40c0-88b0-f1ae49935534" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="1992e723-8b2a-4c6f-9851-59ffadce2983"
                      ReqIFIdentifier="[FCS_0010]" ReqIFLongName="FCS interfaces - Power supply"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall be compatible with the received power from the Power Supply : voltage between 4.75V and 5.25V, max power consumption : 100W">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="fbb515e7-d6b6-41ec-84c0-e5da68a028f0" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#1992e723-8b2a-4c6f-9851-59ffadce2983" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                </ownedRequirements>
                <ownedRequirements xsi:type="Requirements:Folder" id="a07fa3a0-5095-4cc1-9012-9b7dad9e34e6"
                    ReqIFLongName="FCS functions">
                  <ownedRequirements xsi:type="Requirements:Requirement" id="d499b396-c3ca-42d4-9985-5cca3b08378d"
                      ReqIFIdentifier="[FCS_0011]" ReqIFLongName="FCS functions - provide drone navigation data (SF3)"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall compute the following navigation data : drone position and time, vertical speed, ground speed, drone attitude and attitude rate, drone altitude">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="14c0f553-cad1-4314-b4c1-5c5e9b4fbbe2" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#d499b396-c3ca-42d4-9985-5cca3b08378d" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="5a16f654-2917-43e7-83e1-e3a23f544f72"
                      ReqIFIdentifier="[FCS_0012]" ReqIFLongName="FCS functions - provide drone navigation data (SF3)"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall measure the following physical values : ambiant static pressure, three axis acceleration rates and rotation speeds, magnetic north direction, ground distance, ground traveling speed. ">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="958e382d-0e87-4192-b5cf-091b72f13724" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#5a16f654-2917-43e7-83e1-e3a23f544f72" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="7dc8fcf4-31ad-409b-8b57-a4aa255eed27"
                      ReqIFIdentifier="[FCS_0013]" ReqIFLongName="FCS functions - Run automatic control (SF4.2)"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall execute automatically the flight plan when the Flight Plan mode is selected">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="31a92d92-7c88-455d-8aec-3896fd71fabe" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#7dc8fcf4-31ad-409b-8b57-a4aa255eed27" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="42a783f2-db51-491e-aad4-5bccc75289e6"
                      ReqIFIdentifier="[FCS_0014]" ReqIFLongName="FCS functions - Control mode selection (SF4.3)"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall select the appropriate control mode (Flight Plan, Speed consign or Manual), depending on the control mode selected by the pilot and the Flight plan progress status (mission completed)">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="ec3490d7-3906-4259-b2d2-54919ee3d144" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#42a783f2-db51-491e-aad4-5bccc75289e6" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="99b8649c-f3b9-481a-88cb-07e85cbd6aa7"
                      ReqIFIdentifier="[FCS_0015]" ReqIFLongName="FCS functions - Position and speed control (SF2.1)"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="When the Flight plan or the Speed control mode are selected, the Flight Control system shall automatically control the drone position and compute the Altitude and Attitude AP consigns.">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="cfa9e205-c03d-4f84-911f-5019a50cfbc4" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#99b8649c-f3b9-481a-88cb-07e85cbd6aa7" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="a49a0bca-bac5-4e0e-9952-d55059bd5982"
                      ReqIFIdentifier="[FCS_0016]" ReqIFLongName="FCS functions - Altitude control (SF2.4)"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall select the drone altitude consign depending on the selected control mode (Altitude AP consign in Flight Plan or speed consign mode, Manual Pilot order in Manual mode), control the drone altitude. and compute the associated Total Thrust command">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="a708cb5d-6f5c-4a87-986d-29edc97cbc48" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#a49a0bca-bac5-4e0e-9952-d55059bd5982" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="83d87426-b54c-4f6c-9f4d-c32d8cb63e9b"
                      ReqIFIdentifier="[FCS_0017]" ReqIFLongName="FCS functions - Attitude control (SF2.3)"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall select the drone attitude consign depending on the selected control mode (Attitude AP consign in Flight Plan or speed consign mode, Manual Pilot order in Manual mode), control the drone attitude and compute the Ptheta, Pphi and Psi consigns.">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="6ebd93b7-6578-4888-a331-5df7bb616e10" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#83d87426-b54c-4f6c-9f4d-c32d8cb63e9b" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="019f8fd0-b936-4a11-8291-9c4ee787fcaa"
                      ReqIFIdentifier="[FCS_0018]" ReqIFLongName="FCS functions - Motors commands (SF2.5)"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall compute the Motors commands corresponding to the Total Thrust, Ptheta, Ppsi and Pphi computed consigns.">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="b983ff95-c58f-4780-9dbb-d4795d445182" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#019f8fd0-b936-4a11-8291-9c4ee787fcaa" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="12d7d708-6c20-44b4-b81c-368addf83b61"
                      ReqIFIdentifier="[FCS_0019]" ReqIFLongName="FCS functions - Navigation data monitoring (SF7)"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall detect failures of the navigation data (loss or erroneous) and send the motors disabling orders when a failure is detected">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="1ed36c38-c66d-4da8-aa53-0d01b1e48995" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#12d7d708-6c20-44b4-b81c-368addf83b61" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="82bee044-3636-4cfa-98a3-1e8a4f0cef02"
                      ReqIFIdentifier="[FCS_0020]" ReqIFLongName="FCS functions - Motors command monitoring (SF7)"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall detect failures of the Motors command computation and send the motos disabling orders when a failure is detected">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="ad86b99a-1ead-44c5-994e-fff1f9d8f357" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#82bee044-3636-4cfa-98a3-1e8a4f0cef02" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="ab9ed893-9566-4d1d-8068-39e25f642761"
                      ReqIFIdentifier="[FCS_0021]" ReqIFLongName="FCS functions - Motors speed monitoring (SF7)"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The Flight Control system shall detect failures of the motors control by comparing the Motors command and the motors measured speed, and desactivate the corresponding motor when a failure is detected">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="14cccdc8-e734-47de-b5f9-3a246f2cf317" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#ab9ed893-9566-4d1d-8068-39e25f642761" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                </ownedRequirements>
                <ownedRequirements xsi:type="Requirements:Folder" id="0600d3da-2836-4f73-a9d7-dddc878d908c"
                    ReqIFLongName="FCS safety">
                  <ownedRequirements xsi:type="Requirements:Requirement" id="a226fd1e-5b12-4135-bfa8-599e87d32069"
                      ReqIFIdentifier="[FCS_0022]" ReqIFLongName="FCS safety - failure conditions"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The Flight Control system shall respect the safety requirements associated to the following failure conditions. CAT Failure conditions shall not result from single failures.&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width: 612px;&quot; width=&quot;612&quot;>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr height=&quot;77&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;77&quot; style=&quot;width: 315px; height: 77px;&quot;>Failure condition&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td style=&quot;width: 117px;&quot;>&lt;em>Criticity&lt;/em>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td style=&quot;width: 180px;&quot;>&lt;em>Failure rate objective (if more severe than required by the criticity), 1/fh&lt;/em>&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;19&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;19&quot; style=&quot;width: 315px; height: 19px;&quot;>Erroneous desactivation of at most 3 engines&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>CAT&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>1.10-9&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;19&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;19&quot; style=&quot;width: 315px; height: 19px;&quot;>Erroneous attitude/altitude control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>HAZ&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>&amp;nbsp;&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;58&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;58&quot; style=&quot;width: 315px; height: 58px;&quot;>Erroneous attitude/altitude control combined with incapacity to depower actuators due to Flight control system&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>CAT&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>1.10-9&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;38&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;38&quot; style=&quot;width: 315px; height: 38px;&quot;>Erroneous position control due to Flight control system&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>HAZ&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>&amp;nbsp;&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;19&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;19&quot; style=&quot;width: 315px; height: 19px;&quot;>Erroneous control mode selection (&amp;quot;stuck auto&amp;quot;)&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>HAZ&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>&amp;nbsp;&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;38&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;38&quot; style=&quot;width: 315px; height: 38px;&quot;>Erroneous position control combined with erroneous control mode selection (&amp;quot;stuck auto&amp;quot;)&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>CAT&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>1.10-9&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;19&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;19&quot; style=&quot;width: 315px; height: 19px;&quot;>Erroneous control mode selection (&amp;quot;stuck man&amp;quot;)&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>HAZ&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>&amp;nbsp;&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;19&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;19&quot; style=&quot;width: 315px; height: 19px;&quot;>Complete loss of thrust due to Flight Control system&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>HAZ&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>1.10-7&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;38&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;38&quot; style=&quot;width: 315px; height: 38px;&quot;>Loss of position control in AUTO mode due to Flight Control System&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>MAJ&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>&amp;nbsp;&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;58&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;58&quot; style=&quot;width: 315px; height: 58px;&quot;>Loss of position control in AUTO mode combined with erroneous control mode selection (&amp;quot;stuck auto&amp;quot;)&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>HAZ&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>1.10-7&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;38&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;38&quot; style=&quot;width: 315px; height: 38px;&quot;>Incapacity to depower actuators due to Flight Control system&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>HAZ&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>&amp;nbsp;&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&#x9;&lt;colgroup>&#xA;&#x9;&#x9;&lt;col />&#xA;&#x9;&#x9;&lt;col />&#xA;&#x9;&#x9;&lt;col />&#xA;&#x9;&lt;/colgroup>&#xA;&lt;/table>&#xA;">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="af596dd8-10fa-4666-a072-9111bc73fdf4" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#a226fd1e-5b12-4135-bfa8-599e87d32069" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="ca74e56b-097d-4f21-aa72-ed017d79a32c"
                      ReqIFIdentifier="[FCS_0023]" ReqIFLongName="FCS safety - FDAL"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The Flight Control system shall respect the Following Functional Design Assurance Level :&lt;/p>&#xA;&#xA;&lt;p>- SF3, SF4.1, SF4.2, SF4.3, SF2.1, SF2.3, SF2.4, SF2.5 : DAL B&lt;/p>&#xA;&#xA;&lt;p>- SF7 : DAL A&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="87b498c0-1471-49f2-884b-a199666b9d1e" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#ca74e56b-097d-4f21-aa72-ed017d79a32c" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="3cf1329d-821c-44fa-8a67-63d0cedecd1e"
                      ReqIFIdentifier="[FCS_0024]" ReqIFLongName="FCS safety - Functional independance"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The Flight Control system shall respect the Following Functional independance constraints :&lt;/p>&#xA;&#xA;&lt;p>- SF2.1, SF3, SF4.2 shall be independant from SF4.3 and SF7&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="c8f6cf40-89aa-4e2c-b10e-bef1a33cb01f" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#3cf1329d-821c-44fa-8a67-63d0cedecd1e" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                  </ownedRequirements>
                </ownedRequirements>
                <ownedRequirements xsi:type="Requirements:Folder" id="0b046afa-ffba-4fc7-8b5c-03282e11fdc4"
                    ReqIFLongName="FCS physical constraints">
                  <ownedRequirements xsi:type="Requirements:Requirement" id="3de0d9d6-8861-4b6f-b483-97caabd2d61d"
                      ReqIFIdentifier="[FCS_0025]" ReqIFLongName="FCS physical - mass"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The Flight Control system mass shall be lower than 500g.&lt;/p>&#xA;">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="7a34226a-3d8c-4ba6-ae28-1d0fd8dfd1be" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#3de0d9d6-8861-4b6f-b483-97caabd2d61d" target="#26a12278-5126-48c0-9fc4-2304d158b01b"/>
                    <ownedRelations xsi:type="Requirements:InternalRelation" id="a67fbae0-404b-4044-8d93-c36817607cde"
                        relationType="#801e3058-4eb7-40e8-8355-0b26b2fab27c" source="#3de0d9d6-8861-4b6f-b483-97caabd2d61d"
                        target="#9e455df3-16b7-4a80-a6a7-64aff16237ed"/>
                  </ownedRequirements>
                </ownedRequirements>
              </ownedRequirements>
              <ownedRequirements xsi:type="Requirements:Folder" id="babbcedb-73f6-457e-b5b8-b50d5d193dee"
                  ReqIFLongName="Sub-systems">
                <ownedRequirements xsi:type="Requirements:Folder" id="42631b43-914e-4515-ae1f-cdc7e492816e"
                    ReqIFLongName="RC receiver">
                  <ownedRequirements xsi:type="Requirements:Requirement" id="b235a5c1-7314-4e3e-ac52-3cb0532623cf"
                      ReqIFIdentifier="[RC_0001]" ReqIFLongName="RC_receiver - mass"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The RC receiver mass shall be lower than 20g.&lt;/p>&#xD;&#xA;">
                    <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                        id="aef2cbb6-71fb-418a-ac08-8dbf00ca15b9" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                        source="#b235a5c1-7314-4e3e-ac52-3cb0532623cf" target="#119d84d5-bcfa-4457-9095-4bd00e7c030a"/>
                    <ownedRelations xsi:type="Requirements:InternalRelation" id="96f74d8b-4fc7-4f75-a7fe-5c6a2091abb4"
                        relationType="#801e3058-4eb7-40e8-8355-0b26b2fab27c" source="#b235a5c1-7314-4e3e-ac52-3cb0532623cf"
                        target="#3de0d9d6-8861-4b6f-b483-97caabd2d61d"/>
                  </ownedRequirements>
                  <ownedRequirements xsi:type="Requirements:Requirement" id="dba6ae76-1be8-4bcb-a988-3cd0a9075e95"
                      ReqIFIdentifier="[RC_0002]" ReqIFLongName="RC_receiver - safety"
                      requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="&lt;p>The RC receiver shall be designed so as to respect the following failure rates :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width: 880px;&quot; width=&quot;881&quot;>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr height=&quot;19&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;19&quot; style=&quot;width: 385px; height: 19px;&quot;>&lt;strong>Failure mode&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td style=&quot;width: 315px;&quot;>&lt;strong>Description&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td style=&quot;width: 180px;&quot;>&lt;strong>Maximum failure rate&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;19&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;19&quot; style=&quot;height: 19px;&quot;>RC_receiver.Loss&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td style=&quot;width: 315px;&quot;>Complete loss of reception of RC transmitted data&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>1.10^-5&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr height=&quot;19&quot;>&#xA;&#x9;&#x9;&#x9;&lt;td height=&quot;19&quot; style=&quot;height: 19px;&quot;>RC_receiver.Erroneous&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td style=&quot;width: 315px;&quot;>Erroneous reception of RC transmitted data&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Extremely remote&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&#x9;&lt;colgroup>&#xA;&#x9;&#x9;&lt;col />&#xA;&#x9;&#x9;&lt;col />&#xA;&#x9;&#x9;&lt;col />&#xA;&#x9;&lt;/colgroup>&#xA;&lt;/table>&#xA;">
