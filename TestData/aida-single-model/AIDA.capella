                    name="FIP 1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="95e831cd-3943-44d3-9650-8a8a06c231ef" sid="95e831cd-3943-44d3-9650-8a8a06c231ef"
                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="2b05a498-2321-4c21-b149-dcedbd8a0031" sid="2b05a498-2321-4c21-b149-dcedbd8a0031"
                  name="[SF2.2.4] Acquire vertical speed order" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Altitude order and send it to the Drone as the&amp;nbsp;Altitude consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#7061bb50-1c67-4c38-87f4-5e168b857404">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="7061bb50-1c67-4c38-87f4-5e168b857404" sid="7061bb50-1c67-4c38-87f4-5e168b857404"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
