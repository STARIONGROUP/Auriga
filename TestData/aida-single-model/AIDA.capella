                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="297be11d-dbda-40f7-8e80-6392b36a449d" sid="297be11d-dbda-40f7-8e80-6392b36a449d"
                    name="FOP 2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="2fc88329-15cb-4505-9a0c-566fb1e0c45e" sid="2fc88329-15cb-4505-9a0c-566fb1e0c45e"
                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="455a0207-7218-4f8d-bc32-005339749f68" sid="455a0207-7218-4f8d-bc32-005339749f68"
                  name="[SF4.3.2] Passivate engagement oscillation" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall detect oscillations of Selected control mode.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute AP engagement as follows : IF (Selected control mode = MANUAL) OR (Selected control mode oscillations detected) THEN AP engagement = MANUAL ELSE AP engagement = AUTO.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Flight plan interruption as follows : IF (Selected control mode = MANUAL) OR (Selected control mode oscillations detected) THEN Flight plan interruption =&amp;nbsp;INTERRUPTED ELSE Flight plan interruption =&amp;nbsp;NOT INTERRUPTED.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#3d3b10a5-aae3-4334-b79c-04114316586c">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="3d3b10a5-aae3-4334-b79c-04114316586c" name="DAL level.FDAL"
                    appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="3970e532-05a3-4512-92d6-71e7a22dfb24" name="Functionnal Design Assurance Level"
                      appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="6d77293e-7049-422a-9021-a1b2aa7ff0a2" sid="6d77293e-7049-422a-9021-a1b2aa7ff0a2"
                    name="FIP 1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="72118957-5a6c-4f4a-a305-b98dbdf34803" sid="72118957-5a6c-4f4a-a305-b98dbdf34803"
                    name="FOP 2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="c07d78a2-afd5-402a-9e98-13a5b82a85b5" sid="c07d78a2-afd5-402a-9e98-13a5b82a85b5"
                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="844b806b-e469-49a1-934b-5772cb5802fa" sid="844b806b-e469-49a1-934b-5772cb5802fa"
                  name="[SF4.3.3] Indicate control mode" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the control mode for display as follows : IF AP engagement = MANUAL THEN control mode for display = manual mode ELSE control mode for display = Selected AP mode.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#a2b62463-1b3f-4b8a-a347-e8f149a4c64a">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
