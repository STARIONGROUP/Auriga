                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="0303f7ce-1144-4a96-a001-afe9ebed0279" sid="0303f7ce-1144-4a96-a001-afe9ebed0279"
