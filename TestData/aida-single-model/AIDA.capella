                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="05f7f2df-5871-4c6a-be17-89eaf6bc2fc2" sid="1188d16a-3084-4935-9c8d-2475d7d570a1"
                    name="FIP 2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="39d74ec0-5626-4747-9d27-e666948219d7" sid="41d43b74-17da-49f7-94d4-ed6889fa8974"
                    name="FOP 1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="58832349-201c-4c43-ac66-18eaf30b70c8" sid="c48f5934-ff91-483e-b9ba-7df60db584fb"
                    name="FOP 2"/>
