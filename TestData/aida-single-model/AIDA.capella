                  id="716eb3a7-b7ca-409a-9e7d-5817380ba53c" sid="716eb3a7-b7ca-409a-9e7d-5817380ba53c"
                  name="FOP 2"/>
            </ownedFunctions>
            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="8de4f3ef-1d60-404f-9428-18dcab3afc57" targetElement="#90d1a30c-84d0-46f6-a8bc-9d057284d754"
                sourceElement="#40de6da2-7c73-4f86-93d6-e70724e98c63"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="0f6f032e-aaed-4842-82ad-baed3a0e5c9f" sid="0f6f032e-aaed-4842-82ad-baed3a0e5c9f"
                name="Rate sensor measurement" target="#862bfba6-7afd-4d5a-b0a9-2b7fb44ce9bf"
                source="#f9629196-bc08-4509-a8f7-3f09c1538c3a"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="7c8d865c-3a46-4697-92f9-5b9595e91917" sid="7c8d865c-3a46-4697-92f9-5b9595e91917"
                name="Acceleration sensor measurement" target="#869deb34-ee5f-4886-a62e-28a74b3ac466"
                source="#feb87bdb-3a26-4b21-a8f1-7e1d503dcbdb"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="acc48bff-f9ee-43e2-b372-48420703243c" sid="acc48bff-f9ee-43e2-b372-48420703243c"
                name="North direction measurement" target="#f6c23522-7307-460b-876b-71269909c999"
                source="#a076f55d-a42f-4ea6-9def-9b3ff491f2f6"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="3fa873bd-f67b-47af-9547-a0526695f103" sid="3fa873bd-f67b-47af-9547-a0526695f103"
                name="Measured ground distance" target="#a6cacffe-c272-42c4-be2f-9951d65ad08a"
                source="#c618f908-eb3f-40c3-82bd-6d59835fdf70"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="535d5e80-1fc1-4821-b1fd-3afafb2c3e70" sid="535d5e80-1fc1-4821-b1fd-3afafb2c3e70"
                name="Measured pressure" target="#ed65cf08-f60e-41ce-875c-c886858961c8"
                source="#432922d7-81e8-4bfd-88bc-82dc65c44578"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="4aa42c54-d2b2-414e-9269-d4ea526d067e" sid="4aa42c54-d2b2-414e-9269-d4ea526d067e"
                name="Measured positioning signal" target="#70a33ae9-5433-4eed-ab1b-c0d7e38d03d5"
                source="#e6802e37-cf88-4f02-afb5-030aa0fad8aa"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="8a19701e-f284-4998-be02-e928f328e10d" sid="8a19701e-f284-4998-be02-e928f328e10d"
              name="[SF4] Control drone navigation" description="&lt;p>Depending on the control mode selected by the pilot, the AIDA system moves to the requested position and visual sight angle :&lt;/p>&#xA;&#xA;&lt;p>- in AUTO mode, it executes the mission previously defined&lt;/p>&#xA;&#xA;&lt;p>- in MANUAL mode, it executes the real-time manual motion commands&lt;/p>&#xA;&#xA;&lt;p>The AIDA system provides mission progress feedback to the operator.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;"
              appliedPropertyValueGroups="#b64bc0a8-9cba-4679-9cbe-f49bc06584e7">
            <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                id="b64bc0a8-9cba-4679-9cbe-f49bc06584e7" sid="b64bc0a8-9cba-4679-9cbe-f49bc06584e7"
                name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
              <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                  id="1724122f-23fc-4fe6-bec5-b05755991dac" sid="1724122f-23fc-4fe6-bec5-b05755991dac"
                  name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                  type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
            </ownedPropertyValueGroups>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="c4d46af7-1f63-46ce-978e-9f262068836f" sid="c4d46af7-1f63-46ce-978e-9f262068836f"
                name="[SF4.1] Acquire and store flight plan" description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>This function store flight plan and flight zone computed by ground segment, prior to the Mission. So, the inspection is robust to communication shortage between drone and ground segment.&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The control desk shall acquire and store the Flight plan and Flight zone.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall send the Flight plan and Flight zone to the drone.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall monitor the integrity of the storage of the Flight plan and Flight zone.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall compute the Flight plan validity status as follows : IF (Flight plan is INVALID) OR (Flight plan storage integrity is INVALID) THEN (Flight plan sent to the drone is INVALID) else (Flight plan sent to the drone is VALID).&lt;/p>&#xA;&#xA;&lt;p>The control desk shall compute the Flight zone validity status as follows : IF (Flight zone is INVALID) OR (Flight zone storage integrity is INVALID) THEN (Flight zone sent to the drone is INVALID) else (Flight zone sent to the drone is VALID).&lt;/p>&#xA;"
                appliedPropertyValueGroups="#767ba430-72df-4d5e-a0bf-b09113cac4f5">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="767ba430-72df-4d5e-a0bf-b09113cac4f5" sid="767ba430-72df-4d5e-a0bf-b09113cac4f5"
                  name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="66db07fb-9f1a-4ec5-b73f-32b370cb9b97" sid="66db07fb-9f1a-4ec5-b73f-32b370cb9b97"
                    name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                    type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
              </ownedPropertyValueGroups>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="d76d9c13-2347-4507-8904-faf6b721123c" sid="d76d9c13-2347-4507-8904-faf6b721123c"
                  name="FIP 1"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="f8e1d358-3998-4829-a3ab-b70bcdbf3f0a" sid="f8e1d358-3998-4829-a3ab-b70bcdbf3f0a"
                  name="FIP 2"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="e97911f9-9d8c-4973-a1a5-719abde1a029" sid="e97911f9-9d8c-4973-a1a5-719abde1a029"
                  name="FOP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="e57d5fe7-7700-447c-8d08-84ade8716953" sid="e57d5fe7-7700-447c-8d08-84ade8716953"
                  name="FOP 2"/>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="11513800-55b9-420f-a670-e7ffd744d2fe" targetElement="#c18cc0d3-37d6-4c6e-bd4a-a1a34afbeac6"
                  sourceElement="#c4d46af7-1f63-46ce-978e-9f262068836f"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="9c8a3261-df78-4d1e-80d8-a6a370d7339c" sid="9c8a3261-df78-4d1e-80d8-a6a370d7339c"
                name="[SF4.2] Run automatic control" description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>This function runs the flight plan : it commands the request drone consigns and control mode, then controls the payload when the position is reached.&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>It report mission progress and monitors that drone remains in flight zone. &lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>If the pilot interrupts the mission, the function switch from flight plan consigns to pilots consigns.&lt;/span>&lt;/p>&#xA;"
                appliedPropertyValueGroups="#f27c3795-5cfc-4a27-bb6a-a8ac3cd5182c">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="f27c3795-5cfc-4a27-bb6a-a8ac3cd5182c" sid="f27c3795-5cfc-4a27-bb6a-a8ac3cd5182c"
                  name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="5749e753-e042-4341-af4b-07d68d26d004" sid="5749e753-e042-4341-af4b-07d68d26d004"
                    name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                    type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
              </ownedPropertyValueGroups>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="1e706e99-fc30-4893-b807-92d8240e7777" sid="1e706e99-fc30-4893-b807-92d8240e7777"
                  name="[SF4.2.1] Run flight plan" description="&lt;p>This function provides the coordinates of the next position to be reached by the drone (X,Y,Z coordinates + yaw angle + payload angle). It also provides feedback on the flight plan progress to be displayed to the operator.&lt;/p>&#xA;&#xA;&lt;p>The output are used only in Navigation AP mode.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>When Automatic control start is set to &amp;quot;Start&amp;quot;, the main processor shall compute the Drone position consign as the trajectory to reach the next waypoint of the Flight plan while ensuring the drone stays in the Flight zone.&lt;/p>&#xA;&#xA;&lt;p>When Automatic control start is set to &amp;quot;Start&amp;quot; and Flight plan interruption is set to &amp;quot;Not interrupted&amp;quot;, the main processor shall compute the Flight plan payload control as the payload position and acquisition consign defined in the Flight plan.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Drone position consign and Flight plan payload control&amp;nbsp;validity status as follows : IF (Flight plan is INVALID) OR (Flight zone is INVALID) OR (Drone position is INVALID) OR (Drone time is INVALID) THEN Drone position consign and Flight plan payload control&amp;nbsp;is INVALID ELSE Drone position consign and Flight plan payload control is VALID.&lt;/p>&#xA;&#xA;&lt;p>When Flight plan interruption is set to &amp;quot;INTERRUPTED&amp;quot; or Automatic control start is set to &amp;quot;stop&amp;quot;, the main processor shall&amp;nbsp;set the Drone position consign to the current Drone position.&lt;/p>&#xA;&#xA;&lt;p>&lt;em>Note : when the pilot selects the Flight plan mode but has not yet commanded the Automatic control start, the drone stays on the current position. &lt;em>When the Flight plan is interrupted, the control mode is switched to MANUAL and the Drone position consign is not used in downstream functions.&lt;/em>&lt;/em>&lt;/p>&#xA;&#xA;&lt;p>When the last waypoint is reached, the main processor shall set the Mission completed to &amp;quot;Completed&amp;quot;.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall send the Flight plan progress to the Control desk.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the&amp;nbsp;Flight plan progress&amp;nbsp;validity status as follows : IF (Flight plan is INVALID) OR (Flight zone is INVALID) OR (Drone position is INVALID) OR (Drone time is INVALID) THEN Flight plan progress is INVALID ELSE Flight plan progress is VALID.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#b928ca40-7e71-437e-a479-4df1b391fbfa">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="b928ca40-7e71-437e-a479-4df1b391fbfa" sid="b928ca40-7e71-437e-a479-4df1b391fbfa"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="0408219a-0af0-4d54-b89f-da206bd3c644" sid="0408219a-0af0-4d54-b89f-da206bd3c644"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="2a090ee8-a103-4dfa-b718-dd150efe7a93" sid="2a090ee8-a103-4dfa-b718-dd150efe7a93"
                    name="FIP 2"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="6f3a52a6-ef6f-4d90-998d-6b89e87effc9" sid="6f3a52a6-ef6f-4d90-998d-6b89e87effc9"
                    name="FIP 1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="ad057c2c-b29e-4839-bd6b-08d93726b5f7" sid="ad057c2c-b29e-4839-bd6b-08d93726b5f7"
                    name="FIP 4"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="1b766019-ce33-4566-a700-698cded243d5" sid="1b766019-ce33-4566-a700-698cded243d5"
                    name="FIP 5"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="5cf002aa-a0e5-45f2-8eee-3a758086508f" sid="5cf002aa-a0e5-45f2-8eee-3a758086508f"
                    name="FIP 8"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="e77c1434-705a-4131-9011-c94ac26f632d" sid="e77c1434-705a-4131-9011-c94ac26f632d"
                    name="FIP 3"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="d7487f7a-61dc-4e36-b2dd-b71fb604b19b" sid="d7487f7a-61dc-4e36-b2dd-b71fb604b19b"
                    name="FOP 4"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="cb695684-ea06-4bcc-9355-0e51b507dcc7" sid="cb695684-ea06-4bcc-9355-0e51b507dcc7"
                    name="FOP 1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="5464ce22-8594-445b-a1b8-d9189bf0124d" sid="5464ce22-8594-445b-a1b8-d9189bf0124d"
                    name="FOP 3"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="4cca83a7-c6df-4901-9e8e-bfcbadc675b6" sid="4cca83a7-c6df-4901-9e8e-bfcbadc675b6"
                    name="FOP 5"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="52c682d5-a257-4c33-998e-d40f9b697bdc" sid="52c682d5-a257-4c33-998e-d40f9b697bdc"
                  name="[SF4.2.2] Run speed control" description="&lt;p>This function provides the speed consign to be followed by the drone in Speed AP mode, and the programmed payload control parameters&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>When Automatic control start is set to &amp;quot;Start&amp;quot;, the main processor shall compute the Drone speed consign as defined in the Pilot control consigns.&lt;/p>&#xA;&#xA;&lt;p>When automatic control start is set to &amp;quot;Stop&amp;quot;, the main processor shall set the Drone speed consign to 0.&lt;/p>&#xA;&#xA;&lt;p>&lt;em>Note : if the pilot sets the control mode to &amp;quot;Speed consign mode&amp;quot; but has not started yet the Automatic control, the drone stays in the current position.&lt;/em>&lt;/p>&#xA;&#xA;&lt;p>When Automatic control start is set to &amp;quot;Start&amp;quot;, the main processor shall compute the Programmed payload control as defined in the Pilot control consigns.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Drone speed consign and Programmed payload control validity status as follows : IF (Automatic control start is INVALID) OR (Pilot control consigns is INVALID) THEN Drone speed consign and Programmed payload control are INVALID ELSE Drone speed consign and Programmed payload control are VALID.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#78a13a35-b7b1-4bc0-849c-8ee6077eae10">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="78a13a35-b7b1-4bc0-849c-8ee6077eae10" sid="78a13a35-b7b1-4bc0-849c-8ee6077eae10"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="0836cf0c-fc70-406d-90f6-980f7db4896c" sid="0836cf0c-fc70-406d-90f6-980f7db4896c"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="afac5860-5ed8-45c9-a7e1-b5296daaaf44" sid="afac5860-5ed8-45c9-a7e1-b5296daaaf44"
                    name="FIP 6"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="0d2fd06e-58b1-44bd-aca1-2c6204a2d127" sid="0d2fd06e-58b1-44bd-aca1-2c6204a2d127"
                    name="FIP 2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="f7c9f25b-0f17-4a56-ba9f-99661330a6f7" sid="f7c9f25b-0f17-4a56-ba9f-99661330a6f7"
                    name="FOP 2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="b6940f40-8345-4b0e-b512-c1034e273c03" sid="b6940f40-8345-4b0e-b512-c1034e273c03"
                    name="FOP 3"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="859cea30-7dd5-4a60-ace4-db66141f303b" sid="859cea30-7dd5-4a60-ace4-db66141f303b"
                  name="[SF4.2.3] Select automatic payload control" description="&lt;p>This function select the appropriate payload control parameters according to the selected control mode.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall select the Automatic payload control value and validity status as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup span=&quot;5&quot; width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; height=&quot;70&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Selected AP mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Flight plan payload control Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Programmed payload control validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control validity status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;96&quot; rowspan=&quot;2&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Flight plan mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Flight plan payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Flight plan payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;96&quot; rowspan=&quot;2&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Speed consign mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Programmed payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid r