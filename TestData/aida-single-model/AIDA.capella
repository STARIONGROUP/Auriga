                    sourceElement="#06a8a92a-6878-405e-ba3e-96702d26e3c0"/>
                <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                    id="3ed15b26-e1cf-4b06-a26d-e0f8659f4928" targetElement="#120ab220-1f17-4d7a-ac86-2e16154ece4d"
