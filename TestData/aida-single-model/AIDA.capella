                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="6d56d52c-4e29-437a-8aa3-0ffb60e45fe9" sid="e1d83d05-be3d-4aa8-9607-7c805a6ed8b5"
