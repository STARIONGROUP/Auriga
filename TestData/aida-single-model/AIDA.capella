        </ownedSystemComponents>
        <ownedSystemComponents xsi:type="org.polarsys.capella.core.data.ctx:SystemComponent"
            id="53711f6d-23a4-42e1-be6b-3fded5ba0efe" name="Drone environment" description="&lt;p align=&quot;JUSTIFY&quot; dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>The AIDA system is designed to be used outdoor, and therefore has to sustain possible adverse atmospheric conditions : wind, extreme temperatures, rain, snow and icing, thunderstorm&amp;hellip; . Probable operational limitations will be identified in further states of design.&lt;/span>&lt;/p>&#xA;"
            actor="true">
          <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
              id="5a841efe-50b5-411a-aca3-9795eb3b0ca1" targetElement="#6666f2d1-525a-4f61-b633-e0f944f21661"
              sourceElement="#53711f6d-23a4-42e1-be6b-3fded5ba0efe"/>
          <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
              id="12add41d-0415-45b0-8068-cdb1e1a328b4" targetElement="#9e7a01d8-7e85-4733-b956-bd9f7c5f553c"
              sourceElement="#53711f6d-23a4-42e1-be6b-3fded5ba0efe"/>
          <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
              id="4405fb5e-6dff-4378-a0a4-78ede898a77f" name="CP 1" orientation="OUT"
              kind="FLOW">
            <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                id="a5da7bfc-227d-4638-b049-61f66043da50" targetElement="#23f34f6e-2c3c-4e33-af80-ee4009e35a2b"
                sourceElement="#4405fb5e-6dff-4378-a0a4-78ede898a77f"/>
          </ownedFeatures>
          <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
              id="5eecd399-d4b9-4e1f-8f4d-69d4c050beaf" name="CP 2" orientation="OUT"
              kind="FLOW">
            <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                id="f6ed6eee-dccd-4cef-9d83-583e994dbd95" targetElement="#fbee5fdb-9bb2-4ab7-b6fc-d5d03efb18cc"
                sourceElement="#5eecd399-d4b9-4e1f-8f4d-69d4c050beaf"/>
          </ownedFeatures>
          <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
              id="1c2ff6be-c950-47cc-a2ed-c1bb00365db6" targetElement="#cc36fecd-9c5d-437f-ba46-17bcdac202c3"
              sourceElement="#53711f6d-23a4-42e1-be6b-3fded5ba0efe"/>
        </ownedSystemComponents>
        <ownedSystemComponents xsi:type="org.polarsys.capella.core.data.ctx:SystemComponent"
            id="93374bff-b04d-44e4-a885-f4ffe954f0e1" name="Airline data base" description="&lt;p>&lt;span lang=&quot;EN&quot;>this database contains data that are used for inspection (flight plan definition, aircraft inspection history,&amp;hellip;) and stores the inspection report. A direct communication link between the AIDA system and this database is foreseen.&lt;/span>&lt;/p>&#xA;"
            actor="true">
          <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
              id="d45a2d8c-e5ce-49fc-b262-fa10201a6242" targetElement="#90552b63-523c-4b58-a8d6-6333760f3ec7"
              sourceElement="#93374bff-b04d-44e4-a885-f4ffe954f0e1"/>
          <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
              id="03646e02-bc3d-4f19-8c04-68b34cd10119" targetElement="#50e6bf63-cd96-4c37-9169-f7a92734880f"
              sourceElement="#93374bff-b04d-44e4-a885-f4ffe954f0e1"/>
          <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
              id="f9c1e0c4-2ad7-4919-9cca-7f2a25aa4aa7" name="CP 1" orientation="IN"
              kind="FLOW">
            <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                id="de6e3307-d12e-4a7a-b7fd-c543e990f10a" targetElement="#850f5001-e72b-403e-ba3b-6c65236c5890"
                sourceElement="#f9c1e0c4-2ad7-4919-9cca-7f2a25aa4aa7"/>
            <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                id="713ca484-d51f-4464-82e7-a3895cfb7113" targetElement="#f7e0af73-f606-46a1-a5f8-09c321b05b82"
                sourceElement="#f9c1e0c4-2ad7-4919-9cca-7f2a25aa4aa7"/>
            <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                id="8e8caafb-8e2b-4f4c-9022-2448b3bf96d6" targetElement="#c93832ec-e940-40bb-99a7-ba3bdb9be1a2"
                sourceElement="#f9c1e0c4-2ad7-4919-9cca-7f2a25aa4aa7"/>
          </ownedFeatures>
          <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
              id="2dfdc614-f7ff-4735-981e-b15ea32091c6" targetElement="#8b52bfb2-074a-49a0-ab07-dd22be3a0a35"
              sourceElement="#93374bff-b04d-44e4-a885-f4ffe954f0e1"/>
        </ownedSystemComponents>
        <ownedSystemComponents xsi:type="org.polarsys.capella.core.data.ctx:SystemComponent"
            id="1e461398-81d8-40c0-b154-f83b488cfc5f" name="Aircraft flight crew"
            description="&lt;p align=&quot;JUSTIFY&quot; dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>the flight crew is the ultimate &amp;quot;customer&amp;quot; of the AIDA system, as they will take decisions based upon the results of the inspection. The need for a direct interface between the AIDA system and the flight crew (for example via the pilot notepad) will have to be defined, however this is not seen as a major architecture topic. So far, the flight crew does not intervene directly in the AIDA system operations (&lt;b>to be discussed when establishing the operational scenarios&lt;/b>).&lt;/span>&lt;/p>&#xA;"
            actor="true" human="true">
          <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
              id="f63bcc00-71a7-4db7-b237-51a6ef826e61" targetElement="#f493a093-2342-4dc4-b12c-63958e9603ac"
              sourceElement="#1e461398-81d8-40c0-b154-f83b488cfc5f"/>
          <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
              id="8f706151-87f3-48aa-94b9-752dce9ea81c" targetElement="#153accaa-fefa-4ce3-aa84-9ec3e6b3557b"
              sourceElement="#1e461398-81d8-40c0-b154-f83b488cfc5f"/>
        </ownedSystemComponents>
        <ownedSystemComponents xsi:type="org.polarsys.capella.core.data.ctx:SystemComponent"
            id="bcb9c522-05a0-4d47-b351-9452727f9d69" name="Air Traffic Management and airport Authorities"
            description="&lt;p align=&quot;JUSTIFY&quot; dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>Being a flying object in an airport environment, it is very likely that some kind of communication will be needed between the AIDA system and ATM systems (radio communication between the operator and the control tower, identification within the ATM system, direct orders communicated from the ATM system to AIDA,&amp;hellip;). This will be further studied in the concept of operations.&lt;/span>&lt;/p>&#xA;"
            actor="true">
          <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
              id="4c8da369-51ac-4a24-9134-178cab2c196e" targetElement="#f146aa7c-bfe2-4020-a701-9e98b3b9b37f"
              sourceElement="#bcb9c522-05a0-4d47-b351-9452727f9d69"/>
          <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
              id="e759e11c-7826-4b83-b1c1-d72bb288cbf7" name="CP 1" orientation="IN"
              kind="FLOW">
            <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                id="43994d92-f81c-4b3c-abda-6fde92b13f9d" targetElement="#734bf5e4-dbc3-44f4-a61e-ac6aab632c0b"
                sourceElement="#e759e11c-7826-4b83-b1c1-d72bb288cbf7"/>
          </ownedFeatures>
          <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
              id="edd613e1-1234-4bd4-961f-eb82b6e34d36" targetElement="#cc36fecd-9c5d-437f-ba46-17bcdac202c3"
              sourceElement="#bcb9c522-05a0-4d47-b351-9452727f9d69"/>
        </ownedSystemComponents>
        <ownedSystemComponents xsi:type="org.polarsys.capella.core.data.ctx:SystemComponent"
            id="700fe553-3fa3-4855-b7a7-a5c3de791a35" name="Obstacles (static, moving on ground or flying)"
            description="&lt;p align=&quot;JUSTIFY&quot; dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>Many foreign objects can be expected in the airport gate environment. Three categories can be identified :&lt;/span>&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>&lt;font face=&quot;Calibri&quot; size=&quot;3&quot;>&lt;font face=&quot;Calibri&quot; size=&quot;3&quot;>&lt;span lang=&quot;FR&quot;>Static objects　: airport buildings, aircraft access gate, lamppost, static vehicules,&amp;hellip;&lt;/span>&lt;/font>&lt;/font>&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>&lt;font face=&quot;Calibri&quot; size=&quot;3&quot;>&lt;font face=&quot;Calibri&quot; size=&quot;3&quot;>&lt;span lang=&quot;FR&quot;>Objects moving on ground　: passengers access ramps and buses, fuel truck, fret and luggage vehicules, food and servicing vehicules, de-icing vehicules, involved (mechanic/ground team, aircraft crew,&amp;hellip;) or uninvolved (passengers,&amp;hellip;) persons, other aircrafts,&amp;hellip;&lt;/span>&lt;/font>&lt;/font>&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>&lt;font face=&quot;Calibri&quot; size=&quot;3&quot;>&lt;font face=&quot;Calibri&quot; size=&quot;3&quot;>&lt;span lang=&quot;FR&quot;>Flying objects　: other drones (although not very developed so far), flying aircrafts (not foreseen in the direct environment of the airport gate),&amp;hellip;&lt;/span>&lt;/font>&lt;/font>&lt;/li>&#xA;&lt;/ul>&#xA;"
            actor="true">
          <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
              id="c9c1efc8-6bb4-4002-a735-c0d63410ddcf" targetElement="#cc36fecd-9c5d-437f-ba46-17bcdac202c3"
              sourceElement="#700fe553-3fa3-4855-b7a7-a5c3de791a35"/>
        </ownedSystemComponents>
        <ownedSystemComponents xsi:type="org.polarsys.capella.core.data.ctx:SystemComponent"
            id="acdb5ff1-946a-462b-8ef0-0c3402bd829c" name="Manufacturer" description="&lt;p>&lt;span lang=&quot;EN&quot;>Mainly involved during the design and manufacture life phases, the manufacturer can also intervene as a back office all along the lifecycle. &lt;/span>&lt;/p>&#xA;"
            actor="true"/>
        <ownedSystemComponents xsi:type="org.polarsys.capella.core.data.ctx:SystemComponent"
            id="41bf7216-6af1-4bf3-aaaa-6a6a0ae125c2" name="Regulation authorities"
            description="&lt;p align=&quot;JUSTIFY&quot; dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>They publish the regulation documents and authorize the system operations in the context of &amp;quot;specific&amp;quot; or &amp;quot;certified&amp;quot; operations.&lt;/span>&lt;/p>&#xA;"
            actor="true">
          <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
              id="ec331df1-fde4-455e-8de5-f81af4891b80" targetElement="#cc36fecd-9c5d-437f-ba46-17bcdac202c3"
              sourceElement="#41bf7216-6af1-4bf3-aaaa-6a6a0ae125c2"/>
        </ownedSystemComponents>
      </ownedSystemComponentPkg>
      <ownedMissionPkg xsi:type="org.polarsys.capella.core.data.ctx:MissionPkg" id="6809807f-f0df-486b-9763-ee2ca0f1dfe4"
          name="Missions">
