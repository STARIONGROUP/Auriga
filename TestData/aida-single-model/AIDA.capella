              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="a433c1b7-16a6-438f-841e-12efbf0a3f7b" sid="a433c1b7-16a6-438f-841e-12efbf0a3f7b"
                  name="[SF1.2.7] Measure motor 2 speed MON" appliedPropertyValueGroups="#6ae27cf6-af19-439c-b851-d2c19a1dd2f6">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="6ae27cf6-af19-439c-b851-d2c19a1dd2f6" sid="6ae27cf6-af19-439c-b851-d2c19a1dd2f6"
