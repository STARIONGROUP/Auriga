              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="2b47a560-a08e-4e92-9843-e751a4d44757" sid="2b47a560-a08e-4e92-9843-e751a4d44757"
                  name="[SF2.2.5] Acquire manual override order" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Manual override&amp;nbsp;order and send it to the Drone as the&amp;nbsp;Manuel override, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#93f4af15-1ed1-49e5-b11b-20193437578f">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="93f4af15-1ed1-49e5-b11b-20193437578f" sid="93f4af15-1ed1-49e5-b11b-20193437578f"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="af43187e-0562-4af1-a579-af6e8b644d09" sid="af43187e-0562-4af1-a579-af6e8b644d09"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="95187af0-6668-407d-a75f-27b63b42827e" sid="95187af0-6668-407d-a75f-27b63b42827e"
