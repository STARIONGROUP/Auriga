            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="349033ce-0ae3-41f8-b176-ee69527db25c" sid="cd4b4638-23ec-4864-8924-4a3b5c99db04"
                name="[SF1.3] Control propeller 3" description="&lt;p>This function controls the engine 1.&lt;/p>&#xA;"
                appliedPropertyValueGroups="#6a405d8e-eec2-4dbb-adc6-9dc5d046048e">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="6a405d8e-eec2-4dbb-adc6-9dc5d046048e" sid="6a405d8e-eec2-4dbb-adc6-9dc5d046048e"
                  name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="c541d6b2-cf5a-4781-b673-1b1a22fc34fd" sid="c541d6b2-cf5a-4781-b673-1b1a22fc34fd"
                    name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                    type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#1ed8f881-a7b9-4ac3-b2e6-ea5235d56475"/>
              </ownedPropertyValueGroups>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="f52f8d6b-0d25-4602-8ff2-a510c7c0cb41" sid="3ae73397-7ab1-46e6-88de-bd3aeb9515b3"
                  name="[SF1.3.1] Control motor 3" description="&lt;p>This function controls the current sent to the engine, based on the Motor rate demand and the Motor rate measurement. The Motor position measurement is also used, it is assumed at this stage that the motor will be brushless engines for which the position is needed.&lt;/p>&#xA;&#xA;&lt;p>REQs :&lt;/p>&#xA;&#xA;&lt;p>The&amp;nbsp;variator shall compute the Motor i control consign as a function of the &amp;quot;Motor i rate&amp;quot; demand, the &amp;quot;Motor i rate measured&amp;quot; feedback and the &amp;quot;Motor i position measured&amp;quot; feedback.&lt;/p>&#xA;&#xA;&lt;p>The variator shall set the Motor i control consign validity&amp;nbsp;status to INVALID if one of the validity status of &amp;quot;Motor i rate&amp;quot;, &amp;quot;Motor i rate measured&amp;quot; or &amp;quot;Motor i position measured&amp;quot; is INVALID, otherwise to VALID.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#16deb3eb-e679-4273-be8c-41134d8c33f5">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="16deb3eb-e679-4273-be8c-41134d8c33f5" sid="16deb3eb-e679-4273-be8c-41134d8c33f5"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="1b22f0e7-3d50-4b8f-b61b-35bf1b1a8381" sid="1b22f0e7-3d50-4b8f-b61b-35bf1b1a8381"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#1ed8f881-a7b9-4ac3-b2e6-ea5235d56475"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="e239baaf-4c95-48f7-8f6c-e86d8b0688bd" sid="8cc98ce5-c678-4ee9-9a69-d1e55e9e546d"
                    name="FIP 1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="58b97f85-7b6b-4f23-87bf-ffec2b39ab8c" sid="ceee2807-ceed-4cf8-b61c-fce252a4398e"
                    name="FIP 2"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="7535e73a-8732-4969-87d7-3c3144db663f" sid="322e78f7-9d10-4439-a37b-a28b6581bd47"
                    name="FIP 3"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="fab6f888-b5c5-4f8f-8fa2-7a894043601e" sid="a24daeda-d41e-426f-abe5-23ca5fa03091"
                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="bf5d57a4-d9cc-4585-9251-01209871c400" sid="20d72c81-f1e1-482b-8465-4b2aa67f42f3"
                  name="[SF1.3.2] Create motion 3" description="&lt;p>This function transform the Motor i command into rotation mouvement.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The motor&amp;nbsp; i shall rotate according to the Motor i command signal.&lt;/p>&#xA;&#xA;&lt;p>The motor i shall provide to the MCPS a 3-phased electrical interface. Two phases are used for the motor command, the last one is used as a voltage feedback of the motor position.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#1dfa10e1-38c5-42ab-97e9-dff29ae4711c">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="1dfa10e1-38c5-42ab-97e9-dff29ae4711c" sid="1dfa10e1-38c5-42ab-97e9-dff29ae4711c"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="79a6c4c3-859e-4bf1-bf59-12dedd0999cf" sid="79a6c4c3-859e-4bf1-bf59-12dedd0999cf"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#1ed8f881-a7b9-4ac3-b2e6-ea5235d56475"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="8c0d3516-fc0a-46ee-9d0a-a7d61dae449c" sid="1188d16a-3084-4935-9c8d-2475d7d570a1"
                    name="FIP 2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="93ebf00f-9382-4ded-a7e5-1d41bd3308d0" sid="41d43b74-17da-49f7-94d4-ed6889fa8974"
                    name="FOP 1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="c87f7fec-e702-40d5-b955-b124f1ae6a29" sid="c48f5934-ff91-483e-b9ba-7df60db584fb"
                    name="FOP 2"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="6691f73f-c2e1-42aa-a189-415709cb2775" sid="ac9a89d2-caff-407c-9f29-efa9b221cba0"
                  name="[SF1.3.3] Create thrust and torque at propeller 3" description="&lt;p>This function transforms the rotation mouvement into lift/drag and torque.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The propeller shall transform the Motor i motion into Helix 1 thrust and Helix 1 torque.&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#93b9171a-eb76-437b-af17-eda3698caa1c">
