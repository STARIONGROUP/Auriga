            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="47349b0a-3358-4c69-a242-23dffcfe8d22" sid="cd4b4638-23ec-4864-8924-4a3b5c99db04"
                name="[SF1.4] Control propeller 4" description="&lt;p>This function controls the engine 1.&lt;/p>&#xA;"
                appliedPropertyValueGroups="#e911bdee-e15d-49e4-b8ce-9788b1b32227">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="e911bdee-e15d-49e4-b8ce-9788b1b32227" sid="e911bdee-e15d-49e4-b8ce-9788b1b32227"
                  name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="159df406-b425-44b2-9754-1ab79e74daaa" sid="159df406-b425-44b2-9754-1ab79e74daaa"
                    name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                    type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#1ed8f881-a7b9-4ac3-b2e6-ea5235d56475"/>
              </ownedPropertyValueGroups>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="87ccf262-a663-4018-acd5-0bac82e0988d" sid="3ae73397-7ab1-46e6-88de-bd3aeb9515b3"
                  name="[SF1.4.1] Control motor 4" description="&lt;p>This function controls the current sent to the engine, based on the Motor rate demand and the Motor rate measurement. The Motor position measurement is also used, it is assumed at this stage that the motor will be brushless engines for which the position is needed.&lt;/p>&#xA;&#xA;&lt;p>REQs :&lt;/p>&#xA;&#xA;&lt;p>The&amp;nbsp;variator shall compute the Motor i control consign as a function of the &amp;quot;Motor i rate&amp;quot; demand, the &amp;quot;Motor i rate measured&amp;quot; feedback and the &amp;quot;Motor i position measured&amp;quot; feedback.&lt;/p>&#xA;&#xA;&lt;p>The variator shall set the Motor i control consign validity&amp;nbsp;status to INVALID if one of the validity status of &amp;quot;Motor i rate&amp;quot;, &amp;quot;Motor i rate measured&amp;quot; or &amp;quot;Motor i position measured&amp;quot; is INVALID, otherwise to VALID.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#eaa1e886-5d4e-41e5-9309-a09b461c1a45">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="eaa1e886-5d4e-41e5-9309-a09b461c1a45" sid="eaa1e886-5d4e-41e5-9309-a09b461c1a45"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="56e6638b-5d40-4223-b427-54ba6dd7b72f" sid="56e6638b-5d40-4223-b427-54ba6dd7b72f"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#1ed8f881-a7b9-4ac3-b2e6-ea5235d56475"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="9d64db21-54fd-481b-b97f-d3333492726d" sid="8cc98ce5-c678-4ee9-9a69-d1e55e9e546d"
                    name="FIP 1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="fedca4b5-b7c6-4682-b723-335d3bd94b96" sid="ceee2807-ceed-4cf8-b61c-fce252a4398e"
                    name="FIP 2"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="146e3b96-6d41-4628-bcee-d509b681e04a" sid="322e78f7-9d10-4439-a37b-a28b6581bd47"
                    name="FIP 3"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="8af827eb-d4d5-49aa-bb5f-d373bf70e1d3" sid="a24daeda-d41e-426f-abe5-23ca5fa03091"
                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="b832e127-9483-4e25-a019-c46812bf4857" sid="20d72c81-f1e1-482b-8465-4b2aa67f42f3"
                  name="[SF1.4.2] Create motion 4" description="&lt;p>This function transform the Motor i command into rotation mouvement.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The motor&amp;nbsp; i shall rotate according to the Motor i command signal.&lt;/p>&#xA;&#xA;&lt;p>The motor i shall provide to the MCPS a 3-phased electrical interface. Two phases are used for the motor command, the last one is used as a voltage feedback of the motor position.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#084bc75a-2a5a-438a-b951-a8b35672a02b">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="084bc75a-2a5a-438a-b951-a8b35672a02b" sid="084bc75a-2a5a-438a-b951-a8b35672a02b"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
