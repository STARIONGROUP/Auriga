                    requirementType="#3ec90f98-f273-4a93-9fb6-a698ffaa25c4" ReqIFText="The payload shall digitise photos and videos in the required format and send them to the control desk.">
                  <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                      id="c1e1aff9-9f71-4d11-b88d-c02fb19ad1ad" relationType="#725baeba-8665-4983-93f7-7b5a985ddc08"
                      source="#9c4521c7-3878-4112-8850-87f24215e11c" target="#52074add-3d9e-475f-923e-cde9487c04b2"/>
                </ownedRequirements>
