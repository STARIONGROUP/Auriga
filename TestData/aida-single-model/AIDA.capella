          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="df53dafa-17f1-4ac2-bc92-1a1034a38b21" sid="df53dafa-17f1-4ac2-bc92-1a1034a38b21"
              name="[SF1] Control drone propulsion" description="&lt;p>This function controls the rotation speed of each engine and propeller, based on the speed command received from SF2 (&amp;quot;Motors rate&amp;quot;)&amp;nbsp;and the engine disabling command (&amp;quot;Motor&amp;nbsp;disabled&amp;quot;)&amp;nbsp;received from SF7.Because of the aerodynamical interaction between the propeller and ambiant air, it generates lift and torque at the emplacement of each engine.&lt;/p>&#xA;"
              appliedPropertyValueGroups="#9d1fcfb0-f02c-49e3-b6c8-07ca0e91683b">
            <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                id="9d1fcfb0-f02c-49e3-b6c8-07ca0e91683b" sid="9d1fcfb0-f02c-49e3-b6c8-07ca0e91683b"
                name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
              <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                  id="9752591c-accc-4c7b-bb1e-7e76271c5135" sid="9752591c-accc-4c7b-bb1e-7e76271c5135"
                  name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                  type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#1ed8f881-a7b9-4ac3-b2e6-ea5235d56475"/>
            </ownedPropertyValueGroups>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="cd4b4638-23ec-4864-8924-4a3b5c99db04" sid="cd4b4638-23ec-4864-8924-4a3b5c99db04"
                name="[SF1.1] Control propeller 1" description="&lt;p>This function controls the engine 1.&lt;/p>&#xA;"
                appliedPropertyValueGroups="#0889a7f2-e380-489c-a37b-c1c1dc95a0e5">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="0889a7f2-e380-489c-a37b-c1c1dc95a0e5" sid="0889a7f2-e380-489c-a37b-c1c1dc95a0e5"
                  name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="151583be-443a-43fe-898c-6c83f703df85" sid="151583be-443a-43fe-898c-6c83f703df85"
                    name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                    type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#1ed8f881-a7b9-4ac3-b2e6-ea5235d56475"/>
              </ownedPropertyValueGroups>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="3ae73397-7ab1-46e6-88de-bd3aeb9515b3" sid="3ae73397-7ab1-46e6-88de-bd3aeb9515b3"
                  name="[SF1.1.1] Control motor 1" description="&lt;p>This function controls the current sent to the engine, based on the Motor rate demand and the Motor rate measurement. The Motor position measurement is also used, it is assumed at this stage that the motor will be brushless engines for which the position is needed.&lt;/p>&#xA;&#xA;&lt;p>REQs :&lt;/p>&#xA;&#xA;&lt;p>The&amp;nbsp;variator shall compute the Motor i control consign as a function of the &amp;quot;Motor i rate&amp;quot; demand, the &amp;quot;Motor i rate measured&amp;quot; feedback and the &amp;quot;Motor i position measured&amp;quot; feedback.&lt;/p>&#xA;&#xA;&lt;p>The variator shall set the Motor i control consign validity&amp;nbsp;status to INVALID if one of the validity status of &amp;quot;Motor i rate&amp;quot;, &amp;quot;Motor i rate measured&amp;quot; or &amp;quot;Motor i position measured&amp;quot; is INVALID, otherwise to VALID.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#b04699a3-5840-4e3a-9cba-3b46a2f3e9be">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="b04699a3-5840-4e3a-9cba-3b46a2f3e9be" sid="b04699a3-5840-4e3a-9cba-3b46a2f3e9be"
                    name="DAL level.FDAL" appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="d2a47204-2e9e-4ef4-8232-0e77982860f7" sid="d2a47204-2e9e-4ef4-8232-0e77982860f7"
                      name="Functionnal Design Assurance Level" appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#1ed8f881-a7b9-4ac3-b2e6-ea5235d56475"/>
                </ownedPropertyValueGroups>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="8cc98ce5-c678-4ee9-9a69-d1e55e9e546d" sid="8cc98ce5-c678-4ee9-9a69-d1e55e9e546d"
                    name="FIP 1"/>
