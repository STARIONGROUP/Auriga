              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="668b4793-4673-4115-b1ca-d302cd3e313c" sid="668b4793-4673-4115-b1ca-d302cd3e313c"
                  name="[SF2.3.3] Control pitch angle" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Ptheta as the result of the closed loop control of the pitch angle to reach the Pitch consign from the current Drone pitch and Drone pitch rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Ptheta validity status as follow : IF (Drone pitchis INVALID) OR (Drone pitch rate validity status&amp;nbsp;is INVALID) OR (Pitch consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Ptheta validity status is INVALID ELSE Ptheta validity status is VALID&lt;/p>&#xA;"
                  appliedPropertyValueGroups="#f00378e2-fd17-4a8e-ac18-b58e95102398">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="f00378e2-fd17-4a8e-ac18-b58e95102398" name="DAL level.FDAL"
                    appliedPropertyValueGroups="#905c565a-8b6f-4bcf-b551-a2f2f19f8473">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                      id="c9a526d2-2b65-458f-b59e-82896d88ce02" name="Functionnal Design Assurance Level"
                      appliedPropertyValues="#5f6708b4-43c6-425e-ae40-558daa5c0184"
                      type="#3b11f4b4-27d2-4b6e-a0ab-26a8dd4fa860" value="#ee453306-11e9-41b6-839b-f9da3a8ff016"/>
                </ownedPropertyValueGroups>
