                    sourceElement="#3ca02ed0-f234-4b77-860b-6a79e55cdf2f"/>
                <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                    id="65ecf862-9638-4ef0-b9fa-808a0f0c34fa" targetElement="#4a265be7-184f-435b-9553-d5fa3b9e2b55"
                    sourceElement="#3ca02ed0-f234-4b77-860b-6a79e55cdf2f"/>
              </ownedFeatures>
              <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
                  id="9e5fa438-ad56-47a8-a6f6-68d50c575926" targetElement="#93374bff-b04d-44e4-a885-f4ffe954f0e1"
                  sourceElement="#e7a65176-ba6b-4315-9ab0-7c08305af9cf"/>
            </ownedLogicalComponents>
            <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
                id="51168139-d30c-4d06-a625-e6c7e3e710fb" name="Regulation authorities"
                description="&lt;p align=&quot;JUSTIFY&quot; dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>They publish the regulation documents and authorize the system operations in the context of &amp;quot;specific&amp;quot; or &amp;quot;certified&amp;quot; operations.&lt;/span>&lt;/p>&#xA;"
                actor="true">
              <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
                  id="cffc66c0-f231-4ca4-ac7f-c28c918dee5a" targetElement="#41bf7216-6af1-4bf3-aaaa-6a6a0ae125c2"
                  sourceElement="#51168139-d30c-4d06-a625-e6c7e3e710fb"/>
            </ownedLogicalComponents>
            <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
                id="e8502beb-8527-4a5a-961d-bcd450f66868" name="Manufacturer" description="&lt;p>&lt;span lang=&quot;EN&quot;>Mainly involved during the design and manufacture life phases, the manufacturer can also intervene as a back office all along the lifecycle. &lt;/span>&lt;/p>&#xA;"
                actor="true">
              <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
                  id="09a2c984-ca7a-414b-a4fa-73d7fe042189" targetElement="#acdb5ff1-946a-462b-8ef0-0c3402bd829c"
                  sourceElement="#e8502beb-8527-4a5a-961d-bcd450f66868"/>
            </ownedLogicalComponents>
            <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
                id="c67c75f3-a5d6-4e3d-a480-623e4c16a8b3" name="Aircraft flight crew"
                description="&lt;p align=&quot;JUSTIFY&quot; dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>the flight crew is the ultimate &amp;quot;customer&amp;quot; of the AIDA system, as they will take decisions based upon the results of the inspection. The need for a direct interface between the AIDA system and the flight crew (for example via the pilot notepad) will have to be defined, however this is not seen as a major architecture topic. So far, the flight crew does not intervene directly in the AIDA system operations (&lt;b>to be discussed when establishing the operational scenarios&lt;/b>).&lt;/span>&lt;/p>&#xA;"
                actor="true" human="true">
              <ownedTraces xsi:type="org.polarsys.capella.core.data.capellacommon:TransfoLink"
                  id="ac1c90a2-4198-4967-84df-41f0a1681ed1" targetElement="#f63bcc00-71a7-4db7-b237-51a6ef826e61"
                  sourceElement="#4e191a1f-15ce-4c04-9121-0523e5a9832d"/>
              <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
                  id="4e191a1f-15ce-4c04-9121-0523e5a9832d" targetElement="#9b2fbf5c-c35d-421b-a1d5-c34ba601d19f"
                  sourceElement="#c67c75f3-a5d6-4e3d-a480-623e4c16a8b3"/>
              <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
                  id="e210f787-8a99-4e0e-893c-1d1e5d725583" targetElement="#1e461398-81d8-40c0-b154-f83b488cfc5f"
                  sourceElement="#c67c75f3-a5d6-4e3d-a480-623e4c16a8b3"/>
            </ownedLogicalComponents>
            <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
                id="224551e9-4ad2-4a85-babb-f016eb56e1fc" name="Air Traffic Management and airport Authorities"
                description="&lt;p align=&quot;JUSTIFY&quot; dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>Being a flying object in an airport environment, it is very likely that some kind of communication will be needed between the AIDA system and ATM systems (radio communication between the operator and the control tower, identification within the ATM system, direct orders communicated from the ATM system to AIDA,&amp;hellip;). This will be further studied in the concept of operations.&lt;/span>&lt;/p>&#xA;"
                actor="true">
              <ownedTraces xsi:type="org.polarsys.capella.core.data.capellacommon:TransfoLink"
                  id="9371c371-b788-49f1-9c30-7237f0962569" targetElement="#4c8da369-51ac-4a24-9134-178cab2c196e"
                  sourceElement="#377d49f9-f542-449d-a664-ff51e92f7837"/>
              <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
                  id="377d49f9-f542-449d-a664-ff51e92f7837" targetElement="#196a5bb9-d53e-4d85-a6de-07b6144e1ebd"
                  sourceElement="#224551e9-4ad2-4a85-babb-f016eb56e1fc"/>
              <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
                  id="5f878de5-d74e-46e9-9b09-dafe4e2a07e0" name="CP 1" orientation="IN"
                  kind="FLOW">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="069fad94-9b4b-49b2-aea1-1b65ea92095c" targetElement="#e759e11c-7826-4b83-b1c1-d72bb288cbf7"
                    sourceElement="#5f878de5-d74e-46e9-9b09-dafe4e2a07e0"/>
                <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                    id="ed51ab16-521c-4c9f-82ab-4aed4969204e" targetElement="#0fc40c3a-dcae-4cc6-97f3-3c83173cd853"
                    sourceElement="#5f878de5-d74e-46e9-9b09-dafe4e2a07e0"/>
              </ownedFeatures>
              <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
                  id="9a6caf17-a76a-4fa1-ad3f-77798c3ff75a" targetElement="#bcb9c522-05a0-4d47-b351-9452727f9d69"
                  sourceElement="#224551e9-4ad2-4a85-babb-f016eb56e1fc"/>
            </ownedLogicalComponents>
            <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
                id="a8bb2e35-1fa1-4d3f-b2ee-da204201b7b3" name="Aircraft" description="&lt;p align=&quot;JUSTIFY&quot; dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>this is the aircraft inspected by AIDA. It &amp;quot;provides&amp;quot; visual information to be acquired by the system, and it is also a kind of &amp;quot;obstacle&amp;quot;, as the drone must of course avoid any collision with it.&lt;/span>&lt;/p>&#xA;"
                actor="true">
              <ownedTraces xsi:type="org.polarsys.capella.core.data.capellacommon:TransfoLink"
                  id="6c3b3706-8eb0-4cd9-8bcb-dd093fe4381e" targetElement="#6baa498c-43cf-4191-a178-c2197e9f47ff"
                  sourceElement="#6f62e591-1e14-4a6e-822e-c30ccaff9370"/>
              <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
                  id="6f62e591-1e14-4a6e-822e-c30ccaff9370" targetElement="#7ac3a3d2-d1d5-41ce-9080-c302347b32bd"
                  sourceElement="#a8bb2e35-1fa1-4d3f-b2ee-da204201b7b3"/>
              <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
                  id="ccfda90f-c383-41a7-8dea-436640fcd413" name="CP 1" orientation="OUT"
                  kind="FLOW">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="b25e9247-836d-4a92-a6f5-1b1197e7e850" targetElement="#836447e7-2f30-41e5-8e25-db7208c02bcf"
                    sourceElement="#ccfda90f-c383-41a7-8dea-436640fcd413"/>
              </ownedFeatures>
              <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
                  id="0bb7bf3c-6252-4091-90d9-66aa7936bb7d" targetElement="#466f7e4e-6475-4d9b-82f2-f76e78259268"
                  sourceElement="#a8bb2e35-1fa1-4d3f-b2ee-da204201b7b3"/>
            </ownedLogicalComponents>
            <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
                id="7a289419-3216-4049-a901-1098ec9156a5" name="Obstacles (static, moving on ground or flying)"
                description="&lt;p align=&quot;JUSTIFY&quot; dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>Many foreign objects can be expected in the airport gate environment. Three categories can be identified :&lt;/span>&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>&lt;font face=&quot;Calibri&quot; size=&quot;3&quot;>&lt;font face=&quot;Calibri&quot; size=&quot;3&quot;>&lt;span lang=&quot;FR&quot;>Static objects　: airport buildings, aircraft access gate, lamppost, static vehicules,&amp;hellip;&lt;/span>&lt;/font>&lt;/font>&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>&lt;font face=&quot;Calibri&quot; size=&quot;3&quot;>&lt;font face=&quot;Calibri&quot; size=&quot;3&quot;>&lt;span lang=&quot;FR&quot;>Objects moving on ground　: passengers access ramps and buses, fuel truck, fret and luggage vehicules, food and servicing vehicules, de-icing vehicules, involved (mechanic/ground team, aircraft crew,&amp;hellip;) or uninvolved (passengers,&amp;hellip;) persons, other aircrafts,&amp;hellip;&lt;/span>&lt;/font>&lt;/font>&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>&lt;font face=&quot;Calibri&quot; size=&quot;3&quot;>&lt;font face=&quot;Calibri&quot; size=&quot;3&quot;>&lt;span lang=&quot;FR&quot;>Flying objects　: other drones (although not very developed so far), flying aircrafts (not foreseen in the direct environment of the airport gate),&amp;hellip;&lt;/span>&lt;/font>&lt;/font>&lt;/li>&#xA;&lt;/ul>&#xA;"
                actor="true">
              <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
                  id="7102178e-68b6-4fae-932f-eab22c2d7d9c" targetElement="#700fe553-3fa3-4855-b7a7-a5c3de791a35"
                  sourceElement="#7a289419-3216-4049-a901-1098ec9156a5"/>
            </ownedLogicalComponents>
            <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
                id="8ad0a709-a602-481b-8e52-e2edcd1474ce" name="Drone environment"
                description="&lt;p align=&quot;JUSTIFY&quot; dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>The AIDA system is designed to be used outdoor, and therefore has to sustain possible adverse atmospheric conditions : wind, extreme temperatures, rain, snow and icing, thunderstorm&amp;hellip; . Probable operational limitations will be identified in further states of design.&lt;/span>&lt;/p>&#xA;"
                actor="true">
              <ownedTraces xsi:type="org.polarsys.capella.core.data.capellacommon:TransfoLink"
                  id="9dfcf108-c675-4e60-98e5-2e924dd184b2" targetElement="#5a841efe-50b5-411a-aca3-9795eb3b0ca1"
                  sourceElement="#16bfc7e6-9830-4e85-81f8-a2f8d176b683"/>
              <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
                  id="16bfc7e6-9830-4e85-81f8-a2f8d176b683" targetElement="#c2b4ecf7-6506-44f5-82d9-abcc7ac6e9b0"
                  sourceElement="#8ad0a709-a602-481b-8e52-e2edcd1474ce"/>
              <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
                  id="ff525102-89eb-4c3f-80c4-289fdd745947" targetElement="#b1e82519-d272-4d18-bacd-3832de555c66"
                  sourceElement="#8ad0a709-a602-481b-8e52-e2edcd1474ce"/>
              <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
                  id="de744f98-e68e-49ad-a12b-d4793396637b" name="CP 1" orientation="OUT"
                  kind="FLOW">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="c4bdd793-4380-4555-b97f-63539dcff5f8" targetElement="#4405fb5e-6dff-4378-a0a4-78ede898a77f"
                    sourceElement="#de744f98-e68e-49ad-a12b-d4793396637b"/>
              </ownedFeatures>
              <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
                  id="06a8a92a-6878-405e-ba3e-96702d26e3c0" name="CP 2" orientation="OUT"
