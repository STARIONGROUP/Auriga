                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="b5ae0851-5f3b-419f-87a2-7ae18dddb246" sid="b5ae0851-5f3b-419f-87a2-7ae18dddb246"
                    name="FOP 5"/>
              </ownedFunctions>
