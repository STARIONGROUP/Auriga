      <ownedEntityPkg xsi:type="org.polarsys.capella.core.data.oa:EntityPkg" id="055f35ce-0a4f-4ee6-a6ce-e94b7cc23712"
          name="Operational Entities"/>
    </ownedArchitectures>
    <ownedArchitectures xsi:type="org.polarsys.capella.core.data.ctx:SystemAnalysis"
        id="f255ec05-e6dd-42fe-8bca-1a054e249761" name="System Analysis">
      <ownedFunctionPkg xsi:type="org.polarsys.capella.core.data.ctx:SystemFunctionPkg"
          id="31250295-1afd-4e00-9ee8-bd6fec4ed631" name="System Functions">
        <ownedSystemFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
            id="19c5d12c-2e71-43e7-8274-7fbc219d475e" name="Root System Function">
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
              id="eb3c3d22-129b-487c-852d-11dbf6bbc956" sid="263f3408-eaf8-43f1-8649-77f819b782b2"
              name="[SF6] Manage mission">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="8826c9b5-d9e8-409e-8ad4-683aa8deb8fa" sid="0bc477c0-4abd-415e-a28b-4a94a80f01bc"
                name="[SF6.2] Store data" description="&lt;p>Different types of data : current mission definition, current mission progress/status, current mission acquired data and results, former mission description and results.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The control desk shall store in a local database the following information about the current mission definition, and associated validity status&amp;nbsp;when available&amp;nbsp;: aircraft type, flight plan, flight zone, drone position and time.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall store in a local database the following information about the current mission status, and associated validity status&amp;nbsp;when available&amp;nbsp;: drone position and time, flight plan progress, control mode.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall store in a local database the following information about the current mission results, and associated validity status&amp;nbsp;when available&amp;nbsp;: acquired photos and videos, validated report.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall retrieve from the external database and&amp;nbsp;store in a local database the following information about the current mission status, and associated validity status&amp;nbsp;when available&amp;nbsp;: mission description, former mission results.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="f7d7ae6c-476f-463c-a04e-c11a2ff0e96f" sid="9bf9fbd8-d98e-4d1d-8999-6c73f04ce279"
                  name="FIP 4"/>
            </ownedFunctions>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
              id="2d635279-7ea1-407c-8f25-728210b83471" sid="367aec60-6d0d-4c75-a079-da3abe8d54b4"
              name="[A/C] Stimulate payload video camera">
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="c88aece4-d580-4c0a-adaa-3724dbb2671e" sid="0533cd8d-0eda-4151-8b40-a813382e9a74"
                name="FOP 1"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
              id="efa8df69-6b0b-424f-9678-f5d8aa94e664" sid="8a19701e-f284-4998-be02-e928f328e10d"
              name="[SF4] Control drone navigation" description="&lt;p>Depending on the control mode selected by the pilot, the AIDA system moves to the requested position and visual sight angle :&lt;/p>&#xA;&#xA;&lt;p>- in AUTO mode, it executes the mission previously defined&lt;/p>&#xA;&#xA;&lt;p>- in MANUAL mode, it executes the real-time manual motion commands&lt;/p>&#xA;&#xA;&lt;p>The AIDA system provides mission progress feedback to the operator.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="9763de39-e4ed-4a46-970b-7e9386f80ebb" sid="9c8a3261-df78-4d1e-80d8-a6a370d7339c"
                name="[SF4.2] Run automatic control" description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>This function runs the flight plan : it commands the request drone consigns and control mode, then controls the payload when the position is reached.&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>It report mission progress and monitors that drone remains in flight zone. &lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>If the pilot interrupts the mission, the function switch from flight plan consigns to pilots consigns.&lt;/span>&lt;/p>&#xA;">
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="94a4ff75-0892-4f36-92ab-2b52923c2a17" sid="74987de6-fdd1-4555-84cc-2aea21407686"
                  name="FOP 5"/>
            </ownedFunctions>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
              id="e601a5df-d2ae-4155-8f17-0b70e04ed0ce" sid="be3372e7-9db6-471d-88e4-f4f616ae58f6"
              name="[SF5] Make and record video">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="417f6fd7-6ed4-478d-a183-7f12d8879812" sid="9ff12d46-56e3-4215-bbda-c75328c1f418"
                name="[SF5.1] Select camera control" description="&lt;p>&lt;em>Note : the control mode information is missing. In the requirement below, it is assumed that the &amp;quot;AP engagement&amp;quot; information is available as an input of SF5.1.&lt;/em>&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The video processor shall select the Camera position consign, Photo and video control and File storage format and associated validity statuses as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup span=&quot;5&quot; width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; height=&quot;70&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Manual payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Output value *&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Output status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;96&quot; rowspan=&quot;2&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;96&quot; rowspan=&quot;2&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Manual payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Manual payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;&#xA;&lt;p>* : output&amp;nbsp;corresponds&amp;nbsp;to the set of the following information : Camera position consign, Photo and&amp;nbsp;video control, file storage format, which are contained in Automatic/Manual&amp;nbsp;payload control flows.&amp;nbsp;&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="ba57c055-27d9-4124-9923-66fe3f1cd5a3" sid="55a651af-38a5-4411-91f3-dbe42e243dce"
                  name="FIP 1"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="8680b8e1-3399-4f96-a001-7f45e4847381" sid="e43c1d6d-5398-4456-9c90-070e300656ca"
                  name="FIP 2"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="59aa1be8-835b-4841-abc8-5419063d5ecf" sid="b64b794c-a861-46ae-a035-a6eaa2cd5349"
                  name="FOP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="39d38da7-0f6d-4699-82f7-33b1d98439ff" sid="686639f9-69fa-4cc5-aa6e-a3ad656711e9"
                  name="FOP 2"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="d60701c2-abc2-4f0f-b395-752fa363d624" sid="25b5439a-a360-4598-9d44-5c8f1a236974"
                  name="FOP 3"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="a851e66f-6244-4329-8273-fe77e9e5f80d" sid="0294e6b0-a1c1-4334-9020-d6ddfe74546e"
                name="[SF5.2] Control camera orientation" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The camery rotary support shall set the camera position as follows : IF Camera position consign is VALID then Camera position is set to Camera position consign ELSE Camera position is set to default position.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="f5c6681c-c090-4d00-b7fe-8d49c24da693" sid="5bbc4bcf-65ad-412c-982f-e142792ae9c2"
                  name="FIP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="1612979e-70db-4e9e-a1b1-77abc38526c1" sid="2e92f737-3457-464c-b9be-39f15cb97c3b"
                  name="FOP 1"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="3906bdd3-b60d-4ecb-9ab6-b53ca36f157e" sid="c95e963e-74d5-466d-a847-f290c798cc0a"
                name="[SF5.3] Make photos and videos" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>If Photo and Video control is VALID, the camera sensor behaviour shall take pictures and video as required.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="ef645195-81b2-4ee0-b629-21a30db886ab" sid="e7b2f77d-ca32-473a-9e82-0d0f17ea9812"
                  name="FIP 1"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="6df7aa50-8ac8-4694-a8e3-e0265d01ed63" sid="8d0618b6-91ec-49f6-9add-dd8ff34117db"
                  name="FIP 2"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="469f6241-18c3-4651-ba1b-6bd0e06b59db" sid="92c57c5d-c417-4ac8-b992-459da798597f"
                  name="FIP 3"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="203aa371-7755-45e1-90f0-8ff0f4fdfe7c" sid="453fce61-5b04-40b8-ad2d-2557b690d098"
                  name="FOP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="0d99fe3e-a725-42b9-b291-068289415bba" sid="934049c6-5eec-4bf9-8736-3665051da866"
                  name="FOP 2"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="48b22830-dfea-4854-80bb-3f6c4b1294e9" sid="52a60d29-11ea-4239-942c-6a0c4e49b792"
                name="[SF5.4] Digitise photos and videos" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The Video processor shall digitise photos and videos as follows : IF File storage format is VALID THEN photos and videos are digitised into the required format ELSE photos and videos are digitised into the default format.&lt;/p>&#xA;&#xA;&lt;p>The Video processor shall send the photos and videos files to the control desk.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="4c4cb8c7-e0c1-4df7-8937-80c5917badab" sid="f85ddaa0-0a5f-4864-90ce-c3d3b98f5516"
                  name="FIP 1"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="9c4b03d5-ffef-4d09-93bb-5c2aa9965db8" sid="7fd5f645-d430-4bbb-a95e-44f0048e7710"
                  name="FIP 2"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
