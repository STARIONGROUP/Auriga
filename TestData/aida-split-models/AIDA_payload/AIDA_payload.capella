                    sourceElement="#cff996cc-834c-496e-ab10-131c4650662c"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="08c8abad-aa3c-4b19-a57c-48a24ff9e466" sid="92c57c5d-c417-4ac8-b992-459da798597f"
