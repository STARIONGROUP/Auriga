                  id="cff996cc-834c-496e-ab10-131c4650662c" sid="8d0618b6-91ec-49f6-9add-dd8ff34117db"
                  name="FIP 2">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
