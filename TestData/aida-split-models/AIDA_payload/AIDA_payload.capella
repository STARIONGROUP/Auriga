    <ownedArchitectures xsi:type="org.polarsys.capella.core.data.pa:PhysicalArchitecture"
        id="5f5333e6-d1e0-4ac2-8186-39bc091a41e7" name="Physical Architecture">
      <ownedFunctionPkg xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunctionPkg"
          id="23b32c51-fed5-4a7d-9473-457f11dfaac0" name="Physical Functions">
        <ownedPhysicalFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
            id="460ea897-63bf-4efe-872d-414a905e0bce" name="Root Physical Function">
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="e0ceee27-700a-4a70-a904-4948dc995203" name="[SF6] Manage mission">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="b710951a-55f8-43d9-bc1a-bfeb228e2d69" name="[SF6.2] Store data"
                description="&lt;p>Different types of data : current mission definition, current mission progress/status, current mission acquired data and results, former mission description and results.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The control desk shall store in a local database the following information about the current mission definition, and associated validity status&amp;nbsp;when available&amp;nbsp;: aircraft type, flight plan, flight zone, drone position and time.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall store in a local database the following information about the current mission status, and associated validity status&amp;nbsp;when available&amp;nbsp;: drone position and time, flight plan progress, control mode.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall store in a local database the following information about the current mission results, and associated validity status&amp;nbsp;when available&amp;nbsp;: acquired photos and videos, validated report.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall retrieve from the external database and&amp;nbsp;store in a local database the following information about the current mission status, and associated validity status&amp;nbsp;when available&amp;nbsp;: mission description, former mission results.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="48aa5383-335c-4f9c-a14a-286823a998c8" name="FIP 4">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="4e59862c-aa09-41c3-80ba-0b76c868a31d" targetElement="#f4805c16-1f72-4d07-8265-0b19f2f18778"
                    sourceElement="#48aa5383-335c-4f9c-a14a-286823a998c8"/>
              </inputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="113973e0-a93e-4f79-8ebe-1a58136a2adc" targetElement="#3b069e18-ccc9-4f46-841e-9626a997ee4b"
                  sourceElement="#b710951a-55f8-43d9-bc1a-bfeb228e2d69"/>
            </ownedFunctions>
            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="11822d43-e01a-4073-ad7e-693855dedfa2" targetElement="#58cbc216-c9f5-4b1a-a534-f022df58b465"
                sourceElement="#e0ceee27-700a-4a70-a904-4948dc995203"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="8d0a733b-0ed4-4bff-a40c-c5175e8f69d0" name="[A/C] Stimulate payload video camera">
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="f583b00d-d7c8-4481-8a96-a69245837bbc" name="FOP 1">
              <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                  id="cd12b20f-acc5-4c9b-a5b8-d624e9fade89" targetElement="#fc563c16-03cb-4cec-ad80-811b7f9cb896"
                  sourceElement="#f583b00d-d7c8-4481-8a96-a69245837bbc"/>
            </outputs>
            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="8cd0a0f5-cd79-4e95-94fc-316b1b29caf0" targetElement="#3311dce9-d833-4cbb-95a9-e5bfad960bf3"
                sourceElement="#8d0a733b-0ed4-4bff-a40c-c5175e8f69d0"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="3b0f467a-963b-4b86-8a32-7e27eb3a3308" name="[SF4] Control drone navigation"
              description="&lt;p>Depending on the control mode selected by the pilot, the AIDA system moves to the requested position and visual sight angle :&lt;/p>&#xA;&#xA;&lt;p>- in AUTO mode, it executes the mission previously defined&lt;/p>&#xA;&#xA;&lt;p>- in MANUAL mode, it executes the real-time manual motion commands&lt;/p>&#xA;&#xA;&lt;p>The AIDA system provides mission progress feedback to the operator.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="d5981889-d23c-46d4-b4c5-d9ed18c8a37a" name="[SF4.2] Run automatic control"
                description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>This function runs the flight plan : it commands the request drone consigns and control mode, then controls the payload when the position is reached.&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>It report mission progress and monitors that drone remains in flight zone. &lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>If the pilot interrupts the mission, the function switch from flight plan consigns to pilots consigns.&lt;/span>&lt;/p>&#xA;">
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="521a745e-ca2b-4906-8f42-501eee0a757f" name="FOP 5">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="c698f197-24ed-47c2-ad75-b985385251db" targetElement="#a0af7f94-33f3-4195-892b-8535558f557f"
                    sourceElement="#521a745e-ca2b-4906-8f42-501eee0a757f"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="29e36041-3614-4d2e-b89d-ce926042f2cb" targetElement="#29ae98f8-a0f3-4090-9eea-8e774030197b"
                  sourceElement="#d5981889-d23c-46d4-b4c5-d9ed18c8a37a"/>
            </ownedFunctions>
            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="bb310694-fff1-4880-8988-dd1e326b4dca" targetElement="#1cd39c1c-f688-463e-bba2-d5d2e26e23e3"
                sourceElement="#3b0f467a-963b-4b86-8a32-7e27eb3a3308"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="5a861888-814a-4278-88c1-9567e2e2de3e" name="[SF5] Make and record video">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="6c9b9de3-5b69-4d4f-8251-52a4835c8db6" name="[SF5.1] Select camera control"
                description="&lt;p>&lt;em>Note : the control mode information is missing. In the requirement below, it is assumed that the &amp;quot;AP engagement&amp;quot; information is available as an input of SF5.1.&lt;/em>&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The video processor shall select the Camera position consign, Photo and video control and File storage format and associated validity statuses as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup span=&quot;5&quot; width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; height=&quot;70&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Manual payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Output value *&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Output status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;96&quot; rowspan=&quot;2&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;96&quot; rowspan=&quot;2&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Manual payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Manual payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;&#xA;&lt;p>* : output&amp;nbsp;corresponds&amp;nbsp;to the set of the following information : Camera position consign, Photo and&amp;nbsp;video control, file storage format, which are contained in Automatic/Manual&amp;nbsp;payload control flows.&amp;nbsp;&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="d514ca42-7a3e-4ca8-aa05-a8502e15a69b" name="FIP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="261026e2-5d76-4259-9b07-745d61da07cf" targetElement="#3522191f-d961-46da-a328-08fd30358d48"
                    sourceElement="#d514ca42-7a3e-4ca8-aa05-a8502e15a69b"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="a4b5a7a2-64bd-4576-ae0a-bbb10425a788" name="FIP 2">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="5842878c-1930-43a6-992b-83b322c30294" targetElement="#3efd94ef-ff8d-4ced-bfe4-970aa9211bf6"
                    sourceElement="#a4b5a7a2-64bd-4576-ae0a-bbb10425a788"/>
              </inputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="f7f4ced7-8dd3-4ba1-b02d-86fb7e7977c5" name="FOP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="56358849-a98a-44cd-886b-967949a6933e" targetElement="#7803be0b-7af8-4a82-a0cc-0f29b0131626"
                    sourceElement="#f7f4ced7-8dd3-4ba1-b02d-86fb7e7977c5"/>
              </outputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="bfcf26c0-844d-4c24-940a-3723d84cbfd2" name="FOP 2">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="7134267c-af87-4ae9-bcf6-d68df86dd092" targetElement="#29c33c63-9e53-42b4-bad0-f477c87037c2"
                    sourceElement="#bfcf26c0-844d-4c24-940a-3723d84cbfd2"/>
              </outputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="1a31109f-293f-4b59-be79-8245e9952687" name="FOP 3">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="90d8db3f-44b4-445c-9d3b-cc9f09a556b1" targetElement="#b46522ab-cd02-4b69-84b3-250ea349670e"
                    sourceElement="#1a31109f-293f-4b59-be79-8245e9952687"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="ef2cd3c5-9fcf-483d-bea6-ce4c942252ae" targetElement="#975f98c4-a1e3-4e35-b025-3aa31694485c"
                  sourceElement="#6c9b9de3-5b69-4d4f-8251-52a4835c8db6"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="0062b9e8-c158-4f81-8120-fa4d742ec365" name="[SF5.2] Control camera orientation"
                description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The camery rotary support shall set the camera position as follows : IF Camera position consign is VALID then Camera position is set to Camera position consign ELSE Camera position is set to default position.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="be5b05bd-f387-45d0-8dc9-289467e3e349" name="FIP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="724e9021-3d88-4b37-a8b1-4276a008a977" targetElement="#6b7df70e-8a15-4357-a1ea-84e38ab8a1c6"
                    sourceElement="#be5b05bd-f387-45d0-8dc9-289467e3e349"/>
              </inputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="607536e3-4b7a-4f63-ae4c-0dac6502b760" name="FOP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="f2dbe9be-577a-4ec0-a839-2500ade27a9d" targetElement="#870c81fe-4360-4b11-9ee9-27044a21386d"
                    sourceElement="#607536e3-4b7a-4f63-ae4c-0dac6502b760"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="e08f58fb-f399-45ee-82a9-1db1480e4877" targetElement="#9c51f5fc-53ee-4749-80ca-c03dfa13d4fd"
                  sourceElement="#0062b9e8-c158-4f81-8120-fa4d742ec365"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="add90c8f-642b-46e0-8504-12ede7e84bbe" name="[SF5.3] Make photos and videos"
                description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>If Photo and Video control is VALID, the camera sensor behaviour shall take pictures and video as required.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="8a368047-d1d4-4fc3-a2d3-2f2eee6bbc13" name="FIP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="f6884456-c25c-4a86-b585-f44d8a9a6ad5" targetElement="#48f694c0-58f6-4c1f-b85e-7f067b0eacf6"
                    sourceElement="#8a368047-d1d4-4fc3-a2d3-2f2eee6bbc13"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="ef57b455-304d-415c-b9e3-06b9f4f44452" name="FIP 2">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="49dd0202-b1af-4ea0-a8c9-bc762bd03bbf" targetElement="#cff996cc-834c-496e-ab10-131c4650662c"
                    sourceElement="#ef57b455-304d-415c-b9e3-06b9f4f44452"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="0d6fa897-ac49-4740-975a-e096c7f21845" name="FIP 3">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="e9ea95ec-6083-495f-bfc1-b6a2e5459e84" targetElement="#08c8abad-aa3c-4b19-a57c-48a24ff9e466"
                    sourceElement="#0d6fa897-ac49-4740-975a-e096c7f21845"/>
              </inputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="5b468398-7eff-4050-9455-4ab6573173c9" name="FOP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="935b717a-7d48-4a2e-886a-d3aab724fc87" targetElement="#3591f69d-ea8f-48aa-b90e-4dd64fe6c9de"
                    sourceElement="#5b468398-7eff-4050-9455-4ab6573173c9"/>
              </outputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="daf2f50e-9932-4874-89a2-0aca860f3f7e" name="FOP 2">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="d06fb881-f48b-4cde-9c3c-711a960a5f56" targetElement="#76e0c6a4-fe87-4851-8fc4-85d5208adb79"
                    sourceElement="#daf2f50e-9932-4874-89a2-0aca860f3f7e"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="9ebec839-5e60-40dd-8dc2-58640d20e2d1" targetElement="#b23109f2-897b-4fa1-83e9-620bac47398f"
                  sourceElement="#add90c8f-642b-46e0-8504-12ede7e84bbe"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="204c9d61-2b8b-4665-9f6b-b082346c6a02" name="[SF5.4] Digitise photos and videos"
                description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The Video processor shall digitise photos and videos as follows : IF File storage format is VALID THEN photos and videos are digitised into the required format ELSE photos and videos are digitised into the default format.&lt;/p>&#xA;&#xA;&lt;p>The Video processor shall send the photos and videos files to the control desk.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="e6d2414e-29f2-4b71-8331-ff2c584be4d3" name="FIP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="a9bdf5e2-3150-4e31-b0d3-679095e48c34" targetElement="#45cb31ed-9ce8-4ba2-afa3-32877d19f663"
                    sourceElement="#e6d2414e-29f2-4b71-8331-ff2c584be4d3"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="e0d87b9a-4908-454e-9f95-ee855b4b4ba4" name="FIP 2">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="53a1fd0a-7281-478f-8ff4-1e165bea59fb" targetElement="#d56c3019-5d61-4957-a6dd-b37bcefb3d68"
                    sourceElement="#e0d87b9a-4908-454e-9f95-ee855b4b4ba4"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="73de4d26-8853-4705-a615-de05b05d09f4" name="FIP 3">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="7378edfc-ac8c-4dd8-a0e8-4ad1bd5b7de0" targetElement="#35a2da50-6afc-4ea9-81ce-8fe5ef60a876"
                    sourceElement="#73de4d26-8853-4705-a615-de05b05d09f4"/>
              </inputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="4e7fe719-29a2-4077-a0b9-86d1a7ab3ba6" name="FOP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="be26bda0-a275-4354-99d8-27bb81766d2d" targetElement="#6cf9c76d-b503-4c82-bef1-a59e17d557aa"
                    sourceElement="#4e7fe719-29a2-4077-a0b9-86d1a7ab3ba6"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="db7b518c-d777-42e3-bfb0-c565bdf62d3c" targetElement="#c2d6ae2e-3985-49bf-85f6-413ebb2946ba"
                  sourceElement="#204c9d61-2b8b-4665-9f6b-b082346c6a02"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="1f3f2421-e1e8-41aa-acc5-61ce1da6ef93" name="[SF5.5] Acquire manual payload control"
                description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The camera remote control shall acquire the Manual payload control and provide an associated validity status.&lt;/p>&#xA;&#xA;&lt;p>The camera remote control shall send the Manual payload control and its validity status to the Video processor.&lt;/p>&#xA;">
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="4d7ade63-952a-4783-bbb8-c5e4b115f9db" name="FOP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="c0bc13bc-1d39-4ff2-a926-d293b4eeee99" targetElement="#5d0550d7-0179-4f39-99be-d59669b81f60"
                    sourceElement="#4d7ade63-952a-4783-bbb8-c5e4b115f9db"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="cdd90d0e-6f1b-4278-9ce8-7781a11c9082" targetElement="#658e4f5a-2120-4d0c-8187-3727f45f2fa5"
                  sourceElement="#1f3f2421-e1e8-41aa-acc5-61ce1da6ef93"/>
            </ownedFunctions>
            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="55d6514b-8ed9-4481-902f-13030782f85c" targetElement="#ed96cd10-b637-49ea-b799-ab08ad03e7ed"
                sourceElement="#5a861888-814a-4278-88c1-9567e2e2de3e"/>
