              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="870c81fe-4360-4b11-9ee9-27044a21386d" sid="2e92f737-3457-464c-b9be-39f15cb97c3b"
                  name="FOP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="26739b21-3cdb-4077-aa96-99e46b54b377" targetElement="#1612979e-70db-4e9e-a1b1-77abc38526c1"
                    sourceElement="#870c81fe-4360-4b11-9ee9-27044a21386d"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="d45e34de-aad8-4b93-9a0d-6eba30e4e0a2" targetElement="#a851e66f-6244-4329-8273-fe77e9e5f80d"
                  sourceElement="#9c51f5fc-53ee-4749-80ca-c03dfa13d4fd"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="b23109f2-897b-4fa1-83e9-620bac47398f" sid="c95e963e-74d5-466d-a847-f290c798cc0a"
                name="[SF5.3] Make photos and videos" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>If Photo and Video control is VALID, the camera sensor behaviour shall take pictures and video as required.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="48f694c0-58f6-4c1f-b85e-7f067b0eacf6" sid="e7b2f77d-ca32-473a-9e82-0d0f17ea9812"
