              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="7f4dce62-0555-4e7f-9dae-ad2a1437034a" name="[SF1.1.3] Create thrust and torque at propeller 1"
                  description="&lt;p>This function transforms the rotation mouvement into lift/drag and torque.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The propeller shall transform the Motor i motion into Helix 1 thrust and Helix 1 torque.&lt;/p>&#xA;">
