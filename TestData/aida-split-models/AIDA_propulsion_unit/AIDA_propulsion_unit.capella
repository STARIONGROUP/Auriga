                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="06bb4be4-c907-4e4c-b66e-b0c235842dd5" sid="d4cd4935-f38d-4a46-8232-805f7b3fab71"
                  name="[SF1.1.6] Depower motor 1" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The power distribution system shall compute the Motor i shut down signal as follows : IF Motor 1 disabled is &amp;quot;Requested&amp;quot; THEN Motor i shut down signal is &amp;quot;shut down&amp;quot; ELSE Motor i shut down is &amp;quot;not shut down&amp;quot;.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
