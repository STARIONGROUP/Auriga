                      sourceElement="#193ee698-6393-4bbd-9d20-3904a97fc731"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="86bfd6dc-f02e-43df-84a6-87b295ee835c" sid="ef5a191f-84b5-4979-a4cd-7a8049a4997c"
                    name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="da0461df-7c52-484f-abce-d742e429b4d2" targetElement="#7c00d2c0-20dd-4a75-8fe2-8385f3806f85"
                      sourceElement="#86bfd6dc-f02e-43df-84a6-87b295ee835c"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="91b225fa-24d1-4779-ad13-7857591726aa" sid="f73eb327-340c-4239-9b5d-45dd464a9d87"
                    name="FOP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="3bf64cac-ffbf-4654-9901-1a9459315adb" targetElement="#07aad9be-616a-4618-a8e8-389f5305bf97"
