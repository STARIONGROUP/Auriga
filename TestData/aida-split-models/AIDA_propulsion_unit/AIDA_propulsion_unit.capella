          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="34b454ab-d338-4e5c-bee1-ac5d2857707b" sid="75c5f7e3-f956-4884-a754-61158abf4939"
              name="[SF2] Control drone attitude and position" description="&lt;p>This function computes the engine rotation rate to ensure either (depending on the control mode) :&lt;/p>&#xA;&#xA;&lt;p>- in AP mode : &amp;nbsp;the speed and position demands provided by SF4&lt;/p>&#xA;&#xA;&lt;p>- in manual mode : the attitude and altitude demands provided by the pilot&lt;/p>&#xA;&#xA;&lt;p>(see breakdown for d&amp;eacute;tails)&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="bf98d600-ac0d-420f-913a-0932231aa2d0" sid="a99351ae-d454-4594-9ada-9d6a8b1808d7"
                name="[SF2.5] Compute motor commands" description="&lt;p>This function computes the engines rotation rate demands to generate the various thrust components :&amp;nbsp;total vertical&amp;nbsp;thrust (to control the altitude) and torque generated around the various axis (to control the attitude).&lt;/p>&#xA;&#xA;&lt;p>Ptheta/phi/psi are the forces needed to generate a rotation around the corresponding axis (=Torque X Lever_arm).&lt;/p>&#xA;">
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="91f199eb-5a5c-4ad8-a394-a2d13314defb" sid="084b83ce-a081-4604-8a66-9bb2fb64ed5c"
                  name="FOP 2">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="1f086b51-2abb-4b5c-8a30-3d8083a9db06" targetElement="#52357648-1c96-455e-9b21-2d1aadd3e5de"
                    sourceElement="#91f199eb-5a5c-4ad8-a394-a2d13314defb"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="c0640237-4287-4973-a83e-ba5eaa82efba" targetElement="#058e70dd-57e4-4bab-a039-c112375c0674"
                  sourceElement="#bf98d600-ac0d-420f-913a-0932231aa2d0"/>
