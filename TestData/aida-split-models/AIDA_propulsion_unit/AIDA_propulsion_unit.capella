          <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
              id="73b3fe27-5c86-4744-819c-b8e368b11aa3" sid="add61b1a-63c0-4430-80f4-afccc2fb4b0b"
              name="[SF7] Monitor drone control">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="74fe4d11-c522-4f72-967e-1e6c5ccd1af4" sid="8567a34c-429d-4a84-9211-0f7e377c9e39"
                name="[SF7.3] Monitor drone parameters">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="2679b080-c23a-4290-8b4c-e19ebfbd98f4" sid="5685bc89-6156-428b-a9bc-1e1d2f2318fc"
                  name="FIP 12"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="5326907f-f22b-4643-a294-0dcb852a1411" sid="713b0d63-edcf-48dc-a2df-98c64188b40c"
                  name="FIP 8"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="4aa2b4ad-f85d-43db-bfde-7fabf609c129" sid="cc9cb209-df86-48c4-bea5-89e84516ae49"
                  name="FOP M1D"/>
            </ownedFunctions>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
              id="093ff11a-9dcf-455d-8da1-92c7825e7f31" sid="df53dafa-17f1-4ac2-bc92-1a1034a38b21"
              name="[SF1] Control drone propulsion" description="&lt;p>This function controls the rotation speed of each engine and propeller, based on the speed command received from SF2 (&amp;quot;Motors rate&amp;quot;)&amp;nbsp;and the engine disabling command (&amp;quot;Motor&amp;nbsp;disabled&amp;quot;)&amp;nbsp;received from SF7.Because of the aerodynamical interaction between the propeller and ambiant air, it generates lift and torque at the emplacement of each engine.&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="fc587f3d-621a-42b9-a707-a69d2cb3955b" sid="cd4b4638-23ec-4864-8924-4a3b5c99db04"
                name="[SF1.1] Control propeller 1" description="&lt;p>This function controls the engine 1.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="534ad59c-3ded-427e-93c6-f3391a8b2ca6" sid="382ee3c1-af0c-4438-8da8-f3e62891a61e"
                  name="FIP 2"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="65dca1d7-5141-496d-8a4f-537e23bd1776" sid="3d0c70a2-3117-4c28-9942-17070e2ed6dd"
                  name="FIP 1"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="3712a095-7714-4ec3-bea7-c86cd4b03a0c" sid="322e78f7-9d10-4439-a37b-a28b6581bd47"
                  name="FIP 3"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="7c00d2c0-20dd-4a75-8fe2-8385f3806f85" sid="ef5a191f-84b5-4979-a4cd-7a8049a4997c"
                  name="FOP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="07aad9be-616a-4618-a8e8-389f5305bf97" sid="f73eb327-340c-4239-9b5d-45dd464a9d87"
                  name="FOP 2"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="5d80d694-8bf6-4c37-8262-567e76e2bc92" sid="7a8885fd-699f-4718-9a46-2fe0936072da"
                  name="FOP 1"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="13df3089-5e35-494f-ad61-8dd4e7d0213e" sid="8c3ac23c-7afa-479f-ae98-48c62f65a1d8"
                name="[SF1.5] Reconstitute global thrust and torque">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="595fb2d5-91c1-40ef-8204-3a4fc7f4944a" sid="b2684b74-7792-4723-867a-dec1785b0069"
                  name="FIP H1Th"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="60152906-d445-4752-952e-269dacf51a22" sid="1ffa5d51-b741-40a8-892e-55338aab4ea9"
                  name="FIP H1To"/>
            </ownedFunctions>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="7d5af8b5-677e-4b6e-9c6a-a515cab5571b" sid="774f6abc-b9cd-4f01-a255-0f902ad77e7a"
                name="Propeller 1 thrust" target="#595fb2d5-91c1-40ef-8204-3a4fc7f4944a"
                source="#7c00d2c0-20dd-4a75-8fe2-8385f3806f85"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="c520cfb5-b9db-4d0d-9706-02b2653da080" sid="d0cd61d1-1bbd-4359-94d2-50681e1958cf"
                name="Propeller 1 torque" target="#60152906-d445-4752-952e-269dacf51a22"
                source="#07aad9be-616a-4618-a8e8-389f5305bf97"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
              id="56df4135-4a07-4b13-aa31-e15eb646d933" sid="75c5f7e3-f956-4884-a754-61158abf4939"
              name="[SF2] Control drone attitude and position" description="&lt;p>This function computes the engine rotation rate to ensure either (depending on the control mode) :&lt;/p>&#xA;&#xA;&lt;p>- in AP mode : &amp;nbsp;the speed and position demands provided by SF4&lt;/p>&#xA;&#xA;&lt;p>- in manual mode : the attitude and altitude demands provided by the pilot&lt;/p>&#xA;&#xA;&lt;p>(see breakdown for d&amp;eacute;tails)&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="058e70dd-57e4-4bab-a039-c112375c0674" sid="a99351ae-d454-4594-9ada-9d6a8b1808d7"
                name="[SF2.5] Compute motor commands" description="&lt;p>This function computes the engines rotation rate demands to generate the various thrust components :&amp;nbsp;total vertical&amp;nbsp;thrust (to control the altitude) and torque generated around the various axis (to control the attitude).&lt;/p>&#xA;&#xA;&lt;p>Ptheta/phi/psi are the forces needed to generate a rotation around the corresponding axis (=Torque X Lever_arm).&lt;/p>&#xA;">
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="52357648-1c96-455e-9b21-2d1aadd3e5de" sid="084b83ce-a081-4604-8a66-9bb2fb64ed5c"
                  name="FOP 2"/>
            </ownedFunctions>
          </ownedFunctions>
          <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
              id="85402298-f849-410d-8b32-ac3576256180" targetElement="#5f0bb7b9-d060-4b87-96f6-c9712572888b"
              sourceElement="#ca9f0145-07ee-4a33-9d7c-12383759ed9e"/>
          <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
