                    id="eede4013-eaed-4409-9e0c-fe48b544f18f" name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="06f4bf85-53a1-4eec-911a-8cb8340fa60e" targetElement="#aa7cbfdd-5388-4693-9fee-198a700ee674"
                      sourceElement="#eede4013-eaed-4409-9e0c-fe48b544f18f"/>
                </inputs>
