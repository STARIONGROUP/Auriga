          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="8de43ebd-c668-4ffc-a788-2cbce3e3de76" name="[SF2] Control drone attitude and position"
              description="&lt;p>This function computes the engine rotation rate to ensure either (depending on the control mode) :&lt;/p>&#xA;&#xA;&lt;p>- in AP mode : &amp;nbsp;the speed and position demands provided by SF4&lt;/p>&#xA;&#xA;&lt;p>- in manual mode : the attitude and altitude demands provided by the pilot&lt;/p>&#xA;&#xA;&lt;p>(see breakdown for d&amp;eacute;tails)&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="22c2bf90-4320-434d-b466-3e2ad658e3f1" name="[SF2.5] Compute motor commands"
                description="&lt;p>This function computes the engines rotation rate demands to generate the various thrust components :&amp;nbsp;total vertical&amp;nbsp;thrust (to control the altitude) and torque generated around the various axis (to control the attitude).&lt;/p>&#xA;&#xA;&lt;p>Ptheta/phi/psi are the forces needed to generate a rotation around the corresponding axis (=Torque X Lever_arm).&lt;/p>&#xA;">
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="72ca416b-67a1-4f7b-a6ad-12574232978e" name="FOP 2">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="15cc845e-5609-4279-ae79-69fc9517def1" targetElement="#91f199eb-5a5c-4ad8-a394-a2d13314defb"
                    sourceElement="#72ca416b-67a1-4f7b-a6ad-12574232978e"/>
              </outputs>
