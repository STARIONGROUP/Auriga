          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="97523cea-9a3a-477b-9f72-c1dd66390404" name="[SF1] Control drone propulsion"
              description="&lt;p>This function controls the rotation speed of each engine and propeller, based on the speed command received from SF2 (&amp;quot;Motors rate&amp;quot;)&amp;nbsp;and the engine disabling command (&amp;quot;Motor&amp;nbsp;disabled&amp;quot;)&amp;nbsp;received from SF7.Because of the aerodynamical interaction between the propeller and ambiant air, it generates lift and torque at the emplacement of each engine.&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="64e37427-74de-4203-8bf5-4f97ef2bc317" name="[SF1.1] Control propeller 1"
                description="&lt;p>This function controls the engine 1.&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="c75ba554-5229-4ee5-a44c-2cc38332a48a" name="[SF1.1.1] Control motor 1"
                  description="&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="d51361e1-d0df-4440-bb9a-f2878d7ab50b" name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="4a822961-d2ff-4b3c-b4c8-17e8eea2ae2c" targetElement="#760c4f15-858a-4357-b2a4-eadc84c50c07"
                      sourceElement="#d51361e1-d0df-4440-bb9a-f2878d7ab50b"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="7762ee9c-fdca-46f2-a046-aed6c5f7b6cf" name="FIP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="cdfe0622-9944-4060-ba1b-4b23686cbd62" targetElement="#826dfce8-c3b0-413b-a899-06612cbf2a98"
                      sourceElement="#7762ee9c-fdca-46f2-a046-aed6c5f7b6cf"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="74cebc6a-c602-46c8-9595-c77fdda25a27" name="FIP 3">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="66aa4dd5-095c-4d36-8b27-809ce0dff301" targetElement="#030d646a-7563-46ec-bbb1-36678f924fb6"
                      sourceElement="#74cebc6a-c602-46c8-9595-c77fdda25a27"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="8a15597f-0cbf-4820-90c7-6de640764e5b" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="448f8fd4-5b28-4c77-a705-3bcc7c2daa11" targetElement="#93a9a0a6-e013-4d6e-93f1-77cc177f63db"
                      sourceElement="#8a15597f-0cbf-4820-90c7-6de640764e5b"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="31ad5c38-0018-4f38-8f70-6275fc77bcc2" targetElement="#2934c411-d9d5-4623-baa4-064512e841ed"
                    sourceElement="#c75ba554-5229-4ee5-a44c-2cc38332a48a"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="d58ce68f-286d-4aca-8acd-30193e6f36be" name="[SF1.1.2] Create motion 1"
                  description="&lt;p>This function transform the Motor i control consign into rotation mouvement. If the motor is disabled (&amp;quot;Motor i shut down = TRUE&amp;quot;), the engine does not rotate.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The motor and variator i shall generate the Motor i motion as follows : IF (Motor i shut down = &amp;quot;shut down commanded&amp;quot;) or (Motor i control consign validity status is INVALID) THEN Motor i motion is &amp;quot;no motion&amp;quot; ELSE Motor i motion = f(Motor i control signal)&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="f37194d9-0646-48ae-94cf-c6f963e561f2" name="FIP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="209f1bf9-1932-487c-aa91-5b65947eb8b8" targetElement="#6273de99-1306-40e0-802f-1c11ef30199c"
                      sourceElement="#f37194d9-0646-48ae-94cf-c6f963e561f2"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="b625ec4e-e3fc-4568-aa2c-60abb1e96b4d" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="72931002-f0dd-46ac-bc85-a3abdf4fa54c" targetElement="#5e393fd8-7d36-41d2-bd9b-5d8f80b8eed9"
                      sourceElement="#b625ec4e-e3fc-4568-aa2c-60abb1e96b4d"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="f6cc5373-5a9d-437b-a0dc-556d611b6fd2" name="FOP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="cf056a3e-9509-4122-9430-6c31e02cd4a5" targetElement="#2fa7d93b-205a-46a5-89ce-1a0d38dca58a"
                      sourceElement="#f6cc5373-5a9d-437b-a0dc-556d611b6fd2"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="0401f0da-0921-4530-a09a-6d0772f75b82" targetElement="#1a39d238-cf22-4cb9-b77b-ebd755a7c44b"
