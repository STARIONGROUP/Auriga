                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="e174b918-c766-4a44-bc81-19706a7bb3ab" targetElement="#86bfd6dc-f02e-43df-84a6-87b295ee835c"
