          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="82a409cc-de5a-4500-9f2c-31df5ecf31f3" sid="df53dafa-17f1-4ac2-bc92-1a1034a38b21"
              name="[SF1] Control drone propulsion" description="&lt;p>This function controls the rotation speed of each engine and propeller, based on the speed command received from SF2 (&amp;quot;Motors rate&amp;quot;)&amp;nbsp;and the engine disabling command (&amp;quot;Motor&amp;nbsp;disabled&amp;quot;)&amp;nbsp;received from SF7.Because of the aerodynamical interaction between the propeller and ambiant air, it generates lift and torque at the emplacement of each engine.&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="71734d42-9932-4e87-8808-acd3768e1e52" sid="cd4b4638-23ec-4864-8924-4a3b5c99db04"
                name="[SF1.1] Control propeller 1" description="&lt;p>This function controls the engine 1.&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="2934c411-d9d5-4623-baa4-064512e841ed" sid="3ae73397-7ab1-46e6-88de-bd3aeb9515b3"
                  name="[SF1.1.1] Control motor 1" description="&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="760c4f15-858a-4357-b2a4-eadc84c50c07" sid="8cc98ce5-c678-4ee9-9a69-d1e55e9e546d"
                    name="FIP 1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="826dfce8-c3b0-413b-a899-06612cbf2a98" sid="ceee2807-ceed-4cf8-b61c-fce252a4398e"
                    name="FIP 2"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="030d646a-7563-46ec-bbb1-36678f924fb6" sid="322e78f7-9d10-4439-a37b-a28b6581bd47"
                    name="FIP 3">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="e040c565-0229-4fa3-8319-43e2775d18de" targetElement="#3712a095-7714-4ec3-bea7-c86cd4b03a0c"
                      sourceElement="#030d646a-7563-46ec-bbb1-36678f924fb6"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="93a9a0a6-e013-4d6e-93f1-77cc177f63db" sid="a24daeda-d41e-426f-abe5-23ca5fa03091"
                    name="FOP 1"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="1a39d238-cf22-4cb9-b77b-ebd755a7c44b" sid="20d72c81-f1e1-482b-8465-4b2aa67f42f3"
                  name="[SF1.1.2] Create motion 1" description="&lt;p>This function transform the Motor i control consign into rotation mouvement. If the motor is disabled (&amp;quot;Motor i shut down = TRUE&amp;quot;), the engine does not rotate.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The motor and variator i shall generate the Motor i motion as follows : IF (Motor i shut down = &amp;quot;shut down commanded&amp;quot;) or (Motor i control consign validity status is INVALID) THEN Motor i motion is &amp;quot;no motion&amp;quot; ELSE Motor i motion = f(Motor i control signal)&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="6273de99-1306-40e0-802f-1c11ef30199c" sid="1188d16a-3084-4935-9c8d-2475d7d570a1"
                    name="FIP 2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="5e393fd8-7d36-41d2-bd9b-5d8f80b8eed9" sid="41d43b74-17da-49f7-94d4-ed6889fa8974"
                    name="FOP 1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="2fa7d93b-205a-46a5-89ce-1a0d38dca58a" sid="c48f5934-ff91-483e-b9ba-7df60db584fb"
                    name="FOP 2"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="65dc6a43-c52a-498b-894e-9a41e8541be0" sid="ac9a89d2-caff-407c-9f29-efa9b221cba0"
                  name="[SF1.1.3] Create thrust and torque at propeller 1" description="&lt;p>This function transforms the rotation mouvement into lift/drag and torque.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The propeller shall transform the Motor i motion into Helix 1 thrust and Helix 1 torque.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="aa7cbfdd-5388-4693-9fee-198a700ee674" sid="56da906e-45b7-4967-8eb8-b063ad3e80c4"
                    name="FIP 1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="193ee698-6393-4bbd-9d20-3904a97fc731" sid="382ee3c1-af0c-4438-8da8-f3e62891a61e"
                    name="FIP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
