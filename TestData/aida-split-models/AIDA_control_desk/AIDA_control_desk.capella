              </outputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="c9401df8-34ce-49c6-9767-6baa3b2f5537" sid="329f12e2-b26e-4bb3-9029-a82296b50c86"
