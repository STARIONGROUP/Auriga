                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="7cade717-f55a-4e7f-bbb5-f7f9ef45fde8" sid="cc98e22e-f58a-4e5e-9589-79ac9d69b4d7"
