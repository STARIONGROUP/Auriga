                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="95ec89ff-036a-410a-ad82-5df479d7333d" targetElement="#db4b684d-bc21-432f-818e-dba036cdc33b"
                    sourceElement="#ad91d37f-743f-452d-a7fc-2f15594c492d"/>
