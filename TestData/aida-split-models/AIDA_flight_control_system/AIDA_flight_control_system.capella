                      sourceElement="#ac5f8a57-69f4-429b-ba5f-c687fad2f0f3"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="b8786ae8-8ae8-444f-9ee1-2e1b16a2e3df" sid="c541fb7f-272a-447c-9a6c-f5e11610fe58"
                    name="FIP 7">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="cd3d9ed4-09ae-414f-ad71-d0499b6e43cd" targetElement="#2cf580ff-eb9c-486e-8db5-74db892a54dc"
