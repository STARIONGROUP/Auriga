                  name="FIP Roll"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="05bb1bef-e56b-4b9b-ba0d-43496d1752e7" sid="75db1d27-d0e4-435a-a69c-70b04e111e0a"
                  name="FIP Pitch"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="6dc51d47-18bd-4df7-a949-307215c0df43" sid="b6bbfe80-b407-4bcd-8708-bd4dbf5f7ff4"
                  name="FIP Alt"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="2a36febd-996f-4917-906f-b26729efd567" sid="76712516-d72e-4db8-b9b9-039c37bb24c2"
                  name="FIP Eng"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="7eefab78-1ad2-4125-8810-14f8fc03fb15" sid="21469201-11bb-4858-82f2-eb7c536293bf"
                  name="FIP T AP"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="90863ba0-5268-49b9-ba0a-7b637313335a" sid="d551297a-b9d2-4d6f-9cf7-384184de2647"
                  name="FOP T"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="df068524-9067-4a7e-8190-f6920e3f7582" sid="a99351ae-d454-4594-9ada-9d6a8b1808d7"
                name="[SF2.5] Compute motor commands" description="&lt;p>This function computes the engines rotation rate demands to generate the various thrust components :&amp;nbsp;total vertical&amp;nbsp;thrust (to control the altitude) and torque generated around the various axis (to control the attitude).&lt;/p>&#xA;&#xA;&lt;p>Ptheta/phi/psi are the forces needed to generate a rotation around the corresponding axis (=Torque X Lever_arm).&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="5b011609-8210-4b62-a1ea-30ea9396b9ca" sid="c943e445-c272-4446-9d10-820ca59ec981"
                  name="FIP Pphi"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="ffbd8cc8-19af-4330-bfd5-6276a9f4c0a4" sid="c3555e6d-cff7-4aa0-b439-40647ce0d21d"
                  name="FIP Ppsi"/>
