            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="929595e7-3d14-4bb2-8bdd-2708acacd0fe" name="[SF2.2] Acquire pilot orders"
                description="&lt;p>This function acquires the following pilots orders : manuel override, vertical speed, pitch demand, roll demand, yaw rate demand.&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="d73bc5b0-728b-449a-840f-77c3b886b0be" name="[SF2.2.1] Acquire pitch order"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote Pitch order and send it to the Drone as the Pitch consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="7e50aa18-7e14-419a-b1e8-3a1d0fd378eb" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="9e0ac111-e37f-45b0-a577-d1a1af71e081" targetElement="#79878e1d-3b52-4795-8dd0-0a9f38f6ff97"
                      sourceElement="#7e50aa18-7e14-419a-b1e8-3a1d0fd378eb"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="aaad4f84-6b95-40f1-8d20-74c30aa54410" targetElement="#d6cbf4eb-eebd-43b2-a561-03cd67d1cf10"
                    sourceElement="#d73bc5b0-728b-449a-840f-77c3b886b0be"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="78d0dfc8-95c5-48b3-8af2-6dea038efe64" name="[SF2.2.2] Acquire roll order"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Roll order and send it to the Drone as the&amp;nbsp;Roll consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="f3271e32-8e7e-406c-b85e-46386074458e" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="295ee0e0-b452-4d48-a985-48a5698e60c6" targetElement="#fdb384cd-6c61-435b-b24b-ab1e72eead29"
                      sourceElement="#f3271e32-8e7e-406c-b85e-46386074458e"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="1b0f83d2-bd10-49ac-8b8d-d5127008dd48" targetElement="#46e55fd4-0176-4f8c-8560-761ef32b0bc6"
                    sourceElement="#78d0dfc8-95c5-48b3-8af2-6dea038efe64"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="06ec8199-63bc-4898-b3aa-c2680f6390c8" name="[SF2.2.3] Acquire yaw rate order"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Yaw rate order and send it to the Drone as the&amp;nbsp;Yaw rate consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="2e919700-69f3-482b-89ac-785d2c0d402d" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="8096c538-9c40-46a8-97f5-709960fae465" targetElement="#8f6948f8-7b5d-4530-917f-09ccca118246"
                      sourceElement="#2e919700-69f3-482b-89ac-785d2c0d402d"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="abb04842-290c-40c9-90a3-e5e2941baa8f" targetElement="#b2fa4f0c-a4dc-4540-8f27-67e8b4df163c"
                    sourceElement="#06ec8199-63bc-4898-b3aa-c2680f6390c8"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="080395df-7bfb-4d67-aab4-4cafe60a677d" name="[SF2.2.4] Acquire vertical speed order"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Altitude order and send it to the Drone as the&amp;nbsp;Altitude consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="7382dbc2-0a36-498a-85b6-559cb245eb64" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="01944594-424a-475e-bcda-ceb19da5582f" targetElement="#a639bb84-e3f2-43b0-88d8-b22984185ceb"
                      sourceElement="#7382dbc2-0a36-498a-85b6-559cb245eb64"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="108bdaa6-e99a-4c4f-8caf-ed55817c2c4c" targetElement="#2dacc486-85c1-4acd-b2ad-db42c7fd9b9b"
                    sourceElement="#080395df-7bfb-4d67-aab4-4cafe60a677d"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="9c31fe94-9110-466f-babe-95d74daa78ba" name="[SF2.2.5] Acquire manual override order"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Manual override&amp;nbsp;order and send it to the Drone as the&amp;nbsp;Manuel override, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="8aa7167f-7c3a-4fa1-bd06-503ef403ffcd" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="82c29587-c9c0-460c-9bca-9d3db0e58199" targetElement="#9668c773-5581-4823-8267-08bdd5fd52d7"
                      sourceElement="#8aa7167f-7c3a-4fa1-bd06-503ef403ffcd"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="e99ec523-9936-4260-906f-5bee4f2fc38f" targetElement="#75d9ec2e-f03c-4f05-ad4d-5a2c594ec202"
                    sourceElement="#9c31fe94-9110-466f-babe-95d74daa78ba"/>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="c08b1c6c-bb51-4d84-b28a-b879bbb7aa56" targetElement="#dcc3ca66-4091-4d46-8f86-31f7d7a50281"
                  sourceElement="#929595e7-3d14-4bb2-8bdd-2708acacd0fe"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="f539ed30-7129-40db-ba7b-2bc96c5bf7e8" name="[SF2.3] Control attitude"
                description="&lt;p>This function realises the closed-loop control of the drone attitude :&lt;/p>&#xA;&#xA;&lt;p>- first, the adequate attitude demand is selected (SF2.3.2), depending on AP engagement value :&amp;nbsp;IF AP engagement = &amp;quot;engaged&amp;quot;, THEN the Attitude AP values are selected ELSE the pilot consign are selected (Yaw rate demand is integrated to compute the yaw demand : SF2.3.1)&lt;/p>&#xA;&#xA;&lt;p>- then, SF2.3.3, SF2.3.4 and SF2.3.5 realise the closed-loop control of each angle (respectively pitch, roll, yaw) : they compute the requested forces related to each angle to achieve the requested positions, using the attitude position and speed measurements from SF3. Two typical control structure (see dedicated presentation)&amp;nbsp;: either a multi-variable PID loop&amp;nbsp;on both position and speed, or two imbricated PI loops on position and speed.&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="d46c55ee-72ed-46a8-93a6-61d8ad9cf0f9" name="[SF2.3.1] Compute yaw consign"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Yaw consign as th integration of the Yaw rate consign.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Yaw consign validity status as the Yaw rate consign validity status.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="f288fa74-fde0-4753-8008-b90e82b0de81" name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="b0846157-537b-42bf-b23b-04311e7afc74" targetElement="#92f343ac-527f-4890-aa10-ae907fb09785"
                      sourceElement="#f288fa74-fde0-4753-8008-b90e82b0de81"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="02feca8e-a301-4045-b337-df38462ddc4c" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="f0219277-bd79-44bd-bc75-ac6dda0b88aa" targetElement="#ac6e2bcb-03e5-42ef-a7c1-2b317da83146"
                      sourceElement="#02feca8e-a301-4045-b337-df38462ddc4c"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="d1dcac52-3c11-4693-8046-4f68c41db472" targetElement="#ecc19a0a-0ec5-402c-8e91-08a96f5234c5"
                    sourceElement="#d46c55ee-72ed-46a8-93a6-61d8ad9cf0f9"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="ad91d37f-743f-452d-a7fc-2f15594c492d" name="[SF2.3.2] Select attitude consign"
                  description="&lt;p>REQ&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall select the&amp;nbsp;Pitch&amp;nbsp;consign as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup width=&quot;204&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;207&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup span=&quot;2&quot; width=&quot;245&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Pitch&amp;nbsp;consign Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Attitude AP consigns Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Selected Pitch consign&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Validity status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Attitude AP consigns (pitch)&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Attitude AP consigns (pitch)&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Pitch consign&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Pitch&amp;nbsp;consign&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;&#xA;&lt;p>- The main processor shall select the&amp;nbsp;Roll consign as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup width=&quot;204&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;207&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup span=&quot;2&quot; width=&quot;245&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Roll consign Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Attitude AP consigns Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Selected Roll consign&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Validity status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Attitude AP consigns (roll)&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Attitude AP consigns (roll)&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Roll&amp;nbsp;consign&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Roll&amp;nbsp;consign&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;&#xA;&lt;p>- The main processor shall select the&amp;nbsp;Yaw consign as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup width=&quot;204&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;207&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup span=&quot;2&quot; width=&quot;245&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Yaw&amp;nbsp;consign Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Attitude AP consigns Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Selected Yaw consign&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Validity status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Attitude AP consigns (Yaw)&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Attitude AP consigns (Yaw)&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Yaw consign&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Yaw&amp;nbsp;consign&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="b19aebb2-f315-4101-bdc6-a9fc89bfe411" name="FIP AP cons">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="35fcd9a4-4964-43af-ba4f-3dd3b6dfe371" targetElement="#81948cb1-f1d2-41fa-bcfa-5b9b46bfbca3"
