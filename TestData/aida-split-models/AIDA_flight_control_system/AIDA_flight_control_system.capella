                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="4a6fa7d0-220e-4289-9a1b-cdf4161f3f59" sid="f6a6c6e1-3bc8-4f6a-99de-cc71c1ab0eaf"
                    name="FOP 1"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="f856f556-554e-4e27-9434-cf9fbe41d505" targetElement="#19d9d5bf-2b0d-44dc-ad30-07fd99a40ef6"
                    sourceElement="#85e9514b-c20c-4dd7-a78f-90fc959b75b0"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="72614b60-5e0b-4c8e-80d3-4f874f150553" sid="ef59e24b-b7f8-4e1b-9f8b-ecc196742ce2"
                  name="[SF7.3.2] Compare drone altitude" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compare altitude and altitude MON.&lt;/p>&#xA;&#xA;&lt;p>The monitoring shall compare vertical speed and vertical speed MON.&lt;/p>&#xA;&#xA;&lt;p>The monitoring shall compare ground altitude and ground altitude MON.&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall detect an altitude measurement failure as follows : IF (drone altitude is INVALID) OR (vertical speed is INVALID) OR (ground speed is INVALID) OR&amp;nbsp;(drone attitude MON is INVALID) OR (vertical speed MON is INVALID) OR (ground altitude is INVALID) OR&amp;nbsp;(an atitude discrepancy is&amp;nbsp;detected) OR (a&amp;nbsp;vertical speed&amp;nbsp;discrepancy is detected) OR (a ground altitude discrepancy is detected) THEN altitude measurement failure&amp;nbsp;= FAILURE DETECTED ELSE altitude measurement = NO FAILURE.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="d6462df2-4321-4c2d-8e1f-be3c9d7f4581" sid="73ad8098-5a4d-4419-a797-fd3d2a23c49f"
                    name="FIP 3">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="d9bbd29c-f400-4e07-8cfa-c1ef47c4ed5a" targetElement="#01972666-9263-48c3-aa48-1fa8b3a06390"
                      sourceElement="#d6462df2-4321-4c2d-8e1f-be3c9d7f4581"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="6a68d20c-76eb-4447-9f7d-95e8ea16123c" sid="435a30c9-05d5-45c9-a387-69f4abcb4508"
                    name="FIP 4">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="fd8f3826-0a80-4749-9db9-3ba2553b3282" targetElement="#0f8cbaaa-f98b-49c9-a316-b17d2426134e"
                      sourceElement="#6a68d20c-76eb-4447-9f7d-95e8ea16123c"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="ae4d9342-99bc-49ed-8327-84f0e0550990" sid="b4b37a07-0eaf-4639-a9b4-a21b0550adbd"
                    name="FOP 1"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="e0c982d3-953c-4060-b2ec-c7492b2d81d5" targetElement="#19d9d5bf-2b0d-44dc-ad30-07fd99a40ef6"
                    sourceElement="#72614b60-5e0b-4c8e-80d3-4f874f150553"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="63635767-fe0b-4f17-b7fa-c090ac3fda92" sid="a6613fa5-a7b1-4ec9-8be3-dffadc1b7c0c"
                  name="[SF7.3.3] Compare drone motor commands" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>For each motor, the monitoring processor shall compare Motor rate and Motor rate MON.&lt;/p>&#xA;&#xA;&lt;p>For each motor, the monitoring processor shall detect a motor consign failure as follows : IF (Motor rate is INVALID) OR (Motor rate MON is INVALID) OR (a motor rate discrepancy is detected) THEN Motor consign failure = FAILURE DETECTED ELSE Motor consign failure = NO FAILURE.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c483afab-bfd8-486c-9de5-a54a258574ae" sid="0303f7ce-1144-4a96-a001-afe9ebed0279"
                    name="FIP 3">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
