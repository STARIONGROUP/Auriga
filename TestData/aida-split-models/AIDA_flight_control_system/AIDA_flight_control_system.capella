                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="af9d82ae-0ea3-4d4e-8ebf-06267c21fe57" targetElement="#0068658c-aeec-41f9-b419-9f3d191fec9e"
                    sourceElement="#8d82e7cb-fb87-4d87-b99c-a48916dfd3b4"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="da49d77b-0072-4426-9ec7-6610838aef4c" sid="455a0207-7218-4f8d-bc32-005339749f68"
                  name="[SF4.3.2] Passivate engagement oscillation" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall detect oscillations of Selected control mode.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute AP engagement as follows : IF (Selected control mode = MANUAL) OR (Selected control mode oscillations detected) THEN AP engagement = MANUAL ELSE AP engagement = AUTO.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Flight plan interruption as follows : IF (Selected control mode = MANUAL) OR (Selected control mode oscillations detected) THEN Flight plan interruption =&amp;nbsp;INTERRUPTED ELSE Flight plan interruption =&amp;nbsp;NOT INTERRUPTED.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="02065a3f-1b5e-47e0-a0d1-93fa37b59e6c" sid="6d77293e-7049-422a-9021-a1b2aa7ff0a2"
                    name="FIP 1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="362dfd7d-272a-4840-90b0-dee225898290" sid="72118957-5a6c-4f4a-a305-b98dbdf34803"
                    name="FOP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="fab1e51d-e18e-4b92-bb3f-6361f135e9f5" targetElement="#a6c50e1b-2448-4f7e-adda-c2c6941d5fc5"
                      sourceElement="#362dfd7d-272a-4840-90b0-dee225898290"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="5712f34e-a884-42f4-b1b3-ece4d7f1f931" sid="c07d78a2-afd5-402a-9e98-13a5b82a85b5"
                    name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="1cfda7a9-db63-4467-91ad-01cc8cea946c" targetElement="#f60f1304-1232-4276-bd95-17fc5535f343"
                      sourceElement="#5712f34e-a884-42f4-b1b3-ece4d7f1f931"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="cc6019fa-a590-467d-a628-4089b2a21114" targetElement="#0068658c-aeec-41f9-b419-9f3d191fec9e"
                    sourceElement="#da49d77b-0072-4426-9ec7-6610838aef4c"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="9cce8f59-ea6b-4ef9-8b97-5c2c7faa85a5" sid="844b806b-e469-49a1-934b-5772cb5802fa"
                  name="[SF4.3.3] Indicate control mode" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the control mode for display as follows : IF AP engagement = MANUAL THEN control mode for display = manual mode ELSE control mode for display = Selected AP mode.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="16aa9d91-d707-4b47-9b36-250ea4879458" sid="b99564ea-0f3d-4c8b-bc8a-aa254e345746"
                    name="FIP 1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="1ceb3f93-faad-4dde-acae-c0d5a07e439b" sid="1e69a5f0-2699-4d11-8cf0-d2b80260ec4b"
                    name="FIP 2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="d5cb01c0-2578-4077-b06e-1cd0d7b46b4c" sid="6e1e5704-e014-4a0a-80a4-58ca15dde934"
                    name="FOP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="cdebe433-41db-49b4-8ee6-f89546a5c43f" targetElement="#485bcfc3-de26-4c17-908d-859ad142f1dc"
                      sourceElement="#d5cb01c0-2578-4077-b06e-1cd0d7b46b4c"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="78c51e8b-0b93-45a0-b2d7-ec84fc32df52" targetElement="#0068658c-aeec-41f9-b419-9f3d191fec9e"
                    sourceElement="#9cce8f59-ea6b-4ef9-8b97-5c2c7faa85a5"/>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="f54356ae-1daa-4654-a308-bc5b15e14542" targetElement="#0068658c-aeec-41f9-b419-9f3d191fec9e"
