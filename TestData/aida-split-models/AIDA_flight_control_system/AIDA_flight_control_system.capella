            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="8375c452-e2b4-4ca2-9ba7-cc5a9c0fecd0" name="[SF2.5] Compute motor commands"
                description="&lt;p>This function computes the engines rotation rate demands to generate the various thrust components :&amp;nbsp;total vertical&amp;nbsp;thrust (to control the altitude) and torque generated around the various axis (to control the attitude).&lt;/p>&#xA;&#xA;&lt;p>Ptheta/phi/psi are the forces needed to generate a rotation around the corresponding axis (=Torque X Lever_arm).&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="2ff68fb3-5e39-4e58-baa1-161a5a7213df" name="[SF2.5.1] Compute motors expected thrust"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the thrust required from each propeller P1, P2, P3, P4 with the following formulas :&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>1&lt;/font>&lt;/sub> = Thrust + P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>2&lt;/font>&lt;/sub> = Thrust - P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>3&lt;/font>&lt;/sub> = Thrust- P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>4&lt;/font>&lt;/sub> = Thrust + P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the P1, P2, P3, P4 validity statuses as follows : IF (Thrust is INVALID) OR (PTheta is INVALID) OR (Pphi is INVALID) OR (Ppsi is INVALID) THEN P1, P2, P3, P4 are INVALID ELSE P1, P2, P3, P4 are VALID.&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&amp;nbsp;&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="a104d776-4fc2-46eb-8d5a-9e4e6bf5729c" name="FIP Pt">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="a0458a9e-6119-4984-949e-ec15869177a8" targetElement="#42d0cd43-5e66-4d33-a590-3ed0ad817f70"
                      sourceElement="#a104d776-4fc2-46eb-8d5a-9e4e6bf5729c"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="0341cd17-4c42-4d1a-8640-4a09a68c052d" name="FIP Pphi">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="f02f8678-ba05-442c-b574-70d37f7dddad" targetElement="#843573b4-5b7a-47a1-b03a-c19f8761a815"
                      sourceElement="#0341cd17-4c42-4d1a-8640-4a09a68c052d"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="457be596-4218-4db9-9930-d9b7bfb24596" name="FIP Ppsi">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="f7988fa8-7712-4ccf-bc75-672e53d5ff31" targetElement="#290a2893-6599-4015-9149-a4e468d0a756"
                      sourceElement="#457be596-4218-4db9-9930-d9b7bfb24596"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="26d18fe1-2604-45bd-95d9-94065a96fede" name="FIP T">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="c11a6c29-c833-4310-a3bb-ec044828fbd7" targetElement="#ae52fadf-6a8e-4510-a9cf-4b0565d5ad6e"
                      sourceElement="#26d18fe1-2604-45bd-95d9-94065a96fede"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="07f7ac75-4f10-434b-a367-436288ed0b76" name="FOP P1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="ecf62f3f-fd20-4dbe-aae8-d1b6f2fd6c67" targetElement="#1061080b-49bb-45d5-9b1d-b2adfe56c7b8"
                      sourceElement="#07f7ac75-4f10-434b-a367-436288ed0b76"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="012eb647-de93-46e8-8764-3aa7ce1c7d2d" name="FOP P2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="0a8f6ff3-9e50-4a3f-97d1-fa8621ee11ad" targetElement="#88240ede-5683-432e-a858-eac21c6da321"
                      sourceElement="#012eb647-de93-46e8-8764-3aa7ce1c7d2d"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="ca9a56e0-b827-4984-be2b-960c6b07209a" name="FOP P3">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="b40a53e1-78e0-4b20-8c45-91c6130f5c5b" targetElement="#768e8ce7-4958-4c3e-9d79-fa02ddd42bc5"
                      sourceElement="#ca9a56e0-b827-4984-be2b-960c6b07209a"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="9328ac92-a155-46df-9a04-66d8c6a902f2" name="FOP P4">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="3959a791-d8b6-47fd-bf9b-06a9b25b40fe" targetElement="#aad98ebb-585d-4b11-bdc0-1768db6f1bcc"
                      sourceElement="#9328ac92-a155-46df-9a04-66d8c6a902f2"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="f7487c72-2e87-4013-8c28-bcecb7fdaa9b" targetElement="#a23af858-33c0-4f7f-b4be-a4689bd3f69c"
                    sourceElement="#2ff68fb3-5e39-4e58-baa1-161a5a7213df"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="705262a8-c96e-4b15-8544-2243d7d6983e" name="[SF2.5.2] Compute motors speed command"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the Motor 1,2,3,4 rotation rate for each propeller from the expected thrust as follows (Cprop_i being the propeller coefficient of the propeller i):&lt;/p>&#xA;&#xA;&lt;p>Motor i rotation rate = square_root(Pi/Cprop_i) (i=1,2,3,4)&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the Motor 1,2,3,4 rotation rate validity status as follows : IF Pi is INVALID THEN Motor i rotation rate is INVALID ELSE Motor i rotation rate is valid (i=1,2,3,4).&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c926cea1-189a-4492-b4df-08406d310919" name="FIP P1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="de45da6b-ea20-41f0-97c1-55c01350a9b9" targetElement="#8a07ca84-6377-420a-82a7-0d0b26bcfe45"
                      sourceElement="#c926cea1-189a-4492-b4df-08406d310919"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="fce65faa-df71-46c7-b6c0-053bd0de06d1" name="FIP P2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="9075c740-ee68-4a43-8c46-3e2330aa71ad" targetElement="#60f7b6d9-ba67-4ba0-ae16-32f852c5b63c"
                      sourceElement="#fce65faa-df71-46c7-b6c0-053bd0de06d1"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="6af8af31-8cc8-4a55-8292-0588432d66a8" name="FIP P3">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="b12dcaa9-d228-4527-822c-a23b5a058b88" targetElement="#7a5599ee-db6b-4112-a42c-064aa1031ba4"
                      sourceElement="#6af8af31-8cc8-4a55-8292-0588432d66a8"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="020f25ca-c0d3-4e8f-b375-23db480a0d07" name="FIP P4">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="605bb715-2ad4-4b0e-b4c3-759da8dd9502" targetElement="#87fedeec-3de6-4ee7-bc3a-a59406f1a185"
                      sourceElement="#020f25ca-c0d3-4e8f-b375-23db480a0d07"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="54acb16f-a729-4a5b-bff8-ccad4cd0c307" name="FOP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="ae29a0b9-118e-45aa-a298-24fd00a10f2b" targetElement="#235cb64b-a76c-448a-9e01-336e80fe4054"
                      sourceElement="#54acb16f-a729-4a5b-bff8-ccad4cd0c307"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="fc40b263-994e-42ab-a644-9d29cb7e578e" name="FOP 3">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="7f98af87-b703-4b45-b182-1c3ce4f45f89" targetElement="#4c9e67ac-4c8f-447e-b30a-daf0688ffc87"
                      sourceElement="#fc40b263-994e-42ab-a644-9d29cb7e578e"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="9ee2849d-74c3-45fe-b394-130cf1b972cc" name="FOP 4">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="b14178ac-44bf-451c-a360-aadd2289e703" targetElement="#ae9a8d9c-be11-4f40-943f-c23a9038cca0"
