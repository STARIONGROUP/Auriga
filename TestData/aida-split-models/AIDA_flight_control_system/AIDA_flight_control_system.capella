                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="cb8b1c26-0ec4-4d55-a719-3ef40d174d5c" name="FOP T">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="a24fe86d-53b0-4786-8c60-c040f7248eed" targetElement="#69e55d80-c244-4606-85a4-2bc9033e5525"
                      sourceElement="#cb8b1c26-0ec4-4d55-a719-3ef40d174d5c"/>
