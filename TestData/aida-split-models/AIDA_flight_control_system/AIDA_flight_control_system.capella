                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="c6c1363c-4220-474d-b0ec-0b90c1f616b9" targetElement="#b66d3238-d024-4427-a3d1-5d4fc1237377"
                    sourceElement="#d82ab197-d5fb-4a58-b70f-718b4ec94f50"/>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="cf3cb705-72ec-4b4c-b924-1928fee6a886" targetElement="#e5017d03-647c-4b07-972d-e01fc1e2145e"
                  sourceElement="#409ffc69-0b05-47d8-9deb-76122eba4ba8"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="42dfd671-95bc-4890-b9b4-9531110bbc03" name="Altitude consign"
                  target="#02c58102-d729-4f31-96c7-9c61242f1b74" source="#55073973-9f6f-46be-94ec-836c90847879">
                <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                    id="c2dd82f4-18c2-4297-9168-8b7e6eed6981" targetElement="#7f25a872-31ff-4883-9685-7f86ae0c8827"
                    sourceElement="#42dfd671-95bc-4890-b9b4-9531110bbc03"/>
