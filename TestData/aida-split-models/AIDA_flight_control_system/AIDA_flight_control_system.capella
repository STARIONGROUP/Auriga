                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The pressure sensor shall measure the ambient static pressure and provide an associated validity status.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="5c770add-2c82-4507-b0e8-299ef57065d2" name="FIP 1">
