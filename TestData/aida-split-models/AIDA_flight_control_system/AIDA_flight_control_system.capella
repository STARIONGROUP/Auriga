                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="fdddc804-acb8-4ca5-a841-3ff9b497ff95" targetElement="#2419e740-e4fb-448e-886c-3f16f038f0f8"
                    sourceElement="#596c48f4-6299-482f-8b14-ac88563fd020"/>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="58b82bc2-91cb-4983-980f-4b108af0d5fd" targetElement="#2419e740-e4fb-448e-886c-3f16f038f0f8"
                  sourceElement="#06614c57-ad88-4f75-87a1-8ecec4fbdbe4"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="2a15dc1b-c5d5-4e77-ac59-2fe872f0d489" sid="463c6213-55c4-4d99-a4f9-0b7ee12d5265"
                  name="Speed consign" target="#8690eeda-944c-4f02-ae9a-710ab4bcf657"
                  source="#486331fa-287f-476a-86ba-64f02f31c5db"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="c50c5328-9ace-4971-a469-55d6dedce495" sid="db2e57bb-f5fb-40e3-a884-76db57c8ebcd"
