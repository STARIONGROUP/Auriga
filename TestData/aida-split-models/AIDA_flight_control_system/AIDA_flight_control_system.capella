          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="d6cd1a5c-b413-4d16-ba0c-a469c1d697f7" sid="40de6da2-7c73-4f86-93d6-e70724e98c63"
              name="[SF3] Provide drone navigation data">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="1e0786b1-e19c-41b1-8ff4-cac99de06349" sid="5e797bb9-32b5-44a6-9556-06fc843c9756"
                name="[SF3.1] Measure physical values" description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;FR&quot;>les attitudes sont estim&amp;eacute;es &amp;agrave; partir des mesures gyro. Les biais des gyro roulis et tangage sont estim&amp;eacute;s gr&amp;acirc;ce &amp;agrave; la comparaison avec la mesure de la gravit&amp;eacute; effectu&amp;eacute;e par les acc&amp;eacute;l&amp;eacute;rom&amp;egrave;tres (fen&amp;ecirc;tre temporelle d&amp;rsquo;environ 30s, en l&amp;rsquo;absence de commande d&amp;rsquo;attitude). &lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;FR&quot;>Le biais gyro en lacet est estim&amp;eacute;e gr&amp;acirc;ce au magn&amp;eacute;tom&amp;egrave;tre (hypoth&amp;egrave;se Terre plate . Direction du nord magn&amp;eacute;tique fixe pendant la mission)&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>&lt;span lang=&quot;FR&quot;>Note : confirm that pitch and roll consigns are used only to detect the absence of attitude command and trigger the gyroscop bias estimation (only during init phase on ground ?)&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&amp;nbsp;&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="365edda7-6d17-4b8a-87d1-1a86945d7bed" sid="202656ee-7a9c-4aef-976c-2cbc756b8698"
                  name="[SF3.1.1] Measure drone acceleration" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The inertial reference sensors shall measure the&amp;nbsp;linear acceleration along X, Y and Z axis, and provide an associated&amp;nbsp;validity status.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="797e45a9-a8eb-42c4-9160-77a49b04d397" sid="ad59ee0b-d099-48d0-9475-c88d5207a2df"
                    name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="25567487-c6c1-4aee-96e2-50da18a5ebda" targetElement="#e7d1c586-7be3-410f-928d-f67e9408bdc0"
                      sourceElement="#797e45a9-a8eb-42c4-9160-77a49b04d397"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="f2bb1793-b6a7-466e-9322-0f1a747ee506" sid="feb87bdb-3a26-4b21-a8f1-7e1d503dcbdb"
                    name="FOP 1"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="58fc9bab-682b-4c70-ad49-090577549d36" targetElement="#b7e186c9-cf1e-4708-ac28-a29522041957"
                    sourceElement="#365edda7-6d17-4b8a-87d1-1a86945d7bed"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="48ec883f-06e1-4d0b-90a3-b6b831527c7f" sid="894f9589-3baa-46b1-bd22-ea4c2c7e6667"
                  name="[SF3.1.2] Measure drone rate" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The inertial reference sensors shall measure the angular rate along X, Y and Z axis, and provide an associated&amp;nbsp;validity status.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="0aac1780-1f4c-4a3d-8eb8-0c95c0b81847" sid="68a9f6e5-ea53-4dd9-b0ec-d97a21e9fe97"
