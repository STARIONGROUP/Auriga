              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="94cac03d-bb69-439a-ab8d-60428122a8cf" name="[SF7.3.3] Compare drone motor commands"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>For each motor, the monitoring processor shall compare Motor rate and Motor rate MON.&lt;/p>&#xA;&#xA;&lt;p>For each motor, the monitoring processor shall detect a motor consign failure as follows : IF (Motor rate is INVALID) OR (Motor rate MON is INVALID) OR (a motor rate discrepancy is detected) THEN Motor consign failure = FAILURE DETECTED ELSE Motor consign failure = NO FAILURE.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="912c88ae-7518-4126-9c77-e8b41331a296" name="FIP 3">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
