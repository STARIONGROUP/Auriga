                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="b61d05f6-fdf8-44cf-81df-5774ca893cdd" sid="9e7459b6-2068-44e5-9778-c52ab7f4b550"
                    name="FIP Yawcons"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="3a0bb6c3-3f0a-4513-a25b-65e4e109fc94" sid="86c6098e-1269-40b3-987f-65d78b060bbd"
                    name="FOP P">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="92aa9a8b-3c38-490a-948e-ece6e7a88cda" targetElement="#db6baceb-4520-41b9-8984-d42679f241c8"
                      sourceElement="#3a0bb6c3-3f0a-4513-a25b-65e4e109fc94"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="fc8e9ac2-377b-4f3c-899d-686f1418fd31" sid="40d44593-8d21-489d-93b6-80d8d30fd555"
                    name="FOP R">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="de8c9710-1bc3-4e99-8dc9-4d94c49421cb" targetElement="#7646c36f-8580-4692-ad60-b7e0d824da15"
                      sourceElement="#fc8e9ac2-377b-4f3c-899d-686f1418fd31"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="2f04d451-c314-4984-a6d6-d7bad48a8899" sid="1c6dc6d6-cb98-4ea4-873e-e556b4ed0d34"
                    name="FOP Y"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="299600f0-b609-4db3-a479-ce2848bd0e00" targetElement="#70c4320a-9a24-4b90-af19-d383a89e73ce"
                    sourceElement="#db4b684d-bc21-432f-818e-dba036cdc33b"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="5fd20af2-35ce-4662-9eac-7bd8a4dfd1f2" sid="668b4793-4673-4115-b1ca-d302cd3e313c"
                  name="[SF2.3.3] Control pitch angle" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Ptheta as the result of the closed loop control of the pitch angle to reach the Pitch consign from the current Drone pitch and Drone pitch rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Ptheta validity status as follow : IF (Drone pitchis INVALID) OR (Drone pitch rate validity status&amp;nbsp;is INVALID) OR (Pitch consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Ptheta validity status is INVALID ELSE Ptheta validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="db18a96e-5b08-4843-bdb1-5d857a202713" sid="73b2f756-05bd-4c16-85e8-3929667d9485"
                    name="FIP PC"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="216a62ae-7c36-431c-8124-94896ecaab64" sid="a7696de0-e51b-4eb7-ac21-0dd7a02bbebd"
                    name="FIP DP">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="b22a6cd9-803c-46b6-a200-2ee9f95fe1f0" targetElement="#3d73b0e1-64e8-480c-9128-407a4c13dc9a"
                      sourceElement="#216a62ae-7c36-431c-8124-94896ecaab64"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="af2a951f-1c3b-4eff-9f86-a14a75d5feee" sid="1ec60335-222f-4b15-80a5-c9037e42545c"
                    name="FIP DPR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="eac4c7ba-0e6a-4d86-a841-bf5ee8f4d234" targetElement="#464cf419-58ba-437b-80a1-3488b05ffc01"
                      sourceElement="#af2a951f-1c3b-4eff-9f86-a14a75d5feee"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="590e22c9-15c6-467e-8697-0a43fe36a96f" sid="d6d89294-e63d-41c9-babf-3cc3a1522438"
                    name="FOP Pt">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="2a5924d6-801c-4d18-a07b-266f3b82aa6b" targetElement="#05fd1f4b-1792-49a9-a355-fd0c94fc7ab0"
                      sourceElement="#590e22c9-15c6-467e-8697-0a43fe36a96f"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="300f124c-c367-4995-8c9d-9b5526589afd" targetElement="#70c4320a-9a24-4b90-af19-d383a89e73ce"
                    sourceElement="#5fd20af2-35ce-4662-9eac-7bd8a4dfd1f2"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="4194cfb4-552b-42f5-b0e4-35c183eaba3b" sid="dc634c14-17ef-40d8-b040-de2dfe9fce10"
                  name="[SF2.3.4] Control roll angle" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Pphi as the result of the closed loop control of the rollangle to reach the Roll consign from the current Drone roll and Drone roll rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Pphi validity status as follow : IF (Drone roll is INVALID) OR (Drone roll rate validity status&amp;nbsp;is INVALID) OR (Roll consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Pphi validity status is INVALID ELSE Pphi validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="ad2b02da-4170-4518-8279-ee977ecfb4b1" sid="6b20556f-ce67-4489-a0df-6d7ea757aabd"
                    name="FIP RC"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="512a9377-3096-4776-af56-1e9956c69c61" sid="9ac1e775-04d5-44fb-9db4-43c752f04c02"
                    name="FIP DR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="a31d070c-544e-4bd7-8b00-af3400e7d588" targetElement="#28e73f28-c805-45b7-bcd8-836ca9e9b213"
                      sourceElement="#512a9377-3096-4776-af56-1e9956c69c61"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="a7520dcc-4def-4663-ac94-ec0c936f81a4" sid="a45741ea-4caa-428e-b703-eca3457488f8"
                    name="FIP DRR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="753243c5-d398-4449-9b74-810f3092a6e5" targetElement="#685a5dc1-ac95-4e5e-85da-06e45892bdd4"
                      sourceElement="#a7520dcc-4def-4663-ac94-ec0c936f81a4"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="9899f828-be9f-4363-a18f-2d62203d0350" sid="3453be3b-b6ef-4a1d-bc5d-56768ef9caf2"
                    name="FOP Pphi">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="3a35d2ef-d2cf-4980-bffb-c2fafff0a82a" targetElement="#7b895c3d-699f-4e89-8858-289464a8b8f0"
                      sourceElement="#9899f828-be9f-4363-a18f-2d62203d0350"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="189e5554-7119-4158-8000-c7cca019501c" targetElement="#70c4320a-9a24-4b90-af19-d383a89e73ce"
                    sourceElement="#4194cfb4-552b-42f5-b0e4-35c183eaba3b"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="3b3abc74-153a-4073-82c1-0f77dbc0b226" sid="af9dcf0b-124f-4a67-9457-44147c69f468"
                  name="[SF2.3.5] Control yaw angle" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Ppsi as the result of the closed loop control of the yaw angle to reach the Yaw consign from the current Drone yaw and Drone yaw rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Ppsi validity status as follow : IF (Drone yaw is INVALID) OR (Drone yaw rate validity status&amp;nbsp;is INVALID) OR (Yaw consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Ppsi validity status is INVALID ELSE Ppsi validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="9e88f335-ce23-4721-a242-7e687f15b400" sid="975c6ad9-6371-4387-b371-40105b73ae10"
                    name="FIP YC"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="96571da6-1bdf-465d-86bc-e356059c995b" sid="c4c09e1a-dec3-4e80-bc6b-d8001b0353c1"
                    name="FIP DY">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="d43b8aa3-b933-4d58-826f-bf7581095753" targetElement="#c376d61a-7e7e-4950-a4a2-35a7f05efafe"
                      sourceElement="#96571da6-1bdf-465d-86bc-e356059c995b"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="339d9684-31f5-4eae-8be0-4ca780830426" sid="3aafc5ce-29f7-4d3b-8112-f263dad48ff1"
                    name="FIP DYR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="987b6301-25b9-4dd1-b160-1fce3203ec44" targetElement="#164e164e-3e97-45d7-b7bb-c9d5e750a8ef"
                      sourceElement="#339d9684-31f5-4eae-8be0-4ca780830426"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="6750e545-1c87-4ff8-aff8-86467872bab7" sid="b430e36e-0dd3-4ea9-9a81-d8de482fe200"
                    name="FOP Ppsi">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="b2e9ff1f-f270-4095-9620-fb72b6937645" targetElement="#5c513b7f-fc20-4a50-bbca-d8e659bd6750"
                      sourceElement="#6750e545-1c87-4ff8-aff8-86467872bab7"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="c9bbc286-2181-4e2e-b675-c138ba31562d" targetElement="#70c4320a-9a24-4b90-af19-d383a89e73ce"
                    sourceElement="#3b3abc74-153a-4073-82c1-0f77dbc0b226"/>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="728ea788-a790-4f4d-b7e5-1f0c73a4a3a3" targetElement="#70c4320a-9a24-4b90-af19-d383a89e73ce"
                  sourceElement="#84ca5383-65af-4abc-821e-5c6765c2b844"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="42842273-9d61-45e7-91b1-39d28597cfe0" sid="7cb5a784-9099-4225-9c95-17fbc14ffc45"
                  name="Yaw consign" target="#b61d05f6-fdf8-44cf-81df-5774ca893cdd"
                  source="#ac6e2bcb-03e5-42ef-a7c1-2b317da83146"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="894fedee-f541-4e9b-a2d0-9c66c1c43d38" sid="ed8f1731-eae4-47e0-9bbe-0d94b8eb2535"
                  name="Pitch consign" target="#db18a96e-5b08-4843-bdb1-5d857a202713"
                  source="#3a0bb6c3-3f0a-4513-a25b-65e4e109fc94"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="0d28f717-652a-4621-a52e-b0041ac3a165" sid="8b548238-1c7f-46be-8940-cd12be0eccc9"
                  name="Roll consign" target="#ad2b02da-4170-4518-8279-ee977ecfb4b1"
                  source="#fc8e9ac2-377b-4f3c-899d-686f1418fd31"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="7c2fed99-aaec-41d6-9899-46e249f03bb4" sid="87386598-10f1-4da6-8d15-edaea0ab0b88"
                  name="Yaw consign" target="#9e88f335-ce23-4721-a242-7e687f15b400"
                  source="#2f04d451-c314-4984-a6d6-d7bad48a8899"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="e5017d03-647c-4b07-972d-e01fc1e2145e" sid="b7e0ca10-5698-4cf6-a0cf-94994d78cc82"
                name="[SF2.4] Control altitude" description="&lt;p>This function computes the requested total thrust :&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;- in manual mode : to ensure the vertical speed demand provided by the pilot&lt;/p>&#xA;&#xA;&lt;p>- in AP mode, the total thrust demand is already computed by SF2.1&lt;/p>&#xA;&#xA;&lt;p>The final thrust demand is then selected according to the current control mode.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="030f593d-2b64-4e30-92ca-a61f88d162ce" sid="a455ce49-0054-4bbf-ac80-f3f759444ed2"
                  name="[SF2.4.1] Compute altitude consign" description="&lt;p>This function integrates the vertical speed demand to compute an altitude demand.&lt;/p>&#xA;&#xA;&lt;p>Note : the integration operation probably also requires the measure of the current altitude.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the&amp;nbsp;Altitude consign as th integration of the Vertical speed consign.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Altitude consign validity status as the Altitude rate consign validity status.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c5cfdd44-c9ce-406a-99b1-8e374bacaacc" sid="cd7d10aa-056e-464b-bde1-f95a32eef3f4"
                    name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="ec349960-01d2-469c-858d-78839014be7b" targetElement="#1e20ecc1-4f19-4474-9992-a29ad49107cd"
                      sourceElement="#c5cfdd44-c9ce-406a-99b1-8e374bacaacc"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="586c8ad6-49dc-4a83-8c7e-cc086cb074b7" sid="8e620e63-07d1-4cdd-b1bd-4d7ed2cff9c7"
                    name="FOP 1"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="1c322242-c1b1-49c5-9ced-f2bca2c895ee" targetElement="#ac63c351-97f8-483b-b8cf-a8ba1063a306"
                    sourceElement="#030f593d-2b64-4e30-92ca-a61f88d162ce"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="3fd1fba4-b30f-43ba-b724-a54f87bd4151" sid="3a2f7b89-a884-4a86-85e1-97d0c9c02078"
                  name="[SF2.4.2] Compute total thrust" description="&lt;p>This function realised the closed loop control on altitude, it computes the thrust demand to achieve the requested altitude.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Tmanual as the result of the closed loop control of the&amp;nbsp;altitude to reach the Altitude consign from the current altitude measurement and Drone pitch&amp;nbsp;and&amp;nbsp;roll&amp;nbsp;measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Tmanual validity status as follow : IF (Drone pitch is INVALID) OR (Drone&amp;nbsp;roll validity status&amp;nbsp;is INVALID) OR (Altitude consign validity status&amp;nbsp;is INVALID)&amp;nbsp;OR (Altitude validity status&amp;nbsp;is INVALID)THEN&amp;nbsp;Tmanual validity status is INVALID ELSE&amp;nbsp;Tmanual validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="623b0980-0e4b-416b-8e5c-ebd360affbde" sid="e248a904-fb22-4c6b-9aec-d75205078c15"
                    name="FIP Alt Cons"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="dfaa9d00-ff61-4d8c-980e-7ca175af179f" sid="b6bbfe80-b407-4bcd-8708-bd4dbf5f7ff4"
                    name="FIP Alt">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="b3bb8275-b3b7-483f-9dc5-05579aaa9c97" targetElement="#6dc51d47-18bd-4df7-a949-307215c0df43"
                      sourceElement="#dfaa9d00-ff61-4d8c-980e-7ca175af179f"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="08335532-e648-407c-a84c-12573d63cd16" sid="75db1d27-d0e4-435a-a69c-70b04e111e0a"
                    name="FIP Pitch">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="aef00e5e-f0f7-44a9-a5bf-7117d28d651b" targetElement="#05bb1bef-e56b-4b9b-ba0d-43496d1752e7"
                      sourceElement="#08335532-e648-407c-a84c-12573d63cd16"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="b796e883-61a9-4009-a621-e3f641f5df39" sid="7d54b263-ff1b-4f85-92be-61143f433d17"
                    name="FIP Roll">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="602c0502-b846-488b-a0e4-8c43cf212bef" targetElement="#9c717118-d32f-4c45-94e1-ebb2ff094560"
                      sourceElement="#b796e883-61a9-4009-a621-e3f641f5df39"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="8cb5340e-3fd9-40fb-8c2e-9e7621120dd1" sid="25be096a-127a-463b-9b95-6d0a2cbf67f8"
                    name="FOP T"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="f6c08236-919c-44e2-b320-801096f7a726" targetElement="#ac63c351-97f8-483b-b8cf-a8ba1063a306"
                    sourceElement="#3fd1fba4-b30f-43ba-b724-a54f87bd4151"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="b66d3238-d024-4427-a3d1-5d4fc1237377" sid="3b2e3a74-6e95-47ac-b8f0-0438e561da86"
                  name="[SF2.4.3] Select total thrust consign" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall select the&amp;nbsp;Total Thrust consign as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup width=&quot;204&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;207&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup span=&quot;2&quot; width=&quot;245&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Tmanual Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Thrust AP Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Selected Thrust&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Validity status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Thrust AP&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Thrust AP&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Tmanual&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Tmanual&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;">
