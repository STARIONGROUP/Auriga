            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="409ffc69-0b05-47d8-9deb-76122eba4ba8" name="[SF2.4] Control altitude"
                description="&lt;p>This function computes the requested total thrust :&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;- in manual mode : to ensure the vertical speed demand provided by the pilot&lt;/p>&#xA;&#xA;&lt;p>- in AP mode, the total thrust demand is already computed by SF2.1&lt;/p>&#xA;&#xA;&lt;p>The final thrust demand is then selected according to the current control mode.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="a0259e8f-acce-4dc7-99d2-aaaded26997c" name="[SF2.4.1] Compute altitude consign"
                  description="&lt;p>This function integrates the vertical speed demand to compute an altitude demand.&lt;/p>&#xA;&#xA;&lt;p>Note : the integration operation probably also requires the measure of the current altitude.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the&amp;nbsp;Altitude consign as th integration of the Vertical speed consign.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Altitude consign validity status as the Altitude rate consign validity status.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="53c2e5f6-9a11-4038-abec-fdab86c2c3ca" name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="bada9e42-6490-42b0-a0d5-6e7e41ae9cc8" targetElement="#c5cfdd44-c9ce-406a-99b1-8e374bacaacc"
                      sourceElement="#53c2e5f6-9a11-4038-abec-fdab86c2c3ca"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="55073973-9f6f-46be-94ec-836c90847879" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="41f0e687-8bb0-4f3d-bc26-c245e600e362" targetElement="#586c8ad6-49dc-4a83-8c7e-cc086cb074b7"
                      sourceElement="#55073973-9f6f-46be-94ec-836c90847879"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="bedc5d23-2fc2-43d6-836d-c76b2f24ae6c" targetElement="#030f593d-2b64-4e30-92ca-a61f88d162ce"
                    sourceElement="#a0259e8f-acce-4dc7-99d2-aaaded26997c"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="ea1b42a5-cf9e-412e-aab7-b6d3736a818f" name="[SF2.4.2] Compute total thrust"
                  description="&lt;p>This function realised the closed loop control on altitude, it computes the thrust demand to achieve the requested altitude.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Tmanual as the result of the closed loop control of the&amp;nbsp;altitude to reach the Altitude consign from the current altitude measurement and Drone pitch&amp;nbsp;and&amp;nbsp;roll&amp;nbsp;measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Tmanual validity status as follow : IF (Drone pitch is INVALID) OR (Drone&amp;nbsp;roll validity status&amp;nbsp;is INVALID) OR (Altitude consign validity status&amp;nbsp;is INVALID)&amp;nbsp;OR (Altitude validity status&amp;nbsp;is INVALID)THEN&amp;nbsp;Tmanual validity status is INVALID ELSE&amp;nbsp;Tmanual validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="02c58102-d729-4f31-96c7-9c61242f1b74" name="FIP Alt Cons">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="f449ece1-7ec4-485d-b9dd-49c1f3d389d9" targetElement="#623b0980-0e4b-416b-8e5c-ebd360affbde"
                      sourceElement="#02c58102-d729-4f31-96c7-9c61242f1b74"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="521923b2-2d44-4c96-b2a3-47771ff4073f" name="FIP Alt">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="ff15fd22-693b-4672-9657-79e096951694" targetElement="#dfaa9d00-ff61-4d8c-980e-7ca175af179f"
                      sourceElement="#521923b2-2d44-4c96-b2a3-47771ff4073f"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="a2b1fd14-5af0-49da-8478-4e72758c55a6" name="FIP Pitch">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="2e7e0c2c-9367-4fe3-82f6-efa6257535de" targetElement="#08335532-e648-407c-a84c-12573d63cd16"
                      sourceElement="#a2b1fd14-5af0-49da-8478-4e72758c55a6"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="7ed599b5-026d-4cd8-bd80-169d5fe6054e" name="FIP Roll">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="04d2ab2a-cb9c-4264-963c-7798594a64c5" targetElement="#b796e883-61a9-4009-a621-e3f641f5df39"
                      sourceElement="#7ed599b5-026d-4cd8-bd80-169d5fe6054e"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
