                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="ce10f8bb-4f8d-4b18-af59-74f9dea157f5" sid="4e41ab19-7e6f-497c-81c0-16908bd2324e"
                    name="FIP 10">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="9a49f85e-0f04-4e7a-87b4-ebc5645d7aca" targetElement="#ca7280e5-d15f-4bd4-b834-5ef3c985cf98"
                      sourceElement="#ce10f8bb-4f8d-4b18-af59-74f9dea157f5"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="ed4a6632-9017-4c28-bbd3-d34c1f85d140" sid="48b62516-bae2-4323-9f21-ad10b560e226"
                    name="FIP 11">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="c36357a6-e604-4bc8-9a0b-edeaf5403a8e" targetElement="#0d7260bc-a23f-47d4-9f64-6c443ecf96c0"
