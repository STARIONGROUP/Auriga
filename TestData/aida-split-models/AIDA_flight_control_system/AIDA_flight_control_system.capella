              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="aca8421f-05d3-46d5-8882-d551ce7b18c9" sid="3bd712b7-5965-474e-b227-6826f467e30d"
                  name="Selected control mode" description="&lt;p>This flow has three possible values :&lt;/p>&#xA;&#xA;&lt;p>- Flight plan mode&lt;/p>&#xA;&#xA;&lt;p>- Speed consign mode&lt;/p>&#xA;&#xA;&lt;p>-Manual mode&lt;/p>&#xA;"
                  target="#02065a3f-1b5e-47e0-a0d1-93fa37b59e6c" source="#23fbdea1-0fb9-4a04-b27a-9c23aecfc08b"/>
