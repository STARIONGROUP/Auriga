                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="23fbdea1-0fb9-4a04-b27a-9c23aecfc08b" sid="297be11d-dbda-40f7-8e80-6392b36a449d"
                    name="FOP 2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="c64e770a-35b9-4854-b2b9-e1cc98bd5763" sid="2fc88329-15cb-4505-9a0c-566fb1e0c45e"
                    name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="973e1b2c-eb47-4dc4-93cc-aed072246004" targetElement="#0d1e1494-3fce-4c00-af54-4efb1bc7655d"
                      sourceElement="#c64e770a-35b9-4854-b2b9-e1cc98bd5763"/>
