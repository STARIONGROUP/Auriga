                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="e96b784e-fefd-46af-9b6e-57db11f2ce7b" targetElement="#3b3abc74-153a-4073-82c1-0f77dbc0b226"
                    sourceElement="#9e6bd7dd-95b3-4783-b93c-22d5d1a8ded4"/>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="bf550c4c-1938-4dba-91a2-2e9497381395" targetElement="#84ca5383-65af-4abc-821e-5c6765c2b844"
