                    id="aa726a98-714d-44ce-b0a4-6f344c9b3859" sid="08226e73-cd2b-431f-9a92-3e24d3cc41ea"
                    name="FOP Pphi"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="aab49386-aa8e-4a5c-acb2-0264fb94e19f" targetElement="#e2f2d4b4-7598-48d7-965e-5b9b09a8edce"
                    sourceElement="#09291af2-a742-44ea-b7e8-cfb8e8db21d9"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="2805776d-c066-4299-b391-e78fe804de92" sid="f3f0560c-2571-4b3d-b251-06de0f44abd3"
                  name="[SF7.2.6] Control yaw angle MON" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute Ppsi as the result of the closed loop control of the yaw angle to reach the Yaw consign from the current Drone yaw and Drone yaw rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute the Ppsi validity status as follow : IF (Drone yaw is INVALID) OR (Drone yaw rate validity status&amp;nbsp;is INVALID) OR (Yaw consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Ppsi validity status is INVALID ELSE Ppsi validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="38bf0917-f458-40ed-beb3-9072ac412643" sid="f1501c09-0cde-4b0d-b69e-3514b568acb9"
                    name="FIP YC"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="73a0d4bf-4565-437a-b786-79b4d775b360" sid="162391d9-b7a0-4625-8a53-1481951b78cf"
                    name="FIP DY">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="cc6e6de7-1ea6-4f07-99b2-6f24b2aa02e3" targetElement="#c9a1ab9f-0799-44e7-8a9d-3ccee54aeb88"
                      sourceElement="#73a0d4bf-4565-437a-b786-79b4d775b360"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="826af186-2970-43d1-a827-6afbf434b6a9" sid="7d4a7629-22f5-4bcb-b30c-1eeed8b3f11f"
                    name="FIP DYR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="7f1b55e3-f728-462c-81a1-eeffbb7a25fa" targetElement="#1c356ada-55a1-4d1b-b097-7f97a3de973b"
                      sourceElement="#826af186-2970-43d1-a827-6afbf434b6a9"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="de71e148-f9ee-4da1-a8a9-8d1a617088f6" sid="d3dcefca-77d3-4b65-8aaf-f25a19d3ccc1"
                    name="FOP Ppsi"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="525975b8-85f3-4a86-a7b8-1235ee616bde" targetElement="#e2f2d4b4-7598-48d7-965e-5b9b09a8edce"
                    sourceElement="#2805776d-c066-4299-b391-e78fe804de92"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="9af6bb63-a745-4bd2-9905-5be64e686273" sid="db797d2e-fa6e-4144-ad85-96fd6eea876f"
                  name="[SF7.2.7] Compute thrust MON" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>- The monitoring processor shall compute the thrust required from each propeller P1, P2, P3, P4 with the following formulas :&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>1&lt;/font>&lt;/sub> = Thrust MON&amp;nbsp;+ P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>2&lt;/font>&lt;/sub> = Thrust MON&amp;nbsp;- P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>3&lt;/font>&lt;/sub> = Thrust MON - P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>4&lt;/font>&lt;/sub> = Thrust MON&amp;nbsp;+ P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the P1, P2, P3, P4 validity statuses as follows : IF (Thrust MON is INVALID) OR (PTheta is INVALID) OR (Pphi is INVALID) OR (Ppsi is INVALID) THEN P1, P2, P3, P4 are INVALID ELSE P1, P2, P3, P4 are VALID.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="98a34073-201e-46d8-a326-e3d34619f8f9" sid="86e211a1-2283-4d3e-8449-33c4ec753386"
                    name="FIP Pt"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="10bce830-a9a9-4948-9e7f-5d36f7043654" sid="6d42973e-fc24-4d4e-9841-1389ef8b4dfe"
                    name="FIP Pphi"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="8f385fba-bc76-4192-83d3-ff2d3dd80d4b" sid="0092f606-eb43-43a7-ad6d-b337ca804262"
                    name="FIP Ppsi"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="99f1d734-6427-4e09-be75-da0ba7167a4c" sid="82e95ccb-8fe0-475c-8ea3-d87b4b3c87dc"
                    name="FIP T"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="e8026115-7785-40ee-b2ba-a80061da8b70" sid="61253e34-743e-4668-a5e2-39f091a70702"
                    name="FOP P1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="66623354-d841-434e-8c44-9f1a50bb3e1d" sid="97b35eb9-65cb-434b-8e01-ab5253e830a7"
                    name="FOP P2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="4ad3f015-dd01-4ef0-8b6a-587e8f3840a2" sid="5acb829a-142c-4fd5-842a-593e2b251900"
                    name="FOP P3"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="bd01ad18-ad74-438e-b86a-4a8f1e1dea67" sid="ff6f351b-2939-468f-bdb7-a7a03dd586a6"
                    name="FOP P4"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="afe8505a-d78c-4da6-a832-42fb79bae16b" sid="e02c5c09-8b1e-4a6d-aa51-505d837b9651"
                  name="[SF7.2.8] Compute motor rate MON" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>- The monitoring processor shall compute the Motor 1,2,3,4 rotation rate MON&amp;nbsp;for each propeller from the expected thrust as follows (Cprop_i being the propeller coefficient of the propeller i):&lt;/p>&#xA;&#xA;&lt;p>Motor i rotation rate MON = square_root(Pi/Cprop_i) (i=1,2,3,4)&lt;/p>&#xA;&#xA;&lt;p>- The monitoring processor shall compute the Motor 1,2,3,4 rotation rate MON&amp;nbsp;validity status as follows : IF Pi is INVALID THEN Motor i rotation rate MON&amp;nbsp;is INVALID ELSE Motor i rotation rate MON&amp;nbsp;is valid (i=1,2,3,4).&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="e44d1318-1845-44bb-840d-bca0b83b209b" sid="26f97611-d905-47ac-af50-bf896680f037"
                    name="FIP P1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="5c47a09d-5463-4874-9517-2e1f6fadadfb" sid="81a2c779-3e7d-4399-bd76-1e293009451c"
                    name="FIP P2"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="f7f7e34d-68b9-49d6-a021-df99659a9ab7" sid="30e27fc3-43b8-4106-afc3-c90f97e23a6c"
                    name="FIP P3"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="5b0ac869-ff13-4352-8a0c-509a89f382c0" sid="ab9add55-c1a1-4201-97bb-40ee6f7760f3"
                    name="FIP P4"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
