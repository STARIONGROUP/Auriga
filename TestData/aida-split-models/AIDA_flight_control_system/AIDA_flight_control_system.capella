                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="df2738a6-f549-4bd8-9f8a-1ae7a929c9db" targetElement="#e2f2d4b4-7598-48d7-965e-5b9b09a8edce"
