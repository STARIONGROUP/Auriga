                      id="9b7f5785-be9a-4751-b4c7-baf96a1ec10e" targetElement="#ed9bde2d-8e42-4c89-aaa9-8e43211dbec4"
                      sourceElement="#2fe919b0-a165-4585-acbc-55b72ab37f9e"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c7db97f3-c9f2-4c9e-9751-d101a595edf5" name="FIP 5">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="afa748fc-6a49-4946-87cc-48b6aa52a871" targetElement="#e979b3dd-d7f1-491f-bacd-50fece4da634"
                      sourceElement="#c7db97f3-c9f2-4c9e-9751-d101a595edf5"/>
