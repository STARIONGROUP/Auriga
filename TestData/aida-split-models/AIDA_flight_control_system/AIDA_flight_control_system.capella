            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="dd24a8e8-4be3-4c88-b10c-8f049441154e" sid="f6d834a3-4d21-45a7-86fb-2a844171b4a5"
                name="FOP PitchRate"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="7d70d159-ae6c-448d-a933-89f2eb669f31" sid="ca504d21-ee24-4a57-b4ba-770dd1f8762e"
                name="FOP Pitch"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="9322daee-9990-433c-b2d3-3656b7c036dd" sid="b3e808fd-c61a-4917-833e-04c349d23c41"
                name="FOP Roll"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="a7dcbb06-6133-4702-a498-82cf663138e8" sid="94460694-ecd3-49ad-8f65-d7cbbe4bb162"
                name="FOP 6"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="199e3f6d-33fe-4c30-a211-0a7974f6de13" sid="4eea81af-ef03-46c7-a69e-0c36f5cb63ae"
                name="FOP 3"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="9c6edf7b-53a1-4903-8e6a-7f086d2c7ae5" sid="1432f9a1-4ecc-44c0-80fc-fed92c87c317"
                name="FOP 4"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="7068486f-3f8b-477b-b5a5-db2252eb2f1d" sid="8cac71ed-74c9-4797-a610-d8dcbe7aa05b"
                name="FOP 5"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="2c78ab76-f479-4bfe-84bf-01a35a422f44" sid="c618f908-eb3f-40c3-82bd-6d59835fdf70"
                name="FOP 7"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="8fe4f5a0-f095-4ab6-a86c-4b016621ae08" sid="e6802e37-cf88-4f02-afb5-030aa0fad8aa"
                name="FOP 8"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
              id="5e6b914c-213c-40e8-9345-96872f41c974" sid="8a19701e-f284-4998-be02-e928f328e10d"
              name="[SF4] Control drone navigation" description="&lt;p>Depending on the control mode selected by the pilot, the AIDA system moves to the requested position and visual sight angle :&lt;/p>&#xA;&#xA;&lt;p>- in AUTO mode, it executes the mission previously defined&lt;/p>&#xA;&#xA;&lt;p>- in MANUAL mode, it executes the real-time manual motion commands&lt;/p>&#xA;&#xA;&lt;p>The AIDA system provides mission progress feedback to the operator.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="0cfde983-2f5c-49a2-b49c-0434f6499e80" sid="c4d46af7-1f63-46ce-978e-9f262068836f"
                name="[SF4.1] Acquire and store flight plan" description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>This function store flight plan and flight zone computed by ground segment, prior to the Mission. So, the inspection is robust to communication shortage between drone and ground segment.&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The control desk shall acquire and store the Flight plan and Flight zone.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall send the Flight plan and Flight zone to the drone.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall monitor the integrity of the storage of the Flight plan and Flight zone.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall compute the Flight plan validity status as follows : IF (Flight plan is INVALID) OR (Flight plan storage integrity is INVALID) THEN (Flight plan sent to the drone is INVALID) else (Flight plan sent to the drone is VALID).&lt;/p>&#xA;&#xA;&lt;p>The control desk shall compute the Flight zone validity status as follows : IF (Flight zone is INVALID) OR (Flight zone storage integrity is INVALID) THEN (Flight zone sent to the drone is INVALID) else (Flight zone sent to the drone is VALID).&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="7c9ef5c5-46a3-41ab-a6cb-0f185facf3c5" sid="d76d9c13-2347-4507-8904-faf6b721123c"
                  name="FIP 1"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="05aa8867-ec39-4915-8700-65e57d876206" sid="f8e1d358-3998-4829-a3ab-b70bcdbf3f0a"
                  name="FIP 2"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="434bb911-645e-444e-a4b6-6e5c30612f4f" sid="e97911f9-9d8c-4973-a1a5-719abde1a029"
                  name="FOP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="78d7cfb4-5651-4008-858e-3d88efd43165" sid="e57d5fe7-7700-447c-8d08-84ade8716953"
                  name="FOP 2"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="82643582-9aaf-4d67-840c-b61d14791531" sid="9c8a3261-df78-4d1e-80d8-a6a370d7339c"
                name="[SF4.2] Run automatic control" description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>This function runs the flight plan : it commands the request drone consigns and control mode, then controls the payload when the position is reached.&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>It report mission progress and monitors that drone remains in flight zone. &lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>If the pilot interrupts the mission, the function switch from flight plan consigns to pilots consigns.&lt;/span>&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="1187dfaf-9a5c-4cc6-8cc7-035ab2f5d69b" sid="0d2fd06e-58b1-44bd-aca1-2c6204a2d127"
                  name="FIP 9"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="e1aa6940-e0ce-411c-8761-da24a87853fa" sid="afac5860-5ed8-45c9-a7e1-b5296daaaf44"
                  name="FIP 6"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="c2067d4e-5a5a-4aa7-b717-5e78710da1a6" sid="ccd1d90e-0430-4ef1-b099-528abf87e846"
                  name="FIP 7"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="80618ee0-8dd2-4bd7-8639-fe5298bec63e" sid="ad057c2c-b29e-4839-bd6b-08d93726b5f7"
                  name="FIP 4"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="d0f53e1f-4178-48ca-9515-e3ecac026e9b" sid="6f3a52a6-ef6f-4d90-998d-6b89e87effc9"
                  name="FIP 1"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="98c9c87c-d1ff-4d96-90bf-5f1a831c4139" sid="1b766019-ce33-4566-a700-698cded243d5"
                  name="FIP 5"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="642d4123-f90a-41fa-965b-3de4dd4e7b3f" sid="5cf002aa-a0e5-45f2-8eee-3a758086508f"
                  name="FIP 8"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="bca2b520-d3ca-46b0-a25d-5e6f378acded" sid="2a090ee8-a103-4dfa-b718-dd150efe7a93"
                  name="FIP 2"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="05c7100c-e598-4322-8305-6e0136bc2639" sid="e77c1434-705a-4131-9011-c94ac26f632d"
                  name="FIP 3"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="624448cc-ac97-4409-9064-51356bd6be4f" sid="f7c9f25b-0f17-4a56-ba9f-99661330a6f7"
                  name="FOP 2"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="5563985b-8c9c-4f0d-8ec6-11da25357f53" sid="74987de6-fdd1-4555-84cc-2aea21407686"
                  name="FOP 3"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="b04cdbba-dc4d-4984-9feb-06360ee1d74c" sid="cb695684-ea06-4bcc-9355-0e51b507dcc7"
                  name="FOP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="2220645f-56cf-4913-9da4-b8af5ed4fa3c" sid="4cca83a7-c6df-4901-9e8e-bfcbadc675b6"
                  name="FOP 5"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="b28b7cbc-fb35-4c10-8665-bb0a80f9a918" sid="d7487f7a-61dc-4e36-b2dd-b71fb604b19b"
                  name="FOP 4"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="0068658c-aeec-41f9-b419-9f3d191fec9e" sid="9a6d5e8c-257d-4803-bc55-df7d4f439705"
                name="[SF4.3] Select control mode" description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>The drone pilot can always select control mode and override automatic flight plan mode with the &amp;quot;Pilot control mode&amp;quot; and&amp;quot;manual override&amp;quot;&amp;nbsp;signal. Then, the function interrupts the flight plan with the &amp;quot;flight plan interruption&amp;quot;. &lt;/span>&lt;/p>&#xA;&#xA;&lt;p>&amp;quot;Manual override&amp;quot; signal has been added in V4.3.&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&amp;nbsp;&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="a53b9d75-be38-4995-9e1b-7c11c04dc333" sid="a951dfdf-f42a-461e-80ce-db85c3090180"
                  name="FIP 1"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="c6bd69f0-9640-49b2-92f2-33e131749b87" sid="ff06e455-3c66-4f4b-94ac-0bd3d128e205"
                  name="FIP 2"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="538f8074-18b2-465c-bbd5-47983651f1c3" sid="892d6d5f-728d-48b3-9e36-313f31d3e97d"
                  name="FIP 6"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="485bcfc3-de26-4c17-908d-859ad142f1dc" sid="6e1e5704-e014-4a0a-80a4-58ca15dde934"
                  name="FOP 2"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="f60f1304-1232-4276-bd95-17fc5535f343" sid="c07d78a2-afd5-402a-9e98-13a5b82a85b5"
                  name="FOP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="a6c50e1b-2448-4f7e-adda-c2c6941d5fc5" sid="72118957-5a6c-4f4a-a305-b98dbdf34803"
                  name="FOP 3"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="0d1e1494-3fce-4c00-af54-4efb1bc7655d" sid="2fc88329-15cb-4505-9a0c-566fb1e0c45e"
                  name="FOP 4"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="fe97ecbe-b0ab-47af-8ec6-7cfdacc28be5" sid="eb78a5c8-3ffa-4533-9522-86f52a6bfc69"
                name="[SF4.4] Acquire pilot control consigns and mode" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The control desk shall acquire the following pilot control consigns : automatic control start, pilot control consigns, pilote control mode.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall send the automatic control start, pilot control consigns and&amp;nbsp;pilot control mode&amp;nbsp;to the drone, along with the associated validity statuses.&lt;/p>&#xA;">
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="a0abf289-2fa7-4f79-b8ee-56e643c480b9" sid="78795cbe-a270-4e56-bea2-9cac54dfcd1e"
                  name="FOP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="23a883a5-8e18-40bd-8e14-b4bc13c10c16" sid="329f12e2-b26e-4bb3-9029-a82296b50c86"
                  name="FOP 2"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="47a109c6-9ac3-4d39-ad20-f8a18aafbeb4" sid="76119bea-b9a9-4d00-9905-1840c175b6dc"
                  name="FOP 3"/>
            </ownedFunctions>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="a8e8ea81-25ec-4485-92c0-a7e151661d73" sid="445818f5-8f6e-46ef-8b84-f2e189d1f423"
                name="Flight plan interruption" target="#05c7100c-e598-4322-8305-6e0136bc2639"
                source="#f60f1304-1232-4276-bd95-17fc5535f343"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="b4f1240a-6340-4429-a656-050435943550" sid="93eabbce-0852-4be1-9a3c-6501ee2d23c6"
                name="Flight plan" target="#80618ee0-8dd2-4bd7-8639-fe5298bec63e"
                source="#434bb911-645e-444e-a4b6-6e5c30612f4f"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="1ba90814-e243-45b6-b761-9a85f9e54017" sid="142d5541-4136-4728-9b9d-dfc41ee0c211"
