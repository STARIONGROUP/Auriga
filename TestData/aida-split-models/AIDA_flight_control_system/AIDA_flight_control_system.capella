                  id="afc01bc3-8ed9-4d83-bef5-4b2d2113d56c" sid="5769320c-c32d-4e10-a14c-ca1230f0ee06"
                  name="FIP Pt"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="7a6269ad-f922-4163-b280-ad2488875907" sid="34179cb8-d7f3-43df-99b9-d0098f3ad722"
                  name="FIP T"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="65718851-f6f8-4908-b5a5-e1ed85ad9b7f" sid="376d2aee-1c5e-46fb-a323-576e2184dada"
