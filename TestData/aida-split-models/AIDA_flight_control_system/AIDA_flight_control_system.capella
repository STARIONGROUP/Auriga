                  name="FIP 1"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="0dbb6b09-3742-4b40-a048-a615913d0dbb" sid="ebe59f0a-6f15-46cb-a578-3d4e93c1f784"
                  name="FIP 5"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="bbc581e9-636a-4cf7-a60b-56b57281934d" sid="6c530db7-e119-4666-a7c4-ca6652d2b92f"
                  name="FIP 8"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
