              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="34840980-18dc-45a5-9822-88264bfdc127" name="Roll consign" target="#664141d9-02b1-4e98-8a97-1a27a3e2d88b"
                  source="#e4919d20-fd3e-4d3b-85ba-8467105df2aa">
                <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                    id="bc30f540-e152-45f8-ac92-63f06be9e0e9" targetElement="#0d28f717-652a-4621-a52e-b0041ac3a165"
                    sourceElement="#34840980-18dc-45a5-9822-88264bfdc127"/>
