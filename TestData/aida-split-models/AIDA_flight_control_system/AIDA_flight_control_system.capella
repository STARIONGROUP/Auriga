            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="8c906e21-997b-485e-84d4-80ee4076e098" targetElement="#162cc5f7-9a16-438a-838e-36f2e35211e4"
