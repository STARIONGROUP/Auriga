                      sourceElement="#4301a78f-f1ea-4ad7-980f-a559eeb5fdb5"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="d928dabf-1295-493d-a2f1-33fe398ece2b" sid="cc91554a-e91b-4adc-b136-a7298076c1e0"
                    name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="e5b78a78-f4c3-4e46-b617-c0f74a0e5d8d" targetElement="#5506bd4f-f546-46a2-a99b-0405cea0d503"
                      sourceElement="#d928dabf-1295-493d-a2f1-33fe398ece2b"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="c7c92edf-f837-4250-8855-a442e7034c5a" sid="812a2cb6-1da1-40d0-b0c6-1fe15dd42438"
                    name="FOP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
