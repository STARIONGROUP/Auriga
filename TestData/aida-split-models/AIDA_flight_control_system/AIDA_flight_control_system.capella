              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="965ca4ae-0ed1-4647-bee9-81c64fc72d66" name="Acceleration consign"
                  target="#5ad2738e-8c2d-4d87-b92c-76934c01162b" source="#165aa163-81e5-4f80-8c75-58b60bee1ee3">
