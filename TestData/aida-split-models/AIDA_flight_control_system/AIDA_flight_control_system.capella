                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="ae4cf68e-7e83-4267-86bd-ef1b2a968d9a" targetElement="#51d84fcc-fbba-4144-92c1-d44de6b33b5f"
