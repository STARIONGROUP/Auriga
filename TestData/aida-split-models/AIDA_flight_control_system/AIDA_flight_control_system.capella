                    name="FOP 4">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="af25f646-b629-431e-a49d-6a571591c879" targetElement="#0a0fc0a1-6c2b-41ca-a4de-9e91331b7b51"
