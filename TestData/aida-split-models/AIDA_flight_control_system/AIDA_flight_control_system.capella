                      sourceElement="#094f5d87-8dd9-4d0c-9a45-dd9c60d6bcb0"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="b8f4dff8-2426-47d6-8f29-08bb6a80e4a6" targetElement="#e2f2d4b4-7598-48d7-965e-5b9b09a8edce"
