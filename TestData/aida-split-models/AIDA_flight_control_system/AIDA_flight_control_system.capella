              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="dd4ba978-ee62-4300-b98e-bcf7773ac459" name="[SF2.3.3] Control pitch angle"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Ptheta as the result of the closed loop control of the pitch angle to reach the Pitch consign from the current Drone pitch and Drone pitch rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Ptheta validity status as follow : IF (Drone pitchis INVALID) OR (Drone pitch rate validity status&amp;nbsp;is INVALID) OR (Pitch consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Ptheta validity status is INVALID ELSE Ptheta validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="9803a291-23d6-49e4-9cfd-bdc91729df37" name="FIP PC">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="a0a7a04c-3652-4ee9-9ca2-d26f777c5969" targetElement="#db18a96e-5b08-4843-bdb1-5d857a202713"
                      sourceElement="#9803a291-23d6-49e4-9cfd-bdc91729df37"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="638fb9aa-ad22-442a-8582-c9ab263783e3" name="FIP DP">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="324191ba-98de-4ed7-87ba-0166c5901c43" targetElement="#216a62ae-7c36-431c-8124-94896ecaab64"
                      sourceElement="#638fb9aa-ad22-442a-8582-c9ab263783e3"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="83714e39-870d-4bd2-a9c1-755f15660a03" name="FIP DPR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="cca147f3-3df4-47c3-ae65-7269d1859612" targetElement="#af2a951f-1c3b-4eff-9f86-a14a75d5feee"
                      sourceElement="#83714e39-870d-4bd2-a9c1-755f15660a03"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="effceaac-a1ff-4e76-b6da-b2dd2978b4d2" name="FOP Pt">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="420c9797-8032-42e2-bb7c-481f031ad99d" targetElement="#590e22c9-15c6-467e-8697-0a43fe36a96f"
                      sourceElement="#effceaac-a1ff-4e76-b6da-b2dd2978b4d2"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="8e0c5f8c-9b67-4695-8849-64cf46c9add1" targetElement="#5fd20af2-35ce-4662-9eac-7bd8a4dfd1f2"
                    sourceElement="#dd4ba978-ee62-4300-b98e-bcf7773ac459"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="7c27246c-0876-42f4-9cdc-656d34a5a760" name="[SF2.3.4] Control roll angle"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Pphi as the result of the closed loop control of the rollangle to reach the Roll consign from the current Drone roll and Drone roll rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Pphi validity status as follow : IF (Drone roll is INVALID) OR (Drone roll rate validity status&amp;nbsp;is INVALID) OR (Roll consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Pphi validity status is INVALID ELSE Pphi validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="664141d9-02b1-4e98-8a97-1a27a3e2d88b" name="FIP RC">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="19d8a470-92e3-4e6a-a26e-11bf96c4e99c" targetElement="#ad2b02da-4170-4518-8279-ee977ecfb4b1"
                      sourceElement="#664141d9-02b1-4e98-8a97-1a27a3e2d88b"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="a5b98f5a-d647-45d6-80a1-77708d6ba83e" name="FIP DR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="082f2eb7-2bcc-4dc6-9053-5836c3f13eae" targetElement="#512a9377-3096-4776-af56-1e9956c69c61"
