              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="702f2ea1-ca5b-4f5a-83a5-4ba677b296a1" sid="9fab25fe-945c-4148-b179-71e0ae32f48f"
                  name="[SF7.2.4] Control pitch angle MON" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute Ptheta as the result of the closed loop control of the pitch angle to reach the Pitch consign MON&amp;nbsp;from the current Drone pitch and Drone pitch rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute the Ptheta validity status as follow : IF (Drone pitchis INVALID) OR (Drone pitch rate validity status&amp;nbsp;is INVALID) OR (Pitch consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Ptheta validity status is INVALID ELSE Ptheta validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="535719be-23cf-4c10-be6d-e095182627b6" sid="f96de728-bdf0-46b0-8fa3-70c356ff14bb"
                    name="FIP PC"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="6d3a8cb5-ff40-4e4b-8652-882cc9d13718" sid="d0afb0e2-d039-4bcf-a9b7-83354469b352"
                    name="FIP DP"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="825a30a3-70d2-43fb-a02f-d025807c2fc1" sid="e4628d05-c78b-4825-8671-dfab80180633"
                    name="FIP DPR"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="ccabf00d-4d1d-420a-b662-86c7d917ba8a" sid="b565836c-cc1e-477a-82c1-f8fd1e645f87"
                    name="FOP Pt"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="09291af2-a742-44ea-b7e8-cfb8e8db21d9" sid="ff93fe9e-b653-40f2-a397-988921eb0132"
                  name="[SF7.2.5] Control roll angle MON" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute Pphi as the result of the closed loop control of the rollangle to reach the Roll consign from the current Drone roll and Drone roll rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute the Pphi validity status as follow : IF (Drone roll is INVALID) OR (Drone roll rate validity status&amp;nbsp;is INVALID) OR (Roll consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Pphi validity status is INVALID ELSE Pphi validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="3f6a0d75-857f-4113-9735-6a8789491575" sid="3bb2ed54-00a2-4da3-850d-0edbabd65fe9"
                    name="FIP RC"/>
