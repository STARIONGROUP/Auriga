                    id="6d1d2161-7460-40a1-af2a-d44d18d1f22f" sid="a951dfdf-f42a-461e-80ce-db85c3090180"
                    name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
