                      sourceElement="#73808931-dd38-4fbc-b6f0-2a67bb008a21"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="18d26ec8-6810-4aa0-9aef-053eeac233f3" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="02b68762-5042-45fd-b245-ee0825a3ce20" targetElement="#4a6fa7d0-220e-4289-9a1b-cdf4161f3f59"
                      sourceElement="#18d26ec8-6810-4aa0-9aef-053eeac233f3"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="9ce7b66e-eea7-439a-b48f-390eb52f75b5" targetElement="#85e9514b-c20c-4dd7-a78f-90fc959b75b0"
