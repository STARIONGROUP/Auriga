                      sourceElement="#f57d9801-2622-4d83-80c8-7db94a946bf9"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="e8bfa971-913d-40d5-9430-c7ac4cc42366" name="FIP DPR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="e7f7eeb8-71b2-4e37-9879-88194b1d08ac" targetElement="#825a30a3-70d2-43fb-a02f-d025807c2fc1"
                      sourceElement="#e8bfa971-913d-40d5-9430-c7ac4cc42366"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="8a393c1c-5251-4bbc-afdf-b640e6ebf8b7" name="FOP Pt">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="8d11fa38-364f-4467-9cdb-35908fcddb9b" targetElement="#ccabf00d-4d1d-420a-b662-86c7d917ba8a"
                      sourceElement="#8a393c1c-5251-4bbc-afdf-b640e6ebf8b7"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="00f105b7-11db-4619-86d8-4c85c25bc4d3" targetElement="#702f2ea1-ca5b-4f5a-83a5-4ba677b296a1"
                    sourceElement="#d51abd0b-592b-48fb-8123-a08be8280e75"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="e1569786-81f9-491d-aee6-8c68d79e5002" name="[SF7.2.5] Control roll angle MON"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute Pphi as the result of the closed loop control of the rollangle to reach the Roll consign from the current Drone roll and Drone roll rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute the Pphi validity status as follow : IF (Drone roll is INVALID) OR (Drone roll rate validity status&amp;nbsp;is INVALID) OR (Roll consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Pphi validity status is INVALID ELSE Pphi validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="4e4cb944-55ce-47fe-96c5-7a71cda182ac" name="FIP RC">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="248dfa62-d459-410f-9b34-e27402cc48c1" targetElement="#3f6a0d75-857f-4113-9735-6a8789491575"
                      sourceElement="#4e4cb944-55ce-47fe-96c5-7a71cda182ac"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="7a989303-6045-4dbb-9a56-d39116718e56" name="FIP DR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="93f8d610-b7bd-428c-b75c-c19e8c0d1f3e" targetElement="#4323ae3d-7846-45cb-b2dd-094612458d90"
                      sourceElement="#7a989303-6045-4dbb-9a56-d39116718e56"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="aadde7c0-c1ae-44a4-a587-845b031b9778" name="FIP DRR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="54dc64e0-07c0-405b-9991-1e7c04d7dd2b" targetElement="#216d5c9e-ae07-4270-8d07-d9ebae330cc3"
                      sourceElement="#aadde7c0-c1ae-44a4-a587-845b031b9778"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="fee4907c-5981-4091-ab95-cbcb7e102c20" name="FOP Pphi">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="b56f526c-c448-47e1-8b6f-1c1a36bc80d2" targetElement="#aa726a98-714d-44ce-b0a4-6f344c9b3859"
                      sourceElement="#fee4907c-5981-4091-ab95-cbcb7e102c20"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="cc455141-5d72-4a59-b4cf-f259f25d3049" targetElement="#09291af2-a742-44ea-b7e8-cfb8e8db21d9"
                    sourceElement="#e1569786-81f9-491d-aee6-8c68d79e5002"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="37e648bb-02e9-4a03-9e16-530d970cb30e" name="[SF7.2.6] Control yaw angle MON"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute Ppsi as the result of the closed loop control of the yaw angle to reach the Yaw consign from the current Drone yaw and Drone yaw rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute the Ppsi validity status as follow : IF (Drone yaw is INVALID) OR (Drone yaw rate validity status&amp;nbsp;is INVALID) OR (Yaw consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Ppsi validity status is INVALID ELSE Ppsi validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c14c6004-26cd-4553-af22-7c03b0ee9c8c" name="FIP YC">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="0238e44e-d728-45cf-8dc1-7201de7376ff" targetElement="#38bf0917-f458-40ed-beb3-9072ac412643"
                      sourceElement="#c14c6004-26cd-4553-af22-7c03b0ee9c8c"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="ee5d6d01-c37a-43bc-b258-c7fa73e43a68" name="FIP DY">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="9083f530-07cf-4d57-9e4e-12c9581d9804" targetElement="#73a0d4bf-4565-437a-b786-79b4d775b360"
                      sourceElement="#ee5d6d01-c37a-43bc-b258-c7fa73e43a68"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="0ca3cb57-ceaa-4232-a437-5ae8ae9e84f8" name="FIP DYR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="828573ac-655c-47ba-b16d-51f075096f51" targetElement="#826af186-2970-43d1-a827-6afbf434b6a9"
                      sourceElement="#0ca3cb57-ceaa-4232-a437-5ae8ae9e84f8"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="5fe88cf5-2f0a-4f61-ab22-866a5171e574" name="FOP Ppsi">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="737d0384-c0b2-4a90-8771-b868f51744a3" targetElement="#de71e148-f9ee-4da1-a8a9-8d1a617088f6"
                      sourceElement="#5fe88cf5-2f0a-4f61-ab22-866a5171e574"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="c87a010f-7ca6-47de-8bf2-34703e17485a" targetElement="#2805776d-c066-4299-b391-e78fe804de92"
                    sourceElement="#37e648bb-02e9-4a03-9e16-530d970cb30e"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="87b60fee-bd22-4b32-93a8-3ae1bd32c0ec" name="[SF7.2.7] Compute thrust MON"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>- The monitoring processor shall compute the thrust required from each propeller P1, P2, P3, P4 with the following formulas :&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>1&lt;/font>&lt;/sub> = Thrust MON&amp;nbsp;+ P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>2&lt;/font>&lt;/sub> = Thrust MON&amp;nbsp;- P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>3&lt;/font>&lt;/sub> = Thrust MON - P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>4&lt;/font>&lt;/sub> = Thrust MON&amp;nbsp;+ P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the P1, P2, P3, P4 validity statuses as follows : IF (Thrust MON is INVALID) OR (PTheta is INVALID) OR (Pphi is INVALID) OR (Ppsi is INVALID) THEN P1, P2, P3, P4 are INVALID ELSE P1, P2, P3, P4 are VALID.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="19cdd6a8-cb6f-43ee-b5f0-eab41e4756f6" name="FIP Pt">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="26421f5f-d6f3-41db-89c6-ca910a41e0f5" targetElement="#98a34073-201e-46d8-a326-e3d34619f8f9"
                      sourceElement="#19cdd6a8-cb6f-43ee-b5f0-eab41e4756f6"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="9028f828-e845-46d0-8b91-4835f5d4590c" name="FIP Pphi">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="2b3cb45a-9880-4059-9df4-e550b052b22f" targetElement="#10bce830-a9a9-4948-9e7f-5d36f7043654"
                      sourceElement="#9028f828-e845-46d0-8b91-4835f5d4590c"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="979d2099-d343-4b5d-a98d-693279bdcb6e" name="FIP Ppsi">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="08741eda-4658-42b6-a468-dce664ede871" targetElement="#8f385fba-bc76-4192-83d3-ff2d3dd80d4b"
                      sourceElement="#979d2099-d343-4b5d-a98d-693279bdcb6e"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="b24e1882-506e-4282-a04c-347775cc1077" name="FIP T">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="aea98cac-47a1-4bbc-a49c-92016f324f9d" targetElement="#99f1d734-6427-4e09-be75-da0ba7167a4c"
                      sourceElement="#b24e1882-506e-4282-a04c-347775cc1077"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="49c96c1d-bb10-4bf5-baa3-73a17b9eaa1c" name="FOP P1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="e91d46cc-b78d-49be-b663-20461cd098ef" targetElement="#e8026115-7785-40ee-b2ba-a80061da8b70"
                      sourceElement="#49c96c1d-bb10-4bf5-baa3-73a17b9eaa1c"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="8a87ec7e-3462-4175-bcbd-9c5a63e0e098" name="FOP P2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="0014227d-cd63-4819-9cb9-2afec91577ea" targetElement="#66623354-d841-434e-8c44-9f1a50bb3e1d"
                      sourceElement="#8a87ec7e-3462-4175-bcbd-9c5a63e0e098"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="68e40947-acc1-4ebc-9e13-926a30d45145" name="FOP P3">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="06acf0eb-589f-485d-9669-d4c73b614996" targetElement="#4ad3f015-dd01-4ef0-8b6a-587e8f3840a2"
                      sourceElement="#68e40947-acc1-4ebc-9e13-926a30d45145"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="4b34de80-6019-4ffb-9f06-095cd9597d31" name="FOP P4">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="7b19a2e6-992f-44b7-8c93-531765eea95b" targetElement="#bd01ad18-ad74-438e-b86a-4a8f1e1dea67"
                      sourceElement="#4b34de80-6019-4ffb-9f06-095cd9597d31"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="58e9eb78-d735-4a27-985e-192f5b8027b2" targetElement="#9af6bb63-a745-4bd2-9905-5be64e686273"
                    sourceElement="#87b60fee-bd22-4b32-93a8-3ae1bd32c0ec"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="d4005d78-fc81-41df-b801-364439c036a8" name="[SF7.2.8] Compute motor rate MON"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>- The monitoring processor shall compute the Motor 1,2,3,4 rotation rate MON&amp;nbsp;for each propeller from the expected thrust as follows (Cprop_i being the propeller coefficient of the propeller i):&lt;/p>&#xA;&#xA;&lt;p>Motor i rotation rate MON = square_root(Pi/Cprop_i) (i=1,2,3,4)&lt;/p>&#xA;&#xA;&lt;p>- The monitoring processor shall compute the Motor 1,2,3,4 rotation rate MON&amp;nbsp;validity status as follows : IF Pi is INVALID THEN Motor i rotation rate MON&amp;nbsp;is INVALID ELSE Motor i rotation rate MON&amp;nbsp;is valid (i=1,2,3,4).&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="7ab1dfcb-f358-4fca-ad86-979eddf32b7f" name="FIP P1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="d0fd758e-8d10-4aef-a24e-55d5f9cac20a" targetElement="#e44d1318-1845-44bb-840d-bca0b83b209b"
                      sourceElement="#7ab1dfcb-f358-4fca-ad86-979eddf32b7f"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="e29bc560-9ac0-4cc5-9b34-b1ab2bf9bcb9" name="FIP P2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="7ee2a6a1-e0e5-4f87-92cd-83553a28d90d" targetElement="#5c47a09d-5463-4874-9517-2e1f6fadadfb"
                      sourceElement="#e29bc560-9ac0-4cc5-9b34-b1ab2bf9bcb9"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="9cf73127-2d67-4936-a62e-13b98a150ecd" name="FIP P3">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="97436b68-9064-4cb2-bd26-c3fb992453bc" targetElement="#f7f7e34d-68b9-49d6-a021-df99659a9ab7"
                      sourceElement="#9cf73127-2d67-4936-a62e-13b98a150ecd"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="bf2ad48a-9add-4958-9190-0c2567440bf4" name="FIP P4">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="e1524c9d-a234-49c2-923e-3465774d245a" targetElement="#5b0ac869-ff13-4352-8a0c-509a89f382c0"
                      sourceElement="#bf2ad48a-9add-4958-9190-0c2567440bf4"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="881c10f3-00c7-4844-bd35-b66491888f71" name="FOP M1R">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="9ef4bbdc-cd8d-4d8d-844a-a62d0a447c4e" targetElement="#913a822c-6b5e-4d02-a219-ba29a82198cb"
                      sourceElement="#881c10f3-00c7-4844-bd35-b66491888f71"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="ba1cf727-d43d-4604-beda-c3fcf48bcff4" name="FOP M2R">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="e7d2bf08-9bb4-4c74-9a52-17e37b679e73" targetElement="#56db3bfe-6c0e-49de-b44f-5eaa3cef0eb2"
                      sourceElement="#ba1cf727-d43d-4604-beda-c3fcf48bcff4"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="b4f5ab1a-594c-49e0-9ec0-13db4fe847d4" name="FOP M3R">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="db52d327-755d-4212-95f6-82f1c1bca9dc" targetElement="#6dc1011b-9247-41ce-b02f-46bcf1cf769b"
                      sourceElement="#b4f5ab1a-594c-49e0-9ec0-13db4fe847d4"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="aa527a1c-67be-4921-92fa-ea0b4635a205" name="FOP M4R">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="1d02da1d-7636-4cc4-844a-ccf656b19c9d" targetElement="#094f5d87-8dd9-4d0c-9a45-dd9c60d6bcb0"
                      sourceElement="#aa527a1c-67be-4921-92fa-ea0b4635a205"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="2531d19e-df1e-4c52-bf08-e592f709662a" targetElement="#afe8505a-d78c-4da6-a832-42fb79bae16b"
                    sourceElement="#d4005d78-fc81-41df-b801-364439c036a8"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="8f65e2f8-0423-49e5-9809-9ad6224f3a6f" name="[SF7.2.9] Compute yaw consign MON">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="f7e89fcb-6dc8-4611-b146-7a4a0c22ba46" name="FIP Yawcons">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="eb0c70cc-bb32-48d2-a7c2-25196ceb079d" targetElement="#b2f35037-2208-410d-8e64-2320028dc7f8"
                      sourceElement="#f7e89fcb-6dc8-4611-b146-7a4a0c22ba46"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="b4212bb8-dce4-4ba6-9e70-cc9f885f9591" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="6af19e6a-ff97-431a-b2fc-f7add0b4f995" targetElement="#ddccd01d-9fb1-46c7-93b8-8f4f93c46d14"
                      sourceElement="#b4212bb8-dce4-4ba6-9e70-cc9f885f9591"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="2bd6ebeb-e7a8-466e-ade9-e305bc150918" targetElement="#9c290910-3f1e-4a79-bc29-18a033518d2d"
                    sourceElement="#8f65e2f8-0423-49e5-9809-9ad6224f3a6f"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="6a53d6e9-7fa8-4497-aaef-7149d0a74e50" name="[SF7.2.10] Compute altitude consign MON">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="81560f09-9dcb-4448-91e9-44b84f12475e" name="FIP Alt Cons">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="61974a90-4ef0-421b-8209-a66bb83a17cd" targetElement="#1d0fadab-5006-4179-bb41-55c27f293322"
                      sourceElement="#81560f09-9dcb-4448-91e9-44b84f12475e"/>
