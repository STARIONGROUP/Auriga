                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="db671e19-36ab-4e94-b510-672accd4b2fb" name="FIP DRR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="47d0dfe4-cafb-45bc-9fd0-473a5cd1458c" targetElement="#a7520dcc-4def-4663-ac94-ec0c936f81a4"
                      sourceElement="#db671e19-36ab-4e94-b510-672accd4b2fb"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="91dff8a9-e716-4731-8aaa-88f0fc5aebcd" name="FOP Pphi">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="562229ea-5a56-4fb9-8805-67ecbc211e89" targetElement="#9899f828-be9f-4363-a18f-2d62203d0350"
                      sourceElement="#91dff8a9-e716-4731-8aaa-88f0fc5aebcd"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="e1c09d25-78ab-48a2-8320-5ad403e80ce0" targetElement="#4194cfb4-552b-42f5-b0e4-35c183eaba3b"
                    sourceElement="#7c27246c-0876-42f4-9cdc-656d34a5a760"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="9e6bd7dd-95b3-4783-b93c-22d5d1a8ded4" name="[SF2.3.5] Control yaw angle"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute Ppsi as the result of the closed loop control of the yaw angle to reach the Yaw consign from the current Drone yaw and Drone yaw rate measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Ppsi validity status as follow : IF (Drone yaw is INVALID) OR (Drone yaw rate validity status&amp;nbsp;is INVALID) OR (Yaw consign validity status&amp;nbsp;is INVALID)&amp;nbsp;THEN Ppsi validity status is INVALID ELSE Ppsi validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="47ea572f-d305-4156-bb60-5fe17f21ef6f" name="FIP YC">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="86a4c72a-4cfc-4c00-915d-2cd5f27f0bd5" targetElement="#9e88f335-ce23-4721-a242-7e687f15b400"
                      sourceElement="#47ea572f-d305-4156-bb60-5fe17f21ef6f"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="a14fa2ad-87ee-41a9-a8e5-d4c744c8638a" name="FIP DY">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="672edcc1-27f3-4b79-a02c-c733a0dd6711" targetElement="#96571da6-1bdf-465d-86bc-e356059c995b"
                      sourceElement="#a14fa2ad-87ee-41a9-a8e5-d4c744c8638a"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="d7f55cfa-c4fb-4849-9d4d-99cd71a87349" name="FIP DYR">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="c883ca84-369b-4eb3-a3fc-e53ee63d41c6" targetElement="#339d9684-31f5-4eae-8be0-4ca780830426"
                      sourceElement="#d7f55cfa-c4fb-4849-9d4d-99cd71a87349"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="0539dbf8-0b9d-4a90-afb1-54249f377b51" name="FOP Ppsi">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="7532fc98-df19-4026-802b-e0eec7f5d658" targetElement="#6750e545-1c87-4ff8-aff8-86467872bab7"
                      sourceElement="#0539dbf8-0b9d-4a90-afb1-54249f377b51"/>
