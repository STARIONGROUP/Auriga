                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="d4d1da9c-e574-4316-b186-e75768e0bb0b" sid="d7487f7a-61dc-4e36-b2dd-b71fb604b19b"
                    name="FOP 4">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="9c4b7b6c-54f6-4cc8-8bee-e7b05ae038cf" targetElement="#b28b7cbc-fb35-4c10-8665-bb0a80f9a918"
                      sourceElement="#d4d1da9c-e574-4316-b186-e75768e0bb0b"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="f318133e-ad0c-48cf-9161-5d361e4207af" sid="cb695684-ea06-4bcc-9355-0e51b507dcc7"
                    name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="0a7a777f-cd0a-4220-8b49-069b7ed159b2" targetElement="#b04cdbba-dc4d-4984-9feb-06360ee1d74c"
                      sourceElement="#f318133e-ad0c-48cf-9161-5d361e4207af"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="22da8949-10e4-43b5-a739-32257e8bcf3b" sid="5464ce22-8594-445b-a1b8-d9189bf0124d"
                    name="FOP 3"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="08564654-4f5d-4ebb-b6c0-e1c7eebc1c31" sid="4cca83a7-c6df-4901-9e8e-bfcbadc675b6"
                    name="FOP 5">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="3b073bab-371e-4edc-bf04-9d9df831690c" targetElement="#2220645f-56cf-4913-9da4-b8af5ed4fa3c"
                      sourceElement="#08564654-4f5d-4ebb-b6c0-e1c7eebc1c31"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="ddab89ca-81dc-4d63-bfd1-12ffb264e997" targetElement="#82643582-9aaf-4d67-840c-b61d14791531"
                    sourceElement="#6a01556f-f6c9-448f-b657-cd42b87a624e"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="c70fe015-faae-4d63-8eb4-e6caafe00796" sid="52c682d5-a257-4c33-998e-d40f9b697bdc"
                  name="[SF4.2.2] Run speed control" description="&lt;p>This function provides the speed consign to be followed by the drone in Speed AP mode, and the programmed payload control parameters&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>When Automatic control start is set to &amp;quot;Start&amp;quot;, the main processor shall compute the Drone speed consign as defined in the Pilot control consigns.&lt;/p>&#xA;&#xA;&lt;p>When automatic control start is set to &amp;quot;Stop&amp;quot;, the main processor shall set the Drone speed consign to 0.&lt;/p>&#xA;&#xA;&lt;p>&lt;em>Note : if the pilot sets the control mode to &amp;quot;Speed consign mode&amp;quot; but has not started yet the Automatic control, the drone stays in the current position.&lt;/em>&lt;/p>&#xA;&#xA;&lt;p>When Automatic control start is set to &amp;quot;Start&amp;quot;, the main processor shall compute the Programmed payload control as defined in the Pilot control consigns.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Drone speed consign and Programmed payload control validity status as follows : IF (Automatic control start is INVALID) OR (Pilot control consigns is INVALID) THEN Drone speed consign and Programmed payload control are INVALID ELSE Drone speed consign and Programmed payload control are VALID.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="f1a7911f-46a9-4278-a708-bd61846edde3" sid="afac5860-5ed8-45c9-a7e1-b5296daaaf44"
                    name="FIP 6">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="8090b0ff-d0f5-45fb-aac2-dddd23daece9" targetElement="#e1aa6940-e0ce-411c-8761-da24a87853fa"
                      sourceElement="#f1a7911f-46a9-4278-a708-bd61846edde3"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="7285e45f-43fd-4c1c-9610-5575fe234c7d" sid="0d2fd06e-58b1-44bd-aca1-2c6204a2d127"
                    name="FIP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="86f4b662-6e2d-4bce-8cb1-a342a20ce4a8" targetElement="#1187dfaf-9a5c-4cc6-8cc7-035ab2f5d69b"
                      sourceElement="#7285e45f-43fd-4c1c-9610-5575fe234c7d"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="dcba2f4d-3349-4060-86e9-21ebc4e9ea42" sid="f7c9f25b-0f17-4a56-ba9f-99661330a6f7"
                    name="FOP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="d260df63-8a96-4f6b-9a56-1f1c46b69070" targetElement="#624448cc-ac97-4409-9064-51356bd6be4f"
                      sourceElement="#dcba2f4d-3349-4060-86e9-21ebc4e9ea42"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="059375ad-e747-4ac8-ba41-36f60b434517" sid="b6940f40-8345-4b0e-b512-c1034e273c03"
                    name="FOP 3"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="d467e871-ab79-4175-aa19-6e2eefa049c4" targetElement="#82643582-9aaf-4d67-840c-b61d14791531"
                    sourceElement="#c70fe015-faae-4d63-8eb4-e6caafe00796"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="c38beda3-2b82-419d-b2e1-fbf838997eef" sid="859cea30-7dd5-4a60-ace4-db66141f303b"
                  name="[SF4.2.3] Select automatic payload control" description="&lt;p>This function select the appropriate payload control parameters according to the selected control mode.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall select the Automatic payload control value and validity status as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup span=&quot;5&quot; width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; height=&quot;70&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Selected AP mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Flight plan payload control Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Programmed payload control validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control validity status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;96&quot; rowspan=&quot;2&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Flight plan mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Flight plan payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Flight plan payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;96&quot; rowspan=&quot;2&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Speed consign mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Programmed payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Programmed payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="2227db3f-080d-40e3-a1ea-8163bf350d94" sid="ccd1d90e-0430-4ef1-b099-528abf87e846"
                    name="FIP 7">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="9a927234-e4a8-4537-b6da-7a21249451a6" targetElement="#c2067d4e-5a5a-4aa7-b717-5e78710da1a6"
                      sourceElement="#2227db3f-080d-40e3-a1ea-8163bf350d94"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="fb504f09-c759-454d-ae2b-a779a1462c6a" sid="30f6ec28-786f-4413-9108-9e656f9b458e"
                    name="FIP 2"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="714a95e4-139a-485f-883f-de7941dc8d09" sid="a2c97152-4ca6-43fb-87f5-f25b934a6ba3"
                    name="FIP 3"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="f1320a2c-b725-48ee-a5da-9da4f7a059d4" sid="74987de6-fdd1-4555-84cc-2aea21407686"
                    name="FOP 5">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="4442069e-758b-4c4b-b9a7-f7db7a9ad4c3" targetElement="#5563985b-8c9c-4f0d-8ec6-11da25357f53"
                      sourceElement="#f1320a2c-b725-48ee-a5da-9da4f7a059d4"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="d3aa6e43-465b-405c-b30e-d6af7b69fee0" targetElement="#82643582-9aaf-4d67-840c-b61d14791531"
                    sourceElement="#c38beda3-2b82-419d-b2e1-fbf838997eef"/>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="537ccfa6-0f2f-4315-b99e-b3fd8b5d7fe1" targetElement="#82643582-9aaf-4d67-840c-b61d14791531"
                  sourceElement="#59b60f00-408f-4a84-9862-d49a206a347e"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="78f264da-7cd5-4e46-a6ea-51b0fe1f5bb7" sid="eccdf852-02bb-427b-8f42-132213d89f9c"
                  name="Flight plan payload control" target="#fb504f09-c759-454d-ae2b-a779a1462c6a"
                  source="#22da8949-10e4-43b5-a739-32257e8bcf3b"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="78bc77b0-869c-4d84-a29d-b0026b7f8fac" sid="ff850f8f-5504-4109-b2e8-6400e04950fa"
                  name="Programmed payload control" target="#714a95e4-139a-485f-883f-de7941dc8d09"
                  source="#059375ad-e747-4ac8-ba41-36f60b434517"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="d1263f11-3625-4876-a9e6-94080c255f92" sid="9a6d5e8c-257d-4803-bc55-df7d4f439705"
                name="[SF4.3] Select control mode" description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>The drone pilot can always select control mode and override automatic flight plan mode with the &amp;quot;Pilot control mode&amp;quot; and&amp;quot;manual override&amp;quot;&amp;nbsp;signal. Then, the function interrupts the flight plan with the &amp;quot;flight plan interruption&amp;quot;. &lt;/span>&lt;/p>&#xA;&#xA;&lt;p>&amp;quot;Manual override&amp;quot; signal has been added in V4.3.&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&amp;nbsp;&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="8d82e7cb-fb87-4d87-b99c-a48916dfd3b4" sid="c708a796-d797-4646-b5ec-dd5dede215e8"
                  name="[SF4.3.1] Select drone control mode" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall select the AP mode as follows&amp;nbsp;:&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup width=&quot;204&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup span=&quot;3&quot; width=&quot;207&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup span=&quot;4&quot; width=&quot;245&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;2&quot; height=&quot;26&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Pilot control mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Manual override&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;1&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Mission completed&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Selected AP mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Selected control mode&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;26&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;26&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>OVERRIDE&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Speed consign mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;26&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Speed consign mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;26&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Completed&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Speed consign mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;26&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>&lt;i>N/A&lt;/i>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Speed consign mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;26&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>&lt;em>N/A&lt;/em>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>&lt;em>N/A&lt;/em>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Speed consign mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;26&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Speed consign mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>NO OVERRIDE&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Speed consign mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;26&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Flight plan mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>NO OVERRIDE&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Not completed&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Flight plan mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;&#xA;&lt;p>&lt;em>Note : in manual mode, the value of selected AP mode has no impact. The choice of setting AP mode to speed consign mode is justified so that an inadvertent transition of &amp;quot;Automatic control start&amp;quot; does not result on the execution of the programmed flight plan.&lt;/em>&lt;/p>&#xA;&#xA;&lt;p>&lt;em>Note : in the current control strategy, the manual mode is considered as a &amp;quot;failsafe&amp;quot; mode when AUTO modes cannot be executed safely. Therefore, the invalidity of any input data for the mode selection leads to select the MANUAL mode. When all the input data are valid, &amp;quot;Manual override&amp;quot; and &amp;quot;Mission completed&amp;quot; date have the priority to force the MANUAL mode. Therefore, to select an AUTO mode, all input must be valid, the manual override must not be selected and the mission not completed.&lt;/em>&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="1df38c10-7638-4038-ac73-2b625bfd7bc8" sid="ff06e455-3c66-4f4b-94ac-0bd3d128e205"
                    name="FIP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="8e269327-4fa1-4396-bfac-42351994f3e9" targetElement="#c6bd69f0-9640-49b2-92f2-33e131749b87"
                      sourceElement="#1df38c10-7638-4038-ac73-2b625bfd7bc8"/>
