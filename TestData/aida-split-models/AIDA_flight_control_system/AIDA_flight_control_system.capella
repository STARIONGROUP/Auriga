                <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                    id="8240afeb-0baa-4b8d-9579-26e12adc076e" targetElement="#42842273-9d61-45e7-91b1-39d28597cfe0"
                    sourceElement="#492c229b-20b4-421a-8762-692185764608"/>
              </ownedFunctionalExchanges>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="c09b0bff-c2e5-4941-aa7d-25d06ddab9bb" name="Pitch consign" target="#9803a291-23d6-49e4-9cfd-bdc91729df37"
                  source="#bc29f181-3ac4-461b-9c8c-1bf965f16382">
                <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                    id="6b75fe30-ea85-4dc8-9242-645871097146" targetElement="#894fedee-f541-4e9b-a2d0-9c66c1c43d38"
