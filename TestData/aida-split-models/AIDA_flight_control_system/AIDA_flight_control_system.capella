                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="9cf787c7-0550-4a0b-b132-97c9c4d0033f" name="FIP 13">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="ae7207d2-6b55-46cc-9d38-0dfd64c81cfa" targetElement="#11c59ecd-7fd8-472e-b65a-a753df2aeeda"
                      sourceElement="#9cf787c7-0550-4a0b-b132-97c9c4d0033f"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="73808931-dd38-4fbc-b6f0-2a67bb008a21" name="FIP 14">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
