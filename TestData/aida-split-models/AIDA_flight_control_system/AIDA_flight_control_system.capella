          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="cf002aa9-dfa2-4ac4-9c05-154b877fda93" name="[SF3] Provide drone navigation data">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="446e80aa-e0c1-41d1-8ce6-7a11f911670f" name="[SF3.1] Measure physical values"
                description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;FR&quot;>les attitudes sont estim&amp;eacute;es &amp;agrave; partir des mesures gyro. Les biais des gyro roulis et tangage sont estim&amp;eacute;s gr&amp;acirc;ce &amp;agrave; la comparaison avec la mesure de la gravit&amp;eacute; effectu&amp;eacute;e par les acc&amp;eacute;l&amp;eacute;rom&amp;egrave;tres (fen&amp;ecirc;tre temporelle d&amp;rsquo;environ 30s, en l&amp;rsquo;absence de commande d&amp;rsquo;attitude). &lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;FR&quot;>Le biais gyro en lacet est estim&amp;eacute;e gr&amp;acirc;ce au magn&amp;eacute;tom&amp;egrave;tre (hypoth&amp;egrave;se Terre plate . Direction du nord magn&amp;eacute;tique fixe pendant la mission)&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>&lt;span lang=&quot;FR&quot;>Note : confirm that pitch and roll consigns are used only to detect the absence of attitude command and trigger the gyroscop bias estimation (only during init phase on ground ?)&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&amp;nbsp;&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="e4a7f0c3-89f1-4427-af97-3ee523fa29b0" name="[SF3.1.1] Measure drone acceleration"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The inertial reference sensors shall measure the&amp;nbsp;linear acceleration along X, Y and Z axis, and provide an associated&amp;nbsp;validity status.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="1ade15bd-aa90-4808-bdee-9e16f80f62d8" name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="53910831-5047-43cf-8be7-e51243d2cc86" targetElement="#797e45a9-a8eb-42c4-9160-77a49b04d397"
                      sourceElement="#1ade15bd-aa90-4808-bdee-9e16f80f62d8"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="611a9a9f-df93-4a7b-acb1-7c9b66c7b4a5" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="1a5c131d-40ad-46da-9e28-a91315400563" targetElement="#f2bb1793-b6a7-466e-9322-0f1a747ee506"
                      sourceElement="#611a9a9f-df93-4a7b-acb1-7c9b66c7b4a5"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="153cf610-cd39-4360-b263-8031eec1f424" targetElement="#365edda7-6d17-4b8a-87d1-1a86945d7bed"
                    sourceElement="#e4a7f0c3-89f1-4427-af97-3ee523fa29b0"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="15041a2a-8a6e-4d81-9c4b-ee5ed737d363" name="[SF3.1.2] Measure drone rate"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The inertial reference sensors shall measure the angular rate along X, Y and Z axis, and provide an associated&amp;nbsp;validity status.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="4c57f28b-0f15-4a83-932f-23d5a42da903" name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="7e9a84db-1e8e-42bd-a090-9039f66ccb9a" targetElement="#0aac1780-1f4c-4a3d-8eb8-0c95c0b81847"
                      sourceElement="#4c57f28b-0f15-4a83-932f-23d5a42da903"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="a4b091ad-f0ec-4172-9d02-06a70c856e50" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="01ce71bb-7241-4e31-a9af-0ed725a9a696" targetElement="#062f3886-a055-4ed3-bfb5-1d599a2165ab"
                      sourceElement="#a4b091ad-f0ec-4172-9d02-06a70c856e50"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="22305d31-68c8-4f8e-b919-3603c56aec06" targetElement="#48ec883f-06e1-4d0b-90a3-b6b831527c7f"
                    sourceElement="#15041a2a-8a6e-4d81-9c4b-ee5ed737d363"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="3258ba6a-e13a-47f0-9bf7-bc5f26251733" name="[SF3.1.3] Measure magnetic north direction"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The magnetometer shall measure the north direction, and provide an associated&amp;nbsp;validity status.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="6db03b72-7f56-4e66-b90f-3d8bedc6851b" name="FIP 1">
