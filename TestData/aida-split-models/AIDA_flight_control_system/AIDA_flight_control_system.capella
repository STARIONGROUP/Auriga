              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="8c79c5c1-493e-4995-8adc-1b7040c1b999" name="Yaw consign" target="#47ea572f-d305-4156-bb60-5fe17f21ef6f"
                  source="#7af2c5e1-8270-40cc-8053-75dc2b21bffa">
                <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                    id="8f3b4500-a74e-40db-b64e-ec01a3df05f1" targetElement="#7c2fed99-aaec-41d6-9899-46e249f03bb4"
                    sourceElement="#8c79c5c1-493e-4995-8adc-1b7040c1b999"/>
