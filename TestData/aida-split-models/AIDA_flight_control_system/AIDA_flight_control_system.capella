                      id="c15ded1b-019e-4f72-b50d-8bb057edb926" targetElement="#535719be-23cf-4c10-be6d-e095182627b6"
                      sourceElement="#bf662635-c479-48c7-a4ce-0db9a5c175cc"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="f57d9801-2622-4d83-80c8-7db94a946bf9" name="FIP DP">
