                  id="c3e27061-690f-4dd0-bae3-ecb0009b56f7" sid="ddfd7595-aa8e-43be-b4ff-ceffb088c175"
                  name="Selected AP mode" target="#16aa9d91-d707-4b47-9b36-250ea4879458"
                  source="#c64e770a-35b9-4854-b2b9-e1cc98bd5763"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="a8be24ef-4527-46b9-9e89-ca4628c640b0" sid="cdfefed3-557a-4d8c-a921-caeea2bc9d82"
