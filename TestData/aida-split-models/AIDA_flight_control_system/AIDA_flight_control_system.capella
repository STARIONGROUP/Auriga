                      sourceElement="#4be46069-677f-41de-9cce-8511bec2d888"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="6a182e34-0f9f-4a00-9da1-2c0b1b6e130e" sid="a42a17a9-5593-4651-ab64-ea0e9668b2f4"
                    name="FOP 1"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="d7d2d0d7-9072-44b8-931f-361ab90f382a" targetElement="#19d9d5bf-2b0d-44dc-ad30-07fd99a40ef6"
                    sourceElement="#63635767-fe0b-4f17-b7fa-c090ac3fda92"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="b7ddb761-3b08-401f-a35f-dd70f5ad3350" sid="7c58d23a-d38a-417b-b6d5-7c110755cdb6"
                  name="[SF7.3.4] Monitor drone motors" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>For each motor, the Monitoring processor shall compare Motor rate and Motor rate measured.&lt;/p>&#xA;&#xA;&lt;p>For each motor, the Monitoring processor shall detect a Motor runaway as follows : IF (Motor rate measured is INVALID) OR (a discrepancy is detected between Motor rate and Motor rate measured) THEN Motor runaway = RUNAWAY DETECTED ELSE Motor runaway = NO FAILURE&lt;/p>&#xA;&#xA;&lt;p>&lt;em>Note : Motor consign failure are already covered in SF7.4.3.&lt;/em>&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="02c2023a-de12-47e7-9365-a5ca9738170b" sid="a916733c-c0b8-4ae0-a381-b5b243d57b6a"
