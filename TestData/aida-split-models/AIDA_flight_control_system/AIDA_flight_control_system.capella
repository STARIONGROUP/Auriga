              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="4e00178d-666b-4c30-a978-ba01589a75a1" sid="f235e260-12cb-48b3-bdbd-f9d9e0ba73f9"
                  name="FIP AP cons"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="5507e83e-3589-4345-be31-511cff75fb55" sid="221b2ed2-62fb-4b54-9328-cc7a2f378767"
                  name="FIP AP Eng"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="c4da534a-de13-4b55-8e9d-b76a12f9c8ae" sid="5d4db713-8567-4964-9b5b-00ab25048bbe"
                  name="FIP Rollcons"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="3f7cad75-c9c4-48b0-bbaf-fd7378cd86d7" sid="0d60a4aa-510c-444e-8320-a44465867428"
                  name="FIP Pitchcons"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="05fd1f4b-1792-49a9-a355-fd0c94fc7ab0" sid="d6d89294-e63d-41c9-babf-3cc3a1522438"
                  name="FOP Pt"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="7b895c3d-699f-4e89-8858-289464a8b8f0" sid="3453be3b-b6ef-4a1d-bc5d-56768ef9caf2"
                  name="FOP Pphi"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="5c513b7f-fc20-4a50-bbca-d8e659bd6750" sid="b430e36e-0dd3-4ea9-9a81-d8de482fe200"
                  name="FOP Ppsi"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="db6baceb-4520-41b9-8984-d42679f241c8" sid="86c6098e-1269-40b3-987f-65d78b060bbd"
