              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="d98f4c4e-259c-4269-ae21-ea8007f94a2c" sid="ba068d7d-fb2b-4be0-a372-a9c6da81ad69"
                  name="Measured pressure MON" target="#1e28cc33-9313-4d34-93e1-4f3baf8546c9"
