            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="2190007d-2686-4bf1-893c-f17a56ce3906" name="[SF7.2] Control attitude and altitude MON">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="3ecd37a7-88f1-403f-9ff6-32d07210b4f0" name="[SF7.2.1] Compute total thrust MON"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute Tmanual MON&amp;nbsp;as the result of the closed loop control of the&amp;nbsp;altitude to reach the Altitude consign from the current altitude measurement and Drone pitch&amp;nbsp;and&amp;nbsp;roll&amp;nbsp;measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Tmanual MON&amp;nbsp;validity status as follow : IF (Drone pitch is INVALID) OR (Drone&amp;nbsp;roll validity status&amp;nbsp;is INVALID) OR (Altitude consign validity status&amp;nbsp;is INVALID)&amp;nbsp;OR (Altitude validity status&amp;nbsp;is INVALID)THEN&amp;nbsp;Tmanual validity status is INVALID ELSE&amp;nbsp;Tmanual validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="56182958-56c6-46e9-88ff-1152644dfb91" name="FIP Pitch">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="62e6a055-bb9c-49b3-b846-ed98a76ad4ee" targetElement="#201f5c2d-9ad2-43bf-8a34-b40ac223a661"
                      sourceElement="#56182958-56c6-46e9-88ff-1152644dfb91"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="0dc9360d-ff29-4cf6-8f88-08ca9541713e" name="FIP Alt">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="3b07f542-bee8-417c-b157-d63b41426107" targetElement="#46a009fa-9f12-4cf0-afb9-64ef9d096657"
                      sourceElement="#0dc9360d-ff29-4cf6-8f88-08ca9541713e"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="e3f83092-3064-46b0-97a8-900b6ae94799" name="FIP Roll">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="ec5c928f-5da9-441c-a7b1-5c7fbd87046e" targetElement="#a4b904d5-c52b-4846-a070-a7056922c688"
                      sourceElement="#e3f83092-3064-46b0-97a8-900b6ae94799"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="33b9db42-c121-4cb8-9617-baa140e2804a" name="FIP 4">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="3f8ea1f5-b00a-45f4-a87f-97ffd40db030" targetElement="#a693f5f9-10d2-4578-ba55-3c83271b63d1"
                      sourceElement="#33b9db42-c121-4cb8-9617-baa140e2804a"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="5c5f5e7c-3d98-471d-a2aa-762d92fd251a" name="FOP T">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="a71092b3-4ad3-4c2a-9862-5db3a87c0f77" targetElement="#ac851cc0-8c8d-4b2f-be96-2533489a1fa6"
                      sourceElement="#5c5f5e7c-3d98-471d-a2aa-762d92fd251a"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="4c93c580-73fc-447f-be38-b79d664f4cb8" targetElement="#e4f21e5e-eeb5-4521-9383-bcce6830aa75"
                    sourceElement="#3ecd37a7-88f1-403f-9ff6-32d07210b4f0"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="bc3456d2-2f29-465d-a3b0-83eb2b9af623" name="[SF7.2.2] Select total thrust consign MON"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall select the&amp;nbsp;Total Thrust&amp;nbsp;consign MON&amp;nbsp;as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup width=&quot;204&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;207&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup span=&quot;2&quot; width=&quot;245&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Tmanual MON Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Thrust AP Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Selected Thrust&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Validity status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Thrust AP&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Thrust AP&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Tmanual MON&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Tmanual MON&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="1e29f543-bdd5-46d1-be5a-7f80bb8c9da2" name="FIP T AP">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="ef38760f-b6ff-47ce-84a7-507787c14f1c" targetElement="#402ca961-e0f8-413a-a154-fc52edcf512a"
                      sourceElement="#1e29f543-bdd5-46d1-be5a-7f80bb8c9da2"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="473b298b-db47-44eb-a270-13ec63482da3" name="FIP Tman">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="5ce1d3e1-e6e5-4273-8922-fb720d940864" targetElement="#9dcee7f1-fb91-470b-8494-6e7a08d95e49"
                      sourceElement="#473b298b-db47-44eb-a270-13ec63482da3"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="1ab68f81-169b-46bc-b9c5-ad2988f65bdb" name="FIP Eng">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="2542b84e-9674-45af-917a-233ea7a17a87" targetElement="#c5e205f1-187a-41de-888a-60aee00de95e"
                      sourceElement="#1ab68f81-169b-46bc-b9c5-ad2988f65bdb"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="704a8dff-e63b-46b1-abcd-ea68942ad36b" name="FOP T">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="1907fe74-46e7-410e-8974-b0a2bb313dab" targetElement="#ce69153a-4797-4a44-92ad-12b68a415669"
                      sourceElement="#704a8dff-e63b-46b1-abcd-ea68942ad36b"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="9b3a6850-a468-48a7-ae6b-41bb39a61091" targetElement="#43551775-645b-478e-ac66-184117d9b669"
                    sourceElement="#bc3456d2-2f29-465d-a3b0-83eb2b9af623"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="89f70e19-d2f5-40d9-a417-975b2fe5e250" name="[SF7.2.3] Select attitude consign MON"
                  description="&lt;p>REQ&lt;/p>&#xA;&#xA;&lt;p>- The monitoring processor shall select the&amp;nbsp;Pitch&amp;nbsp;consign MON&amp;nbsp;as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup width=&quot;204&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;207&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup span=&quot;2&quot; width=&quot;245&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Pitch&amp;nbsp;consign Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Attitude AP consigns Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Selected Pitch consign MON&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Validity status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA