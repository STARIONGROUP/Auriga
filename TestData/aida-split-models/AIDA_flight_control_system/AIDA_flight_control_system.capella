            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="aca85523-bbad-4131-a9b8-8247474c6bf9" name="[SF7.3] Monitor drone parameters">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="f5141e80-71d2-4c8e-a9d3-cc1423ff7027" name="[SF7.3.1] Compare drone attitude"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compare drone attitude and drone attitude MON.&lt;/p>&#xA;&#xA;&lt;p>The monitoring shall compare drone attitude rate and drone attitude rate MON.&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall detect an attitude measurement failure as follows : IF (drone attitude is INVALID) OR (drone attitude rate is INVALID) OR (drone attitude MON is INVALID) OR (drone attitude rate MON is INVALID) OR (a drone attitude discrepancy is&amp;nbsp;detected) OR (a drone attitude rate discrepancy is detected) THEN attitude measurement failure&amp;nbsp;= FAILURE DETECTED ELSE attitude measurement = NO FAILURE.&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall detect an attitude measurement failure as follows :&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="1259802e-4e80-424e-8fa4-3f28e768dbf4" name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="116b21a0-a241-4351-a363-b3797107a6ed" targetElement="#e179f6bb-543e-4cc8-b1eb-bc4798d04be4"
                      sourceElement="#1259802e-4e80-424e-8fa4-3f28e768dbf4"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="1e5689ec-509f-4394-9fd4-e2fe97af1a07" name="FIP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="ba4deb5e-7f5c-476c-a300-474214c152c0" targetElement="#be9a386c-e692-463c-ab92-8081f5cae824"
                      sourceElement="#1e5689ec-509f-4394-9fd4-e2fe97af1a07"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="a0e54405-4ee2-4dc0-9e5a-51070901c2bc" name="FIP 9">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="489da8cc-50b3-4eef-9409-ab9d155e9758" targetElement="#b90e3992-983e-4a51-b903-6e1a17fddc7a"
                      sourceElement="#a0e54405-4ee2-4dc0-9e5a-51070901c2bc"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="2fe919b0-a165-4585-acbc-55b72ab37f9e" name="FIP 10">
