                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="5ead725f-28f1-4854-a2a7-e777e15689d4" targetElement="#ac63c351-97f8-483b-b8cf-a8ba1063a306"
                    sourceElement="#b66d3238-d024-4427-a3d1-5d4fc1237377"/>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="008f05a5-8b93-414d-ba50-ab3bf419df5c" targetElement="#ac63c351-97f8-483b-b8cf-a8ba1063a306"
                  sourceElement="#e5017d03-647c-4b07-972d-e01fc1e2145e"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="7f25a872-31ff-4883-9685-7f86ae0c8827" sid="be2f8504-5786-46f4-b19b-d7df0bd4edf4"
                  name="Altitude consign" target="#623b0980-0e4b-416b-8e5c-ebd360affbde"
                  source="#586c8ad6-49dc-4a83-8c7e-cc086cb074b7"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="c63029b0-362c-41a8-86ad-68a1a5f4f7f3" sid="12d0082a-ec1f-4597-8e21-6cbe7ae8c9f2"
                  name="Tmanual" target="#7e2bab04-c634-4781-af88-e701a55168ef" source="#8cb5340e-3fd9-40fb-8c2e-9e7621120dd1"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="cec99b79-555b-4435-809d-8736002081f8" sid="a99351ae-d454-4594-9ada-9d6a8b1808d7"
                name="[SF2.5] Compute motor commands" description="&lt;p>This function computes the engines rotation rate demands to generate the various thrust components :&amp;nbsp;total vertical&amp;nbsp;thrust (to control the altitude) and torque generated around the various axis (to control the attitude).&lt;/p>&#xA;&#xA;&lt;p>Ptheta/phi/psi are the forces needed to generate a rotation around the corresponding axis (=Torque X Lever_arm).&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="a23af858-33c0-4f7f-b4be-a4689bd3f69c" sid="00217877-bab0-4431-bcdd-00680d096be9"
                  name="[SF2.5.1] Compute motors expected thrust" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the thrust required from each propeller P1, P2, P3, P4 with the following formulas :&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>1&lt;/font>&lt;/sub> = Thrust + P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>2&lt;/font>&lt;/sub> = Thrust - P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>3&lt;/font>&lt;/sub> = Thrust- P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> + P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>P&lt;sub>&lt;font size=&quot;2&quot;>4&lt;/font>&lt;/sub> = Thrust + P&lt;sub>&lt;font size=&quot;2&quot;>Theta&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>Phi&lt;/font>&lt;/sub> - P&lt;sub>&lt;font size=&quot;2&quot;>psi&lt;/font>&lt;/sub>&lt;/span>&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the P1, P2, P3, P4 validity statuses as follows : IF (Thrust is INVALID) OR (PTheta is INVALID) OR (Pphi is INVALID) OR (Ppsi is INVALID) THEN P1, P2, P3, P4 are INVALID ELSE P1, P2, P3, P4 are VALID.&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&amp;nbsp;&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="42d0cd43-5e66-4d33-a590-3ed0ad817f70" sid="5769320c-c32d-4e10-a14c-ca1230f0ee06"
                    name="FIP Pt">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="43c629f4-edb2-4ade-90cf-cfd9adb660a5" targetElement="#afc01bc3-8ed9-4d83-bef5-4b2d2113d56c"
                      sourceElement="#42d0cd43-5e66-4d33-a590-3ed0ad817f70"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="843573b4-5b7a-47a1-b03a-c19f8761a815" sid="c943e445-c272-4446-9d10-820ca59ec981"
                    name="FIP Pphi">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="e2a1acb6-eb9b-4a06-93e9-b4da8a03ab40" targetElement="#5b011609-8210-4b62-a1ea-30ea9396b9ca"
                      sourceElement="#843573b4-5b7a-47a1-b03a-c19f8761a815"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="290a2893-6599-4015-9149-a4e468d0a756" sid="c3555e6d-cff7-4aa0-b439-40647ce0d21d"
                    name="FIP Ppsi">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="6157c231-a981-462b-b948-90d7434d01c0" targetElement="#ffbd8cc8-19af-4330-bfd5-6276a9f4c0a4"
                      sourceElement="#290a2893-6599-4015-9149-a4e468d0a756"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="ae52fadf-6a8e-4510-a9cf-4b0565d5ad6e" sid="34179cb8-d7f3-43df-99b9-d0098f3ad722"
                    name="FIP T">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="8e2998cb-c41c-42d3-a7ab-c24a4f01c39e" targetElement="#7a6269ad-f922-4163-b280-ad2488875907"
                      sourceElement="#ae52fadf-6a8e-4510-a9cf-4b0565d5ad6e"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="1061080b-49bb-45d5-9b1d-b2adfe56c7b8" sid="1de99de0-c831-4a84-9b7c-aaf37fa1e440"
                    name="FOP P1"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="88240ede-5683-432e-a858-eac21c6da321" sid="02eb39e3-5226-488d-9e01-4a80aeb22be2"
                    name="FOP P2"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="768e8ce7-4958-4c3e-9d79-fa02ddd42bc5" sid="9ebf1694-477e-4926-aba5-e257c8df8ce2"
                    name="FOP P3"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="aad98ebb-585d-4b11-bdc0-1768db6f1bcc" sid="9e8c5d65-c28c-44e9-a194-4fd914af756d"
                    name="FOP P4"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="7ce01b28-2a93-4272-bd1f-21a06d346ff2" targetElement="#df068524-9067-4a7e-8190-f6920e3f7582"
                    sourceElement="#a23af858-33c0-4f7f-b4be-a4689bd3f69c"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="37ae43fd-034e-41bd-919c-e4491d107ca8" sid="5fee77ff-f555-4c52-812a-c767b6d69f2a"
                  name="[SF2.5.2] Compute motors speed command" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the Motor 1,2,3,4 rotation rate for each propeller from the expected thrust as follows (Cprop_i being the propeller coefficient of the propeller i):&lt;/p>&#xA;&#xA;&lt;p>Motor i rotation rate = square_root(Pi/Cprop_i) (i=1,2,3,4)&lt;/p>&#xA;&#xA;&lt;p>- The main processor shall compute the Motor 1,2,3,4 rotation rate validity status as follows : IF Pi is INVALID THEN Motor i rotation rate is INVALID ELSE Motor i rotation rate is valid (i=1,2,3,4).&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="8a07ca84-6377-420a-82a7-0d0b26bcfe45" sid="45a40d9b-6ced-4574-a589-f871badd7dc3"
                    name="FIP P1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="60f7b6d9-ba67-4ba0-ae16-32f852c5b63c" sid="9511d48c-cbab-4dde-9e92-d32379deac5c"
                    name="FIP P2"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="7a5599ee-db6b-4112-a42c-064aa1031ba4" sid="216c0e5b-ebd9-48d1-bb03-15a29cc37856"
                    name="FIP P3"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="87fedeec-3de6-4ee7-bc3a-a59406f1a185" sid="949fbdb3-5c8b-478e-9551-25401703ec46"
                    name="FIP P4"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="235cb64b-a76c-448a-9e01-336e80fe4054" sid="084b83ce-a081-4604-8a66-9bb2fb64ed5c"
                    name="FOP 2">
