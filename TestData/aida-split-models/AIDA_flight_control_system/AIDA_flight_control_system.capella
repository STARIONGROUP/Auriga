                    id="75a4370f-d610-48ec-accf-4e62dc810cca" targetElement="#f3b6fc4c-59b4-4e09-87cc-4cafc7aca21a"
                    sourceElement="#f3e3fca7-54ca-4677-bb3d-6ea5ff796c1f"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="1e7dec23-ff01-462a-b2bc-40fa0000b0fd" name="FIP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="54e63eaf-d0b1-428d-955d-dcc5ff5e0f43" targetElement="#d3e2ff3f-408c-49f0-9e9c-1dc8ae2be4f8"
                    sourceElement="#1e7dec23-ff01-462a-b2bc-40fa0000b0fd"/>
              </inputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="b1a5f254-532a-42eb-8fe0-ff502aea9e2f" name="FOP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="169062d2-98c8-4089-a946-2ddd38eb989d" targetElement="#cb6f4448-a6cb-49c2-9999-f02cc537e084"
                    sourceElement="#b1a5f254-532a-42eb-8fe0-ff502aea9e2f"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="4affc269-786c-4c42-96f2-3a1768e5a657" targetElement="#828efa78-0a49-4f5f-b202-0be24c6fe799"
                  sourceElement="#71624ea6-0782-46d7-b46b-2019e9cf2494"/>
            </ownedFunctions>
            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="8d304c53-dd95-4caf-8896-0d0852666077" targetElement="#7e7caa1a-ebf5-404b-8cd7-fb065c6b37e2"
                sourceElement="#162cc5f7-9a16-438a-838e-36f2e35211e4"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="184f644e-b997-4e36-b097-a1584c4466f2" sid="75c5f7e3-f956-4884-a754-61158abf4939"
              name="[SF2] Control drone attitude and position" description="&lt;p>This function computes the engine rotation rate to ensure either (depending on the control mode) :&lt;/p>&#xA;&#xA;&lt;p>- in AP mode : &amp;nbsp;the speed and position demands provided by SF4&lt;/p>&#xA;&#xA;&lt;p>- in manual mode : the attitude and altitude demands provided by the pilot&lt;/p>&#xA;&#xA;&lt;p>(see breakdown for d&amp;eacute;tails)&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="06614c57-ad88-4f75-87a1-8ecec4fbdbe4" sid="bfd99b3b-d6e6-49fe-a6a7-8f30618c6ea5"
                name="[SF2.1] Automatically control drone position" description="&lt;p>This function computes the expected attitudes and total thrust to follow the position and speed consign (see breakdown for details).&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="9944d63d-b7d2-499e-a091-4a88d5464903" sid="5b4fa4f0-d7f2-4652-af7d-dbf1189379ce"
                  name="[SF2.1.1] Control position" description="&lt;p>This function realises the closed loop control on position, using the position demand from SF4 and position measurement from SF3. It computes the speed demand to follow the requested trajectory.&lt;/p>&#xA;&#xA;&lt;p>NB : the yaw angle, which is the azimuth of the camera axis, must also be part of the position demand. And the yaw rate is part of the speed demand.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Navigation speed consign as the linear speed vector to reach the Drone position consign from the current Drone position.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Navigation speed consign validity status as follow : IF (Drone position is INVALID) OR (Drone position consign validity status&amp;nbsp;is INVALID) THEN Navigation speed consign validity status is INVALID ELSE Navigation speed consign validity status is VALID&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c1c44b31-9513-4384-9185-46ac5bbcc0a7" sid="1af2a884-bb98-4bce-b2f8-fdecf287354e"
                    name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="c5d245c2-192f-4cc5-8fd3-4b99027db8ad" targetElement="#976f93d0-d83f-4cf7-95bf-ee8e954c5e52"
                      sourceElement="#c1c44b31-9513-4384-9185-46ac5bbcc0a7"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="6bcd6b65-9f86-4da3-a584-bbf173b2e912" sid="c3c3cb3a-6dca-495e-acef-d50da0b6e876"
                    name="FIP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="3c50c6e1-a412-4352-9715-390b2dac1624" targetElement="#a833c693-3cf9-4934-a28c-537d7a012972"
                      sourceElement="#6bcd6b65-9f86-4da3-a584-bbf173b2e912"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="b57f61db-f4e7-4577-9df1-bdfe6f5d08c9" sid="c81fb6be-f4f0-4d74-8406-200a8b5a0879"
                    name="FOP 1"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="e19379f9-39b3-455b-97c7-bef9cd9b4a19" targetElement="#2419e740-e4fb-448e-886c-3f16f038f0f8"
                    sourceElement="#9944d63d-b7d2-499e-a091-4a88d5464903"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="cffd1d97-1377-4247-bb92-1830e6363209" sid="76531947-d06a-4857-b82c-15c12b4a0849"
                  name="[SF2.1.2] Select speed consign" description="&lt;p>REQ&lt;/p>&#xA;&#xA;&lt;p>The main processor shall select the Speed consign as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup width=&quot;204&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;207&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup span=&quot;2&quot; width=&quot;245&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Selected AP mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Drone Speed consign Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Navigation speed consign Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Speed consign&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Validity status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Flight plan mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Navigation speed consign&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Navigation speed consign&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Speed consign mode&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Speed consign&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Speed consign&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="659a8dd5-91b4-41be-857d-9447f67a6d41" sid="ebe59f0a-6f15-46cb-a578-3d4e93c1f784"
                    name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="f98f9748-c10d-45ab-8f61-8e1bb37809da" targetElement="#0dbb6b09-3742-4b40-a048-a615913d0dbb"
                      sourceElement="#659a8dd5-91b4-41be-857d-9447f67a6d41"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="5c8da899-ba21-4da7-95f0-28352e82054f" sid="6c530db7-e119-4666-a7c4-ca6652d2b92f"
                    name="FIP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="f8429f32-462f-481b-b92f-2e53ac4970db" targetElement="#bbc581e9-636a-4cf7-a60b-56b57281934d"
                      sourceElement="#5c8da899-ba21-4da7-95f0-28352e82054f"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="dbb34122-69c4-45a1-8e7e-d4ad16b128d1" sid="24a4ee2e-ec75-4593-9d06-41aca31d52d2"
                    name="FIP 3"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="486331fa-287f-476a-86ba-64f02f31c5db" sid="95e83e82-75e9-4305-ba07-fe0b6c578535"
                    name="FOP 1"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="d04e2391-7be8-4764-ac59-7a4cbcfc141a" targetElement="#2419e740-e4fb-448e-886c-3f16f038f0f8"
                    sourceElement="#cffd1d97-1377-4247-bb92-1830e6363209"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="87fd0961-ddf4-4b87-b4ee-0b8285f26117" sid="ee0034de-0b20-4404-977c-2c679c85e22e"
                  name="[SF2.1.3] Control speed" description="&lt;p>This function realises the closed-loop control for speed, based on selected speed consign and speed measurement (ground speed and vertical speed). It computes the requested acceleration to reach the targeted speed.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the acceleration consign as the&amp;nbsp;linear acceleration vector to reach the&amp;nbsp;Speed consign from the current Vertical speed and Ground speed.&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Acceleration consign validity status as follow : IF (Speed consign&amp;nbsp;validity status is INVALID) OR (Vertical speed&amp;nbsp;validity status&amp;nbsp;is INVALID) OR (Ground speed&amp;nbsp;validity status&amp;nbsp;is INVALID) THEN Acceleration consign validity status is INVALID ELSE Acceleration consign validity status is VALID&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="8690eeda-944c-4f02-ae9a-710ab4bcf657" sid="d7dd5720-ea5a-41c6-a6ab-03aa6dc1bec3"
                    name="FIP 1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="61caedfa-b1cd-4749-b14d-7e41b1a4b028" sid="5a292eaf-619e-4495-aeab-0ac1b382f233"
                    name="FIP 2">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="f07a23fb-fdda-467d-b1a0-cf3c6da8544b" targetElement="#e0112252-f553-4a76-ab3d-53043ef1d098"
                      sourceElement="#61caedfa-b1cd-4749-b14d-7e41b1a4b028"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="35cd6d50-13fe-4bcb-86df-e45c212a43a8" sid="8993e2d8-2224-4104-9af0-c7d47680d5a4"
                    name="FIP 3">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="8b7b1af8-f003-4df3-a834-107f928e269b" targetElement="#2ca40643-3df9-4b07-a1c7-cb5d1b668db8"
                      sourceElement="#35cd6d50-13fe-4bcb-86df-e45c212a43a8"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="6ba88717-59dd-49e8-a80b-399e1212e14f" sid="a467e871-627c-4e9a-9a9b-a94dc81d6d89"
                    name="FOP 1"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="beb21993-355a-4cdb-907b-8389ae0e205a" targetElement="#2419e740-e4fb-448e-886c-3f16f038f0f8"
                    sourceElement="#87fd0961-ddf4-4b87-b4ee-0b8285f26117"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="596c48f4-6299-482f-8b14-ac88563fd020" sid="043c01a3-dc1f-4369-a9b9-f9fde0eb6580"
                  name="[SF2.1.4] Compute thrust and attitude consign" description="&lt;p>This function transforms the acceleration&amp;nbsp;demand (in the ground reference frame) into attitude and thrust demand (in drone body frame), using the attitude measures to compute the frame change matrix.&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Thurst AP consign&amp;nbsp;and Attitude AP consign that allow to generate the Acceleration consign., knowing the current attitude (Drone pitch, Drone roll, Drone yaw).&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Thrust AP consign validity status&amp;nbsp;and Attitude AP consign validity status as follows : IF (Acceleration consign is INVALID) OR (Drone pitch is INVALID) OR (Drone roll is INVALID) or (DRONE yaw is INVALID) then Thrust AP consign and Attitude AP consign are INVALID ELSE Thrust AP consign and Attitude AP consign are VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="7ccf48b3-5125-47bc-a7fb-056656d2f0a6" sid="c072bcde-62ff-48fe-b2ef-8ce2c3c37859"
                    name="FIP 1"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="49724781-ecc6-40e6-9594-931702c829fa" sid="43719066-8ec8-421e-894b-2848c1dce534"
                    name="FIP 3">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="708a54e1-a8e8-4249-a87f-172d887fafd6" targetElement="#c43c20fa-e20e-4b0d-992f-a59aaf4f40e6"
                      sourceElement="#49724781-ecc6-40e6-9594-931702c829fa"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="f29ab5c0-d006-4e53-9810-92483e84dc11" sid="b0165cfd-97c9-426e-89b2-0e8e1908fcd5"
                    name="FIP 4">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="ca67ac69-efb6-47fe-9271-ea341b413666" targetElement="#bbdbb30c-59cc-4ab9-bf6a-b0fbc4bcf1fa"
                      sourceElement="#f29ab5c0-d006-4e53-9810-92483e84dc11"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="4301a78f-f1ea-4ad7-980f-a559eeb5fdb5" sid="6ad4f13a-73b7-4b52-a7f7-a9d0be64b7cd"
                    name="FIP 6">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
