                  id="2c497e8b-167c-4d57-8c6a-e435ff27b230" sid="322e78f7-9d10-4439-a37b-a28b6581bd47"
                  name="FIP 3"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="979bdd08-b20b-4688-b633-38f99629a190" sid="7a8885fd-699f-4718-9a46-2fe0936072da"
                  name="FOP 1"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="8bf2fe98-96c7-410d-9474-241a16f3189c" sid="cd4b4638-23ec-4864-8924-4a3b5c99db04"
