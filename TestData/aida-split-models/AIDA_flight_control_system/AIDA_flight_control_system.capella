              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="5d155a0c-3614-487d-a9a6-78e77ca8b607" name="FIP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="336ee38a-623b-4545-bad8-8602c295ea77" targetElement="#1e7dec23-ff01-462a-b2bc-40fa0000b0fd"
                    sourceElement="#5d155a0c-3614-487d-a9a6-78e77ca8b607"/>
              </inputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="4cf25285-f5c8-4356-ae51-a3c9bead0d5c" name="FOP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="af6abd55-feb5-43bf-acd3-41d084fbad10" targetElement="#b1a5f254-532a-42eb-8fe0-ff502aea9e2f"
                    sourceElement="#4cf25285-f5c8-4356-ae51-a3c9bead0d5c"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="b7a5b14b-241b-4c22-b087-af2a813c9cd1" targetElement="#71624ea6-0782-46d7-b46b-2019e9cf2494"
