                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The telemetric sensor behavior shall measure the ground distance and provide an associated validity status.&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="df860729-bbd4-42dd-a742-6d3dd6f29c0f" name="FIP 1">
