            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="f5941e4a-9596-4923-90a0-f2e56215024c" sid="6367aad4-f15d-4fe7-9e00-ca131f3e7b73"
                name="[SF7.2] Control attitude and altitude MON">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="e4f21e5e-eeb5-4521-9383-bcce6830aa75" sid="01a3740b-0e1d-4d6f-91ca-f9abdbd2fe26"
                  name="[SF7.2.1] Compute total thrust MON" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall compute Tmanual MON&amp;nbsp;as the result of the closed loop control of the&amp;nbsp;altitude to reach the Altitude consign from the current altitude measurement and Drone pitch&amp;nbsp;and&amp;nbsp;roll&amp;nbsp;measurement.&lt;/p>&#xA;&#xA;&lt;p>The main processor shall compute the Tmanual MON&amp;nbsp;validity status as follow : IF (Drone pitch is INVALID) OR (Drone&amp;nbsp;roll validity status&amp;nbsp;is INVALID) OR (Altitude consign validity status&amp;nbsp;is INVALID)&amp;nbsp;OR (Altitude validity status&amp;nbsp;is INVALID)THEN&amp;nbsp;Tmanual validity status is INVALID ELSE&amp;nbsp;Tmanual validity status is VALID&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="201f5c2d-9ad2-43bf-8a34-b40ac223a661" sid="48602ef1-e9b4-45f0-a3ca-edbf0168196d"
                    name="FIP Pitch">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="5b1aaa42-165e-4adc-9c6a-2ae4a7b323ba" targetElement="#b94c341e-22c5-4077-a966-a5f353d71664"
                      sourceElement="#201f5c2d-9ad2-43bf-8a34-b40ac223a661"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="46a009fa-9f12-4cf0-afb9-64ef9d096657" sid="c256fc47-fcf4-4ff5-80a2-ba3ca15b1d95"
                    name="FIP Alt">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="41cc1d5c-5de1-478a-bb35-12103cd827c2" targetElement="#5a63ef47-81e2-4f5d-90c6-0a698059f5f3"
                      sourceElement="#46a009fa-9f12-4cf0-afb9-64ef9d096657"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="a4b904d5-c52b-4846-a070-a7056922c688" sid="0a2dadb1-08eb-4b10-b621-d0c5c868649c"
                    name="FIP Roll">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="6f670d71-94e4-41ae-ab80-2eea1fa13560" targetElement="#62d1309d-9b22-4b1e-b67f-92470c6eebac"
                      sourceElement="#a4b904d5-c52b-4846-a070-a7056922c688"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="a693f5f9-10d2-4578-ba55-3c83271b63d1" sid="9e4ee821-fb7d-4c14-91cb-c6ac53daaf26"
                    name="FIP 4"/>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="ac851cc0-8c8d-4b2f-be96-2533489a1fa6" sid="8f715c54-fdbe-40a8-aa8d-1c889dd967d5"
                    name="FOP T"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="af3a04c9-301a-4daf-b90b-47590014aa18" targetElement="#e2f2d4b4-7598-48d7-965e-5b9b09a8edce"
                    sourceElement="#e4f21e5e-eeb5-4521-9383-bcce6830aa75"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="43551775-645b-478e-ac66-184117d9b669" sid="f414e26b-d878-4669-838b-ebb6613b7bee"
                  name="[SF7.2.2] Select total thrust consign MON" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The monitoring processor shall select the&amp;nbsp;Total Thrust&amp;nbsp;consign MON&amp;nbsp;as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup width=&quot;204&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;207&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup span=&quot;2&quot; width=&quot;245&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Tmanual MON Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Thrust AP Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Selected Thrust&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Validity status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Thrust AP&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Thrust AP&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Tmanual MON&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Tmanual MON&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="402ca961-e0f8-413a-a154-fc52edcf512a" sid="5257ce82-2e18-450f-8b00-5a8432e725de"
                    name="FIP T AP">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="e087a7ef-5d24-446b-a0ab-7b09f2e4c902" targetElement="#7794fe40-3059-485d-9863-7b9912f7f106"
                      sourceElement="#402ca961-e0f8-413a-a154-fc52edcf512a"/>
                </inputs>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="9dcee7f1-fb91-470b-8494-6e7a08d95e49" sid="0664843d-43dd-41ea-9718-18ff8dc04073"
                    name="FIP Tman"/>
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="c5e205f1-187a-41de-888a-60aee00de95e" sid="80f2a8d7-3d17-4364-b20b-dbd482954995"
                    name="FIP Eng">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="51b22814-3959-4235-9032-564ea0606e49" targetElement="#7a393440-f809-43c9-95c9-1724914ecd1f"
                      sourceElement="#c5e205f1-187a-41de-888a-60aee00de95e"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="ce69153a-4797-4a44-92ad-12b68a415669" sid="30ee0150-1467-4e08-acba-0011b106b636"
                    name="FOP T"/>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="cb85fade-fd0d-4d92-9a8a-eab16f0f3f0a" targetElement="#e2f2d4b4-7598-48d7-965e-5b9b09a8edce"
                    sourceElement="#43551775-645b-478e-ac66-184117d9b669"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="ac9c2709-59bf-4281-9e06-dc03833a96fd" sid="691695e9-7cb0-413c-874d-d1e7d3466b24"
                  name="[SF7.2.3] Select attitude consign MON" description="&lt;p>REQ&lt;/p>&#xA;&#xA;&lt;p>- The monitoring processor shall select the&amp;nbsp;Pitch&amp;nbsp;consign MON&amp;nbsp;as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup width=&quot;204&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;207&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup span=&quot;2&quot; width=&quot;245&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;colgroup width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Pitch&amp;nbsp;consign Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Attitude AP consigns Validity status&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; colspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>Selected Pitch consign MON&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Value&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quot;>Validity status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;51&quot; rowspan=&quot;2&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-image: none;&quo