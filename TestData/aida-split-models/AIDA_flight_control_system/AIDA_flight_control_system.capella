                      id="28274a6b-5bf8-4ba2-acd1-5b59e95c03d5" targetElement="#ae4d9342-99bc-49ed-8327-84f0e0550990"
                      sourceElement="#d4000d82-72e6-4529-b1a3-556a29ff7bb0"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
