                    name="FOP M1R">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="e03e6f12-448f-4d4d-bd09-68216dc065eb" targetElement="#d4bebb77-7b12-4012-8d66-1cb0fa5c574a"
                      sourceElement="#913a822c-6b5e-4d02-a219-ba29a82198cb"/>
                </outputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
