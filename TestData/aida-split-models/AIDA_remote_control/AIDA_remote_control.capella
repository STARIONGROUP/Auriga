                    sourceElement="#093eb84c-80d9-4d49-b0fc-882f743decc4"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="787d4be1-1ea5-4f15-a486-dce5d12a5b32" name="FIP Rollcons">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="5fd10c2e-b903-4b4c-8118-d7ad20dfc4f2" targetElement="#cc2a71c5-3217-4676-ac32-3894b4ca17c0"
                    sourceElement="#787d4be1-1ea5-4f15-a486-dce5d12a5b32"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="2567c9d9-5342-486e-8a7e-2edadcd09c99" name="FIP Yawcons">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="59ff3a2d-dcaf-4f67-ab66-107319c87117" targetElement="#c2963bb8-6664-4241-9d13-8fcfae53c847"
                    sourceElement="#2567c9d9-5342-486e-8a7e-2edadcd09c99"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="c1998a22-2d72-4448-87bf-66dbeb7fc0b8" name="FIP Alt Cons">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="1f3e740a-1d9e-4953-ab47-27ff8525f1e6" targetElement="#42b3d12e-fde5-4e85-a788-ba3e3f4e59ee"
                    sourceElement="#c1998a22-2d72-4448-87bf-66dbeb7fc0b8"/>
              </inputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="6beef6dc-6e3d-4515-a8cb-25d69e14e80f" targetElement="#2faba3f7-5152-43c7-b701-4ef75f251ed8"
                  sourceElement="#bdf68f95-6d5a-4a17-b160-f10aa8ee1356"/>
            </ownedFunctions>
            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="fe136891-1b34-4fad-b1dc-694ac9b9805b" targetElement="#492d11a4-2f2b-43a1-936d-d6f09c5b875a"
                sourceElement="#80990b7f-6cab-4903-9de6-60a21eb84af9"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="8afd055e-6abb-46ef-bfbc-078af7a41123" sid="75c5f7e3-f956-4884-a754-61158abf4939"
              name="[SF2] Control drone attitude and position" description="&lt;p>This function computes the engine rotation rate to ensure either (depending on the control mode) :&lt;/p>&#xA;&#xA;&lt;p>- in AP mode : &amp;nbsp;the speed and position demands provided by SF4&lt;/p>&#xA;&#xA;&lt;p>- in manual mode : the attitude and altitude demands provided by the pilot&lt;/p>&#xA;&#xA;&lt;p>(see breakdown for d&amp;eacute;tails)&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="ae35a3cd-fe94-41cf-abf9-48d5a208c9ea" sid="99a496c2-c42f-41fc-857e-fa7f7092187a"
                name="[SF2.2] Acquire pilot orders" description="&lt;p>This function acquires the following pilots orders : manuel override, vertical speed, pitch demand, roll demand, yaw rate demand.&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="792053b9-6db0-4f4c-9f82-65de8de48a5f" sid="e4af7c54-78fe-463c-8141-6915d2de3807"
                  name="[SF2.2.1] Acquire pitch order" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote Pitch order and send it to the Drone as the Pitch consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="42b5fcf1-5183-4f85-b178-5537d20689a3" sid="68e19d36-e131-40f5-839b-62463921851e"
                    name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="6090319b-45f9-4a12-bd40-2ed34410eaa7" targetElement="#c00eb400-0f52-4cbd-99b3-e04b9be4db88"
                      sourceElement="#42b5fcf1-5183-4f85-b178-5537d20689a3"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="2ab9efa7-43bd-4ee5-870c-3021187a9f46" sid="893d8ffb-0a14-459f-ae10-229b69535e75"
                    name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="77261daf-c423-4034-86b2-ff004812ead1" targetElement="#c77e7c48-7af2-4801-a938-8a064ef93dc0"
                      sourceElement="#2ab9efa7-43bd-4ee5-870c-3021187a9f46"/>
                </outputs>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="2b8d7709-fb89-418b-8ca8-0565118e670b" sid="8095e524-3d88-4924-95b8-4a877736cfdf"
                  name="[SF2.2.2] Acquire roll order" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Roll order and send it to the Drone as the&amp;nbsp;Roll consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="6ea37fea-4fb8-4e09-b63a-b1da2538e191" sid="7c0b9a05-9327-4341-b5e5-f2d66c83129c"
                    name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="d2772e7e-b2f9-4ad4-8a6f-9722a84e4dcb" targetElement="#0f093de8-e453-43f3-a0fb-8b44cfbd86f2"
                      sourceElement="#6ea37fea-4fb8-4e09-b63a-b1da2538e191"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="89151cdf-fef3-4192-8885-b6ceab1c26c4" sid="fa21376c-d575-40af-a92c-395c8e7b24d2"
                    name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="140e8e02-295b-4b6e-beae-812868abb853" targetElement="#4df4756d-3e1b-4b95-8a8f-be692c3f16f6"
                      sourceElement="#89151cdf-fef3-4192-8885-b6ceab1c26c4"/>
                </outputs>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="a7d75531-676a-4653-a8dd-50849a5ae5ee" sid="44642563-3511-49e4-9cf3-98b08b96769d"
                  name="[SF2.2.3] Acquire yaw rate order" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Yaw rate order and send it to the Drone as the&amp;nbsp;Yaw rate consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="5e23dfea-64ec-4c92-9358-df7818815c7f" sid="628b4ff5-356f-42af-a3d5-7fe1fe32b2de"
                    name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="1f88bb57-6273-4413-8dfd-7f506d28a640" targetElement="#d4495789-f7d4-4bf2-a77d-5ac2a743e32f"
                      sourceElement="#5e23dfea-64ec-4c92-9358-df7818815c7f"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="aa47f6d7-50ae-4dbb-9067-9afe75ab08df" sid="95e831cd-3943-44d3-9650-8a8a06c231ef"
                    name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="41c861e1-cc6a-4ba7-b3b7-8a22cba65f82" targetElement="#9b4f3997-b822-426a-a1fe-93ebde596882"
                      sourceElement="#aa47f6d7-50ae-4dbb-9067-9afe75ab08df"/>
                </outputs>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="3f880e63-67fd-400d-bca6-606071785301" sid="2b05a498-2321-4c21-b149-dcedbd8a0031"
                  name="[SF2.2.4] Acquire vertical speed order" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Altitude order and send it to the Drone as the&amp;nbsp;Altitude consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="ae1ecda7-db50-40b8-b703-93f82af84ca9" sid="a2b3d418-a21e-4ca1-ad03-7eda97b1d908"
                    name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="d2039815-81b2-4d91-b8b8-0dbd57229be9" targetElement="#fde8f934-2f15-42b5-b158-dfa1b93182c7"
                      sourceElement="#ae1ecda7-db50-40b8-b703-93f82af84ca9"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="a99239db-351e-452d-a92a-1f08da4222fc" sid="b94bd614-26da-48ad-a82c-cab526c49eef"
                    name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="829e95c6-36b3-43d9-8c7d-fc55bf1cd259" targetElement="#19182af6-9210-45bb-a582-13e6c8b8cd9e"
                      sourceElement="#a99239db-351e-452d-a92a-1f08da4222fc"/>
                </outputs>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                  id="be7c7793-dae3-4187-8866-36e33bf2e4a1" sid="2b47a560-a08e-4e92-9843-e751a4d44757"
                  name="[SF2.2.5] Acquire manual override order" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Manual override&amp;nbsp;order and send it to the Drone as the&amp;nbsp;Manuel override, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="e3db768e-1096-4e41-be4c-660eb2032ae1" sid="95187af0-6668-407d-a75f-27b63b42827e"
                    name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="c872a3db-6cc7-45c1-aebb-223d153734d9" targetElement="#631f592e-1cfc-4c0d-ba6e-d417fce0eb1f"
                      sourceElement="#e3db768e-1096-4e41-be4c-660eb2032ae1"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="a0af18cd-88df-4e58-b84e-c86b6886a321" sid="a40d4be4-aed2-432c-9b54-5a550ed4f5be"
                    name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="9f3de78f-ff14-47ef-bd92-74d321db9d86" targetElement="#f6be4cad-bb8f-43ea-b76f-08fa8c4c812b"
                      sourceElement="#a0af18cd-88df-4e58-b84e-c86b6886a321"/>
                </outputs>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="209ae4c1-c097-4dd9-adcd-a13509880363" targetElement="#e2cef42d-604d-44e3-a59f-a7ceb328df61"
                  sourceElement="#ae35a3cd-fe94-41cf-abf9-48d5a208c9ea"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="9e1bc7d8-ef82-4674-ac32-00d7bdbc560a" name="[SF2.3] Control attitude"
                description="&lt;p>This function realises the closed-loop control of the drone attitude :&lt;/p>&#xA;&#xA;&lt;p>- first, the adequate attitude demand is selected (SF2.3.2), depending on AP engagement value :&amp;nbsp;IF AP engagement = &amp;quot;engaged&amp;quot;, THEN the Attitude AP values are selected ELSE the pilot consign are selected (Yaw rate demand is integrated to compute the yaw demand : SF2.3.1)&lt;/p>&#xA;&#xA;&lt;p>- then, SF2.3.3, SF2.3.4 and SF2.3.5 realise the closed-loop control of each angle (respectively pitch, roll, yaw) : they compute the requested forces related to each angle to achieve the requested positions, using the attitude position and speed measurements from SF3. Two typical control structure (see dedicated presentation)&amp;nbsp;: either a multi-variable PID loop&amp;nbsp;on both position and speed, or two imbricated PI loops on position and speed.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="855be126-36a9-4b35-96f6-09e42b4e8079" name="FIP Pitchcons">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="845b131d-9464-473c-8e4a-7e214689ebbf" targetElement="#b584b967-adaf-4649-8086-7474dca7a5d7"
                    sourceElement="#855be126-36a9-4b35-96f6-09e42b4e8079"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="3d7255fa-a1c1-4045-98b7-2691857c7a50" name="FIP Rollcons">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="96629b5c-550c-4774-8008-6f5f2f74c11e" targetElement="#3d8930b7-11b9-4ad5-9439-e4f485ff4be8"
                    sourceElement="#3d7255fa-a1c1-4045-98b7-2691857c7a50"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="facf79f2-b495-4dfa-b34b-0260cfa52c59" name="FIP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="b2cbf95e-f884-4889-993c-61cc0d3a1b7f" targetElement="#cd3ff36a-f2d1-4827-9fb9-df1223849254"
                    sourceElement="#facf79f2-b495-4dfa-b34b-0260cfa52c59"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="9e1fa8b8-9ade-4dfa-956c-7de23f35a442" name="FIP RC">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="57366af9-7c3f-47cc-b30b-1d56b2687529" targetElement="#4556bb54-25e7-4e36-8318-1c6ac9ddfc0d"
                    sourceElement="#9e1fa8b8-9ade-4dfa-956c-7de23f35a442"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="97582b36-637b-4d66-adb5-c480882b6fb6" name="FIP PC">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="341c9734-7c65-46de-babb-47c811f91160" targetElement="#29d4b5d2-7463-4701-9b17-2a9e33f5e4a2"
                    sourceElement="#97582b36-637b-4d66-adb5-c480882b6fb6"/>
              </inputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="47a65ee5-d64c-4e53-8da7-55b4003d9205" name="FOP P">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="be60dfec-13b2-4fcc-b3db-d817e5586def" targetElement="#7a03f733-8ada-43ff-a462-3cd224b1a903"
                    sourceElement="#47a65ee5-d64c-4e53-8da7-55b4003d9205"/>
              </outputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="065623a0-18a5-474d-94b4-c39dbf44d1f5" name="FOP R">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="99f4d2cf-37e0-4952-a3b6-d6b3c7ce7f5c" targetElement="#d415e9db-e809-48e9-9b2b-ab5822d3eed8"
                    sourceElement="#065623a0-18a5-474d-94b4-c39dbf44d1f5"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="7a405704-51a8-48f6-95a0-361f206b8070" targetElement="#95b05f8a-9768-4301-baa1-7c022773b99d"
                  sourceElement="#9e1bc7d8-ef82-4674-ac32-00d7bdbc560a"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="ee6d503e-5dbe-4fdc-b8aa-11a386d3b345" name="Pitch consign" target="#97582b36-637b-4d66-adb5-c480882b6fb6"
                  source="#47a65ee5-d64c-4e53-8da7-55b4003d9205">
                <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                    id="415dc1f2-8226-4604-a148-5bbdf65643f5" targetElement="#611ae85b-4d3e-41fb-b64a-d3f378683fea"
                    sourceElement="#ee6d503e-5dbe-4fdc-b8aa-11a386d3b345"/>
              </ownedFunctionalExchanges>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="d1ce89d3-b163-411f-8621-dd7e1142475a" name="Roll consign" target="#9e1fa8b8-9ade-4dfa-956c-7de23f35a442"
                  source="#065623a0-18a5-474d-94b4-c39dbf44d1f5">
                <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                    id="cd1dd27a-cb98-437d-8e52-dd478c34af36" targetElement="#71456c83-2579-46c7-9215-4f2a37787981"
                    sourceElement="#d1ce89d3-b163-411f-8621-dd7e1142475a"/>
              </ownedFunctionalExchanges>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="589937d9-4ceb-4c54-ac8f-4bcc82038d50" name="[SF2.4] Control altitude"
                description="&lt;p>This function computes the requested total thrust :&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;- in manual mode : to ensure the vertical speed demand provided by the pilot&lt;/p>&#xA;&#xA;&lt;p>- in AP mode, the total thrust demand is already computed by SF2.1&lt;/p>&#xA;&#xA;&lt;p>The final thrust demand is then selected according to the current control mode.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="e34edbcf-a026-498f-af8a-f5eee75a7ebc" name="FIP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="6b49fef8-1470-4bdc-b841-08d6f00a703f" targetElement="#0e44b5bb-c1ce-4d6b-9092-eff805ca1703"
                    sourceElement="#e34edbcf-a026-498f-af8a-f5eee75a7ebc"/>
              </inputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="e487bd15-ba6d-4086-b5dd-7296a0e441c9" targetElement="#953b4093-f578-4868-9822-7278b99c9a41"
                  sourceElement="#589937d9-4ceb-4c54-ac8f-4bcc82038d50"/>
            </ownedFunctions>
            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="a8895190-4037-4347-b75b-9f3587d00ce7" targetElement="#29a142a3-61be-4359-808b-d77d7b2ede5f"
                sourceElement="#8afd055e-6abb-46ef-bfbc-078af7a41123"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="bdecc116-f15c-46c8-9fd2-6c745efcc7e8" name="Pitch consign" target="#855be126-36a9-4b35-96f6-09e42b4e8079"
                source="#2ab9efa7-43bd-4ee5-870c-3021187a9f46">
              <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
