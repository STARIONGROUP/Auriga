              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="3cc3d1ab-2479-4973-8da4-b8e340150732" sid="8a6f15a7-6d0a-4a74-aab8-604c73eb9a10"
                  name="FOP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="ed8e816a-07c5-4e16-9eee-ef80ce90ceaf" targetElement="#2570f5dd-872a-423b-970d-9168af8c2230"
