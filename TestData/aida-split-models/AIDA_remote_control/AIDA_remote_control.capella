                  id="4df4756d-3e1b-4b95-8a8f-be692c3f16f6" sid="fa21376c-d575-40af-a92c-395c8e7b24d2"
                  name="FOP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="9b4f3997-b822-426a-a1fe-93ebde596882" sid="95e831cd-3943-44d3-9650-8a8a06c231ef"
                  name="FOP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="19182af6-9210-45bb-a582-13e6c8b8cd9e" sid="b94bd614-26da-48ad-a82c-cab526c49eef"
                  name="FOP 1"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="f6be4cad-bb8f-43ea-b76f-08fa8c4c812b" sid="a40d4be4-aed2-432c-9b54-5a550ed4f5be"
                  name="FOP 1"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="95b05f8a-9768-4301-baa1-7c022773b99d" sid="79fd1a18-e41e-4fa5-9d45-cff4b6bfe612"
                name="[SF2.3] Control attitude" description="&lt;p>This function realises the closed-loop control of the drone attitude :&lt;/p>&#xA;&#xA;&lt;p>- first, the adequate attitude demand is selected (SF2.3.2), depending on AP engagement value :&amp;nbsp;IF AP engagement = &amp;quot;engaged&amp;quot;, THEN the Attitude AP values are selected ELSE the pilot consign are selected (Yaw rate demand is integrated to compute the yaw demand : SF2.3.1)&lt;/p>&#xA;&#xA;&lt;p>- then, SF2.3.3, SF2.3.4 and SF2.3.5 realise the closed-loop control of each angle (respectively pitch, roll, yaw) : they compute the requested forces related to each angle to achieve the requested positions, using the attitude position and speed measurements from SF3. Two typical control structure (see dedicated presentation)&amp;nbsp;: either a multi-variable PID loop&amp;nbsp;on both position and speed, or two imbricated PI loops on position and speed.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="b584b967-adaf-4649-8086-7474dca7a5d7" sid="0d60a4aa-510c-444e-8320-a44465867428"
                  name="FIP Pitchcons"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="3d8930b7-11b9-4ad5-9439-e4f485ff4be8" sid="5d4db713-8567-4964-9b5b-00ab25048bbe"
                  name="FIP Rollcons"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="cd3ff36a-f2d1-4827-9fb9-df1223849254" sid="e4bd1d4e-12a5-40ae-bd26-a5451296db1a"
                  name="FIP 1"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="4556bb54-25e7-4e36-8318-1c6ac9ddfc0d" sid="6b20556f-ce67-4489-a0df-6d7ea757aabd"
                  name="FIP RC"/>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="29d4b5d2-7463-4701-9b17-2a9e33f5e4a2" sid="73b2f756-05bd-4c16-85e8-3929667d9485"
                  name="FIP PC"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="7a03f733-8ada-43ff-a462-3cd224b1a903" sid="86c6098e-1269-40b3-987f-65d78b060bbd"
                  name="FOP P"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="d415e9db-e809-48e9-9b2b-ab5822d3eed8" sid="40d44593-8d21-489d-93b6-80d8d30fd555"
                  name="FOP R"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="611ae85b-4d3e-41fb-b64a-d3f378683fea" sid="ed8f1731-eae4-47e0-9bbe-0d94b8eb2535"
                  name="Pitch consign" target="#29d4b5d2-7463-4701-9b17-2a9e33f5e4a2"
                  source="#7a03f733-8ada-43ff-a462-3cd224b1a903"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="71456c83-2579-46c7-9215-4f2a37787981" sid="8b548238-1c7f-46be-8940-cd12be0eccc9"
                  name="Roll consign" target="#4556bb54-25e7-4e36-8318-1c6ac9ddfc0d"
                  source="#d415e9db-e809-48e9-9b2b-ab5822d3eed8"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="953b4093-f578-4868-9822-7278b99c9a41" sid="b7e0ca10-5698-4cf6-a0cf-94994d78cc82"
                name="[SF2.4] Control altitude" description="&lt;p>This function computes the requested total thrust :&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;- in manual mode : to ensure the vertical speed demand provided by the pilot&lt;/p>&#xA;&#xA;&lt;p>- in AP mode, the total thrust demand is already computed by SF2.1&lt;/p>&#xA;&#xA;&lt;p>The final thrust demand is then selected according to the current control mode.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="0e44b5bb-c1ce-4d6b-9092-eff805ca1703" sid="cd7d10aa-056e-464b-bde1-f95a32eef3f4"
                  name="FIP 1"/>
            </ownedFunctions>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="8a3b3d62-813c-498a-9069-aa0a48f360c4" sid="21e1f77a-caa6-4c97-adc2-7bd2953081eb"
                name="Pitch consign" target="#b584b967-adaf-4649-8086-7474dca7a5d7"
                source="#c77e7c48-7af2-4801-a938-8a064ef93dc0"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="2439afe8-d36f-4935-9571-38aa796df537" sid="e7033dda-7cf7-458a-bbf9-cb6d5af38679"
                name="Roll consign" target="#3d8930b7-11b9-4ad5-9439-e4f485ff4be8"
                source="#4df4756d-3e1b-4b95-8a8f-be692c3f16f6"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="29fd6b90-8bc9-4e81-978e-7a3e1566e130" sid="ca719674-a861-48d5-aba1-89c2de588a07"
                name="Yaw rate consign" target="#cd3ff36a-f2d1-4827-9fb9-df1223849254"
                source="#9b4f3997-b822-426a-a1fe-93ebde596882"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="a45102df-5771-42e6-a24a-ed1c3fe8044c" sid="d328f57f-7274-4a56-bd5b-03592ec4f772"
                name="Vertical speed consign" target="#0e44b5bb-c1ce-4d6b-9092-eff805ca1703"
                source="#19182af6-9210-45bb-a582-13e6c8b8cd9e"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
              id="74108d99-f569-4d2c-933f-37c2c9139738" sid="8a19701e-f284-4998-be02-e928f328e10d"
              name="[SF4] Control drone navigation" description="&lt;p>Depending on the control mode selected by the pilot, the AIDA system moves to the requested position and visual sight angle :&lt;/p>&#xA;&#xA;&lt;p>- in AUTO mode, it executes the mission previously defined&lt;/p>&#xA;&#xA;&lt;p>- in MANUAL mode, it executes the real-time manual motion commands&lt;/p>&#xA;&#xA;&lt;p>The AIDA system provides mission progress feedback to the operator.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="c76c7998-4806-436f-9f89-1f8497712d78" sid="9a6d5e8c-257d-4803-bc55-df7d4f439705"
                name="[SF4.3] Select control mode" description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>The drone pilot can always select control mode and override automatic flight plan mode with the &amp;quot;Pilot control mode&amp;quot; and&amp;quot;manual override&amp;quot;&amp;nbsp;signal. Then, the function interrupts the flight plan with the &amp;quot;flight plan interruption&amp;quot;. &lt;/span>&lt;/p>&#xA;&#xA;&lt;p>&amp;quot;Manual override&amp;quot; signal has been added in V4.3.&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&amp;nbsp;&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="5071633d-5510-402a-ae51-654d94f4f2ea" sid="892d6d5f-728d-48b3-9e36-313f31d3e97d"
                  name="FIP 6"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="a09054ba-fdef-4efa-9c14-e364c4dbe65a" sid="eb78a5c8-3ffa-4533-9522-86f52a6bfc69"
                name="[SF4.4] Acquire pilot control consigns and mode" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The control desk shall acquire the following pilot control consigns : automatic control start, pilot control consigns, pilote control mode.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall send the automatic control start, pilot control consigns and&amp;nbsp;pilot control mode&amp;nbsp;to the drone, along with the associated validity statuses.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="c813f837-5c33-4db1-98d6-cc78837ac08f" sid="ec940287-853d-46fd-bc4a-29eaf49084fd"
                  name="FIP 2"/>
            </ownedFunctions>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
              id="dca2f2e4-9f67-4319-a289-7f2759f00afa" sid="be3372e7-9db6-471d-88e4-f4f616ae58f6"
              name="[SF5] Make and record video">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="a75c6389-7265-47ff-9a65-42d0cf73ad62" sid="9ff12d46-56e3-4215-bbda-c75328c1f418"
                name="[SF5.1] Select camera control" description="&lt;p>&lt;em>Note : the control mode information is missing. In the requirement below, it is assumed that the &amp;quot;AP engagement&amp;quot; information is available as an input of SF5.1.&lt;/em>&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The video processor shall select the Camera position consign, Photo and video control and File storage format and associated validity statuses as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup span=&quot;5&quot; width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; height=&quot;70&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Manual payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Output value *&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Output status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;96&quot; rowspan=&quot;2&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;96&quot; rowspan=&quot;2&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Manual payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Manual payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;&#xA;&lt;p>* : output&amp;nbsp;corresponds&amp;nbsp;to the set of the following information : Camera position consign, Photo and&amp;nbsp;video control, file storage format, which are contained in Automatic/Manual&amp;nbsp;payload control flows.&amp;nbsp;&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="ac9a85b0-9fd2-44b0-b7c7-52b583d6a1ba" sid="e43c1d6d-5398-4456-9c90-070e300656ca"
                  name="FIP 2"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction"
                id="cc988439-3638-47eb-841d-d97f3f85bf11" sid="b843cafa-4af1-411a-a391-3a18cf781cbd"
                name="[SF5.5] Acquire manual payload control" description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The camera remote control shall acquire the Manual payload control and provide an associated validity status.&lt;/p>&#xA;&#xA;&lt;p>The camera remote control shall send the Manual payload control and its validity status to the Video processor.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="b12d04c1-49e8-46e4-bf29-0a4be3f8228d" sid="c30c1281-1adc-4e26-88a2-06df1ebea1ee"
                  name="FIP 2"/>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="2570f5dd-872a-423b-970d-9168af8c2230" sid="8a6f15a7-6d0a-4a74-aab8-604c73eb9a10"
                  name="FOP 1"/>
            </ownedFunctions>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="9597b153-0306-4f78-a9fc-3d11812196ba" sid="b1885492-83b6-46dc-ad5e-855cab067f12"
                name="Manual payload control" target="#ac9a85b0-9fd2-44b0-b7c7-52b583d6a1ba"
                source="#2570f5dd-872a-423b-970d-9168af8c2230"/>
          </ownedFunctions>
