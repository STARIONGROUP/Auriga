          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="7f3d0655-311f-424a-940f-f36221fad7e6" name="[SF2] Control drone attitude and position"
              description="&lt;p>This function computes the engine rotation rate to ensure either (depending on the control mode) :&lt;/p>&#xA;&#xA;&lt;p>- in AP mode : &amp;nbsp;the speed and position demands provided by SF4&lt;/p>&#xA;&#xA;&lt;p>- in manual mode : the attitude and altitude demands provided by the pilot&lt;/p>&#xA;&#xA;&lt;p>(see breakdown for d&amp;eacute;tails)&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="dee1e5f2-bd95-41f3-b5bc-fd377ed73ffc" name="[SF2.2] Acquire pilot orders"
                description="&lt;p>This function acquires the following pilots orders : manuel override, vertical speed, pitch demand, roll demand, yaw rate demand.&lt;/p>&#xA;">
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="df6b8a53-9d20-40b2-96b4-bbef926cace8" name="[SF2.2.1] Acquire pitch order"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote Pitch order and send it to the Drone as the Pitch consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="e2cf54f1-711c-4589-b40b-2bef3988da53" name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="fd3cd460-9702-410c-a275-581793987395" targetElement="#42b5fcf1-5183-4f85-b178-5537d20689a3"
                      sourceElement="#e2cf54f1-711c-4589-b40b-2bef3988da53"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="b0308f9b-a0de-48b7-8b00-cd8c9846d04e" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="e0ce9d7d-a8e5-4662-89c4-4eb57e760dd4" targetElement="#2ab9efa7-43bd-4ee5-870c-3021187a9f46"
                      sourceElement="#b0308f9b-a0de-48b7-8b00-cd8c9846d04e"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="4153e538-23fc-4df2-97e6-db174fb709e7" targetElement="#792053b9-6db0-4f4c-9f82-65de8de48a5f"
                    sourceElement="#df6b8a53-9d20-40b2-96b4-bbef926cace8"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="75087309-c47c-47ce-a649-cd37da42d526" name="[SF2.2.2] Acquire roll order"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Roll order and send it to the Drone as the&amp;nbsp;Roll consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="420ee9c8-35bb-493d-ac1c-fb146435e555" name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="5a400e2c-f4cd-468f-be84-6ebeff5362db" targetElement="#6ea37fea-4fb8-4e09-b63a-b1da2538e191"
                      sourceElement="#420ee9c8-35bb-493d-ac1c-fb146435e555"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="713df6cd-9c92-4924-a0d0-c30c638fc1ee" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="8095e4ab-ffda-4fb1-9d5b-5df72f95596c" targetElement="#89151cdf-fef3-4192-8885-b6ceab1c26c4"
                      sourceElement="#713df6cd-9c92-4924-a0d0-c30c638fc1ee"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="07e421b7-303f-452b-a388-31f89440404e" targetElement="#2b8d7709-fb89-418b-8ca8-0565118e670b"
                    sourceElement="#75087309-c47c-47ce-a649-cd37da42d526"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="769fde35-f948-4907-913b-5b8d4ed33ab2" name="[SF2.2.3] Acquire yaw rate order"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Yaw rate order and send it to the Drone as the&amp;nbsp;Yaw rate consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="733ccf18-d535-4c6c-a70f-eca42c0a06fe" name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="1c2f4957-822d-4a7c-8e86-df4a9ebcf7cc" targetElement="#5e23dfea-64ec-4c92-9358-df7818815c7f"
                      sourceElement="#733ccf18-d535-4c6c-a70f-eca42c0a06fe"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="77cab5d6-0330-4993-86c8-f53606f4caa2" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="0976df02-f2c4-41bb-806e-24514ad48c98" targetElement="#aa47f6d7-50ae-4dbb-9067-9afe75ab08df"
                      sourceElement="#77cab5d6-0330-4993-86c8-f53606f4caa2"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="aaf01963-3801-4562-9481-0644f5893338" targetElement="#a7d75531-676a-4653-a8dd-50849a5ae5ee"
                    sourceElement="#769fde35-f948-4907-913b-5b8d4ed33ab2"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="9f9b937e-cd05-4db1-aad7-c0594b73d2d0" name="[SF2.2.4] Acquire vertical speed order"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Altitude order and send it to the Drone as the&amp;nbsp;Altitude consign, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="a4503cb6-afeb-43c7-9ebc-a739b58920f7" name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="bc73866a-6f9c-43ab-978f-4ac0e538d4ac" targetElement="#ae1ecda7-db50-40b8-b703-93f82af84ca9"
                      sourceElement="#a4503cb6-afeb-43c7-9ebc-a739b58920f7"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="86ac4739-153a-4237-bd95-9a20bf142783" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="f05b8fcd-2fb6-4b28-84a7-1479257a9fed" targetElement="#a99239db-351e-452d-a92a-1f08da4222fc"
                      sourceElement="#86ac4739-153a-4237-bd95-9a20bf142783"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="274bea37-2d09-4833-a7ec-4c5d0020d6af" targetElement="#3f880e63-67fd-400d-bca6-606071785301"
                    sourceElement="#9f9b937e-cd05-4db1-aad7-c0594b73d2d0"/>
              </ownedFunctions>
              <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                  id="3dbbd80b-d42d-428c-beef-52f6c8ed67a2" name="[SF2.2.5] Acquire manual override order"
                  description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The remote control shall acquire the pilote&amp;nbsp;Manual override&amp;nbsp;order and send it to the Drone as the&amp;nbsp;Manuel override, associated with its validity status.&lt;/p>&#xA;&#xA;&lt;p>(Note : the validity status computation is not defined yet, it will depend on the physical implementation of the function)&lt;/p>&#xA;">
                <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                    id="256de904-51a7-4503-8237-6d2aefd509ab" name="FIP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="367ba0ed-22a1-4848-8d05-9af1638c04f6" targetElement="#e3db768e-1096-4e41-be4c-660eb2032ae1"
                      sourceElement="#256de904-51a7-4503-8237-6d2aefd509ab"/>
                </inputs>
                <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                    id="deb3c8f8-0acb-4bba-a1d6-c72aeeb68e8f" name="FOP 1">
                  <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                      id="b1c8b16b-7c06-4eb9-ae34-07f4bb1251ec" targetElement="#a0af18cd-88df-4e58-b84e-c86b6886a321"
                      sourceElement="#deb3c8f8-0acb-4bba-a1d6-c72aeeb68e8f"/>
                </outputs>
                <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                    id="000d99a3-5b79-4e6d-9cab-607d1121e3bb" targetElement="#be7c7793-dae3-4187-8866-36e33bf2e4a1"
                    sourceElement="#3dbbd80b-d42d-428c-beef-52f6c8ed67a2"/>
              </ownedFunctions>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="1257056c-4420-4cc1-be15-66f7f483096c" targetElement="#ae35a3cd-fe94-41cf-abf9-48d5a208c9ea"
                  sourceElement="#dee1e5f2-bd95-41f3-b5bc-fd377ed73ffc"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="5da87bc7-f6f3-47d6-a915-99f2fc063a66" name="[SF2.3] Control attitude"
                description="&lt;p>This function realises the closed-loop control of the drone attitude :&lt;/p>&#xA;&#xA;&lt;p>- first, the adequate attitude demand is selected (SF2.3.2), depending on AP engagement value :&amp;nbsp;IF AP engagement = &amp;quot;engaged&amp;quot;, THEN the Attitude AP values are selected ELSE the pilot consign are selected (Yaw rate demand is integrated to compute the yaw demand : SF2.3.1)&lt;/p>&#xA;&#xA;&lt;p>- then, SF2.3.3, SF2.3.4 and SF2.3.5 realise the closed-loop control of each angle (respectively pitch, roll, yaw) : they compute the requested forces related to each angle to achieve the requested positions, using the attitude position and speed measurements from SF3. Two typical control structure (see dedicated presentation)&amp;nbsp;: either a multi-variable PID loop&amp;nbsp;on both position and speed, or two imbricated PI loops on position and speed.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="49794797-0454-49c1-973b-2c9d0d609e9c" name="FIP Pitchcons">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="743a84f6-30a0-4aba-921e-3990b4788631" targetElement="#855be126-36a9-4b35-96f6-09e42b4e8079"
                    sourceElement="#49794797-0454-49c1-973b-2c9d0d609e9c"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="c2a8a218-dfca-4c9a-ba9f-f670bced18e0" name="FIP Rollcons">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="fa5b5081-0771-4afb-8e3e-823ffb49c12c" targetElement="#3d7255fa-a1c1-4045-98b7-2691857c7a50"
                    sourceElement="#c2a8a218-dfca-4c9a-ba9f-f670bced18e0"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="0d9b521c-8886-4c7e-9e38-e07f22a6bbd1" name="FIP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="8c6833a5-6f75-431d-bd8d-10ce521f15f4" targetElement="#facf79f2-b495-4dfa-b34b-0260cfa52c59"
                    sourceElement="#0d9b521c-8886-4c7e-9e38-e07f22a6bbd1"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="2cf5ec3a-b747-4c83-9f03-c7a973c101e7" name="FIP RC">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="00696402-2332-4123-a13e-af4c026e0017" targetElement="#9e1fa8b8-9ade-4dfa-956c-7de23f35a442"
                    sourceElement="#2cf5ec3a-b747-4c83-9f03-c7a973c101e7"/>
              </inputs>
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="b7e7c6bc-5667-4c08-9cb4-b00f85c44421" name="FIP PC">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="39b19b2c-e27b-43b0-9d91-abe14b977b33" targetElement="#97582b36-637b-4d66-adb5-c480882b6fb6"
                    sourceElement="#b7e7c6bc-5667-4c08-9cb4-b00f85c44421"/>
              </inputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="1fb992cb-849e-4dac-aa5d-0a7182d8e9ba" name="FOP P">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="50292444-dee1-4d87-835f-0a177a05d99e" targetElement="#47a65ee5-d64c-4e53-8da7-55b4003d9205"
                    sourceElement="#1fb992cb-849e-4dac-aa5d-0a7182d8e9ba"/>
              </outputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="0b3788cb-14ea-43a7-a95f-53ce48a5eba9" name="FOP R">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="517fde8e-7b3d-4cc8-b724-29187732c968" targetElement="#065623a0-18a5-474d-94b4-c39dbf44d1f5"
                    sourceElement="#0b3788cb-14ea-43a7-a95f-53ce48a5eba9"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="8331f902-6fd6-4cec-9da0-e1255d491c9d" targetElement="#9e1bc7d8-ef82-4674-ac32-00d7bdbc560a"
                  sourceElement="#5da87bc7-f6f3-47d6-a915-99f2fc063a66"/>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="37f1d2d0-aec1-4fa1-bf3b-20bc63e4bbdc" name="Pitch consign" target="#b7e7c6bc-5667-4c08-9cb4-b00f85c44421"
                  source="#1fb992cb-849e-4dac-aa5d-0a7182d8e9ba">
                <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                    id="55fbdf3f-be1f-4027-8bf8-9bf78b212534" targetElement="#ee6d503e-5dbe-4fdc-b8aa-11a386d3b345"
                    sourceElement="#37f1d2d0-aec1-4fa1-bf3b-20bc63e4bbdc"/>
              </ownedFunctionalExchanges>
              <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                  id="6b5019d6-929a-4103-b30d-677570eb10fb" name="Roll consign" target="#2cf5ec3a-b747-4c83-9f03-c7a973c101e7"
                  source="#0b3788cb-14ea-43a7-a95f-53ce48a5eba9">
                <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                    id="c6838a67-fa3f-49ce-9fa6-5cb6d26a0a9b" targetElement="#d1ce89d3-b163-411f-8621-dd7e1142475a"
                    sourceElement="#6b5019d6-929a-4103-b30d-677570eb10fb"/>
              </ownedFunctionalExchanges>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="c8270852-a6f5-4e19-a4b4-0c71fd9d3bc1" name="[SF2.4] Control altitude"
                description="&lt;p>This function computes the requested total thrust :&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;- in manual mode : to ensure the vertical speed demand provided by the pilot&lt;/p>&#xA;&#xA;&lt;p>- in AP mode, the total thrust demand is already computed by SF2.1&lt;/p>&#xA;&#xA;&lt;p>The final thrust demand is then selected according to the current control mode.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="2bd4ea7f-a4ba-4940-8809-9d07e45a928f" name="FIP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="fa065c6e-db93-4a1e-89b9-efb493d7f3c8" targetElement="#e34edbcf-a026-498f-af8a-f5eee75a7ebc"
                    sourceElement="#2bd4ea7f-a4ba-4940-8809-9d07e45a928f"/>
              </inputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="1bfcd431-507d-4af3-bf6d-a7853c5e62d5" targetElement="#589937d9-4ceb-4c54-ac8f-4bcc82038d50"
                  sourceElement="#c8270852-a6f5-4e19-a4b4-0c71fd9d3bc1"/>
            </ownedFunctions>
            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="62141ab8-d7f4-4e34-a403-c499eb13405a" targetElement="#8afd055e-6abb-46ef-bfbc-078af7a41123"
                sourceElement="#7f3d0655-311f-424a-940f-f36221fad7e6"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="b09b0e28-ae1d-49ea-a3d6-7adef12ae5b4" name="Pitch consign" target="#49794797-0454-49c1-973b-2c9d0d609e9c"
                source="#b0308f9b-a0de-48b7-8b00-cd8c9846d04e">
              <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                  id="67c28006-fa3d-4007-994d-84b163a86baf" targetElement="#bdecc116-f15c-46c8-9fd2-6c745efcc7e8"
                  sourceElement="#b09b0e28-ae1d-49ea-a3d6-7adef12ae5b4"/>
            </ownedFunctionalExchanges>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="5bfe79d8-b9e3-42a5-8293-2dc3bc3becb4" name="Roll consign" target="#c2a8a218-dfca-4c9a-ba9f-f670bced18e0"
                source="#713df6cd-9c92-4924-a0d0-c30c638fc1ee">
              <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                  id="7f9efb93-2db6-4d68-b382-5a13a2e7bb72" targetElement="#3abba625-ae23-4462-9f45-4396b6e27ba0"
                  sourceElement="#5bfe79d8-b9e3-42a5-8293-2dc3bc3becb4"/>
            </ownedFunctionalExchanges>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="68ee9ffe-d1ed-419e-a0d1-0a189d314f28" name="Yaw rate consign"
                target="#0d9b521c-8886-4c7e-9e38-e07f22a6bbd1" source="#77cab5d6-0330-4993-86c8-f53606f4caa2">
              <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                  id="95f46a96-d55f-44cd-9986-fe15c4835c74" targetElement="#67cf02d7-e636-4b62-9817-7fcd4c1a9305"
                  sourceElement="#68ee9ffe-d1ed-419e-a0d1-0a189d314f28"/>
            </ownedFunctionalExchanges>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="f9934e38-b927-4eba-8394-8519f67c9e5b" name="Vertical speed consign"
                target="#2bd4ea7f-a4ba-4940-8809-9d07e45a928f" source="#86ac4739-153a-4237-bd95-9a20bf142783">
              <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                  id="13f924fd-97e8-446e-98ab-2ca87ca35d2c" targetElement="#7770b518-e9ec-4be5-a7c7-57a3b05b727c"
                  sourceElement="#f9934e38-b927-4eba-8394-8519f67c9e5b"/>
            </ownedFunctionalExchanges>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="e9a1304a-5068-4b5b-bed3-44ee6dfd40fc" name="[SF4] Control drone navigation"
              description="&lt;p>Depending on the control mode selected by the pilot, the AIDA system moves to the requested position and visual sight angle :&lt;/p>&#xA;&#xA;&lt;p>- in AUTO mode, it executes the mission previously defined&lt;/p>&#xA;&#xA;&lt;p>- in MANUAL mode, it executes the real-time manual motion commands&lt;/p>&#xA;&#xA;&lt;p>The AIDA system provides mission progress feedback to the operator.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="4173f9bb-a8db-4075-9b72-2964ebc4192a" name="[SF4.3] Select control mode"
                description="&lt;p dir=&quot;LTR&quot;>&lt;span lang=&quot;EN&quot;>The drone pilot can always select control mode and override automatic flight plan mode with the &amp;quot;Pilot control mode&amp;quot; and&amp;quot;manual override&amp;quot;&amp;nbsp;signal. Then, the function interrupts the flight plan with the &amp;quot;flight plan interruption&amp;quot;. &lt;/span>&lt;/p>&#xA;&#xA;&lt;p>&amp;quot;Manual override&amp;quot; signal has been added in V4.3.&lt;/p>&#xA;&#xA;&lt;p dir=&quot;LTR&quot;>&amp;nbsp;&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="826c86c0-34e2-4250-b286-b422141659a0" name="FIP 6">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="7623ecb8-7f1a-405c-864e-37f99372d1f9" targetElement="#8eea2d29-757d-4099-82e9-d039f3765e5b"
                    sourceElement="#826c86c0-34e2-4250-b286-b422141659a0"/>
              </inputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="1a575c61-dc3c-46df-b773-7b6c1d05c01e" targetElement="#87cceec1-1c4b-436a-82d3-d6553e616a96"
                  sourceElement="#4173f9bb-a8db-4075-9b72-2964ebc4192a"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="de8655d6-13c0-4262-8caa-40e9d9407dea" name="[SF4.4] Acquire pilot control consigns and mode"
                description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The control desk shall acquire the following pilot control consigns : automatic control start, pilot control consigns, pilote control mode.&lt;/p>&#xA;&#xA;&lt;p>The control desk shall send the automatic control start, pilot control consigns and&amp;nbsp;pilot control mode&amp;nbsp;to the drone, along with the associated validity statuses.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="cc716f1c-3b66-4488-ba1c-1020b83a226e" name="FIP 2">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="cee3409c-6a43-40d4-a9c2-55b045d1cc23" targetElement="#7007c4f2-398c-4a61-997c-26b842cc3027"
                    sourceElement="#cc716f1c-3b66-4488-ba1c-1020b83a226e"/>
              </inputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="5516fdb2-f00d-45b3-9a57-7886167552e5" targetElement="#13b3085d-1d65-40b1-a2c0-683415ecefd0"
                  sourceElement="#de8655d6-13c0-4262-8caa-40e9d9407dea"/>
            </ownedFunctions>
            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="f696214b-2ded-47c1-8365-e8191a233e48" targetElement="#47c45e6f-3e92-4634-bd98-da94cfdddd28"
                sourceElement="#e9a1304a-5068-4b5b-bed3-44ee6dfd40fc"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
              id="c8c398c8-4616-4c89-9ce2-f7ab78fa477f" name="[SF5] Make and record video">
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="6f0622a6-3367-4d99-bf0b-682a51020f68" name="[SF5.1] Select camera control"
                description="&lt;p>&lt;em>Note : the control mode information is missing. In the requirement below, it is assumed that the &amp;quot;AP engagement&amp;quot; information is available as an input of SF5.1.&lt;/em>&lt;/p>&#xA;&#xA;&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The video processor shall select the Camera position consign, Photo and video control and File storage format and associated validity statuses as follows :&lt;/p>&#xA;&#xA;&lt;table border=&quot;0&quot; cellspacing=&quot;0&quot;>&#xA;&#x9;&lt;colgroup span=&quot;5&quot; width=&quot;171&quot;>&#xA;&#x9;&lt;/colgroup>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; height=&quot;70&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>AP engagement&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Manual payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Output value *&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Output status&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;96&quot; rowspan=&quot;2&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>AUTO&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Automatic payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;center&quot; height=&quot;96&quot; rowspan=&quot;2&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot; valign=&quot;middle&quot;>MANUAL&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Manual payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>VALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>N/A&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>Manual payload control&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td align=&quot;left&quot; style=&quot;border: 2px solid rgb(0, 0, 0); border-image: none;&quot;>INVALID&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;&#xA;&lt;p>* : output&amp;nbsp;corresponds&amp;nbsp;to the set of the following information : Camera position consign, Photo and&amp;nbsp;video control, file storage format, which are contained in Automatic/Manual&amp;nbsp;payload control flows.&amp;nbsp;&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="3772da4e-e5f6-496c-8bbf-192220ab56ed" name="FIP 2">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="0a56b496-b96f-45c2-8d58-dfd26feb3e73" targetElement="#ae79e57b-20b1-4517-ad61-992c230ac3a7"
                    sourceElement="#3772da4e-e5f6-496c-8bbf-192220ab56ed"/>
              </inputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="04bbef59-476f-4bad-b377-07e29391ffc2" targetElement="#93e4a8cc-82cb-47bd-b90f-bfca7d90b0e8"
                  sourceElement="#6f0622a6-3367-4d99-bf0b-682a51020f68"/>
            </ownedFunctions>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.pa:PhysicalFunction"
                id="576ee6ba-7590-4fef-a24c-d460c900d0b9" name="[SF5.5] Acquire manual payload control"
                description="&lt;p>REQ :&lt;/p>&#xA;&#xA;&lt;p>The camera remote control shall acquire the Manual payload control and provide an associated validity status.&lt;/p>&#xA;&#xA;&lt;p>The camera remote control shall send the Manual payload control and its validity status to the Video processor.&lt;/p>&#xA;">
              <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                  id="31e4b31a-3e78-43a7-a037-2feeb9bdbef5" name="FIP 2">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="7ced4901-0548-4825-b416-b68124c3224b" targetElement="#2b52ca7d-8fb4-4923-b2ea-35432336e8d8"
                    sourceElement="#31e4b31a-3e78-43a7-a037-2feeb9bdbef5"/>
              </inputs>
              <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                  id="01d4a083-b934-45ce-9d6a-4f35fef2359b" name="FOP 1">
                <ownedPortRealizations xsi:type="org.polarsys.capella.core.data.information:PortRealization"
                    id="1e02b7fe-63e2-4ca9-b028-7a629ca463de" targetElement="#3cc3d1ab-2479-4973-8da4-b8e340150732"
                    sourceElement="#01d4a083-b934-45ce-9d6a-4f35fef2359b"/>
              </outputs>
              <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                  id="b5fd3325-e3c3-4e96-a2f6-738a563fc652" targetElement="#4c7dc8ab-732f-4f20-8eca-de998b43ef57"
                  sourceElement="#576ee6ba-7590-4fef-a24c-d460c900d0b9"/>
            </ownedFunctions>
            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="56a6784f-5656-4807-a047-3bc9473af918" targetElement="#b0f3ab37-a1dd-4b20-9265-6b7ae2b694ea"
                sourceElement="#c8c398c8-4616-4c89-9ce2-f7ab78fa477f"/>
            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="b126041d-0731-4df9-912a-e3125ce392e4" name="Manual payload control"
                target="#3772da4e-e5f6-496c-8bbf-192220ab56ed" source="#01d4a083-b934-45ce-9d6a-4f35fef2359b">
              <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                  id="a890eff0-49e2-4c7d-8fbe-9aa5e5823761" targetElement="#b6a74c7f-f883-4644-89a4-2d1c455ea4f0"
                  sourceElement="#b126041d-0731-4df9-912a-e3125ce392e4"/>
            </ownedFunctionalExchanges>
          </ownedFunctions>
          <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
              id="b1ae3797-5dac-4570-8825-d4e5052448b1" targetElement="#283c6479-7bcb-44f8-bc77-7cd7270fd746"
              sourceElement="#e51bdbf2-0304-48ea-8d34-85bd95448388"/>
