            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="ba27f203-7d6b-4bb9-9680-ffa8f5f6f59e" targetElement="#80990b7f-6cab-4903-9de6-60a21eb84af9"
