            <ownedFunctionalExchanges xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchange"
                id="67cf02d7-e636-4b62-9817-7fcd4c1a9305" name="Yaw rate consign"
                target="#facf79f2-b495-4dfa-b34b-0260cfa52c59" source="#aa47f6d7-50ae-4dbb-9067-9afe75ab08df">
              <ownedFunctionalExchangeRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionalExchangeRealization"
                  id="a9b05fd4-889e-4f25-8596-dc13f5b48ff5" targetElement="#29fd6b90-8bc9-4e81-978e-7a3e1566e130"
